package main
import (bytes, coll, env, grpc, io, mem, net, task, time, tls)

class Handler {
    #implements: grpc.ConcurrentUnaryHandler
    pub const func call(request: move grpc.UnaryRequest) !grpc.UnaryResponse {
        if request.path == "/interop.Concurrent/Wait" {
            io.println("waiting")!;
            task.sleep(time.Duration.fromSeconds(2)) catch (reason) {
                if task.isCancelled() { io.println("cancelled")!; }
                return reason;
            };
        }
        var response = grpc.response(coll.Vec<u8>.fromSlice(request.body.asConstSlice())!);
        response.initial.addText("x-worker", "ready")!;
        move(response)
    }
}

class Echo {
    #implements: grpc.ConcurrentStreamingHandler
    pub const func handle(stream: *grpc.ConcurrentServerStream) !grpc.Status {
        stream.initial.addText("x-stream", "ready")!;
        for {
            var input = stream.recvMessage() catch (reason) {
                if task.isCancelled() { io.println("stream cancelled")!; }
                return reason;
            };
            var message = move(input) ?? { break; };
            if bytes.equal(message.asConstSlice(), "pressure".asBytes()) {
                var pressure = coll.Vec<u8>.withCapacity(131072)!;
                for index in usize(0)..131072 { pressure.push(0)!; }
                stream.sendMessage(pressure.asConstSlice())!;
                io.println("pressure drained")!;
            } else {
                stream.sendMessage(message.asConstSlice())!;
            }
        }
        stream.trailing.addText("x-stream-end", "received")!;
        grpc.status(grpc.StatusCode.Ok, "")
    }
}

class StopHandler {
    #implements: grpc.ConcurrentUnaryHandler
    var signal: mem.Shared<grpc.Shutdown>;
    pub func init(signal: mem.Shared<grpc.Shutdown>) : signal(move(signal)) {}
    pub const func call(request: move grpc.UnaryRequest) !grpc.UnaryResponse {
        signal.asPtr().request()!;
        grpc.response(coll.Vec<u8>.fromSlice(request.body.asConstSlice())!)
    }
}

func main() !void {
    var server = grpc.Server();
    var handler = Handler();
    var echo = Echo();
    var stop = mem.Shared<grpc.Shutdown>.new(grpc.Shutdown.open()!)!;
    var stopHandler = StopHandler(stop.clone());
    var options = grpc.ServeOptions();
    options.applicationWorkers = 1;
    options.compressResponses = true;
    if env.get("VAQRIN_RPC_SHORT_DRAIN")! != null {
        options.shutdownTimeout = time.Duration.fromMillis(300);
    }
    unsafe {
        server.registerConcurrent("/interop.Concurrent/Wait", raw handler)!;
        server.registerConcurrent("/interop.Concurrent/Fast", raw handler)!;
        server.registerConcurrentStreaming("/interop.Concurrent/Echo", raw echo)!;
        server.registerConcurrent("/interop.Concurrent/Stop", raw stopHandler)!;
    }
    var listener = net.AsyncTcpListener.bind(net.parseSocketAddr("127.0.0.1:0")!)!;
    io.println(listener.localAddr()!.port())!;
    var certificate = env.get("VAQRIN_RPC_CERT")!;
    if certificate != null {
        var cert = move(certificate).unwrap();
        var key = env.get("VAQRIN_RPC_KEY")!.unwrap();
        var config = tls.TlsConfig();
        config.addProtocol("h2".asBytes())!;
        config.requireProtocol = true;
        var acceptor = tls.TlsAcceptor.fromPem(cert, key, move(config))!;
        return server.acceptConcurrentTls(raw listener, raw acceptor, options, null, some(stop.asPtr()));
    }
    socket, peer := listener.accept(null)!;
    server.serveConcurrentH2c(move(socket), options, some(stop.asPtr()))
}
