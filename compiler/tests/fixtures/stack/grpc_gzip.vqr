package main
import (bytes, coll, env, grpc, io, net)

error TestError { Unexpected }

class Echo {
    #implements: grpc.UnaryHandler
    pub func call(request: grpc.UnaryRequest) !grpc.UnaryResponse {
        grpc.response(coll.Vec<u8>.fromSlice(request.body.asConstSlice())!)
    }
}

func serve() !void {
    var server = grpc.Server();
    var handler = Echo{};
    server.register("/interop.Raw/Echo", &handler)!;
    var listener = net.listenTcp(net.parseSocketAddr("127.0.0.1:0")!)!;
    io.println(listener.localAddr()!.port())!;
    raw, _ := listener.accept()!;
    var options = grpc.ServeOptions();
    options.compressResponses = true;
    server.serveH2c(move(raw), options)
}

func main() !void {
    var endpoint = env.get("VAQRIN_RPC_ADDRESS")! ?? { return serve(); };
    var settings = grpc.DialOptions();
    settings.allowH2c = true;
    var connection = grpc.dial(endpoint, settings)!;
    var options = grpc.CallOptions();
    options.compression = grpc.Compression.Gzip;
    var message = coll.Vec<u8>.withCapacity(8192)!;
    for i in usize(0)..8192 { message.push(97)!; }
    var large = connection.start("/interop.Raw/Echo", &options)!;
    var short = connection.start("/interop.Raw/Echo", &options)!;
    connection.sendMessage(&large, message.asConstSlice())!;
    connection.finishSend(&large)!;
    connection.sendMessage(&short, "short".asBytes())!;
    connection.finishSend(&short)!;

    var shortReply = connection.recvMessage(&short)! ?? { return TestError.Unexpected; };
    if !bytes.equal(shortReply.asConstSlice(), "short".asBytes()) { return TestError.Unexpected; }
    if connection.recvMessage(&short)! != null { return TestError.Unexpected; }
    var shortStatus = short.complete()!;
    if !shortStatus.status.isOk() { return TestError.Unexpected; }

    var longReply = connection.recvMessage(&large)! ?? { return TestError.Unexpected; };
    if !bytes.equal(longReply.asConstSlice(), message.asConstSlice()) { return TestError.Unexpected; }
    if connection.recvMessage(&large)! != null { return TestError.Unexpected; }
    var largeStatus = large.complete()!;
    if !largeStatus.status.isOk() { return TestError.Unexpected; }
    connection.close()
}
