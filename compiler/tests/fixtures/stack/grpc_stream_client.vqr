package main
import (env, grpc, protobuf, result, time)

error StreamTestError { BadValue }

func require(ok: bool) !void { if !ok { return StreamTestError.BadValue; } }

func send(connection: *grpc.ClientConn, call: *grpc.Call, value: i32) !void {
    var writer = protobuf.Writer(64);
    writer.writeInt32(1, value)!;
    connection.sendMessage(call, writer.written())
}

func receive(connection: *grpc.ClientConn, call: *grpc.Call, expected: i32) !void {
    var message = connection.recvMessage(call)! ?? { return StreamTestError.BadValue; };
    var reader = protobuf.Reader.open(message.asConstSlice(), protobuf.DecodeLimits())!;
    var field = reader.next()!.unwrap();
    require(field.asInt32()! == expected)
}

func finish(connection: *grpc.ClientConn, call: *grpc.Call) !void {
    if connection.recvMessage(call)! != null { return StreamTestError.BadValue; }
    var complete = call.complete()!;
    require(complete.status.isOk())!;
    var repeated = call.complete() catch (reason) {
        require(reason == grpc.RpcError.CallClosed)!;
        return;
    };
    StreamTestError.BadValue
}

func main() !void {
    var endpoint = env.get("VAQRIN_RPC_ADDRESS")!.unwrap();
    var certificate = env.get("VAQRIN_RPC_CERT")!.unwrap();
    var root: str = certificate;
    var dialOptions = grpc.DialOptions();
    dialOptions.trustedRoots = some(root);
    dialOptions.timeout = time.Duration.fromSeconds(4);
    var connection = grpc.dial(endpoint, dialOptions)!;
    var options = grpc.CallOptions();

    var broadcast = connection.start("/interop.Stream/Broadcast", raw options)!;
    send(raw connection, raw broadcast, 10)!;
    connection.finishSend(raw broadcast)!;
    receive(raw connection, raw broadcast, 10)!;
    receive(raw connection, raw broadcast, 11)!;
    receive(raw connection, raw broadcast, 12)!;
    finish(raw connection, raw broadcast)!;

    // Buffer events from the other live stream while receiving replies.
    var first = connection.start("/interop.Stream/Broadcast", raw options)!;
    send(raw connection, raw first, 20)!;
    connection.finishSend(raw first)!;
    var second = connection.start("/interop.Stream/Broadcast", raw options)!;
    send(raw connection, raw second, 40)!;
    connection.finishSend(raw second)!;
    receive(raw connection, raw second, 40)!;
    receive(raw connection, raw first, 20)!;
    receive(raw connection, raw second, 41)!;
    receive(raw connection, raw first, 21)!;
    receive(raw connection, raw second, 42)!;
    finish(raw connection, raw second)!;
    receive(raw connection, raw first, 22)!;
    finish(raw connection, raw first)!;

    var sum = connection.start("/interop.Stream/Sum", raw options)!;
    send(raw connection, raw sum, 2)!;
    send(raw connection, raw sum, 3)!;
    send(raw connection, raw sum, 4)!;
    connection.finishSend(raw sum)!;
    receive(raw connection, raw sum, 9)!;
    finish(raw connection, raw sum)!;

    var echo = connection.start("/interop.Stream/Echo", raw options)!;
    send(raw connection, raw echo, 15)!;
    receive(raw connection, raw echo, 30)!;
    send(raw connection, raw echo, 16)!;
    receive(raw connection, raw echo, 32)!;
    connection.finishSend(raw echo)!;
    finish(raw connection, raw echo)!;

    var cancelled = connection.start("/interop.Stream/Echo", raw options)!;
    send(raw connection, raw cancelled, 5)!;
    receive(raw connection, raw cancelled, 10)!;
    connection.cancel(raw cancelled)!;
    var rejected = connection.recvMessage(raw cancelled);
    require(result.errorOf(raw rejected).unwrap() == grpc.RpcError.Cancelled)!;
    connection.close()
}
