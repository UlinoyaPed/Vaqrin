import (io, bufio, coll)

func main() !void {
    var scan = bufio.newScanner(io.stdin())!;
    var n = scan.readInt<i64>()!;
    var c = scan.readInt<i64>()!;
    var freq = coll.i64Map<i64>();
    for _ in 0i64..n {
        var key = scan.readInt<i64>()!;
        count := freq.getOrInsert(key, 0)!;
        count++;
    }
    var answer: i64 = 0;
    var entries = freq.iterRef()!;
    for entry in move(entries) {
        var key = *entry.0 - c;
        switch freq.get(key) {
            some(value) => { answer += *entry.1 * value; },
            null => {},
        }
    }
    io.println(answer)!;
}
