package main
import (env, grpc, io, pb_example as generated)

func main() !void {
    var certificate = env.get("VAQRIN_GRPC_CERT")!.unwrap();
    var root: str = certificate;
    var dial = grpc.DialOptions();
    dial.trustedRoots = some(root);
    var connection = grpc.dial("https://localhost:50051", dial)!;
    var client = generated.GreeterClient(&connection);
    var request = generated.Msg_HelloRequest();
    request.f_name = "Vaqrin";
    var options = grpc.CallOptions();
    var response = client.rpc_SayHello(&request, &options)!;
    if response.status.isOk() {
        switch response.message {
            some(ref reply) => { io.println(reply.f_greeting)!; },
            null => {},
        };
    } else {
        io.println(response.status.message)!;
    }
    connection.close()
}
