package main
import (env, grpc, net, pb_example as generated, text, tls)

class Greeter {
    #implements: generated.GreeterService
    pub func rpc_SayHello(request: generated.Msg_HelloRequest,
                          context: *const grpc.UnaryRequest) !grpc.TypedResponse<generated.Msg_HelloReply> {
        var builder = text.StringBuilder();
        builder.append("Hello, ")!;
        builder.append(request.f_name)!;
        var reply = generated.Msg_HelloReply();
        reply.f_greeting = builder.build()!;
        grpc.typedResponse<generated.Msg_HelloReply>(move(reply))
    }
}

func main() !void {
    var certificate = env.get("VAQRIN_GRPC_CERT")!.unwrap();
    var key = env.get("VAQRIN_GRPC_KEY")!.unwrap();
    var config = tls.TlsConfig();
    config.requireProtocol = true;
    config.addProtocol("h2".asBytes())!;
    var acceptor = tls.TlsAcceptor.fromPem(certificate, key, move(config))!;
    var service = Greeter{};
    var adapter = generated.GreeterServer(&service);
    var server = grpc.Server();
    adapter.register(&server)!;
    var listener = net.listenTcp(net.parseSocketAddr("127.0.0.1:50051")!)!;
    server.acceptTls(&listener, &acceptor, grpc.ServeOptions())
}
