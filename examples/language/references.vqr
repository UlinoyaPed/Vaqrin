import (coll, io, meta)

class Point {
    pub var x: i32;
    pub func init(value: i32) : x(value) {}
    pub func step() void { x++; }
}

func read(x: in i32) i32 { x }
func readStrict(x: ref i32) i32 { x }
func increment(x: mut i32) void { x++; }
func identity(x: in i32) ref i32 { x }

func inspect<T>(x: in T) str { meta.typeName<T>() }

func main() !void {
    var n = 10;
    var p: *i32 = raw n;
    {
        ref mut x = n;
        increment(x);
        var ro: ref i32 = identity(x);
        io.println(readStrict(ro))!;
    }
    io.println(read(n) + read(2) + unsafe { read(*p) })!;
    io.println(inspect(p))!;
    io.println(unsafe { inspect<i32>(*p) })!;
    io.println(*identity(42))!;

    var point = new Point(4)!;
    (*point).x = 8;
    (*point).step();
    (*point).x++;
    io.println((*point).x)!;

    var box = new i32(21)!;
    io.println(read(*box))!;
    var callback: func(in i32) i32 = (x: in i32) i32 => x;
    io.println(unsafe { callback(*p) })!;

    {
        var optional: ?*i32 = some(p);
        switch optional {
            some(value) => { unsafe { increment(*value); } },
            null => {},
        }
    }
    io.println(n)!;

    var map = coll.i32Map<i32>();
    map.insert(1, 30)!;
    switch map.getMut(1) {
        some(value) => { value++; },
        null => {},
    }
    switch map.get(1) {
        some(value) => { io.println(value)!; },
        null => {},
    }
    map.remove(1);
}
