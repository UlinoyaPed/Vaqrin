package main
import (settings, grpc, io, net, pb_example as generated, text, tls)

class Greeter {
    #implements: generated.GreeterService
    pub func rpc_SayHello(request: move generated.Msg_HelloRequest,
        context: *const grpc.UnaryRequest) !grpc.TypedResponse<generated.Msg_HelloReply> {
        var builder = text.StringBuilder();
        builder.append("Hello, ")!;
        builder.append(request.f_name)!;
        var reply = generated.Msg_HelloReply();
        reply.f_greeting = builder.build()!;
        grpc.typedResponseOwned<generated.Msg_HelloReply>(move(reply))
    }
}

func main() !void {
    var certificate = settings.certificate()!;
    var key = settings.privateKey()!;
    var config = tls.TlsConfig();
    config.requireProtocol = true;
    config.addProtocol("h2".asBytes())!;
    var acceptor = tls.TlsAcceptor.fromPem(certificate, key, move(config))!;
    var service = Greeter();
    var adapter = generated.GreeterServer(raw service);
    var server = grpc.Server();
    adapter.register(raw server)!;
    var loopback = net.IpAddr.V4(net.Ipv4Addr.new(127, 0, 0, 1));
    var listener = net.listenTcp(net.SocketAddr.new(loopback, settings.port()!))!;
    io.println(listener.localAddr()!.port())!;
    server.acceptTls(raw listener, raw acceptor, grpc.ServeOptions())
}
