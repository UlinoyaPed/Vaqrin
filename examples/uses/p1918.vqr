package main
import (io, bufio, coll)

func main() !void {
  input := io.stdin();
  scanner := bufio.newScanner(&input)!;

  var n = scanner.readInt<i32>()!;
  map := coll.i32Map<i32>();

  for i in 0..n {
    num := scanner.readInt<i32>()!;
    map.insert(num, i)!;
  }

  q := scanner.readInt<i32>()!;
  for i in 0..q {
    num := scanner.readInt<i32>()!;
    switch map.get(num){
      null => {
        io.println(0)!;
      },
      some(v) => {
        io.println(v + 1)!;
      }
    }
  }
}
