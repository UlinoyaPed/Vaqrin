package algo
import (cmp)

pub func allOf<T, F: Movable>(values: []const T, predicate: F) bool {
    for i in usize(0)..values.len() {
        if !predicate(raw values[i]) { return false; }
    }
    true
}

pub func anyOf<T, F: Movable>(values: []const T, predicate: F) bool {
    for i in usize(0)..values.len() {
        if predicate(raw values[i]) { return true; }
    }
    false
}

pub func noneOf<T, F: Movable>(values: []const T, predicate: F) bool {
    !anyOf<T, F>(values, move(predicate))
}

pub func count<T>(values: []const T, needle: *const T) usize {
    var found: usize = 0;
    for i in usize(0)..values.len() {
        if cmp.eq<T>(raw values[i], needle) { found++; }
    }
    found
}

pub func countIf<T, F: Movable>(values: []const T, predicate: F) usize {
    var found: usize = 0;
    for i in usize(0)..values.len() {
        if predicate(raw values[i]) { found++; }
    }
    found
}

pub func find<T>(values: []const T, needle: *const T) ?usize {
    for i in usize(0)..values.len() {
        if cmp.eq<T>(raw values[i], needle) { return some(i); }
    }
    null
}

pub func findLast<T>(values: []const T, needle: *const T) ?usize {
    var i = values.len();
    while i > 0 {
        i--;
        if cmp.eq<T>(raw values[i], needle) { return some(i); }
    }
    null
}

pub func findIf<T, F: Movable>(values: []const T, predicate: F) ?usize {
    for i in usize(0)..values.len() {
        if predicate(raw values[i]) { return some(i); }
    }
    null
}

pub func findIfNot<T, F: Movable>(values: []const T, predicate: F) ?usize {
    for i in usize(0)..values.len() {
        if !predicate(raw values[i]) { return some(i); }
    }
    null
}

pub func adjacentFind<T, F: Movable>(values: []const T, equals: F) ?usize {
    for i in usize(1)..values.len() {
        if equals(raw values[i - 1], raw values[i]) { return some(i - 1); }
    }
    null
}

func lowerIndex<T, K, F>(values: []const T, key: *const K, less: *F) usize {
    var first: usize = 0;
    var end = values.len();
    while first < end {
        var mid = first + (end - first) / 2;
        if (*less)(raw values[mid], key) { first = mid + 1; } else { end = mid; }
    }
    first
}

func upperIndex<T, K, F>(values: []const T, key: *const K, less: *F) usize {
    var first: usize = 0;
    var end = values.len();
    while first < end {
        var mid = first + (end - first) / 2;
        if (*less)(key, raw values[mid]) { end = mid; } else { first = mid + 1; }
    }
    first
}

pub func lowerBound<T, K, F: Movable>(values: []const T, key: *const K, less: F) usize {
    lowerIndex<T, K, F>(values, key, raw less)
}

pub func upperBound<T, K, F: Movable>(values: []const T, key: *const K, less: F) usize {
    upperIndex<T, K, F>(values, key, raw less)
}

pub func equalRange<T, K, F: Movable>(values: []const T, key: *const K, less: F) (usize, usize) {
    (lowerIndex<T, K, F>(values, key, raw less), upperIndex<T, K, F>(values, key, raw less))
}

pub func binarySearch<T, K, F: Movable>(values: []const T, key: *const K, less: F) ?usize {
    var index = lowerIndex<T, K, F>(values, key, raw less);
    if index != values.len() && !less(key, raw values[index]) { return some(index); }
    null
}
