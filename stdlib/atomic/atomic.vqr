package atomic

pub enum Order { Relaxed, Acquire, Release, AcqRel, SeqCst }

pub class CompareExchange<T> {
    pub var old: T;
    pub var exchanged: bool;
}

pub class Atomic<T> {
    #copy: disabled
    var cell: T;
    pub func init(value: T) : cell(value) {
        __vqr_atomic_store(&cell, value, Order.Relaxed);
    }
    pub static func new(value: T) Self { Atomic<T>(value) }

    pub const func load(order: Order) T { __vqr_atomic_load(&cell, order) }
    pub const func load() T { load(Order.SeqCst) }
    pub func store(value: T, order: Order) void { __vqr_atomic_store(&cell, value, order) }
    pub func store(value: T) void { store(value, Order.SeqCst); }
    pub func swap(value: T, order: Order) T { __vqr_atomic_swap(&cell, value, order) }
    pub func swap(value: T) T { swap(value, Order.SeqCst) }

    pub func compareExchange(expected: T, desired: T, success: Order, failure: Order) CompareExchange<T> {
        old, exchanged := __vqr_atomic_compare(&cell, expected, desired, success, failure);
        CompareExchange<T>{old: old, exchanged: exchanged}
    }
    pub func compareExchange(expected: T, desired: T) CompareExchange<T> {
        compareExchange(expected, desired, Order.SeqCst, Order.SeqCst)
    }

    pub func compareExchangeWeak(expected: T, desired: T, success: Order, failure: Order) CompareExchange<T> {
        old, exchanged := __vqr_atomic_compare_weak(&cell, expected, desired, success, failure);
        CompareExchange<T>{old: old, exchanged: exchanged}
    }
    pub func compareExchangeWeak(expected: T, desired: T) CompareExchange<T> {
        compareExchangeWeak(expected, desired, Order.SeqCst, Order.SeqCst)
    }

    pub func fetchAdd(value: T, order: Order) T { __vqr_atomic_add(&cell, value, order) }
    pub func fetchAdd(value: T) T { fetchAdd(value, Order.SeqCst) }
    pub func fetchSub(value: T, order: Order) T { __vqr_atomic_sub(&cell, value, order) }
    pub func fetchSub(value: T) T { fetchSub(value, Order.SeqCst) }
    pub func fetchAnd(value: T, order: Order) T { __vqr_atomic_and(&cell, value, order) }
    pub func fetchAnd(value: T) T { fetchAnd(value, Order.SeqCst) }
    pub func fetchOr(value: T, order: Order) T { __vqr_atomic_or(&cell, value, order) }
    pub func fetchOr(value: T) T { fetchOr(value, Order.SeqCst) }
    pub func fetchXor(value: T, order: Order) T { __vqr_atomic_xor(&cell, value, order) }
    pub func fetchXor(value: T) T { fetchXor(value, Order.SeqCst) }
    pub func fetchMax(value: T, order: Order) T { __vqr_atomic_max(&cell, value, order) }
    pub func fetchMax(value: T) T { fetchMax(value, Order.SeqCst) }
    pub func fetchMin(value: T, order: Order) T { __vqr_atomic_min(&cell, value, order) }
    pub func fetchMin(value: T) T { fetchMin(value, Order.SeqCst) }

    pub static func intoInner(value: Self) T { value.cell }
}

pub class AtomicFlag {
    #copy: disabled
    var cell: Atomic<bool>;
    pub func init(value: bool) : cell(Atomic<bool>(value)) {}
    pub const func test(order: Order) bool { cell.load(order) }
    pub const func test() bool { test(Order.SeqCst) }
    pub func testAndSet(order: Order) bool { cell.swap(true, order) }
    pub func testAndSet() bool { testAndSet(Order.SeqCst) }
    pub func clear(order: Order) void { cell.store(false, order); }
    pub func clear() void { clear(Order.SeqCst); }
}

pub func fence(order: Order) void { __vqr_atomic_fence(order) }
pub func compilerFence(order: Order) void { __vqr_atomic_compiler_fence(order) }
pub comptime func isLockFree<T>() bool { __vqr_atomic_supported<T>() }
pub comptime func isAlwaysLockFree<T>() bool { __vqr_atomic_supported<T>() }

const widths: [4]usize = [4]usize{8, 16, 32, 64};
pub func supportedWidths() []const usize {
    var count: usize = if isLockFree<u64>() { 4 } else { if (isLockFree<u32>()) 3 else 0 };
    widths[0..count]
}

pub func atomicLoad<T>(ptr: *const Atomic<T>, order: Order) T { ptr.load(order) }
pub func atomicStore<T>(ptr: *Atomic<T>, value: T, order: Order) void { ptr.store(value, order); }
