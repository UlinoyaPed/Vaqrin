package bufio
import (io, coll, text, mem, parse)

pub error BufferError { InvalidCapacity, BufferFull, UnreadUnavailable, TokenTooLong }

pub class BufferedReader {
    #copy: disabled
    #implements: io.Reader
    var source: *io.Reader;
    var data: coll.Vec<u8>;
    var position: usize;
    var filled: usize;
    var capacity: usize;
    var eof: bool;
    var lastByte: ?u8;
public:
    func init(reader: *io.Reader, size: usize) !void
        : source(reader), data(coll.Vec<u8>()), position(0), filled(0), capacity(size), eof(false), lastByte(null) {
        if size == 0 { return BufferError.InvalidCapacity; }
        data.reserve(size)!;
        for index in usize(0)..size { data.push(0)!; }
    }
    func fill() !void {
        if eof { return; }
        var buffer = data.asSlice();
        if position != 0 {
            var unread = filled - position;
            if unread != 0 { unsafe { __vqr_move_bytes(&buffer[0], &buffer[position], unread); } }
            filled = unread;
            position = 0;
        }
        if filled == capacity { return; }
        var count = io.read(source, buffer[filled..capacity])!;
        if count == 0 { eof = true; return; }
        filled += count;
    }
    func read(dst: []u8) !usize {
        if dst.len() == 0 { return 0; }
        if position == filled { fill()!; }
        var available = filled - position;
        var count = if available < dst.len() { available } else { dst.len() };
        if count == 0 { lastByte = null; return 0; }
        var bytes = data.asConstSlice();
        unsafe { __vqr_move_bytes(&dst[0], &bytes[position], count); }
        position += count;
        lastByte = some(dst[count - 1]);
        count
    }
    func readByte() !?u8 {
        var one = mem.zeroedBytes<1>();
        var count = read(one[:])!;
        if count == 0 { return null; }
        some(one[0])
    }
    func unreadByte(value: u8) !void {
        if position == 0 { return BufferError.UnreadUnavailable; }
        switch lastByte {
            null => return BufferError.UnreadUnavailable,
            some(previous) => { if previous != value { return BufferError.UnreadUnavailable; } },
        }
        position--;
        lastByte = null;
    }
    func peek(count: usize) ![]const u8 {
        if count > capacity { return BufferError.BufferFull; }
        for filled - position < count && !eof {
            var before = filled - position;
            fill()!;
            if filled - position == before { break; }
        }
        if count > filled - position { return BufferError.BufferFull; }
        data.asConstSlice()[position..position + count]
    }
    func discard(count: usize) !usize {
        var skipped: usize = 0;
        for skipped < count {
            if position == filled { fill()!; }
            var available = filled - position;
            if available == 0 { break; }
            var remaining = count - skipped;
            var chunk = if remaining < available { remaining } else { available };
            position += chunk;
            skipped += chunk;
        }
        lastByte = null;
        skipped
    }
    func readUntil(delimiter: u8, maxBytes: usize) !?coll.Vec<u8> {
        var output = coll.Vec<u8>();
        for {
            if position == filled { fill()!; }
            if position == filled {
                if output.len() == 0 { return null; }
                return some(move(output));
            }
            var buffer = data.asConstSlice();
            var end = position;
            var limit = maxBytes - output.len();
            for end < filled && buffer[end] != delimiter {
                if end - position >= limit {
                    position = end + 1;
                    lastByte = some(buffer[end]);
                    return BufferError.TokenTooLong;
                }
                end++;
            }
            for byte in buffer[position..end] { output.push(byte)!; }
            if end < filled {
                position = end + 1;
                lastByte = some(delimiter);
                return some(move(output));
            }
            position = end;
            lastByte = some(buffer[end - 1]);
        }
    }
    func readString(delimiter: u8, maxBytes: usize) !?string {
        var bytes = readUntil(delimiter, maxBytes)!;
        switch move(bytes) {
            null => null,
            some(value) => some(text.fromBytes(value.asConstSlice())!),
        }
    }
    func readLine(maxBytes: usize) !?string {
        var line = readUntil(10, maxBytes)!;
        switch move(line) {
            null => null,
            some(value) => {
                if value.len() != 0 && value[value.len() - 1] == 13 {
                    value.truncate(value.len() - 1);
                }
                some(text.fromBytes(value.asConstSlice())!)
            },
        }
    }
    const func bufferLen() usize { filled - position }
    func reset(reader: *io.Reader) void {
        source = reader;
        position = 0;
        filled = 0;
        eof = false;
        lastByte = null;
    }
}

pub class BufferedWriter {
    #copy: disabled
    #implements: io.Writer
    var target: *io.Writer;
    var data: coll.Vec<u8>;
    var capacity: usize;
    var finished: bool;
public:
    func init(writer: *io.Writer, size: usize) !void
        : target(writer), data(coll.Vec<u8>()), capacity(size), finished(false) {
        if size == 0 { return BufferError.InvalidCapacity; }
        data.reserve(size)!
    }
    func retainPending(committed: usize) void {
        var pending = data.len() - committed;
        var bytes = data.asSlice();
        if pending != 0 {
            unsafe { __vqr_move_bytes(&bytes[0], &bytes[committed], pending); }
        }
        data.truncate(pending);
    }
    func write(src: []const u8) !usize {
        if finished { return io.IoError.Closed; }
        var total: usize = 0;
        for total < src.len() {
            if data.len() == capacity {
                flush() catch (reason) {
                    if total != 0 { return total; }
                    return reason;
                };
            }
            var room = capacity - data.len();
            var remaining = src.len() - total;
            var count = if room < remaining { room } else { remaining };
            for index in usize(0)..count { data.push(src[total + index])!; }
            total += count;
        }
        total
    }
    func writeByte(byte: u8) !void {
        var one = mem.zeroedBytes<1>();
        one[0] = byte;
        var count = write(one[:])!;
        if count != 1 { return io.IoError.NoProgress; }
    }
    func writeString(value: str) !void {
        var offset: usize = 0;
        var bytes = value.asBytes();
        for offset < bytes.len() {
            var count = write(bytes[offset..bytes.len()])!;
            if count == 0 { return io.IoError.NoProgress; }
            offset += count;
        }
    }
    const func buffered() usize { data.len() }
    const func available() usize { capacity - data.len() }
    func flush() !void {
        if finished { return; }
        var progress = io.writeAllProgress(target, data.asConstSlice())!;
        retainPending(progress.processed);
        if progress.reason != null { return progress.reason.unwrap(); }
        target.flush()
    }
    func finish() !void {
        if finished { return; }
        flush()!;
        finished = true;
    }
    func reset(writer: *io.Writer) !void {
        flush()!;
        target = writer;
        finished = false;
    }
    func deinit() void { finish() catch {}; }
}

pub class Token {
    var contents: string;
    var first: u64;
    var last: u64;
public:
    func init(value: string, start: u64, end: u64)
        : contents(move(value)), first(start), last(end) {}
    const func text() str { unsafe { __vqr_text_borrow_utf8(contents.asBytes()) } }
    const func start() u64 { first }
    const func end() u64 { last }
}

pub enum SplitMode { AsciiWhitespace, Delimiter(u8) }

pub class ByteToken {
    #copy: disabled
    var data: coll.Vec<u8>;
    pub var start: u64;
    pub var end: u64;
public:
    func init(data: coll.Vec<u8>, start: u64, end: u64) : data(move(data)), start(start), end(end) {}
    const func bytes() []const u8 { data.asConstSlice() }
}

pub class Scanner {
    #copy: disabled
    var reader: BufferedReader;
    var maximum: usize;
    var consumed: u64;
    var mode: SplitMode;
public:
    func init(source: *io.Reader) !void
        : reader(BufferedReader(source, 4096)!), maximum(1048576), consumed(0), mode(SplitMode.AsciiWhitespace) {}
    func setMaxToken(value: usize) void { maximum = value; }
    func setSplitMode(value: SplitMode) void { mode = value; }
    const func position() u64 { consumed }
    func nextBytes() !?ByteToken {
        var output = coll.Vec<u8>();
        var started = false;
        var start = consumed;
        for {
            var next = reader.readByte()!;
            switch next {
                null => {
                    if !started { return null; }
                    return some(ByteToken(move(output), start, consumed));
                },
                some(byte) => {
                    consumed++;
                    var delimiter = switch mode {
                        SplitMode.AsciiWhitespace => byte == 32 || (9 <= byte && byte <= 13),
                        SplitMode.Delimiter(separator) => byte == separator,
                    };
                    if delimiter {
                        if !started { start = consumed; continue; }
                        return some(ByteToken(move(output), start, consumed - 1));
                    }
                    if !started { started = true; start = consumed - 1; }
                    if output.len() >= maximum { return BufferError.TokenTooLong; }
                    output.push(byte)!;
                },
            }
        }
    }
    func next() !?Token {
        var item = nextBytes()! ?? { return null; };
        var textValue = text.fromBytes(item.bytes())!;
        some(Token(move(textValue), item.start, item.end))
    }
    func nextString() !?string {
        var item = next()!;
        switch item {
            null => null,
            some(value) => some(text.fromBytes(value.text().asBytes())!),
        }
    }
    func nextInt<T>() !?T {
        var item = next()!;
        switch move(item) {
            null => null,
            some(token) => some(parse.parseInt<T>(token.text())!),
        }
    }
    func readInt<T>() !T {
        nextInt<T>()! ?? { return io.IoError.UnexpectedEof; }
    }
    func nextFloat<T>() !?T {
        var item = next()!;
        switch move(item) {
            null => null,
            some(token) => some(parse.parseFloat<T>(token.text())!),
        }
    }
    func readFloat<T>() !T {
        nextFloat<T>()! ?? { return io.IoError.UnexpectedEof; }
    }
    func reset(source: *io.Reader) void {
        reader.reset(source);
        consumed = 0;
    }
}

pub func newReader(reader: *io.Reader, capacity: usize) !BufferedReader {
    BufferedReader(reader, capacity)
}
pub func newWriter(writer: *io.Writer, capacity: usize) !BufferedWriter {
    BufferedWriter(writer, capacity)
}
pub func newScanner(reader: *io.Reader) !Scanner { Scanner(reader) }
pub func readLine(reader: *BufferedReader, maxBytes: usize) !?string {
    reader.readLine(maxBytes)
}

pub func readLine(reader: *io.Reader, maxBytes: usize) !?string {
    // A borrowed unbuffered source cannot safely be read past its delimiter.
    var result = coll.Vec<u8>();
    var byte = [1]u8{0};
    for {
        if io.read(reader, byte[:])! == 0 {
            if result.len() == 0 { return null; }
            break;
        }
        if byte[0] == 10 { break; }
        if result.len() >= maxBytes { return BufferError.TokenTooLong; }
        result.push(byte[0])!;
    }
    if result.len() != 0 && result[result.len() - 1] == 13 { result.truncate(result.len() - 1); }
    some(text.fromBytes(result.asConstSlice())!)
}
