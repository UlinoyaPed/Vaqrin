package bufio
import (io, coll, core, text, mem, parse)

pub error BufferError { InvalidCapacity, BufferFull, UnreadUnavailable, TokenTooLong, PendingRead }

pub class BufferedReader {
    #copy: disabled
    #implements: io.Reader
    var source: ?*io.Reader;
    comptime if __vqr_host_supports_io() {
        var ownedSource: ?io.HostFile = null;
    }
    var data: coll.Vec<u8>;
    var position: usize;
    var filled: usize;
    var capacity: usize;
    var eof: bool;
    var lastByte: ?u8;
    var pending: coll.Vec<u8>;
    var pendingDelimiter: u8;
    func init(size: usize) !void
        : source(null), data(coll.Vec<u8>()), position(0), filled(0), capacity(size), eof(false), lastByte(null),
          pending(coll.Vec<u8>()), pendingDelimiter(0) {
        if size == 0 { return BufferError.InvalidCapacity; }
        data.reserve(size)!;
        for index in usize(0)..size { data.push(0)!; }
    }
    comptime if __vqr_host_supports_io() {
        func readSource(dst: []u8) !usize {
            switch ownedSource {
                some(ref mut reader) => { return io.read(&reader, dst); },
                null => {},
            }
            io.read(source.unwrap(), dst)
        }
        func releaseOwnedSource() void { ownedSource = null; }
    } else {
        func readSource(dst: []u8) !usize { io.read(source.unwrap(), dst) }
        func releaseOwnedSource() void {}
    }
    pub func init(reader: *io.Reader, size: usize) !void : self(size) { source = some(reader); }
    comptime if __vqr_host_supports_io() {
        pub func init(reader: io.HostFile, size: usize) !void : self(size) {
            ownedSource = some(move(reader));
        }
    }
    pub func fill() !void {
        if eof { return; }
        var buffer = data.asSlice();
        if position != 0 {
            var unread = filled - position;
            if unread != 0 { unsafe { __vqr_move_bytes(&buffer[0], &buffer[position], unread); } }
            filled = unread;
            position = 0;
        }
        if filled == capacity { return; }
        var count = readSource(buffer[filled..capacity])!;
        if count == 0 { eof = true; return; }
        filled += count;
    }
    pub func read(dst: []u8) !usize {
        if !pending.isEmpty() { return BufferError.PendingRead; }
        if dst.len() == 0 { return 0; }
        if position == filled { fill()!; }
        var available = filled - position;
        var count = if available < dst.len() { available } else { dst.len() };
        if count == 0 { lastByte = null; return 0; }
        var bytes = data.asConstSlice();
        unsafe { __vqr_move_bytes(&dst[0], &bytes[position], count); }
        position += count;
        lastByte = some(dst[count - 1]);
        count
    }
    pub func readByte() !?u8 {
        var one = mem.zeroedBytes<1>();
        var count = read(one[:])!;
        if count == 0 { return null; }
        some(one[0])
    }
    pub func unreadByte(value: u8) !void {
        if !pending.isEmpty() { return BufferError.PendingRead; }
        if position == 0 { return BufferError.UnreadUnavailable; }
        switch lastByte {
            null => return BufferError.UnreadUnavailable,
            some(previous) => { if previous != value { return BufferError.UnreadUnavailable; } },
        }
        position--;
        lastByte = null;
    }
    pub func peek(count: usize) ![]const u8 {
        if !pending.isEmpty() { return BufferError.PendingRead; }
        if count > capacity { return BufferError.BufferFull; }
        for filled - position < count && !eof {
            var before = filled - position;
            fill()!;
            if filled - position == before { break; }
        }
        if count > filled - position { return BufferError.BufferFull; }
        data.asConstSlice()[position..position + count]
    }
    pub func discard(count: usize) !usize {
        if !pending.isEmpty() { return BufferError.PendingRead; }
        var skipped: usize = 0;
        for skipped < count {
            if position == filled { fill()!; }
            var available = filled - position;
            if available == 0 { break; }
            var remaining = count - skipped;
            var chunk = if remaining < available { remaining } else { available };
            position += chunk;
            skipped += chunk;
        }
        lastByte = null;
        skipped
    }
    pub func readUntil(delimiter: u8, maxBytes: usize) !?coll.Vec<u8> {
        if !pending.isEmpty() && pendingDelimiter != delimiter { return BufferError.PendingRead; }
        pendingDelimiter = delimiter;
        if pending.len() > maxBytes { return BufferError.PendingRead; }
        for {
            if position == filled { fill()!; }
            if position == filled {
                if pending.isEmpty() { return null; }
                return some(core.replace<coll.Vec<u8>>(&pending, coll.Vec<u8>()));
            }
            var buffer = data.asConstSlice();
            for position < filled {
                var byte = buffer[position];
                if byte == delimiter {
                    position++;
                    lastByte = some(byte);
                    return some(core.replace<coll.Vec<u8>>(&pending, coll.Vec<u8>()));
                }
                if pending.len() == maxBytes {
                    pending.clear();
                    position++;
                    lastByte = some(byte);
                    return BufferError.TokenTooLong;
                }
                pending.push(byte)!;
                position++;
                lastByte = some(byte);
            }
        }
    }
    pub func readString(delimiter: u8, maxBytes: usize) !?string {
        var bytes = readUntil(delimiter, maxBytes)!;
        switch move(bytes) {
            null => null,
            some(value) => some(text.fromBytes(value.asConstSlice())!),
        }
    }
    pub func readLine(maxBytes: usize) !?string {
        var line = readUntil(10, maxBytes)!;
        switch move(line) {
            null => null,
            some(value) => {
                if value.len() != 0 && value[value.len() - 1] == 13 {
                    value.truncate(value.len() - 1);
                }
                some(text.fromBytes(value.asConstSlice())!)
            },
        }
    }
    pub const func bufferLen() usize { filled - position }
    pub func reset(reader: *io.Reader) void {
        releaseOwnedSource();
        source = some(reader);
        position = 0;
        filled = 0;
        eof = false;
        lastByte = null;
        pending.clear();
    }
}

pub class BufferedWriter {
    #copy: disabled
    #implements: io.Writer
    var target: *io.Writer;
    var data: coll.Vec<u8>;
    var capacity: usize;
    var finished: bool;
    pub func init(writer: *io.Writer, size: usize) !void
        : target(writer), data(coll.Vec<u8>()), capacity(size), finished(false) {
        if size == 0 { return BufferError.InvalidCapacity; }
        data.reserve(size)!
    }
    pub func retainPending(committed: usize) void {
        var pending = data.len() - committed;
        var bytes = data.asSlice();
        if pending != 0 {
            unsafe { __vqr_move_bytes(&bytes[0], &bytes[committed], pending); }
        }
        data.truncate(pending);
    }
    pub func write(src: []const u8) !usize {
        if finished { return io.IoError.Closed; }
        var total: usize = 0;
        for total < src.len() {
            if data.len() == capacity {
                flush() catch (reason) {
                    if total != 0 { return total; }
                    return reason;
                };
            }
            var room = capacity - data.len();
            var remaining = src.len() - total;
            var count = if room < remaining { room } else { remaining };
            for index in usize(0)..count { data.push(src[total + index])!; }
            total += count;
        }
        total
    }
    pub func writeByte(byte: u8) !void {
        var one = mem.zeroedBytes<1>();
        one[0] = byte;
        var count = write(one[:])!;
        if count != 1 { return io.IoError.NoProgress; }
    }
    pub func writeString(value: str) !void {
        var offset: usize = 0;
        var bytes = value.asBytes();
        for offset < bytes.len() {
            var count = write(bytes[offset..bytes.len()])!;
            if count == 0 { return io.IoError.NoProgress; }
            offset += count;
        }
    }
    pub const func buffered() usize { data.len() }
    pub const func available() usize { capacity - data.len() }
    pub func flush() !void {
        if finished { return; }
        var progress = io.writeAllProgress(target, data.asConstSlice())!;
        retainPending(progress.processed);
        if progress.reason != null { return progress.reason.unwrap(); }
        target.flush()
    }
    pub func finish() !void {
        if finished { return; }
        flush()!;
        finished = true;
    }
    pub func reset(writer: *io.Writer) !void {
        flush()!;
        target = writer;
        finished = false;
    }
    pub func deinit() void { finish() catch {}; }
}

pub class Token {
    var contents: string;
    var first: u64;
    var last: u64;
    pub func init(value: string, start: u64, end: u64)
        : contents(move(value)), first(start), last(end) {}
    pub const func text() str { unsafe { __vqr_text_borrow_utf8(contents.asBytes()) } }
    pub const func start() u64 { first }
    pub const func end() u64 { last }
}

pub enum SplitMode { AsciiWhitespace, Delimiter(u8) }

pub class ByteToken {
    #copy: disabled
    var data: coll.Vec<u8>;
    pub var start: u64;
    pub var end: u64;
    pub func init(data: coll.Vec<u8>, start: u64, end: u64) : data(move(data)), start(start), end(end) {}
    pub const func bytes() []const u8 { data.asConstSlice() }
}

pub class Scanner {
    #copy: disabled
    var reader: BufferedReader;
    var maximum: usize;
    var consumed: u64;
    var mode: SplitMode;
    var pending: coll.Vec<u8>;
    var tokenStart: u64;
    func init(buffered: BufferedReader, maxToken: usize)
        : reader(move(buffered)), maximum(maxToken), consumed(0), mode(SplitMode.AsciiWhitespace),
          pending(coll.Vec<u8>()), tokenStart(0) {}
    pub func init(source: *io.Reader) !void : self(BufferedReader(source, 4096)!, 1048576) {}
    comptime if __vqr_host_supports_io() {
        pub func init(source: io.HostFile) !void : self(BufferedReader(move(source), 4096)!, 1048576) {}
    }
    pub func setMaxToken(value: usize) void { maximum = value; }
    pub func setSplitMode(value: SplitMode) void { mode = value; }
    pub const func position() u64 { consumed }
    pub func nextBytes() !?ByteToken {
        for {
            var next = reader.readByte()!;
            switch next {
                null => {
                    if pending.isEmpty() { return null; }
                    return some(finishToken(consumed));
                },
                some(byte) => {
                    consumed++;
                    var delimiter = switch mode {
                        SplitMode.AsciiWhitespace => byte == 32 || (9 <= byte && byte <= 13),
                        SplitMode.Delimiter(separator) => byte == separator,
                    };
                    if delimiter {
                        if pending.isEmpty() { continue; }
                        return some(finishToken(consumed - 1));
                    }
                    if pending.isEmpty() { tokenStart = consumed - 1; }
                    if pending.len() >= maximum {
                        pending.clear();
                        return BufferError.TokenTooLong;
                    }
                    pending.push(byte) catch (reason) {
                        reader.unreadByte(byte)!;
                        consumed--;
                        return reason;
                    };
                },
            }
        }
    }
    func finishToken(end: u64) ByteToken {
        var bytes = core.replace<coll.Vec<u8>>(&pending, coll.Vec<u8>());
        ByteToken(move(bytes), tokenStart, end)
    }
    pub func next() !?Token {
        var item = nextBytes()! ?? { return null; };
        var textValue = text.fromBytes(item.bytes())!;
        some(Token(move(textValue), item.start, item.end))
    }
    pub func nextString() !?string {
        var item = next()!;
        switch item {
            null => null,
            some(value) => some(text.fromBytes(value.text().asBytes())!),
        }
    }
    pub func nextInt<T>() !?T {
        var item = next()!;
        switch move(item) {
            null => null,
            some(token) => some(parse.parseInt<T>(token.text())!),
        }
    }
    pub func readInt<T>() !T {
        nextInt<T>()! ?? { return io.IoError.UnexpectedEof; }
    }
    pub func nextFloat<T>() !?T {
        var item = next()!;
        switch move(item) {
            null => null,
            some(token) => some(parse.parseFloat<T>(token.text())!),
        }
    }
    pub func readFloat<T>() !T {
        nextFloat<T>()! ?? { return io.IoError.UnexpectedEof; }
    }
    pub func reset(source: *io.Reader) void {
        reader.reset(source);
        consumed = 0;
        pending.clear();
        tokenStart = 0;
    }
}

pub func newReader(reader: *io.Reader, capacity: usize) !BufferedReader {
    BufferedReader(reader, capacity)
}
pub func newWriter(writer: *io.Writer, capacity: usize) !BufferedWriter {
    BufferedWriter(writer, capacity)
}
pub func newScanner(reader: *io.Reader) !Scanner { Scanner(reader) }
pub func newScanner(reader: io.HostFile) !Scanner { Scanner(move(reader)) }
pub func readLine(reader: *BufferedReader, maxBytes: usize) !?string {
    reader.readLine(maxBytes)
}

pub func readLine(reader: *io.Reader, maxBytes: usize) !?string {
    // A borrowed unbuffered source cannot safely be read past its delimiter.
    var result = coll.Vec<u8>();
    var byte = [1]u8{0};
    for {
        if io.read(reader, byte[:])! == 0 {
            if result.len() == 0 { return null; }
            break;
        }
        if byte[0] == 10 { break; }
        if result.len() >= maxBytes { return BufferError.TokenTooLong; }
        result.push(byte[0])!;
    }
    if result.len() != 0 && result[result.len() - 1] == 13 { result.truncate(result.len() - 1); }
    some(text.fromBytes(result.asConstSlice())!)
}
