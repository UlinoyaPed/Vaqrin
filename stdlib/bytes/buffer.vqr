package bytes
import (core, coll, mem)

pub class Buffer {
    var contents: coll.Vec<u8>;
    var cursor: usize;
    pub func init() : contents(coll.Vec<u8>()), cursor(0) {}

    pub static func withCapacity(n: usize) !Self {
        var result = Buffer();
        result.reserve(n)!;
        move(result)
    }

    pub const func len() usize { contents.len() }
    pub const func capacity() usize { contents.capacity() }
    pub const func isEmpty() bool { contents.isEmpty() }
    pub const func asSlice() []const u8 { contents.asConstSlice() }
    pub func asMutSlice() []u8 { contents.asSlice() }
    pub const func unread() []const u8 { contents.asConstSlice()[cursor..contents.len()] }
    pub func reserve(n: usize) !void { contents.reserve(n) }

    pub func write(data: []const u8) !usize {
        var count = data.len();
        if count == 0 { return 0; }
        var original = contents.len();
        var offset: ?usize = null;
        if original != 0 {
            var current = contents.asConstSlice();
            var base = __vqr_pointer_address(raw current[0]);
            var address = __vqr_pointer_address(raw data[0]);
            if address >= base && address - base < original { offset = address - base; }
        }
        contents.reserveAdditional(count)!;
        switch offset {
            null => {},
            some(index) => { data = contents.asConstSlice()[index..index + count]; },
        }
        for byte in data { contents.push(byte)!; }
        count
    }

    pub func writeByte(value: u8) !void { contents.push(value) }

    pub func read(dst: []u8) !usize {
        var data = peek(dst.len());
        mem.copyBytes(data, dst)!;
        cursor += data.len();
        data.len()
    }

    pub func readByte() ?u8 {
        if cursor == len() { return null; }
        var byte = contents[cursor];
        cursor++;
        some(byte)
    }

    pub const func peek(n: usize) []const u8 {
        var rest = unread();
        rest[0..shorter(n, rest.len())]
    }

    pub func advance(n: usize) !void {
        if n > len() - cursor { return BytesError.OutOfRange; }
        cursor += n;
    }

    pub func discard(n: usize) usize {
        var count = shorter(n, len() - cursor);
        cursor += count;
        count
    }

    pub func compact() void {
        var count = len() - cursor;
        if cursor == 0 { return; }
        var view = contents.asSlice();
        mem.moveBytes(view[cursor..view.len()], view[0..count]) catch { panic("byte buffer invariant"); };
        contents.truncate(count);
        cursor = 0;
    }

    pub func clear() void { contents.clear(); cursor = 0; }

    pub static func intoVec(value: Self) coll.Vec<u8> {
        core.Exchange<coll.Vec<u8>>.replace(value.contents, coll.Vec<u8>())
    }
}

func shorter(a: usize, b: usize) usize { if a < b { a } else { b } }

pub class ByteReader {
    var source: []const u8;
    var position: usize;
    pub func init(data: []const u8) : source(data), position(0) {}

    pub func read(dst: []u8) usize {
        var bytes = peek(dst.len());
        mem.copyBytes(bytes, dst) catch { panic("byte reader invariant"); };
        position += bytes.len();
        bytes.len()
    }

    pub func readByte() ?u8 {
        if remaining() == 0 { return null; }
        var byte = source[position];
        position++;
        some(byte)
    }

    pub const func peek(n: usize) []const u8 { source[position..position + shorter(n, remaining())] }

    pub func skip(n: usize) !void {
        if n > remaining() { return BytesError.OutOfRange; }
        position += n;
    }

    pub const func offset() usize { position }
    pub const func remaining() usize { source.len() - position }
}

pub class ByteWriter {
    var target: []u8;
    var position: usize;
    pub func init(data: []u8) : target(data), position(0) {}

    pub func write(src: []const u8) usize {
        var count = shorter(src.len(), remaining());
        mem.copyBytes(src[0..count], target[position..position + count]) catch {
            panic("byte writer invariant");
        };
        position += count;
        count
    }

    pub func writeByte(byte: u8) bool {
        if remaining() == 0 { return false; }
        target[position] = byte;
        position++;
        true
    }

    pub const func written() []const u8 { target[0..position] }
    pub const func remaining() usize { target.len() - position }
    pub func reset() void { position = 0; }
}
