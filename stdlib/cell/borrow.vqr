package cell
import (opt)

pub error CellError { Borrowed, RecursiveInitialization }

pub class BorrowRef<T> {
    #copy: disabled
    var pointer: *const T;
    var counter: *isize;
    pub unsafe func init(pointer: *const T, counter: *isize) : pointer(pointer), counter(counter) {}

    pub const func get() *const T { pointer }

    pub const func map<U, F: Movable>(project: F) BorrowRef<U> {
        var target = project(pointer);
        (*counter)++;
        unsafe { BorrowRef<U>(target, counter) }
    }

    pub func deinit() void { *counter -= 1; }
}

pub class BorrowMut<T> {
    #copy: disabled
    var pointer: *T;
    var counter: *isize;
    var ownsBorrow: bool;
    pub unsafe func init(pointer: *T, counter: *isize)
        : pointer(pointer), counter(counter), ownsBorrow(true) {}

    pub func get() *T { pointer }

    pub static func map<U, F: Movable>(value: Self, project: F) BorrowMut<U> {
        var target = project(value.pointer);
        var state = value.counter;
        value.ownsBorrow = false;
        unsafe { BorrowMut<U>(target, state) }
    }

    pub func deinit() void {
        if ownsBorrow {
            *counter = 0;
        }
    }
}

pub class RefCell<T: Movable> {
    #copy: disabled
    var value: ?T;
    var count: isize;
    func init(initial: T) : value(some(move(initial))), count(0) {}
    pub static func new(value: T) Self { RefCell<T>(move(value)) }

    pub func tryBorrow() ?BorrowRef<T> {
        if count < 0 { return null; }
        count++;
        unsafe {
            some(BorrowRef<T>(opt.asPtr<T>(&value).unwrap(), &count))
        }
    }

    pub func borrow() !BorrowRef<T> {
        switch tryBorrow() {
            null => CellError.Borrowed,
            some(held) => move(held),
        }
    }

    pub func tryBorrowMut() ?BorrowMut<T> {
        if count != 0 { return null; }
        count = -1;
        unsafe {
            some(BorrowMut<T>(opt.asMutPtr<T>(&value).unwrap(), &count))
        }
    }

    pub func borrowMut() !BorrowMut<T> {
        switch tryBorrowMut() {
            null => CellError.Borrowed,
            some(held) => move(held),
        }
    }

    pub func replace(replacement: T) !T {
        if count != 0 { return CellError.Borrowed; }
        opt.replace<T>(&value, move(replacement)).unwrap()
    }

    pub static func intoInner(inner: Self) T {
        if inner.count != 0 { panic("ref cell still borrowed"); }
        opt.take<T>(&inner.value).unwrap()
    }
}
