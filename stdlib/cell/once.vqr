package cell
import (core, opt)

pub class Cell<T: Copyable & Movable> {
    var slot: ?T;
    func init(value: T) : slot(some(move(value))) {}
public:
    static func new(value: T) Self { Cell<T>(move(value)) }
    const func get() T { slot.unwrap() }
    func set(value: T) void { slot = some(move(value)); }
    func replace(value: T) T { opt.replace<T>(&slot, move(value)).unwrap() }
    func update<F: Movable>(transform: F) void { set(transform(get())); }
    static func intoInner(value: Self) T { opt.take<T>(&value.slot).unwrap() }
}

pub class OnceCell<T: Movable> {
    #copy: disabled
    var slot: ?T;
    var initializing: bool;
    func init() : slot(null), initializing(false) {}
public:
    static func new() Self { OnceCell<T>() }
    const func get() ?*const T { opt.asPtr<T>(&slot) }
    func getMut() ?*T { opt.asMutPtr<T>(&slot) }

    func set(value: T) ?T {
        if initializing || core.isSome<T>(&slot) { return some(move(value)); }
        slot = some(move(value));
        null
    }

    func take() ?T {
        if initializing { return null; }
        opt.take<T>(&slot)
    }

    func getOrInit<F: Movable>(factory: F) *const T {
        switch get() {
            some(ptr) => ptr,
            null => {
                if initializing { panic("recursive once cell initialization"); }
                initializing = true;
                slot = some(factory());
                initializing = false;
                get().unwrap()
            },
        }
    }

    func getOrTryInit<F: Movable>(factory: F) !*const T {
        switch get() {
            some(ptr) => ptr,
            null => {
                if initializing { return CellError.RecursiveInitialization; }
                initializing = true;
                var value = factory() catch (reason) {
                    initializing = false;
                    return reason;
                };
                slot = some(move(value));
                initializing = false;
                get().unwrap()
            },
        }
    }
}

pub class Lazy<T: Movable, F: Movable> {
    #copy: disabled
    var slot: ?T;
    var factory: F;
    var initializing: bool;
public:
    func init(factory: F) : slot(null), factory(move(factory)), initializing(false) {}

    func force() !*const T {
        switch opt.asPtr<T>(&slot) {
            some(ptr) => ptr,
            null => {
                if initializing { return CellError.RecursiveInitialization; }
                initializing = true;
                var result: !T = factory();
                var value = move(result) catch (reason) {
                    initializing = false;
                    return reason;
                };
                slot = some(move(value));
                initializing = false;
                opt.asPtr<T>(&slot).unwrap()
            },
        }
    }
}

pub class UnsafeCell<T: Movable> {
    #copy: disabled
    var slot: T;
    func init(value: T) : slot(move(value)) {}
public:
    static func new(value: T) Self { UnsafeCell<T>(move(value)) }
    unsafe func get() *T { &slot }
}
