package cell
import (core, opt)

pub class Cell<T: Copyable + Movable> {
    var slot: ?T;
    func init(value: T) : slot(some(move(value))) {}
    pub static func new(value: T) Self { Cell<T>(move(value)) }
    pub const func get() T { slot.unwrap() }
    pub func set(value: T) void { slot = some(move(value)); }
    pub func replace(value: T) T { opt.Storage<T>.replace(slot, move(value)).unwrap() }
    pub func update<F: Movable>(transform: F) void { set(transform(get())); }
    pub static func intoInner(value: Self) T { opt.take<T>(value.slot).unwrap() }
}

pub class OnceCell<T: Movable> {
    #copy: disabled
    var slot: ?T;
    var initializing: bool;
    func init() : slot(null), initializing(false) {}
    pub static func new() Self { OnceCell<T>() }
    pub const func get() ?*const T { opt.asPtr<T>(raw slot) }
    pub func getMut() ?*T { opt.asMutPtr<T>(raw slot) }

    pub func set(value: T) ?T {
        if initializing || core.isSome<T>(raw slot) { return some(move(value)); }
        slot = some(move(value));
        null
    }

    pub func take() ?T {
        if initializing { return null; }
        opt.take<T>(slot)
    }

    pub func getOrInit<F: Movable>(factory: F) *const T {
        switch get() {
            some(ptr) => ptr,
            null => {
                if initializing { panic("recursive once cell initialization"); }
                initializing = true;
                slot = some(factory());
                initializing = false;
                get().unwrap()
            },
        }
    }

    // A null success grants this caller the attempt; either a published
    // address or a recursive error leaves the state exactly as it was.
    func prepareTryInit() core.ResultOptional<*const T> {
        var published = get();
        if published != null { return published; }
        if initializing { return CellError.RecursiveInitialization; }
        initializing = true;
        null
    }

    func finishTryInit() *const T {
        initializing = false;
        get().unwrap()
    }

    pub func getOrTryInit<F: Movable>(factory: F) !*const T {
        switch prepareTryInit()! {
            some(ptr) => ptr,
            null => {
                var value = factory() catch (reason) {
                    initializing = false;
                    return reason;
                };
                slot = some(move(value));
                finishTryInit()
            },
        }
    }

    // The factory stays with the caller and is only invoked for a new attempt.
    pub func getOrTryInitMut<F>(factory: mut F) !*const T {
        switch prepareTryInit()! {
            some(ptr) => ptr,
            null => {
                var value = factory() catch (reason) {
                    initializing = false;
                    return reason;
                };
                slot = some(move(value));
                finishTryInit()
            },
        }
    }
}

pub class Lazy<T: Movable, F: Movable> {
    #copy: disabled
    var slot: ?T;
    var factory: F;
    var initializing: bool;
    pub func init(factory: F) : slot(null), factory(move(factory)), initializing(false) {}

    pub func force() !*const T {
        switch opt.asPtr<T>(raw slot) {
            some(ptr) => ptr,
            null => {
                if initializing { return CellError.RecursiveInitialization; }
                initializing = true;
                var result: !T = factory();
                var value = move(result) catch (reason) {
                    initializing = false;
                    return reason;
                };
                slot = some(move(value));
                initializing = false;
                opt.asPtr<T>(raw slot).unwrap()
            },
        }
    }
}

pub class UnsafeCell<T: Movable> {
    #copy: disabled
    var slot: T;
    func init(value: T) : slot(move(value)) {}
    pub static func new(value: T) Self { UnsafeCell<T>(move(value)) }
    pub unsafe func get() *T { raw slot }
}
