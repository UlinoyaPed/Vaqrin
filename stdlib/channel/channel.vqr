package channel
import (core, atomic, mem, meta, opt, sync, time)

pub error ChannelError { Closed, OutOfMemory, Cancelled, Timeout }
pub enum SendResult<T> { Sent, Closed(T), Cancelled(T), OutOfMemory(T) }
pub enum TrySendResult<T> { Sent, Full(T), Closed(T), OutOfMemory(T) }
pub enum TryRecv<T> { Value(T), Empty, Closed }

enum Offer { Empty, Pending, Claimed, Committed }

func hasExpired(deadline: ?time.Deadline) bool {
    switch deadline {
        some(alarm) => alarm.expired() catch true,
        null => false,
    }
}

class Mailbox<T: Movable + Sendable> {
    pub var queue: Queue<T>;
    pub var offer: Offer;
    pub var handoff: ?T;
    pub var sendDeadline: ?time.Deadline;
    pub var receiverWaiting: bool;
    pub var recvDeadline: ?time.Deadline;
    pub var senders: usize;
    pub var closed: bool;
    pub var choices: ?*SelectNode<T>;
    pub func init(queue: move Queue<T>) : queue(move(queue)), offer(Offer.Empty), handoff(null), sendDeadline(null),
                                receiverWaiting(false), recvDeadline(null), senders(1), closed(false), choices(null) {}

    pub func receiveQueue() TryRecv<T> {
        if offer == Offer.Committed || (offer == Offer.Pending && !closed && !hasExpired(sendDeadline)) {
            var item = opt.take<T>(handoff);
            offer = if offer == Offer.Pending { Offer.Claimed } else { Offer.Empty };
            return TryRecv<T>.Value(move(item).unwrap());
        }
        switch queue.pop() {
            some(item) => TryRecv<T>.Value(move(item)),
            null => if closed { TryRecv<T>.Closed } else { TryRecv<T>.Empty },
        }
    }

    // Caller guards both the mailbox and the pending choice.
    pub func findChoice(sending: bool, excluding: ?*Choice) ?*SelectNode<T> {
        if offer != Offer.Empty || closed { return null; }
        var current = choices;
        while current != null {
            var node = current.unwrap();
            var isSend = node.source != null;
            if isSend == sending && node.choice.pending() &&
               (excluding == null || excluding.unwrap() != node.choice) {
                return current;
            }
            current = node.next;
        }
        null
    }

    pub func receive() TryRecv<T> {
        var outcome = receiveQueue();
        if choices == null { return move(outcome); }
        switch move(outcome) {
            TryRecv.Value(item) => TryRecv<T>.Value(move(item)),
            TryRecv.Closed => TryRecv<T>.Closed,
            TryRecv.Empty => {
                var guard = ChoiceLock();
                var sender = findChoice(true, null) ?? { return TryRecv<T>.Empty; };
                var item = takeOffered<T>(sender);
                sender.choice.index = sender.index;
                TryRecv<T>.Value(move(item))
            },
        }
    }

    pub func deliverToChoice(value: mut ?T) bool {
        if choices == null { return false; }
        var guard = ChoiceLock();
        var receiver = findChoice(false, null) ?? { return false; };
        receiver.value = opt.take<T>(value);
        receiver.choice.index = receiver.index;
        true
    }

    pub const func readyReceiver() bool { receiverWaiting && !hasExpired(recvDeadline) }

    pub func deliver(pending: mut ?T, state: Offer, deadline: ?time.Deadline) void {
        offer = state;
        handoff = some(opt.take<T>(pending).unwrap());
        sendDeadline = deadline;
        receiverWaiting = false;
    }
}

class State<T: Movable + Sendable> {
    pub var data: sync.Mutex<Mailbox<T>>;
    var sequence: u32;
    pub func init(queue: move Queue<T>) : data(sync.Mutex<Mailbox<T>>.new(Mailbox<T>(move(queue)))),
                                sequence(0) {}

    pub const func lock() sync.MutexGuard<Mailbox<T>> {
        data.lock() catch { panic("failed to acquire a channel lock"); }
    }

    pub const func wait(guard: move sync.MutexGuard<Mailbox<T>>, deadline: ?time.Deadline) sync.MutexGuard<Mailbox<T>> {
        var address = raw sequence;
        var version = __vqr_atomic_load(address, atomic.Order.Relaxed);
        seconds, nanos := switch deadline {
            some(alarm) => unsafe { alarm.instant().monotonicParts() },
            null => (i64(-1), i32(0)),
        };
        var awaitChange = [address, version, seconds, nanos]() void => {
            if !__vqr_task_channel_wait(address, version, seconds, i64(nanos)) {
                if seconds < 0 { __vqr_sync_wait(address, version); }
                else { var timedOut = __vqr_sync_wait_until(address, version, seconds, i64(nanos)); }
            }
        };
        unsafe { sync.MutexGuard<Mailbox<T>>.unlockWhile(move(guard), awaitChange) }
    }

    pub const func notifyAll() void {
        var address = unsafe { constCast<*u32>(raw sequence) };
        var previous = __vqr_atomic_add(address, 1u32, atomic.Order.Relaxed);
        __vqr_task_channel_notify(address);
        __vqr_sync_wake(address, 0x7fffffffu32);
        notifyChoices();
    }

    pub const func tryReceive() TryRecv<T> {
        var guard = lock();
        var outcome = guard.get().receive();
        switch outcome {
            TryRecv.Value(ref item) => { notifyAll(); },
            _ => {},
        }
        move(outcome)
    }

    pub const func close() void {
        var guard = lock();
        guard.get().closed = true;
        notifyAll();
    }
}

pub class Channel<T: Movable + Sendable> {
    static func open(capacity: ?usize) !(Sender<T>, Receiver<T>) {
        __vqr_validate_channel();
        var queue = Queue<T>(capacity)!;
        var shared = mem.Shared<State<T>>.new(State<T>(move(queue)))!;
        var sender = Sender<T>(shared.clone());
        (move(sender), Receiver<T>(move(shared)))
    }
    pub static func bounded(capacity: usize) !(Sender<T>, Receiver<T>) { Channel<T>.open(some(capacity)) }
    pub static func unbounded() !(Sender<T>, Receiver<T>) { Channel<T>.open(null) }
}

pub class Sender<T: Movable + Sendable> {
    #copy: enable
    var shared: mem.Shared<State<T>>;
    pub func init(state: mem.Shared<State<T>>) : shared(move(state)) {}

    pub const func copy() Self {
        var state = shared.asPtr();
        var guard = state.lock();
        var data = guard.get();
        if data.senders == ~usize(0) { panic("channel sender count overflow"); }
        data.senders++;
        Sender<T>(shared.clone())
    }
    const func selectTicket(choice: *Choice, index: usize, source: *T) Ticket<T> {
        Ticket<T>(shared.clone(), choice, index, some(source))
    }
    pub const func clone() Self { copy() }

    // The sender owns the acquired payload before publishing it. The
    // synchronous helpers either take the local slot into the mailbox or
    // take it into an error result; they do not store a borrow of the slot.
    comptime if meta.isCopyable<T>() {
        pub const func send(value: T) !void {
            var pending: ?T = some(move(value));
            discardRefusal(pending)
        }
        pub const func trySend(value: T) TrySendResult<T> {
            var pending: ?T = some(move(value));
            trySendPending(pending)
        }
        pub const func sendPreserving(value: T) SendResult<T> {
            var pending: ?T = some(move(value));
            sendBefore(pending, null)
        }
        pub const func sendTimeout(value: T, timeout: time.Duration) SendResult<T> {
            var pending: ?T = some(move(value));
            sendWithTimeout(pending, timeout)
        }
    } else {
        pub const func send(value: move T) !void {
            var pending: ?T = some(move(value));
            discardRefusal(pending)
        }
        pub const func trySend(value: move T) TrySendResult<T> {
            var pending: ?T = some(move(value));
            trySendPending(pending)
        }
        pub const func sendPreserving(value: move T) SendResult<T> {
            var pending: ?T = some(move(value));
            sendBefore(pending, null)
        }
        pub const func sendTimeout(value: move T, timeout: time.Duration) SendResult<T> {
            var pending: ?T = some(move(value));
            sendWithTimeout(pending, timeout)
        }
    }

    const func discardRefusal(pending: mut ?T) !void {
        switch sendBefore(pending, null) {
            SendResult.Sent => {},
            SendResult.Closed(item) => { return ChannelError.Closed; },
            SendResult.Cancelled(item) => { return ChannelError.Cancelled; },
            SendResult.OutOfMemory(item) => { return ChannelError.OutOfMemory; },
        }
    }

    const func trySendPending(pending: mut ?T) TrySendResult<T> {
        var state = shared.asPtr();
        var guard = state.lock();
        var data = guard.get();
        if data.closed { return TrySendResult<T>.Closed(opt.take<T>(pending).unwrap()); }
        if data.queue.isRendezvous() {
            if data.offer != Offer.Empty { return TrySendResult<T>.Full(opt.take<T>(pending).unwrap()); }
            if data.readyReceiver() { data.deliver(pending, Offer.Committed, null); }
            else {
                if !data.deliverToChoice(pending) { return TrySendResult<T>.Full(opt.take<T>(pending).unwrap()); }
            }
        } else {
            if data.queue.isFull() { return TrySendResult<T>.Full(opt.take<T>(pending).unwrap()); }
            data.queue.prepare() catch { return TrySendResult<T>.OutOfMemory(opt.take<T>(pending).unwrap()); };
            data.queue.push(pending);
        }
        state.notifyAll();
        TrySendResult<T>.Sent
    }

    const func sendWithTimeout(pending: mut ?T, timeout: time.Duration) SendResult<T> {
        var alarm = time.Deadline.after(timeout) catch { return SendResult<T>.Cancelled(opt.take<T>(pending).unwrap()); };
        sendBefore(pending, some(alarm))
    }

    const func sendBefore(pending: mut ?T, deadline: ?time.Deadline) SendResult<T> {
        var state = shared.asPtr();
        var guard = state.lock();
        var initial = guard.get();
        if initial.queue.isRendezvous() {
            return sendRendezvous(state, move(guard), pending, deadline);
        }
        for {
            var data = guard.get();
            if data.closed { return SendResult<T>.Closed(opt.take<T>(pending).unwrap()); }
            if __vqr_task_channel_cancelled() { return SendResult<T>.Cancelled(opt.take<T>(pending).unwrap()); }
            if !data.queue.isFull() {
                data.queue.prepare() catch { return SendResult<T>.OutOfMemory(opt.take<T>(pending).unwrap()); };
                data.queue.push(pending);
                state.notifyAll();
                return SendResult<T>.Sent;
            }
            if hasExpired(deadline) { return SendResult<T>.Cancelled(opt.take<T>(pending).unwrap()); }
            guard = state.wait(move(guard), deadline);
        }
    }

    pub const func close() void { shared.asPtr().close(); }
    pub const func isClosed() bool {
        var guard = shared.asPtr().lock();
        guard.get().closed
    }
    pub const func capacity() ?usize {
        var guard = shared.asPtr().lock();
        guard.get().queue.capacity()
    }
    pub const func lenApprox() usize {
        var guard = shared.asPtr().lock();
        guard.get().queue.len()
    }

    pub func deinit() void {
        var state = shared.asPtr();
        var guard = state.lock();
        var data = guard.get();
        data.senders--;
        if data.senders == 0 {
            data.closed = true;
            state.notifyAll();
        }
    }
    const func sendRendezvous(state: *const State<T>, guard: move sync.MutexGuard<Mailbox<T>>, pending: mut ?T,
                             deadline: ?time.Deadline)
        SendResult<T> {
        for {
            var data = guard.get();
            if data.closed { return SendResult<T>.Closed(opt.take<T>(pending).unwrap()); }
            if __vqr_task_channel_cancelled() { return SendResult<T>.Cancelled(opt.take<T>(pending).unwrap()); }
            if data.offer == Offer.Empty {
                if data.readyReceiver() {
                    data.deliver(pending, Offer.Committed, null);
                    state.notifyAll();
                    return SendResult<T>.Sent;
                }
                if hasExpired(deadline) { return SendResult<T>.Cancelled(opt.take<T>(pending).unwrap()); }
                if data.deliverToChoice(pending) {
                    state.notifyAll();
                    return SendResult<T>.Sent;
                }
                data.deliver(pending, Offer.Pending, deadline);
                state.notifyAll();
                return waitForClaim(state, move(guard), deadline);
            }
            if hasExpired(deadline) { return SendResult<T>.Cancelled(opt.take<T>(pending).unwrap()); }
            guard = state.wait(move(guard), deadline);
        }
    }

    const func waitForClaim(state: *const State<T>, guard: move sync.MutexGuard<Mailbox<T>>,
                           deadline: ?time.Deadline) SendResult<T> {
        for {
            var data = guard.get();
            if data.offer == Offer.Claimed {
                data.offer = Offer.Empty;
                state.notifyAll();
                return SendResult<T>.Sent;
            }
            var closed = data.closed;
            if closed || __vqr_task_channel_cancelled() || hasExpired(deadline) {
                // The mailbox guard still holds the exclusive lock on the handoff slot.
                var recovered = unsafe { opt.takeRaw<T>(raw data.handoff) };
                data.offer = Offer.Empty;
                state.notifyAll();
                if closed { return SendResult<T>.Closed(move(recovered).unwrap()); }
                return SendResult<T>.Cancelled(move(recovered).unwrap());
            }
            guard = state.wait(move(guard), deadline);
        }
    }
}

pub class Receiver<T: Movable + Sendable> {
    #copy: disabled
    var shared: mem.Shared<State<T>>;
    pub func init(state: mem.Shared<State<T>>) : shared(move(state)) {}

    func selectTicket(choice: *Choice, index: usize) Ticket<T> {
        Ticket<T>(shared.clone(), choice, index, null)
    }

    pub func recv() core.ResultOptional<T> { recvBefore(null) }
    pub func recvTimeout(timeout: time.Duration) core.ResultOptional<T> { recvBefore(some(time.Deadline.after(timeout)!)) }

    func recvBefore(deadline: ?time.Deadline) core.ResultOptional<T> {
        var state = shared.asPtr();
        var guard = state.lock();
        for {
            var data = guard.get();
            data.receiverWaiting = false;
            switch data.receive() {
                TryRecv.Value(item) => { state.notifyAll(); return some(move(item)); },
                TryRecv.Closed => return null,
                TryRecv.Empty => {},
            }
            if __vqr_task_channel_cancelled() { return ChannelError.Cancelled; }
            if hasExpired(deadline) { return ChannelError.Timeout; }
            data.receiverWaiting = true;
            data.recvDeadline = deadline;
            guard = state.wait(move(guard), deadline);
        }
    }

    pub func tryRecv() TryRecv<T> { shared.asPtr().tryReceive() }

    pub func close() void { shared.asPtr().close(); }
    pub func drain() Drain<T> from self { Drain<T>.fromShared(shared) }
    pub const func isClosed() bool {
        var guard = shared.asPtr().lock();
        guard.get().closed
    }
    pub const func capacity() ?usize {
        var guard = shared.asPtr().lock();
        guard.get().queue.capacity()
    }
    pub const func lenApprox() usize {
        var guard = shared.asPtr().lock();
        guard.get().queue.len()
    }

    pub func deinit() void {
        var state = shared.asPtr();
        var guard = state.lock();
        var data = guard.get();
        data.closed = true;
        var unread = data.queue.takeBuffer();
        var completed: ?T = null;
        if data.offer == Offer.Committed {
            // The closing receiver still holds the exclusive mailbox lock.
            completed = unsafe { opt.takeRaw<T>(raw data.handoff) };
            data.offer = Offer.Empty;
        }
        state.notifyAll();
        guard.unlock();
    }
}

pub class Drain<T: Movable + Sendable> {
    #borrowed: scoped
    var source: ref mem.Shared<State<T>>;

    // Only Receiver can supply its encapsulated mailbox handle.
    pub static func fromShared(source: in mem.Shared<State<T>>) Drain<T> from source {
        Drain<T>{source: ref source}
    }

    pub const func next() ?T {
        switch source.asPtr().tryReceive() {
            TryRecv.Value(item) => some(move(item)),
            _ => null,
        }
    }
}

pub func bounded<T: Movable + Sendable>(capacity: usize) !(Sender<T>, Receiver<T>) { Channel<T>.bounded(capacity) }
pub func unbounded<T: Movable + Sendable>() !(Sender<T>, Receiver<T>) { Channel<T>.unbounded() }
pub func send<T: Copyable + Movable + Sendable>(tx: *const Sender<T>, value: T) !void { tx.send(move(value)) }
pub func recv<T: Movable + Sendable>(rx: *Receiver<T>) core.ResultOptional<T> { rx.recv() }
pub func trySend<T: Copyable + Movable + Sendable>(tx: *const Sender<T>, value: T) TrySendResult<T> { tx.trySend(move(value)) }
pub func tryRecv<T: Movable + Sendable>(rx: *Receiver<T>) TryRecv<T> { rx.tryRecv() }
