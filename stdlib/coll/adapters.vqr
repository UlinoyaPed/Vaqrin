package coll
import (core, mem, meta)

pub class Stack<T: Movable> {
    var values: Vec<T>;
    pub func init() : values(Vec<T>()) {}

    pub static func withCapacity(n: usize) !Self {
        var result = Stack<T>();
        result.values = Vec<T>.withCapacity(n)!;
        move(result)
    }

    pub static func withAllocator(allocator: mem.AllocatorRef) Self {
        var result = Stack<T>();
        result.values = Vec<T>.withAllocator(allocator);
        move(result)
    }

    pub static func withCapacityAndAllocator(n: usize, allocator: mem.AllocatorRef) !Self {
        var result = Stack<T>();
        result.values = Vec<T>.withCapacityAndAllocator(n, allocator)!;
        move(result)
    }

    pub const func len() usize { values.len() }
    pub const func isEmpty() bool { values.isEmpty() }
    comptime if meta.isCopyable<T>() {
        pub func push(value: T) !void { values.push(move(value)) }
        pub func pushPreserving(value: T) PushResult<T> { values.pushPreserving(move(value)) }
    } else {
        pub func push(value: move T) !void { values.push(move(value)) }
        pub func pushPreserving(value: move T) PushResult<T> { values.pushPreserving(move(value)) }
    }
    pub func pop() ?T { values.pop() }
    pub const func peek() ?*const T { values.last() }
    pub func peekMut() ?*T { values.lastMut() }
    pub func clear() void { values.clear(); }
}

pub class Queue<T: Movable> {
    var values: VecDeque<T>;
    pub func init() : values(VecDeque<T>()) {}

    pub static func withCapacity(n: usize) !Self {
        var result = Queue<T>();
        result.values = VecDeque<T>.withCapacity(n)!;
        move(result)
    }

    pub static func withAllocator(allocator: mem.AllocatorRef) Self {
        var result = Queue<T>();
        result.values = VecDeque<T>.withAllocator(allocator);
        move(result)
    }

    pub static func withCapacityAndAllocator(n: usize, allocator: mem.AllocatorRef) !Self {
        var result = Queue<T>();
        result.values = VecDeque<T>.withCapacityAndAllocator(n, allocator)!;
        move(result)
    }

    pub const func len() usize { values.len() }
    pub const func isEmpty() bool { values.isEmpty() }
    comptime if meta.isCopyable<T>() {
        pub func enqueue(value: T) !void { values.pushBack(move(value)) }
        pub func enqueuePreserving(value: T) PushResult<T> { values.pushBackPreserving(move(value)) }
    } else {
        pub func enqueue(value: move T) !void { values.pushBack(move(value)) }
        pub func enqueuePreserving(value: move T) PushResult<T> { values.pushBackPreserving(move(value)) }
    }
    pub func dequeue() ?T { values.popFront() }
    pub const func front() ?*const T { values.front() }
    pub const func back() ?*const T { values.back() }
    pub func clear() void { values.clear(); }
}

pub enum HeapOrder { Min, Max }

func heapDefaultLess<T>(a: *const T, b: *const T) bool { *a < *b }

pub class BinaryHeap<T: Movable> {
    #copy: disabled
    var values: Vec<T>;
    var less: func(*const T, *const T) bool;
    var order: HeapOrder;
    pub func init(less: func(*const T, *const T) bool, order: HeapOrder)
        : values(Vec<T>()), less(less), order(order) {}

    pub static func withComparator(
        less: func(*const T, *const T) bool, order: HeapOrder
    ) Self {
        BinaryHeap<T>(less, order)
    }

    pub static func withMaxComparator(less: func(*const T, *const T) bool) Self {
        BinaryHeap<T>(less, HeapOrder.Max)
    }

    pub static func withMinComparator(less: func(*const T, *const T) bool) Self {
        BinaryHeap<T>(less, HeapOrder.Min)
    }

    pub static func max() Self {
        var comparator: func(*const T, *const T) bool = (a, b: *const T) bool => heapDefaultLess<T>(a, b);
        BinaryHeap<T>.withMaxComparator(comparator)
    }
    pub static func min() Self {
        var comparator: func(*const T, *const T) bool = (a, b: *const T) bool => heapDefaultLess<T>(a, b);
        BinaryHeap<T>.withMinComparator(comparator)
    }

    pub static func withAllocator(
        less: func(*const T, *const T) bool, order: HeapOrder,
        allocator: mem.AllocatorRef
    ) Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        result.values = Vec<T>.withAllocator(allocator);
        move(result)
    }

    pub static func withCapacity(
        n: usize, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        result.values = Vec<T>.withCapacity(n)!;
        move(result)
    }

    pub static func withCapacityAndAllocator(
        n: usize, less: func(*const T, *const T) bool,
        order: HeapOrder, allocator: mem.AllocatorRef
    ) !Self {
        var result = BinaryHeap<T>.withAllocator(less, order, allocator);
        result.values.reserve(n)!;
        move(result)
    }

    pub static func fromSlice(
        items: []const T, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        result.values = Vec<T>.fromSlice(items)!;
        result.heapify();
        move(result)
    }

    // Advance an acquired copy without consuming the caller's iterator.
    pub static func fromIter<I: Copyable + Movable>(
        items: I, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        for item in move(items) { result.values.push(move(item))!; }
        result.heapify();
        move(result)
    }

    // Drain an owning iterator, preserving exact transfer and cleanup on error.
    pub static func fromOwnedIter<I: Movable>(
        items: move I, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        for item in move(items) { result.values.push(move(item))!; }
        result.heapify();
        move(result)
    }

    pub const func len() usize { values.len() }
    pub const func capacity() usize { values.capacity() }
    pub const func isEmpty() bool { values.isEmpty() }
    pub const func peek() ?*const T { values.first() }

    comptime if meta.isCopyable<T>() {
        pub func push(value: T) !void {
            values.push(move(value))!;
            siftUp(values.len() - 1);
        }

        pub func pushPreserving(value: T) PushResult<T> {
            switch values.pushPreserving(move(value)) {
                PushResult.Stored => {
                    siftUp(values.len() - 1);
                    PushResult<T>.Stored()
                },
                PushResult.Full(item) => PushResult<T>.Full(move(item)),
                PushResult.Failed(reason, item) => PushResult<T>.Failed(reason, move(item)),
            }
        }

        pub func replaceTop(value: T) core.ResultOptional<T> {
            if values.isEmpty() {
                values.push(move(value))!;
                return null;
            }
            var previous = values.replace(0, move(value)).unwrap();
            siftDown(0);
            some(move(previous))
        }

        pub func pushPop(value: T) T {
            if values.isEmpty() { return move(value); }
            var root = values.at(0);
            var replaceRoot = if order == HeapOrder.Max { less(raw value, root) } else { less(root, raw value) };
            if replaceRoot {
                var previous = values.replace(0, move(value)).unwrap();
                siftDown(0);
                move(previous)
            } else {
                move(value)
            }
        }
    } else {
        pub func push(value: move T) !void {
            values.push(move(value))!;
            siftUp(values.len() - 1);
        }

        pub func pushPreserving(value: move T) PushResult<T> {
            switch values.pushPreserving(move(value)) {
                PushResult.Stored => {
                    siftUp(values.len() - 1);
                    PushResult<T>.Stored()
                },
                PushResult.Full(item) => PushResult<T>.Full(move(item)),
                PushResult.Failed(reason, item) => PushResult<T>.Failed(reason, move(item)),
            }
        }

        pub func replaceTop(value: move T) core.ResultOptional<T> {
            if values.isEmpty() {
                values.push(move(value))!;
                return null;
            }
            var previous = values.replace(0, move(value)).unwrap();
            siftDown(0);
            some(move(previous))
        }

        pub func pushPop(value: move T) T {
            if values.isEmpty() { return move(value); }
            var root = values.at(0);
            var replaceRoot = if order == HeapOrder.Max { less(raw value, root) } else { less(root, raw value) };
            if replaceRoot {
                var previous = values.replace(0, move(value)).unwrap();
                siftDown(0);
                move(previous)
            } else {
                move(value)
            }
        }
    }

    pub func pop() ?T {
        if values.isEmpty() { return null; }
        if values.len() == 1 { return values.pop(); }
        values.swap(0, values.len() - 1);
        var result = values.pop().unwrap();
        siftDown(0);
        some(move(result))
    }

    pub func clear() void { values.clear(); }

    pub func intoSortedVec() !Vec<T> {
        var result = Vec<T>.withCapacity(values.len())!;
        while values.len() > 0 {
            var item = pop().unwrap();
            result.push(move(item))!;
        }
        move(result)
    }

    func higherPriority(a: usize, b: usize) bool {
        if order == HeapOrder.Max { less(values.getPtr(b).unwrap(), values.getPtr(a).unwrap()) }
        else { less(values.getPtr(a).unwrap(), values.getPtr(b).unwrap()) }
    }

    func siftUp(index: usize) void {
        var child = index;
        while child > 0 {
            var parent = (child - 1) / 2;
            if !higherPriority(child, parent) { return; }
            values.swap(child, parent);
            child = parent;
        }
    }

    func siftDown(index: usize) void {
        var root = index;
        while root < values.len() / 2 {
            var child = root * 2 + 1;
            if child + 1 < values.len() && higherPriority(child + 1, child) { child++; }
            if !higherPriority(child, root) { return; }
            values.swap(root, child);
            root = child;
        }
    }

    func heapify() void {
        var i = values.len() / 2;
        while i > 0 {
            i--;
            siftDown(i);
        }
    }
}

pub type PriorityQueue<T: Movable> = BinaryHeap<T>;
