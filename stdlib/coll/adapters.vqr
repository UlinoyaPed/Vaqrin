package coll
import (mem)

pub class Stack<T: Movable> {
    var values: Vec<T>;
public:
    func init() : values(Vec<T>()) {}

    static func withCapacity(n: usize) !Self {
        var result = Stack<T>();
        result.values = Vec<T>.withCapacity(n)!;
        move(result)
    }

    static func withAllocator(allocator: mem.AllocatorRef) Self {
        var result = Stack<T>();
        result.values = Vec<T>.withAllocator(allocator);
        move(result)
    }

    static func withCapacityAndAllocator(n: usize, allocator: mem.AllocatorRef) !Self {
        var result = Stack<T>();
        result.values = Vec<T>.withCapacityAndAllocator(n, allocator)!;
        move(result)
    }

    const func len() usize { values.len() }
    const func isEmpty() bool { values.isEmpty() }
    func push(value: T) !void { values.push(move(value)) }
    func pushPreserving(value: T) PushResult<T> { values.pushPreserving(move(value)) }
    func pop() ?T { values.pop() }
    const func peek() ?*const T { values.last() }
    func peekMut() ?*T { values.lastMut() }
    func clear() void { values.clear(); }
}

pub class Queue<T: Movable> {
    var values: VecDeque<T>;
public:
    func init() : values(VecDeque<T>()) {}

    static func withCapacity(n: usize) !Self {
        var result = Queue<T>();
        result.values = VecDeque<T>.withCapacity(n)!;
        move(result)
    }

    static func withAllocator(allocator: mem.AllocatorRef) Self {
        var result = Queue<T>();
        result.values = VecDeque<T>.withAllocator(allocator);
        move(result)
    }

    static func withCapacityAndAllocator(n: usize, allocator: mem.AllocatorRef) !Self {
        var result = Queue<T>();
        result.values = VecDeque<T>.withCapacityAndAllocator(n, allocator)!;
        move(result)
    }

    const func len() usize { values.len() }
    const func isEmpty() bool { values.isEmpty() }
    func enqueue(value: T) !void { values.pushBack(move(value)) }
    func enqueuePreserving(value: T) PushResult<T> { values.pushBackPreserving(move(value)) }
    func dequeue() ?T { values.popFront() }
    const func front() ?*const T { values.front() }
    const func back() ?*const T { values.back() }
    func clear() void { values.clear(); }
}

pub enum HeapOrder { Min, Max }

func heapDefaultLess<T>(a: *const T, b: *const T) bool { *a < *b }

pub class BinaryHeap<T: Movable> {
    #copy: disabled
    var values: Vec<T>;
    var less: func(*const T, *const T) bool;
    var order: HeapOrder;
public:
    func init(less: func(*const T, *const T) bool, order: HeapOrder)
        : values(Vec<T>()), less(less), order(order) {}

    static func withComparator(
        less: func(*const T, *const T) bool, order: HeapOrder
    ) Self {
        BinaryHeap<T>(less, order)
    }

    static func withMaxComparator(less: func(*const T, *const T) bool) Self {
        BinaryHeap<T>(less, HeapOrder.Max)
    }

    static func withMinComparator(less: func(*const T, *const T) bool) Self {
        BinaryHeap<T>(less, HeapOrder.Min)
    }

    static func max() Self {
        var comparator: func(*const T, *const T) bool = (a, b: *const T) bool => heapDefaultLess<T>(a, b);
        BinaryHeap<T>.withMaxComparator(comparator)
    }
    static func min() Self {
        var comparator: func(*const T, *const T) bool = (a, b: *const T) bool => heapDefaultLess<T>(a, b);
        BinaryHeap<T>.withMinComparator(comparator)
    }

    static func withAllocator(
        less: func(*const T, *const T) bool, order: HeapOrder,
        allocator: mem.AllocatorRef
    ) Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        result.values = Vec<T>.withAllocator(allocator);
        move(result)
    }

    static func withCapacity(
        n: usize, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        result.values = Vec<T>.withCapacity(n)!;
        move(result)
    }

    static func withCapacityAndAllocator(
        n: usize, less: func(*const T, *const T) bool,
        order: HeapOrder, allocator: mem.AllocatorRef
    ) !Self {
        var result = BinaryHeap<T>.withAllocator(less, order, allocator);
        result.values.reserve(n)!;
        move(result)
    }

    static func fromSlice(
        items: []const T, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        result.values = Vec<T>.fromSlice(items)!;
        result.heapify();
        move(result)
    }

    static func fromIter<I: Movable>(
        items: I, less: func(*const T, *const T) bool, order: HeapOrder
    ) !Self {
        var result = BinaryHeap<T>.withComparator(less, order);
        for item in move(items) { result.values.push(move(item))!; }
        result.heapify();
        move(result)
    }

    const func len() usize { values.len() }
    const func capacity() usize { values.capacity() }
    const func isEmpty() bool { values.isEmpty() }
    const func peek() ?*const T { values.first() }

    func push(value: T) !void {
        values.push(move(value))!;
        siftUp(values.len() - 1);
    }

    func pushPreserving(value: T) PushResult<T> {
        switch values.pushPreserving(move(value)) {
            PushResult.Stored => {
                siftUp(values.len() - 1);
                PushResult.Stored()
            },
            PushResult.Full(item) => PushResult.Full(move(item)),
            PushResult.Failed(reason, item) => PushResult.Failed(reason, move(item)),
        }
    }

    func pop() ?T {
        if values.isEmpty() { return null; }
        if values.len() == 1 { return values.pop(); }
        values.swap(0, values.len() - 1);
        var result = values.pop().unwrap();
        siftDown(0);
        some(move(result))
    }

    func replaceTop(value: T) !?T {
        if values.isEmpty() {
            values.push(move(value))!;
            return null;
        }
        var previous = values.replace(0, move(value)).unwrap();
        siftDown(0);
        some(move(previous))
    }

    func pushPop(value: T) T {
        if values.isEmpty() { return move(value); }
        var root = values.at(0);
        var replaceRoot = if (order == HeapOrder.Max) less(&value, root) else less(root, &value);
        if replaceRoot {
            var previous = values.replace(0, move(value)).unwrap();
            siftDown(0);
            move(previous)
        } else {
            move(value)
        }
    }

    func clear() void { values.clear(); }

    func intoSortedVec() !Vec<T> {
        var result = Vec<T>.withCapacity(values.len())!;
        for values.len() > 0 {
            var item = pop().unwrap();
            result.push(move(item))!;
        }
        move(result)
    }

private:
    func higherPriority(a: usize, b: usize) bool {
        if order == HeapOrder.Max { less(values.getPtr(b).unwrap(), values.getPtr(a).unwrap()) }
        else { less(values.getPtr(a).unwrap(), values.getPtr(b).unwrap()) }
    }

    func siftUp(index: usize) void {
        var child = index;
        for child > 0 {
            var parent = (child - 1) / 2;
            if !higherPriority(child, parent) { return; }
            values.swap(child, parent);
            child = parent;
        }
    }

    func siftDown(index: usize) void {
        var root = index;
        for root < values.len() / 2 {
            var child = root * 2 + 1;
            if child + 1 < values.len() && higherPriority(child + 1, child) { child++; }
            if !higherPriority(child, root) { return; }
            values.swap(root, child);
            root = child;
        }
    }

    func heapify() void {
        var i = values.len() / 2;
        for i > 0 {
            i--;
            siftDown(i);
        }
    }
}

pub type PriorityQueue<T: Movable> = BinaryHeap<T>;
