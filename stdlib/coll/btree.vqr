package coll
import (core, meta)

const btreeMinimumDegree: usize = 4;
const btreeMaximumEntries: usize = 7;

class BTreeNode<K: Movable, V: Movable> {
    #copy: disabled
    var leaf: bool;
    var entries: FixedVec<(K, V), 7>;
    var children: FixedVec<*BTreeNode<K, V>, 8>;
    pub func init(isLeaf: bool)
        : leaf(isLeaf), entries(FixedVec<(K, V), 7>()), children(FixedVec<*BTreeNode<K, V>, 8>()) {}

    pub const func isLeaf() bool { leaf }
    pub const func entryCount() usize { entries.len() }
    pub const func childCount() usize { children.len() }

    pub const func entryAt(index: usize) *const (K, V) { entries.get(index).unwrap() }
    pub func entryAtMut(index: usize) *(K, V) { entries.getMut(index).unwrap() }

    comptime if meta.isCopyable<(K, V)>() {
        pub func insertEntry(index: usize, entry: (K, V)) void {
            switch entries.insert(index, move(entry)) {
                PushResult.Stored => {},
                else => panic("BTree node entry capacity invariant"),
            }
        }
    } else {
        pub func insertEntry(index: usize, entry: move (K, V)) void {
            switch entries.insert(index, move(entry)) {
                PushResult.Stored => {},
                else => panic("BTree node entry capacity invariant"),
            }
        }
    }

    pub func removeEntry(index: usize) (K, V) { entries.remove(index).unwrap() }

    pub func childAt(index: usize) *BTreeNode<K, V> {
        *children.get(index).unwrap()
    }

    pub func insertChild(index: usize, child: *BTreeNode<K, V>) void {
        switch children.insert(index, child) {
            PushResult.Stored => {},
            else => panic("BTree node child capacity invariant"),
        }
    }

    pub func removeChild(index: usize) *BTreeNode<K, V> { children.remove(index).unwrap() }
}

func allocateBTreeNode<K: Movable, V: Movable>(
    leaf: bool
) !*BTreeNode<K, V> {
    var owner = new BTreeNode<K, V>(leaf)!;
    Box.intoRaw(move(owner))
}

func destroyBTreeNode<K: Movable, V: Movable>(
    node: *BTreeNode<K, V>
) void {
    while node.childCount() > 0 {
        var child = node.removeChild(0);
        destroyBTreeNode<K, V>(child);
    }
    var owner = unsafe { Box<BTreeNode<K, V>>.fromRaw(node) };
}

func btreeLowerIndex<K: Movable, V: Movable>(
    node: *BTreeNode<K, V>, key: *const K,
    less: func(*const K, *const K) bool
) usize {
    var index: usize = 0;
    while index < node.entryCount() {
        if !less(raw node.entryAt(index).0, key) { return index; }
        index++;
    }
    index
}

class BTreeCursor<K: Movable, V: Movable> {
    // A degree-four B-tree with a usize entry count has at most 32 levels.
    var stack: FixedVec<(*BTreeNode<K, V>, usize), 32>;
    var reverse: bool;
    pub func init(root: ?*BTreeNode<K, V>, reverse: bool)
        : stack(FixedVec<(*BTreeNode<K, V>, usize), 32>()), reverse(reverse) {
        switch root {
            some(node) => push(node),
            null => {},
        }
    }

    pub func push(node: *BTreeNode<K, V>) void {
        var eventCount = if node.isLeaf() { node.entryCount() } else { node.entryCount() * 2 + 1 };
        switch stack.push((node, if reverse { eventCount } else { 0 })) {
            PushResult.Stored => {},
            _ => panic("BTree cursor depth invariant"),
        }
    }

    pub func seekLower(key: *const K, less: func(*const K, *const K) bool) void {
        while !stack.isEmpty() {
            var frame = stack.lastMut().unwrap();
            var node = frame.0;
            var index = btreeLowerIndex<K, V>(node, key, less);
            if node.isLeaf() {
                frame.1 = index;
                return;
            }
            frame.1 = index * 2 + 1;
            push(node.childAt(index));
        }
    }

    pub func next() ?*(K, V) {
        while !stack.isEmpty() {
            var frame = stack.lastMut().unwrap();
            var node = frame.0;
            var leaf = node.isLeaf();
            var eventCount = if leaf { node.entryCount() } else { node.entryCount() * 2 + 1 };
            if (reverse && frame.1 == 0) || (!reverse && frame.1 == eventCount) {
                var done = stack.pop();
                continue;
            }
            if reverse { frame.1--; }
            var event = frame.1;
            if !reverse { frame.1++; }
            if leaf { return some(node.entryAtMut(event)); }
            if event % 2 == 1 { return some(node.entryAtMut(event / 2)); }
            push(node.childAt(event / 2));
        }
        null
    }
}

class BTreeCursors<K: Movable, V: Movable> {
    var front: BTreeCursor<K, V>;
    var back: BTreeCursor<K, V>;
    var count: usize;
    pub func init(root: ?*BTreeNode<K, V>, count: usize)
        : front(BTreeCursor<K, V>(root, false)), back(BTreeCursor<K, V>(root, true)), count(count) {}
    pub func next(reverse: bool) ?*(K, V) {
        if count == 0 { return null; }
        count--;
        if reverse { back.next() } else { front.next() }
    }
    pub const func remaining() usize { count }
}

pub class BTreeIterRef<K: Movable, V: Movable> {
    var cursors: BTreeCursors<K, V>;
    var snapshot: ?IteratorSnapshot<*const (K, V)>;
    pub func init(root: ?*BTreeNode<K, V>, count: usize)
        : cursors(BTreeCursors<K, V>(root, count)), snapshot(null) {}
    pub func init(items: Vec<*const (K, V)>, count: usize)
        : cursors(BTreeCursors<K, V>(null, 0)), snapshot(some(IteratorSnapshot<*const (K, V)>(move(items), count))) {}
    pub func next() ?(*const K, *const V) { take(false) }
    pub func nextBack() ?(*const K, *const V) { take(true) }
    pub const func remaining() usize {
        switch __vqr_optional_pointer(raw snapshot) {
            some(saved) => saved.remaining(),
            null => cursors.remaining(),
        }
    }
    func take(reverse: bool) ?(*const K, *const V) {
        var entry: *const (K, V);
        switch __vqr_optional_pointer(raw snapshot) {
            some(saved) => { entry = saved.take(reverse) ?? { return null; }; },
            null => { entry = cursors.next(reverse) ?? { return null; }; },
        }
        some((raw entry.0, raw entry.1))
    }
}

pub class BTreeIterMut<K: Movable, V: Movable> {
    var cursors: BTreeCursors<K, V>;
    var snapshot: ?IteratorSnapshot<*(K, V)>;
    pub func init(root: ?*BTreeNode<K, V>, count: usize)
        : cursors(BTreeCursors<K, V>(root, count)), snapshot(null) {}
    pub func init(items: Vec<*(K, V)>, count: usize)
        : cursors(BTreeCursors<K, V>(null, 0)), snapshot(some(IteratorSnapshot<*(K, V)>(move(items), count))) {}
    pub func next() ?(*const K, *V) { take(false) }
    pub func nextBack() ?(*const K, *V) { take(true) }
    pub const func remaining() usize {
        switch __vqr_optional_pointer(raw snapshot) {
            some(saved) => saved.remaining(),
            null => cursors.remaining(),
        }
    }
    func take(reverse: bool) ?(*const K, *V) {
        var entry: *(K, V);
        switch __vqr_optional_pointer(raw snapshot) {
            some(saved) => { entry = saved.take(reverse) ?? { return null; }; },
            null => { entry = cursors.next(reverse) ?? { return null; }; },
        }
        some((raw entry.0, raw entry.1))
    }
}

pub class BTreeRangeRef<K: Movable, V: Movable> {
    var cursor: BTreeCursor<K, V>;
    var endKey: ?*const K;
    var done: bool;
    pub func init(root: ?*BTreeNode<K, V>, lower: ?*const K, endKey: ?*const K,
              less: func(*const K, *const K) bool, empty: bool)
        : cursor(BTreeCursor<K, V>(root, false)), endKey(endKey), done(empty) {
        switch lower {
            some(key) => { if !empty { cursor.seekLower(key, less); } },
            null => {},
        }
    }

    pub func next() ?(*const K, *const V) {
        if done { return null; }
        var entry = cursor.next() ?? { done = true; return null; };
        switch endKey {
            some(key) => {
                var address: *const K = raw entry.0;
                if key == address { done = true; return null; }
            },
            null => {},
        }
        some((raw entry.0, raw entry.1))
    }
}

pub class BTreeSetIterRef<T: Movable> {
    var source: BTreeIterRef<T, u8>;
    pub func init(source: BTreeIterRef<T, u8>) : source(move(source)) {}
    pub func next() ?*const T {
        switch source.next() {
            null => null,
            some(entry) => some(entry.0),
        }
    }
    pub func nextBack() ?*const T {
        switch source.nextBack() {
            null => null,
            some(entry) => some(entry.0),
        }
    }
    pub const func remaining() usize { source.remaining() }
}

pub class IntoBTreeIter<K: Movable, V: Movable> {
    var source: BTreeMap<K, V>;
    pub func init(value: BTreeMap<K, V>) : source(move(value)) {}
    pub func next() ?(K, V) { source.popFirst() }
    pub func nextBack() ?(K, V) { source.popLast() }
    pub const func remaining() usize { source.len() }
}

pub class BTreeMap<K: Movable, V: Movable> {
    #copy: disabled
    var root: ?*BTreeNode<K, V>;
    var length: usize;
    var less: func(*const K, *const K) bool;
    pub func init(less: func(*const K, *const K) bool)
        : root(null), length(0), less(less) {}

    pub static func withComparator(less: func(*const K, *const K) bool) Self {
        BTreeMap<K, V>(less)
    }

    pub const func len() usize { length }
    pub const func isEmpty() bool { length == 0 }

    func splitChild(parent: *BTreeNode<K, V>, index: usize) !void {
        var left = parent.childAt(index);
        var right = allocateBTreeNode<K, V>(left.isLeaf())!;

        for i in usize(0)..3 {
            var entry = left.removeEntry(4);
            right.insertEntry(i, move(entry));
        }
        var median = left.removeEntry(3);

        if !left.isLeaf() {
            for i in usize(0)..4 {
                var child = left.removeChild(4);
                right.insertChild(i, child);
            }
        }

        parent.insertEntry(index, move(median));
        parent.insertChild(index + 1, right);
    }

    func borrowFromPrevious(parent: *BTreeNode<K, V>, index: usize) void {
        var child = parent.childAt(index);
        var sibling = parent.childAt(index - 1);

        var separator = parent.removeEntry(index - 1);
        var replacement = sibling.removeEntry(sibling.entryCount() - 1);
        child.insertEntry(0, move(separator));
        parent.insertEntry(index - 1, move(replacement));

        if !sibling.isLeaf() {
            var branch = sibling.removeChild(sibling.childCount() - 1);
            child.insertChild(0, branch);
        }
    }

    func borrowFromNext(parent: *BTreeNode<K, V>, index: usize) void {
        var child = parent.childAt(index);
        var sibling = parent.childAt(index + 1);

        var separator = parent.removeEntry(index);
        var replacement = sibling.removeEntry(0);
        child.insertEntry(child.entryCount(), move(separator));
        parent.insertEntry(index, move(replacement));

        if !sibling.isLeaf() {
            var branch = sibling.removeChild(0);
            child.insertChild(child.childCount(), branch);
        }
    }

    func mergeChildren(parent: *BTreeNode<K, V>, index: usize) void {
        var left = parent.childAt(index);
        var right = parent.childAt(index + 1);
        var separator = parent.removeEntry(index);
        left.insertEntry(left.entryCount(), move(separator));

        while right.entryCount() > 0 {
            var entry = right.removeEntry(0);
            left.insertEntry(left.entryCount(), move(entry));
        }

        while right.childCount() > 0 {
            var branch = right.removeChild(0);
            left.insertChild(left.childCount(), branch);
        }

        var detached = parent.removeChild(index + 1);
        destroyBTreeNode<K, V>(detached);
    }

    func repairUnderflow(parent: *BTreeNode<K, V>, index: usize) void {
        if parent.childAt(index).entryCount() >= btreeMinimumDegree - 1 { return; }

        if index > 0 && parent.childAt(index - 1).entryCount() >= btreeMinimumDegree {
            borrowFromPrevious(parent, index);
        } else if index < parent.entryCount() &&
                  parent.childAt(index + 1).entryCount() >= btreeMinimumDegree {
            borrowFromNext(parent, index);
        } else if index < parent.entryCount() {
            mergeChildren(parent, index);
        } else {
            mergeChildren(parent, index - 1);
        }
    }

    func removeMinimum(node: *BTreeNode<K, V>) (K, V) {
        if node.isLeaf() { return node.removeEntry(0); }

        var removed = removeMinimum(node.childAt(0));
        repairUnderflow(node, 0);
        move(removed)
    }

    func removeMaximum(node: *BTreeNode<K, V>) (K, V) {
        if node.isLeaf() { return node.removeEntry(node.entryCount() - 1); }

        var index = node.childCount() - 1;
        var removed = removeMaximum(node.childAt(index));
        repairUnderflow(node, index);
        move(removed)
    }

    func removeFrom(node: *BTreeNode<K, V>, key: *const K) ?(K, V) {
        var index = btreeLowerIndex<K, V>(node, key, less);
        var found = false;
        if index < node.entryCount() {
            var existing = raw node.entryAt(index).0;
            found = !less(key, existing) && !less(existing, key);
        }

        if found {
            if node.isLeaf() { return some(node.removeEntry(index)); }

            var predecessor = removeMaximum(node.childAt(index));
            var removed = node.removeEntry(index);
            node.insertEntry(index, move(predecessor));
            repairUnderflow(node, index);
            return some(move(removed));
        }

        if node.isLeaf() { return null; }

        // Complete all comparisons before rebalancing can move a borrowed key.
        var removed = removeFrom(node.childAt(index), key);
        if removed != null { repairUnderflow(node, index); }
        move(removed)
    }

    func contractRoot() void {
        switch root {
            null => {},
            some(node) => {
                if node.entryCount() == 0 {
                    if node.isLeaf() {
                        root = null;
                        destroyBTreeNode<K, V>(node);
                    } else {
                        var child = node.removeChild(0);
                        root = some(child);
                        destroyBTreeNode<K, V>(node);
                    }
                }
            },
        }
    }

    const func minimumEntry(node: *BTreeNode<K, V>) *const (K, V) {
        var current = node;
        while !current.isLeaf() { current = current.childAt(0); }
        current.entryAt(0)
    }

    const func maximumEntry(node: *BTreeNode<K, V>) *const (K, V) {
        var current = node;
        while !current.isLeaf() { current = current.childAt(current.childCount() - 1); }
        current.entryAt(current.entryCount() - 1)
    }

    // Find a position while borrowing the incoming key. Root/child splits
    // allocate before mutating an existing node; the owned pair remains intact
    // until a destination is selected.
    func planInsertion(key: in K) !(*BTreeNode<K, V>, usize, bool) {
        var address = key.toRaw();
        switch root {
            null => { return (allocateBTreeNode<K, V>(true)!, 0, false); },
            some(currentRoot) => {
                if currentRoot.entryCount() == btreeMaximumEntries {
                    var newRoot = allocateBTreeNode<K, V>(false)!;
                    newRoot.insertChild(0, currentRoot);
                    splitChild(newRoot, 0) catch (reason) {
                        newRoot.removeChild(0);
                        destroyBTreeNode<K, V>(newRoot);
                        return reason;
                    };
                    root = some(newRoot);
                }
            },
        }

        var node = root.unwrap();
        for {
            var index = btreeLowerIndex<K, V>(node, address, less);
            if index < node.entryCount() {
                var existing = raw node.entryAt(index).0;
                if !less(address, existing) && !less(existing, address) {
                    return (node, index, true);
                }
            }
            if node.isLeaf() { return (node, index, false); }
            var child = node.childAt(index);
            if child.entryCount() == btreeMaximumEntries {
                splitChild(node, index)!;
                var promoted = raw node.entryAt(index).0;
                if !less(address, promoted) && !less(promoted, address) {
                    return (node, index, true);
                }
                if less(promoted, address) { index++; }
            }
            node = node.childAt(index);
        }
    }

    comptime if meta.isCopyable<(K, V)>() {
        func insertPair(entry: (K, V)) core.ResultOptional<V> {
            node, index, replacing := planInsertion(entry.0)!;
            if replacing {
                var previous = node.removeEntry(index);
                oldKey, oldValue := move(previous);
                node.insertEntry(index, move(entry));
                return some(move(oldValue));
            }
            node.insertEntry(index, move(entry));
            if root == null { root = some(node); }
            length++;
            null
        }
    } else {
        func insertPair(entry: move (K, V)) core.ResultOptional<V> {
            node, index, replacing := planInsertion(entry.0)!;
            if replacing {
                var previous = node.removeEntry(index);
                oldKey, oldValue := move(previous);
                node.insertEntry(index, move(entry));
                return some(move(oldValue));
            }
            node.insertEntry(index, move(entry));
            if root == null { root = some(node); }
            length++;
            null
        }
    }

    comptime if meta.isCopyable<K>() {
        comptime if meta.isCopyable<V>() {
            pub func insert(key: K, value: V) core.ResultOptional<V> {
                insertPair((move(key), move(value)))
            }
        } else {
            pub func insert(key: K, value: move V) core.ResultOptional<V> {
                insertPair((move(key), move(value)))
            }
        }
    } else {
        comptime if meta.isCopyable<V>() {
            pub func insert(key: move K, value: V) core.ResultOptional<V> {
                insertPair((move(key), move(value)))
            }
        } else {
            pub func insert(key: move K, value: move V) core.ResultOptional<V> {
                insertPair((move(key), move(value)))
            }
        }
    }

    pub const func get(query: in K) ?ref V from self {
        var key = query.toRaw();
        var current = root;
        while current != null {
            var node = current.unwrap();
            var index = btreeLowerIndex<K, V>(node, key, less);
            if index < node.entryCount() &&
               !less(key, raw node.entryAt(index).0) &&
               !less(raw node.entryAt(index).0, key) {
                return unsafe { __vqr_borrow_from_self(raw node.entryAt(index).1) };
            }
            if node.isLeaf() { return null; }
            current = some(node.childAt(index));
        }
        null
    }

    pub func getMut(query: in K) ?ref mut V from self {
        var key = query.toRaw();
        var current = root;
        while current != null {
            var node = current.unwrap();
            var index = btreeLowerIndex<K, V>(node, key, less);
            if index < node.entryCount() &&
               !less(key, raw node.entryAt(index).0) &&
               !less(raw node.entryAt(index).0, key) {
                return unsafe { __vqr_borrow_from_self(raw node.entryAtMut(index).1) };
            }
            if node.isLeaf() { return null; }
            current = some(node.childAt(index));
        }
        null
    }

    pub const func containsKey(key: in K) bool { get(key) != null }

    pub func removeEntry(key: in K) ?(K, V) {
        switch root {
            null => return null,
            some(node) => {
                var removed = removeFrom(node, key.toRaw());
                if removed != null { length--; }
                contractRoot();
                move(removed)
            },
        }
    }

    pub func remove(key: in K) ?V {
        switch removeEntry(key) {
            null => null,
            some(entry) => {
                oldKey, oldValue := move(entry);
                some(move(oldValue))
            },
        }
    }

    pub const func first() ?(*const K, *const V) {
        switch root {
            null => null,
            some(node) => {
                var entry = minimumEntry(node);
                some((raw entry.0, raw entry.1))
            },
        }
    }

    pub const func last() ?(*const K, *const V) {
        switch root {
            null => null,
            some(node) => {
                var entry = maximumEntry(node);
                some((raw entry.0, raw entry.1))
            },
        }
    }

    pub func popFirst() ?(K, V) {
        switch root {
            null => null,
            some(node) => {
                var entry = removeMinimum(node);
                length--;
                contractRoot();
                some(move(entry))
            },
        }
    }

    pub func popLast() ?(K, V) {
        switch root {
            null => null,
            some(node) => {
                var entry = removeMaximum(node);
                length--;
                contractRoot();
                some(move(entry))
            },
        }
    }

    pub const func lowerBound(key: *const K) ?*const K {
        var current = root;
        var candidate: ?*const K = null;
        while current != null {
            var node = current.unwrap();
            var index = btreeLowerIndex<K, V>(node, key, less);
            if index < node.entryCount() {
                candidate = some(raw node.entryAt(index).0);
            }
            if node.isLeaf() { break; }
            current = some(node.childAt(index));
        }
        candidate
    }

    pub const func upperBound(key: *const K) ?*const K {
        var current = root;
        var candidate: ?*const K = null;
        while current != null {
            var node = current.unwrap();
            var index = btreeLowerIndex<K, V>(node, key, less);
            if index < node.entryCount() &&
               !less(key, raw node.entryAt(index).0) &&
               !less(raw node.entryAt(index).0, key) {
                index++;
            }
            if index < node.entryCount() {
                candidate = some(raw node.entryAt(index).0);
            }
            if node.isLeaf() { break; }
            current = some(node.childAt(index));
        }
        candidate
    }

    pub const func iterRef() !BTreeIterRef<K, V> { BTreeIterRef<K, V>(root, length) }

    pub func iterMut() !BTreeIterMut<K, V> { BTreeIterMut<K, V>(root, length) }

    // Each non-null bound is inclusive at the start and exclusive at the end.
    pub const func range(lower: ?*const K, upper: ?*const K) BTreeRangeRef<K, V> {
        var empty = false;
        var stop: ?*const K = null;
        switch upper {
            some(limit) => {
                stop = lowerBound(limit);
                switch lower {
                    some(start) => { empty = !less(start, limit); },
                    null => {},
                }
            },
            null => {},
        }
        BTreeRangeRef<K, V>(root, lower, stop, less, empty)
    }

    pub static func intoIter(value: Self) IntoBTreeIter<K, V> {
        IntoBTreeIter<K, V>(move(value))
    }

    pub func clear() void {
        switch root {
            null => {},
            some(node) => {
                root = null;
                destroyBTreeNode<K, V>(node);
            },
        }
        length = 0;
    }

    pub func deinit() void { clear(); }
}

pub class BTreeSet<T: Movable> {
    #copy: disabled
    var values: BTreeMap<T, u8>;
    pub func init(less: func(*const T, *const T) bool)
        : values(BTreeMap<T, u8>(less)) {}

    pub static func withComparator(less: func(*const T, *const T) bool) Self {
        BTreeSet<T>(less)
    }

    pub const func len() usize { values.len() }
    pub const func isEmpty() bool { values.isEmpty() }
    pub const func contains(value: in T) bool { values.containsKey(value) }

    comptime if meta.isCopyable<T>() {
        pub func insert(value: T) !bool {
            switch values.insert(move(value), 0u8)! {
                null => true,
                some(_) => false,
            }
        }
    } else {
        pub func insert(value: move T) !bool {
            switch values.insert(move(value), 0u8)! {
                null => true,
                some(_) => false,
            }
        }
    }

    pub func remove(value: in T) bool {
        switch values.remove(value) {
            null => false,
            some(_) => true,
        }
    }

    pub func take(value: in T) ?T {
        switch values.removeEntry(value) {
            null => null,
            some(entry) => {
                key, ignored := move(entry);
                some(move(key))
            },
        }
    }

    pub const func first() ?*const T {
        switch values.first() {
            null => null,
            some(entry) => some(entry.0),
        }
    }

    pub const func last() ?*const T {
        switch values.last() {
            null => null,
            some(entry) => some(entry.0),
        }
    }

    pub func popFirst() ?T {
        switch values.popFirst() {
            null => null,
            some(entry) => {
                key, ignored := move(entry);
                some(move(key))
            },
        }
    }

    pub func popLast() ?T {
        switch values.popLast() {
            null => null,
            some(entry) => {
                key, ignored := move(entry);
                some(move(key))
            },
        }
    }

    pub const func lowerBound(value: *const T) ?*const T { values.lowerBound(value) }
    pub const func upperBound(value: *const T) ?*const T { values.upperBound(value) }
    pub const func iterRef() !BTreeSetIterRef<T> {
        BTreeSetIterRef<T>(values.iterRef()!)
    }
    pub func clear() void { values.clear(); }
    pub func deinit() void { values.clear(); }
}
