package coll
import (core, iter as iterator, mem)

pub class DequeIterRef<T: Movable> {
    var slots: []const mem.MaybeUninit<T>;
    var head: usize;
    var capacity: usize;
    var frontIndex: usize;
    var backIndex: usize;
    pub func init(slots: []const mem.MaybeUninit<T>, head: usize, length: usize, capacity: usize)
        : slots(slots), head(head), capacity(capacity), frontIndex(0), backIndex(length) {}

    pub func next() ?*const T {
        if frontIndex == backIndex { return null; }
        var slot = physical(frontIndex);
        frontIndex++;
        some(slots[slot].asConstPtr())
    }

    pub func nextBack() ?*const T {
        if frontIndex == backIndex { return null; }
        backIndex--;
        some(slots[physical(backIndex)].asConstPtr())
    }

    pub const func remaining() usize { backIndex - frontIndex }

    const func physical(index: usize) usize {
        if capacity == 0 { return 0; }
        var tail = capacity - head;
        if index >= tail { index - tail } else { head + index }
    }
}

pub class DequeIterMut<T: Movable> {
    var slots: []mem.MaybeUninit<T>;
    var head: usize;
    var capacity: usize;
    var frontIndex: usize;
    var backIndex: usize;
    pub func init(slots: []mem.MaybeUninit<T>, head: usize, length: usize, capacity: usize)
        : slots(slots), head(head), capacity(capacity), frontIndex(0), backIndex(length) {}

    pub func next() ?*T {
        if frontIndex == backIndex { return null; }
        var slot = physical(frontIndex);
        frontIndex++;
        some(slots[slot].asPtr())
    }

    pub func nextBack() ?*T {
        if frontIndex == backIndex { return null; }
        backIndex--;
        some(slots[physical(backIndex)].asPtr())
    }

    pub const func remaining() usize { backIndex - frontIndex }

    const func physical(index: usize) usize {
        if capacity == 0 { return 0; }
        var tail = capacity - head;
        if index >= tail { index - tail } else { head + index }
    }
}

pub class DequeIter<T: Movable + Copyable> {
    var slots: []const mem.MaybeUninit<T>;
    var head: usize;
    var capacity: usize;
    var frontIndex: usize;
    var backIndex: usize;
    pub func init(slots: []const mem.MaybeUninit<T>, head: usize, length: usize, capacity: usize)
        : slots(slots), head(head), capacity(capacity), frontIndex(0), backIndex(length) {}

    pub func next() ?T {
        if frontIndex == backIndex { return null; }
        var slot = physical(frontIndex);
        frontIndex++;
        some(*slots[slot].asConstPtr())
    }

    pub func nextBack() ?T {
        if frontIndex == backIndex { return null; }
        backIndex--;
        some(*slots[physical(backIndex)].asConstPtr())
    }

    pub const func remaining() usize { backIndex - frontIndex }

    const func physical(index: usize) usize {
        if capacity == 0 { return 0; }
        var tail = capacity - head;
        if index >= tail { index - tail } else { head + index }
    }
}

pub class VecDeque<T: Movable> {
    #copy: disabled
    var slots: Vec<mem.MaybeUninit<T>>;
    var head: usize;
    var length: usize;
    var allocator: ?mem.AllocatorRef;
    pub func init() : slots(Vec<mem.MaybeUninit<T>>()), head(0), length(0), allocator(null) {}

    pub static func withAllocator(allocator: mem.AllocatorRef) Self {
        var out = VecDeque<T>();
        out.allocator = some(allocator);
        out.slots = Vec<mem.MaybeUninit<T>>.withAllocator(allocator);
        move(out)
    }

    pub static func withCapacity(n: usize) !Self {
        var out = VecDeque<T>();
        out.reserve(n)!;
        move(out)
    }

    pub static func withCapacityAndAllocator(n: usize, allocator: mem.AllocatorRef) !Self {
        var out = VecDeque<T>.withAllocator(allocator);
        out.reserve(n)!;
        move(out)
    }

    pub const func len() usize { length }
    pub const func capacity() usize { slots.len() }
    pub const func isEmpty() bool { length == 0 }

    pub func reserve(minCapacity: usize) !void {
        if minCapacity <= capacity() { return; }
        reallocate(minCapacity)
    }

    pub func reserveAdditional(extra: usize) !void {
        if extra > ~usize(0) - length { return CapacityError.Overflow; }
        reserve(length + extra)
    }

    pub func shrinkToFit() !void {
        if length < capacity() { reallocate(length)!; }
    }

    const func physical(index: usize) usize {
        var cap = capacity();
        if cap == 0 { return 0; }
        var tail = cap - head;
        if index >= tail { index - tail } else { head + index }
    }

    func reallocate(newCapacity: usize) !void {
        var next = Vec<mem.MaybeUninit<T>>();
        switch allocator {
            null => {},
            some(owner) => { next = Vec<mem.MaybeUninit<T>>.withAllocator(owner); },
        }
        next.reserve(newCapacity)!;
        for i in usize(0)..newCapacity {
            next.push(mem.MaybeUninit<T>.uninit())!;
        }
        for i in usize(0)..length {
            var source = physical(i);
            var value = unsafe { slots.getMutPtr(source).unwrap().assumeInit() };
            unsafe { next.getMutPtr(i).unwrap().write(move(value)); }
        }
        core.swap<Vec<mem.MaybeUninit<T>>>(raw slots, raw next);
        head = 0;
    }

    func ensureRoomForOne() !void {
        if length < capacity() { return; }
        if length == ~usize(0) { return CapacityError.Overflow; }
        reserve(nextSequenceCapacity(capacity()))
    }

    pub func pushBack(value: T) !void {
        ensureRoomForOne()!;
        unsafe { slots.getMutPtr(physical(length)).unwrap().write(move(value)); }
        length++;
    }

    pub func pushFront(value: T) !void {
        ensureRoomForOne()!;
        if head == 0 { head = capacity() - 1; } else { head--; }
        unsafe { slots.getMutPtr(head).unwrap().write(move(value)); }
        length++;
    }

    pub func pushBackPreserving(value: T) PushResult<T> {
        ensureRoomForOne() catch (reason) {
            return PushResult<T>.Failed(reason, move(value));
        };
        unsafe { slots.getMutPtr(physical(length)).unwrap().write(move(value)); }
        length++;
        PushResult<T>.Stored()
    }

    pub func pushFrontPreserving(value: T) PushResult<T> {
        ensureRoomForOne() catch (reason) {
            return PushResult<T>.Failed(reason, move(value));
        };
        if head == 0 { head = capacity() - 1; } else { head--; }
        unsafe { slots.getMutPtr(head).unwrap().write(move(value)); }
        length++;
        PushResult<T>.Stored()
    }

    pub func popFront() ?T {
        if length == 0 { return null; }
        var value = unsafe { slots.getMutPtr(head).unwrap().assumeInit() };
        length--;
        if length == 0 { head = 0; }
        else if head + 1 == capacity() { head = 0; }
        else { head++; }
        some(move(value))
    }

    pub func popBack() ?T {
        if length == 0 { return null; }
        var index = physical(length - 1);
        var value = unsafe { slots.getMutPtr(index).unwrap().assumeInit() };
        length--;
        if length == 0 { head = 0; }
        some(move(value))
    }

    pub func get(index: usize) ?*const T {
        if index >= length { return null; }
        some(slots.getPtr(physical(index)).unwrap().asConstPtr())
    }

    pub func getMut(index: usize) ?*T {
        if index >= length { return null; }
        some(slots.getMutPtr(physical(index)).unwrap().asPtr())
    }

    pub const func front() ?*const T { get(0) }
    pub func frontMut() ?*T { getMut(0) }
    pub const func back() ?*const T { if length == 0 { null } else { get(length - 1) } }
    pub func backMut() ?*T { if length == 0 { null } else { getMut(length - 1) } }

    pub func insert(index: usize, value: T) !void {
        if index > length { return CapacityError.IndexOutOfBounds; }
        ensureRoomForOne()!;
        for i := length; i > index; i-- {
            var source = physical(i - 1);
            var target = physical(i);
            var item = unsafe { slots.getMutPtr(source).unwrap().assumeInit() };
            unsafe { slots.getMutPtr(target).unwrap().write(move(item)); }
        }
        unsafe { slots.getMutPtr(physical(index)).unwrap().write(move(value)); }
        length++;
    }

    pub func remove(index: usize) ?T {
        if index >= length { return null; }
        var value = unsafe { slots.getMutPtr(physical(index)).unwrap().assumeInit() };
        for i := index; i + 1 < length; i++ {
            var source = physical(i + 1);
            var target = physical(i);
            var item = unsafe { slots.getMutPtr(source).unwrap().assumeInit() };
            unsafe { slots.getMutPtr(target).unwrap().write(move(item)); }
        }
        length--;
        if length == 0 { head = 0; }
        some(move(value))
    }

    pub func swapRemove(index: usize) ?T {
        if index >= length { return null; }
        swap(index, length - 1);
        popBack()
    }

    pub func replace(index: usize, value: T) ?T {
        if index >= length { return null; }
        var slot = slots.getMutPtr(physical(index)).unwrap();
        var previous = unsafe { slot.assumeInit() };
        unsafe { slot.write(move(value)); }
        some(move(previous))
    }

    pub func retain<F: Movable>(predicate: F) void {
        var kept: usize = 0;
        for i in usize(0)..length {
            var slot = slots.getMutPtr(physical(i)).unwrap();
            if predicate(slot.asConstPtr()) {
                if kept != i {
                    var item = unsafe { slot.assumeInit() };
                    unsafe { slots.getMutPtr(physical(kept)).unwrap().write(move(item)); }
                }
                kept++;
            } else {
                unsafe { slot.assumeInitDrop(); }
            }
        }
        length = kept;
        if length == 0 { head = 0; }
    }

    pub func extend<I: Movable>(values: I) !void {
        for item in move(values) { pushBack(move(item))!; }
    }

    pub func append(other: *Self) !void {
        if self == other || other.length == 0 { return; }
        reserveAdditional(other.length)!;
        for i in usize(0)..other.length {
            var item = other.popFront().unwrap();
            pushBack(move(item))!;
        }
    }

    pub func splitOff(index: usize) !Self {
        if index > length { return CapacityError.IndexOutOfBounds; }
        var count = length - index;
        var result = switch allocator {
            null => VecDeque<T>.withCapacity(count)!,
            some(owner) => VecDeque<T>.withCapacityAndAllocator(count, owner)!,
        };
        for i in usize(0)..count {
            var item = popBack().unwrap();
            result.pushFront(move(item))!;
        }
        move(result)
    }

    // Requires T: Copyable.
    pub const func clone() !Self {
        var result = switch allocator {
            null => VecDeque<T>.withCapacity(length)!,
            some(owner) => VecDeque<T>.withCapacityAndAllocator(length, owner)!,
        };
        for item in iterRef() { result.pushBack(*item)!; }
        move(result)
    }

    pub func swap(a: usize, b: usize) void {
        core.swap<T>(getMut(a).unwrap(), getMut(b).unwrap());
    }

    pub func reverse() void {
        for i in usize(0)..(length / 2) { swap(i, length - i - 1); }
    }

    pub const func iter() DequeIter<T> { DequeIter<T>(slots.asConstSlice(), head, length, capacity()) }
    pub const func iterRef() DequeIterRef<T> {
        DequeIterRef<T>(slots.asConstSlice(), head, length, capacity())
    }
    pub func iterMut() DequeIterMut<T> { DequeIterMut<T>(slots.asSlice(), head, length, capacity()) }
    pub const func reverseIter() iterator.RevIter<DequeIterRef<T>, *const T> {
        iterator.rev<DequeIterRef<T>, *const T>(iterRef())
    }

    pub static func intoIter(value: Self) IntoDequeIter<T> { IntoDequeIter<T>(move(value)) }

    pub func truncate(n: usize) void {
        while length > n {
            var value = popBack().unwrap();
        }
        if length == 0 { head = 0; }
    }

    pub func clear() void {
        truncate(0);
        head = 0;
    }

    pub func deinit() void { clear(); }
}

pub class IntoDequeIter<T: Movable> {
    var source: VecDeque<T>;
    pub func init(value: VecDeque<T>) : source(move(value)) {}
    pub func next() ?T { source.popFront() }
    pub func nextBack() ?T { source.popBack() }
    pub const func remaining() usize { source.len() }
}

pub class FixedDeque<T: Movable, comptime N: usize> {
    #copy: disabled
    var slots: FixedVec<mem.MaybeUninit<T>, N>;
    var head: usize;
    var length: usize;
    pub func init() : slots(FixedVec<mem.MaybeUninit<T>, N>()), head(0), length(0) {
        for i in usize(0)..N {
            switch slots.push(mem.MaybeUninit<T>.uninit()) {
                PushResult.Stored => {},
                else => panic("FixedDeque storage invariant"),
            }
        }
    }

    pub const func len() usize { length }
    pub const func capacity() usize { N }
    pub const func isEmpty() bool { length == 0 }

    func address(index: usize) *mem.MaybeUninit<T> { slots.getMut(index).unwrap() }

    const func physical(index: usize) usize {
        if N == 0 { return 0; }
        var tail = N - head;
        if index >= tail { index - tail } else { head + index }
    }

    pub func pushBack(value: T) PushResult<T> {
        if length == N { return PushResult<T>.Full(move(value)); }
        unsafe { address(physical(length)).write(move(value)); }
        length++;
        PushResult<T>.Stored()
    }

    pub func pushFront(value: T) PushResult<T> {
        if length == N { return PushResult<T>.Full(move(value)); }
        if head == 0 { head = N - 1; } else { head--; }
        unsafe { address(head).write(move(value)); }
        length++;
        PushResult<T>.Stored()
    }

    pub func popFront() ?T {
        if length == 0 { return null; }
        var value = unsafe { address(head).assumeInit() };
        length--;
        if length == 0 { head = 0; }
        else if head + 1 == N { head = 0; }
        else { head++; }
        some(move(value))
    }

    pub func popBack() ?T {
        if length == 0 { return null; }
        var value = unsafe { address(physical(length - 1)).assumeInit() };
        length--;
        if length == 0 { head = 0; }
        some(move(value))
    }

    pub func get(index: usize) ?*const T {
        if index >= length { return null; }
        some(address(physical(index)).asConstPtr())
    }

    pub func getMut(index: usize) ?*T {
        if index >= length { return null; }
        some(address(physical(index)).asPtr())
    }

    pub const func front() ?*const T { get(0) }
    pub func frontMut() ?*T { getMut(0) }
    pub const func back() ?*const T { if length == 0 { null } else { get(length - 1) } }
    pub func backMut() ?*T { if length == 0 { null } else { getMut(length - 1) } }

    pub func insert(index: usize, value: T) PushResult<T> {
        if index > length {
            return PushResult<T>.Failed(CapacityError.IndexOutOfBounds, move(value));
        }
        if length == N { return PushResult<T>.Full(move(value)); }
        for i := length; i > index; i-- {
            var item = unsafe { address(physical(i - 1)).assumeInit() };
            unsafe { address(physical(i)).write(move(item)); }
        }
        unsafe { address(physical(index)).write(move(value)); }
        length++;
        PushResult<T>.Stored()
    }

    pub func remove(index: usize) ?T {
        if index >= length { return null; }
        var value = unsafe { address(physical(index)).assumeInit() };
        for i := index; i + 1 < length; i++ {
            var item = unsafe { address(physical(i + 1)).assumeInit() };
            unsafe { address(physical(i)).write(move(item)); }
        }
        length--;
        if length == 0 { head = 0; }
        some(move(value))
    }

    pub func replace(index: usize, value: T) ?T {
        if index >= length { return null; }
        var slot = address(physical(index));
        var previous = unsafe { slot.assumeInit() };
        unsafe { slot.write(move(value)); }
        some(move(previous))
    }

    pub func retain<F: Movable>(predicate: F) void {
        var kept: usize = 0;
        for i in usize(0)..length {
            var slot = address(physical(i));
            if predicate(slot.asConstPtr()) {
                if kept != i {
                    var item = unsafe { slot.assumeInit() };
                    unsafe { address(physical(kept)).write(move(item)); }
                }
                kept++;
            } else {
                unsafe { slot.assumeInitDrop(); }
            }
        }
        length = kept;
        if length == 0 { head = 0; }
    }

    pub func swap(a: usize, b: usize) void {
        core.swap<T>(getMut(a).unwrap(), getMut(b).unwrap());
    }

    pub func reverse() void {
        for i in usize(0)..(length / 2) { swap(i, length - i - 1); }
    }

    pub const func iter() DequeIter<T> {
        DequeIter<T>(slots.asConstSlice(), head, length, N)
    }
    pub const func iterRef() DequeIterRef<T> {
        DequeIterRef<T>(slots.asConstSlice(), head, length, N)
    }
    pub func iterMut() DequeIterMut<T> { DequeIterMut<T>(slots.asSlice(), head, length, N) }
    pub const func reverseIter() iterator.RevIter<DequeIterRef<T>, *const T> {
        iterator.rev<DequeIterRef<T>, *const T>(iterRef())
    }

    pub static func intoIter(value: Self) IntoFixedDequeIter<T, N> {
        IntoFixedDequeIter<T, N>(move(value))
    }

    pub func truncate(n: usize) void {
        while length > n {
            var value = popBack().unwrap();
        }
    }

    pub func extend<I: Movable>(values: I) !void {
        for item in move(values) {
            switch pushBack(move(item)) {
                PushResult.Stored => {},
                PushResult.Full(_) => return CapacityError.Overflow,
                PushResult.Failed(reason, _) => return reason,
            }
        }
    }

    pub func append(other: *Self) !void {
        if self == other || other.length == 0 { return; }
        if other.length > N - length { return CapacityError.Overflow; }
        while other.length > 0 {
            var item = other.popFront().unwrap();
            switch pushBack(move(item)) {
                PushResult.Stored => {},
                else => panic("FixedDeque append capacity invariant"),
            }
        }
    }

    pub func splitOff(index: usize) !Self {
        if index > length { return CapacityError.IndexOutOfBounds; }
        var result = FixedDeque<T, N>();
        var count = length - index;
        for i in usize(0)..count {
            var item = popBack().unwrap();
            switch result.pushFront(move(item)) {
                PushResult.Stored => {},
                else => panic("FixedDeque split capacity invariant"),
            }
        }
        move(result)
    }

    // Requires T: Copyable.
    pub const func clone() Self {
        var result = FixedDeque<T, N>();
        for item in iterRef() {
            switch result.pushBack(*item) {
                PushResult.Stored => {},
                else => panic("FixedDeque clone capacity invariant"),
            }
        }
        move(result)
    }

    pub func clear() void {
        truncate(0);
        head = 0;
    }

    pub func deinit() void { clear(); }
}

pub class IntoFixedDequeIter<T: Movable, comptime N: usize> {
    var source: FixedDeque<T, N>;
    pub func init(value: FixedDeque<T, N>) : source(move(value)) {}
    pub func next() ?T { source.popFront() }
    pub func nextBack() ?T { source.popBack() }
    pub const func remaining() usize { source.len() }
}
