package coll
import (core, iter as iterator, mem, meta)

pub enum PushResult<T: Movable> {
    Stored,
    Full(T),
    Failed(ErrorId, T),
}

pub class FixedVec<T: Movable, comptime N: usize> {
    var slots: mem.MaybeUninit<[N]T>;
    var length: usize;
    pub func init() : slots(mem.MaybeUninit<[N]T>.uninit()), length(0) {}
    pub const func len() usize { length }
    pub const func capacity() usize { N }
    pub const func isEmpty() bool { length == 0 }

    pub func asSlice() []T { (*slots.asPtr())[0..length] }
    pub const func asConstSlice() []const T { (*slots.asConstPtr())[0..length] }

    pub const func get(index: usize) ?*const T {
        if index >= length { return null; }
        some(raw (*slots.asConstPtr())[index])
    }

    pub func getMut(index: usize) ?*T {
        if index >= length { return null; }
        some(raw (*slots.asPtr())[index])
    }

    pub const func first() ?*const T { get(0) }
    pub func firstMut() ?*T { getMut(0) }
    pub const func last() ?*const T { if length == 0 { null } else { get(length - 1) } }
    pub func lastMut() ?*T { if length == 0 { null } else { getMut(length - 1) } }

    comptime if meta.isCopyable<T>() {
        pub func push(value: T) PushResult<T> { tryPush(move(value)) }
        pub func tryPush(value: T) PushResult<T> {
            if length == N { return PushResult<T>.Full(move(value)); }
            unsafe { __vqr_slot_write<T>(address(length), move(value)); }
            length++;
            PushResult<T>.Stored()
        }
    } else {
        pub func push(value: move T) PushResult<T> { tryPush(move(value)) }
        pub func tryPush(value: move T) PushResult<T> {
            if length == N { return PushResult<T>.Full(move(value)); }
            unsafe { __vqr_slot_write<T>(address(length), move(value)); }
            length++;
            PushResult<T>.Stored()
        }
    }

    pub func pop() ?T {
        if length == 0 { return null; }
        length--;
        unsafe { some(__vqr_slot_take<T>(address(length))) }
    }

    comptime if meta.isCopyable<T>() {
        pub func insert(index: usize, value: T) PushResult<T> {
            if index > length { return PushResult<T>.Failed(CapacityError.IndexOutOfBounds, move(value)); }
            if length == N { return PushResult<T>.Full(move(value)); }
            unsafe {
                for i := length; i > index; i-- { transfer(i - 1, i); }
                __vqr_slot_write<T>(address(index), move(value));
            }
            length++;
            PushResult<T>.Stored()
        }
    } else {
        pub func insert(index: usize, value: move T) PushResult<T> {
            if index > length { return PushResult<T>.Failed(CapacityError.IndexOutOfBounds, move(value)); }
            if length == N { return PushResult<T>.Full(move(value)); }
            unsafe {
                for i := length; i > index; i-- { transfer(i - 1, i); }
                __vqr_slot_write<T>(address(index), move(value));
            }
            length++;
            PushResult<T>.Stored()
        }
    }

    pub func remove(index: usize) ?T {
        if index >= length { return null; }
        var value = unsafe { __vqr_slot_take<T>(address(index)) };
        length--;
        for i := index; i < length; i++ { transfer(i + 1, i); }
        some(move(value))
    }

    pub func swapRemove(index: usize) ?T {
        if index >= length { return null; }
        swap(index, length - 1);
        pop()
    }

    comptime if meta.isCopyable<T>() {
        pub func replace(index: usize, value: T) ?T {
            if index >= length { return null; }
            unsafe {
                var slot = address(index);
                var previous = __vqr_slot_take<T>(slot);
                __vqr_slot_write<T>(slot, move(value));
                some(move(previous))
            }
        }

        pub func replacePreserving(index: usize, value: T) ReplaceResult<T> {
            if index >= length { return ReplaceResult<T>.InvalidIndex(move(value)); }
            var previous = replace(index, move(value)).unwrap();
            ReplaceResult<T>.Replaced(move(previous))
        }
    } else {
        pub func replace(index: usize, value: move T) ?T {
            if index >= length { return null; }
            unsafe {
                var slot = address(index);
                var previous = __vqr_slot_take<T>(slot);
                __vqr_slot_write<T>(slot, move(value));
                some(move(previous))
            }
        }

        pub func replacePreserving(index: usize, value: move T) ReplaceResult<T> {
            if index >= length { return ReplaceResult<T>.InvalidIndex(move(value)); }
            var previous = replace(index, move(value)).unwrap();
            ReplaceResult<T>.Replaced(move(previous))
        }
    }

    pub func truncate(n: usize) void {
        while length > n {
            length--;
            unsafe { __vqr_slot_drop<T>(address(length)); }
        }
    }

    pub func clear() void { truncate(0); }

    pub func extend<I: Movable>(values: I) !void {
        for item in move(values) {
            switch tryPush(move(item)) {
                PushResult.Stored => {},
                PushResult.Full(_) => return CapacityError.Overflow,
                PushResult.Failed(reason, _) => return reason,
            }
        }
    }

    pub func append(other: *Self) !void {
        if self == other || other.length == 0 { return; }
        if other.length > N - length { return CapacityError.Overflow; }
        var base = length;
        while other.length > 0 {
            var item = other.pop().unwrap();
            switch insert(base, move(item)) {
                PushResult.Stored => {},
                else => panic("FixedVec append capacity invariant"),
            }
        }
    }

    pub func splitOff(index: usize) !Self {
        if index > length { return CapacityError.IndexOutOfBounds; }
        var result = FixedVec<T, N>();
        var count = length - index;
        for i in usize(0)..count {
            var item = remove(index).unwrap();
            switch result.push(move(item)) {
                PushResult.Stored => {},
                else => panic("FixedVec split capacity invariant"),
            }
        }
        move(result)
    }

    pub func retain<F: Movable>(predicate: F) void {
        var kept: usize = 0;
        for i in usize(0)..length {
            if predicate(get(i).unwrap()) {
                if kept != i { transfer(i, kept); }
                kept++;
            } else {
                unsafe { __vqr_slot_drop<T>(address(i)); }
            }
        }
        length = kept;
    }

    pub func swap(a: usize, b: usize) void {
        core.swap<T>(getMut(a).unwrap(), getMut(b).unwrap());
    }

    pub func reverse() void {
        for i in usize(0)..(length / 2) { swap(i, length - i - 1); }
    }

    // Requires T: Copyable.
    pub const func clone() Self {
        var result = FixedVec<T, N>();
        for item in iterRef() {
            switch result.push(*item) {
                PushResult.Stored => {},
                else => panic("FixedVec clone capacity invariant"),
            }
        }
        move(result)
    }

    pub const func iter() iterator.SliceIter<T> { iterator.SliceIter<T>(asConstSlice()) }
    pub const func iterRef() iterator.SliceIterRef<T> { iterator.SliceIterRef<T>(asConstSlice()) }
    pub func iterMut() iterator.SliceIterMut<T> { iterator.SliceIterMut<T>(asSlice()) }
    pub const func reverseIter() iterator.RevIter<iterator.SliceIterRef<T>, *const T> {
        iterator.rev<iterator.SliceIterRef<T>, *const T>(iterRef())
    }

    pub static func intoIter(value: move Self) IntoFixedVecIter<T, N> {
        IntoFixedVecIter<T, N>(move(value))
    }

    pub func deinit() void { clear(); }

    func address(index: usize) *T { raw (*slots.asPtr())[index] }

    func transfer(from: usize, to: usize) void {
        unsafe { __vqr_slot_write<T>(address(to), __vqr_slot_take<T>(address(from))); }
    }
}

pub class IntoFixedVecIter<T: Movable, comptime N: usize> {
    var source: FixedVec<T, N>;
    pub func init(values: move FixedVec<T, N>) : source(move(values)) {}
    pub func next() ?T { source.remove(0) }
    pub func nextBack() ?T { source.pop() }
    pub const func remaining() usize { source.len() }
}
