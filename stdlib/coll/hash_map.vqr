package coll
import (core, mem, hash as hashing)

pub enum InsertResult<K: Movable, V: Movable> {
    Inserted,
    Replaced(V),
    Failed(ErrorId, K, V),
}

enum BucketState { Empty, Tombstone, Occupied }

class HashBucket<K: Movable, V: Movable> {
    var state: BucketState;
    var key: mem.MaybeUninit<K>;
    var value: mem.MaybeUninit<V>;
    var hashCode: usize;
    pub func init()
        : state(BucketState.Empty),
          key(mem.MaybeUninit<K>.uninit()),
          value(mem.MaybeUninit<V>.uninit()),
          hashCode(0) {}

    pub const func isEmpty() bool { state == BucketState.Empty }
    pub const func isTombstone() bool { state == BucketState.Tombstone }
    pub const func isOccupied() bool { state == BucketState.Occupied }
    pub const func storedHash() usize { hashCode }
    pub const func keyRef() *const K { key.asConstPtr() }
    pub const func valueRef() *const V { value.asConstPtr() }
    pub func valueMut() *V { value.asPtr() }

    pub const func matches(
        hash: usize, needle: *const K,
        equals: func(*const K, *const K) bool
    ) bool {
        state == BucketState.Occupied && hashCode == hash && equals(key.asConstPtr(), needle)
    }

    pub func write(hash: usize, newKey: K, newValue: V) void {
        if state == BucketState.Occupied { panic("writing an occupied hash bucket"); }
        unsafe {
            key.write(move(newKey));
            value.write(move(newValue));
        }
        hashCode = hash;
        state = BucketState.Occupied;
    }

    pub func take() (K, V) {
        if state != BucketState.Occupied { panic("taking an empty hash bucket"); }
        state = BucketState.Tombstone;
        var oldKey = unsafe { key.assumeInit() };
        var oldValue = unsafe { value.assumeInit() };
        (move(oldKey), move(oldValue))
    }

    pub func tombstoneEntry() void {
        if state != BucketState.Occupied { return; }
        state = BucketState.Tombstone;
        unsafe {
            key.assumeInitDrop();
            value.assumeInitDrop();
        }
    }

    pub func clearEntry() void {
        if state == BucketState.Occupied {
            unsafe {
                key.assumeInitDrop();
                value.assumeInitDrop();
            }
        }
        state = BucketState.Empty;
        hashCode = 0;
    }

    pub func deinit() void { clearEntry(); }
}

pub class MapIterRef<K: Movable, V: Movable> {
    var buckets: []const HashBucket<K, V>;
    var frontIndex: usize;
    var backIndex: usize;
    var count: usize;
    var snapshot: ?IteratorSnapshot<(*const K, *const V)>;
    pub func init(buckets: []const HashBucket<K, V>, count: usize)
        : buckets(buckets), frontIndex(0), backIndex(buckets.len()), count(count), snapshot(null) {}

    pub func init(items: Vec<(*const K, *const V)>, count: usize)
        : buckets(unsafe { __vqr_const_slice<HashBucket<K, V>>(null, 0) }),
          frontIndex(0), backIndex(0), count(0),
          snapshot(some(IteratorSnapshot<(*const K, *const V)>(move(items), count))) {}
    pub func next() ?(*const K, *const V) {
        switch __vqr_optional_pointer(&snapshot) {
            some(saved) => return saved.take(false),
            null => {},
        }
        if count == 0 { return null; }
        for frontIndex < backIndex {
            var bucket = &buckets[frontIndex];
            frontIndex++;
            if bucket.isOccupied() {
                count--;
                return some((bucket.keyRef(), bucket.valueRef()));
            }
        }
        null
    }

    pub func nextBack() ?(*const K, *const V) {
        switch __vqr_optional_pointer(&snapshot) {
            some(saved) => return saved.take(true),
            null => {},
        }
        if count == 0 { return null; }
        for frontIndex < backIndex {
            backIndex--;
            var bucket = &buckets[backIndex];
            if bucket.isOccupied() {
                count--;
                return some((bucket.keyRef(), bucket.valueRef()));
            }
        }
        null
    }

    pub const func remaining() usize {
        switch __vqr_optional_pointer(&snapshot) {
            some(saved) => saved.remaining(),
            null => count,
        }
    }
}

pub class Keys<K: Movable, V: Movable> {
    var source: MapIterRef<K, V>;
    pub func init(source: MapIterRef<K, V>) : source(move(source)) {}
    pub func next() ?*const K {
        switch source.next() { some(entry) => some(entry.0), null => null, }
    }
    pub func nextBack() ?*const K {
        switch source.nextBack() { some(entry) => some(entry.0), null => null, }
    }
    pub const func remaining() usize { source.remaining() }
}

pub class Values<K: Movable, V: Movable> {
    var source: MapIterRef<K, V>;
    pub func init(source: MapIterRef<K, V>) : source(move(source)) {}
    pub func next() ?*const V {
        switch source.next() { some(entry) => some(entry.1), null => null, }
    }
    pub func nextBack() ?*const V {
        switch source.nextBack() { some(entry) => some(entry.1), null => null, }
    }
    pub const func remaining() usize { source.remaining() }
}

func hashTableCapacity(entries: usize) !usize {
    if entries == 0 { return 0; }
    var capacity: usize = 8;
    for entries > capacity - capacity / 8 {
        if capacity > ~usize(0) / 2 { return CapacityError.Overflow; }
        capacity *= 2;
    }
    capacity
}

pub class HashMap<K: Movable, V: Movable> {
    #copy: disabled
    var buckets: Vec<HashBucket<K, V>>;
    var length: usize;
    var tombstones: usize;
    var seed: u32;
    var allocator: ?mem.AllocatorRef;
    var hashFunction: ?func(*const K, u32) usize;
    var keyed: ?(hashing.HashSeed, func(*const K, *hashing.Hasher) void);
    var equalsFunction: func(*const K, *const K) bool;
    pub func init(
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool
    ) : buckets(Vec<HashBucket<K, V>>()), length(0), tombstones(0), seed(0),
        allocator(null), hashFunction(some(hashFunction)), keyed(null), equalsFunction(equalsFunction) {}

    pub func init(
        seed: hashing.HashSeed,
        feed: func(*const K, *hashing.Hasher) void,
        equalsFunction: func(*const K, *const K) bool
    ) : buckets(Vec<HashBucket<K, V>>()), length(0), tombstones(0), seed(0),
        allocator(null), hashFunction(null), keyed(some((seed, feed))), equalsFunction(equalsFunction) {}

    pub static func withSecureHasher(
        feed: func(*const K, *hashing.Hasher) void,
        equalsFunction: func(*const K, *const K) bool
    ) !Self {
        HashMap<K, V>(hashing.processSeed()!, feed, equalsFunction)
    }

    pub static func withHasher(
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool
    ) Self {
        HashMap<K, V>(hashFunction, equalsFunction)
    }

    pub static func withSeed(
        seed: u32,
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool
    ) Self {
        var result = HashMap<K, V>.withHasher(hashFunction, equalsFunction);
        result.seed = seed;
        move(result)
    }

    pub static func withCapacity(
        n: usize,
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool
    ) !Self {
        var result = HashMap<K, V>.withHasher(hashFunction, equalsFunction);
        result.reserve(n)!;
        move(result)
    }

    pub static func withCapacityAndSeed(
        n: usize, seed: u32,
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool
    ) !Self {
        var result = HashMap<K, V>.withSeed(seed, hashFunction, equalsFunction);
        result.reserve(n)!;
        move(result)
    }

    pub static func withAllocator(
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool,
        allocator: mem.AllocatorRef
    ) Self {
        var result = HashMap<K, V>.withHasher(hashFunction, equalsFunction);
        result.allocator = some(allocator);
        result.buckets = Vec<HashBucket<K, V>>.withAllocator(allocator);
        move(result)
    }

    pub static func withSeedAndAllocator(
        seed: u32,
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool,
        allocator: mem.AllocatorRef
    ) Self {
        var result = HashMap<K, V>.withAllocator(hashFunction, equalsFunction, allocator);
        result.seed = seed;
        move(result)
    }

    pub static func withCapacityAndAllocator(
        n: usize,
        hashFunction: func(*const K, u32) usize,
        equalsFunction: func(*const K, *const K) bool,
        allocator: mem.AllocatorRef
    ) !Self {
        var result = HashMap<K, V>.withAllocator(hashFunction, equalsFunction, allocator);
        result.reserve(n)!;
        move(result)
    }

    pub const func len() usize { length }
    pub const func capacity() usize { buckets.len() }
    pub const func isEmpty() bool { length == 0 }

    const func hashKey(key: *const K) usize {
        switch keyed {
            some(config) => {
                var hasher = hashing.SipHasher(config.0);
                var feed = config.1;
                feed(key, &hasher);
                hasher.finish()
            },
            null => {
                var regular = hashFunction.unwrap();
                regular(key, seed)
            },
        }
    }

    const func probe(key: *const K, hash: usize) (?usize, ?usize) {
        var cap = buckets.len();
        if cap == 0 { return (null, null); }
        var index = hash % cap;
        var firstTombstone: ?usize = null;
        for examined in usize(0)..cap {
            var bucket = buckets.getPtr(index).unwrap();
            if bucket.isEmpty() { return (null, some(firstTombstone ?? index)); }
            if bucket.matches(hash, key, equalsFunction) { return (some(index), null); }
            if bucket.isTombstone() && firstTombstone == null { firstTombstone = some(index); }
            index++;
            if index == cap { index = 0; }
        }
        (null, firstTombstone)
    }

    const func findIndex(key: *const K, hash: usize) ?usize { probe(key, hash).0 }

    const func insertionIndex(hash: usize) usize {
        var cap = buckets.len();
        var index = hash % cap;
        var firstTombstone: ?usize = null;
        for examined := usize(0); examined < cap; examined++ {
            var bucket = buckets.getPtr(index).unwrap();
            if bucket.isEmpty() { return firstTombstone ?? index; }
            if bucket.isTombstone() && firstTombstone == null {
                firstTombstone = some(index);
            }
            index++;
            if index == cap { index = 0; }
        }
        firstTombstone.unwrap()
    }

    func insertKnownHash(hash: usize, key: K, value: V) *V {
        insertAt(insertionIndex(hash), hash, move(key), move(value))
    }

    func insertAt(index: usize, hash: usize, key: K, value: V) *V {
        var bucket = buckets.getMutPtr(index).unwrap();
        if bucket.isTombstone() { tombstones--; }
        bucket.write(hash, move(key), move(value));
        length++;
        bucket.valueMut()
    }

    func rehash(newCapacity: usize) !void {
        if newCapacity == buckets.len() && tombstones == 0 { return; }
        var next = Vec<HashBucket<K, V>>();
        switch allocator {
            null => {},
            some(owner) => { next = Vec<HashBucket<K, V>>.withAllocator(owner); },
        }
        next.reserve(newCapacity)!;
        for i in usize(0)..newCapacity { next.push(HashBucket<K, V>())!; }

        core.swap<Vec<HashBucket<K, V>>>(&buckets, &next);
        var previousLength = length;
        length = 0;
        tombstones = 0;

        for i in usize(0)..next.len() {
            var bucket = next.getMutPtr(i).unwrap();
            if bucket.isOccupied() {
                var hash = bucket.storedHash();
                var pair = bucket.take();
                key, value := move(pair);
                insertKnownHash(hash, move(key), move(value));
            }
        }
        if length != previousLength { panic("hash table rehash lost an entry"); }
    }

    func ensureRoomForOne() !bool {
        if length == ~usize(0) { return CapacityError.Overflow; }
        var cap = buckets.len();
        if cap == 0 {
            rehash(8)!;
            return true;
        }
        if length + 1 > cap - cap / 8 {
            if cap > ~usize(0) / 2 { return CapacityError.Overflow; }
            rehash(cap * 2)!;
            return true;
        }
        if tombstones > cap / 4 {
            rehash(cap)!;
            return true;
        }
        false
    }

    pub func reserve(minEntries: usize) !void {
        var target = hashTableCapacity(minEntries)!;
        if target > buckets.len() { rehash(target)!; }
    }

    pub func reserveAdditional(extra: usize) !void {
        if extra > ~usize(0) - length { return CapacityError.Overflow; }
        reserve(length + extra)
    }

    pub func insertPreserving(key: K, value: V) InsertResult<K, V> {
        var hash = hashKey(&key);
        switch findIndex(&key, hash) {
            some(index) => {
                var bucket = buckets.getMutPtr(index).unwrap();
                var previous = bucket.take();
                oldKey, oldValue := move(previous);
                bucket.write(hash, move(key), move(value));
                InsertResult<K, V>.Replaced(move(oldValue))
            },
            null => {
                ensureRoomForOne() catch (reason) {
                    return InsertResult<K, V>.Failed(reason, move(key), move(value));
                };
                insertKnownHash(hash, move(key), move(value));
                InsertResult<K, V>.Inserted()
            },
        }
    }

    pub func insert(key: K, value: V) !?V {
        switch insertPreserving(move(key), move(value)) {
            InsertResult.Inserted => null,
            InsertResult.Replaced(previous) => some(move(previous)),
            InsertResult.Failed(reason, _, _) => return reason,
        }
    }

    pub const func get(key: in K) ?ref V from self {
        var index = findIndex(&key, hashKey(&key))?;
        unsafe { __vqr_borrow_from_self(buckets.getPtr(index).unwrap().valueRef()) }
    }

    pub func getMut(key: in K) ?ref mut V from self {
        var index = findIndex(&key, hashKey(&key))?;
        unsafe { __vqr_borrow_from_self(buckets.getMutPtr(index).unwrap().valueMut()) }
    }

    pub func getOrInsert(key: K, initial: V) !ref mut V from self {
        var address = getOrInsertPtr(move(key), move(initial))!;
        unsafe { __vqr_borrow_from_self(address) }
    }

    pub func getOrInsertWith<F: Movable>(key: K, create: F) !ref mut V from self {
        var index = findIndex(&key, hashKey(&key));
        switch index {
            some(at) => {
                return unsafe { __vqr_borrow_from_self(buckets.getMutPtr(at).unwrap().valueMut()) };
            },
            null => {},
        }
        var initial: V = move(create)();
        var address = getOrInsertPtr(move(key), move(initial))!;
        unsafe { __vqr_borrow_from_self(address) }
    }

    pub func getOrInsertPtr(key: K, initial: V) !*V {
        var hash = hashKey(&key);
        var location = probe(&key, hash);
        switch location.0 {
            some(index) => buckets.getMutPtr(index).unwrap().valueMut(),
            null => {
                var index = if ensureRoomForOne()! { insertionIndex(hash) } else { location.1.unwrap() };
                insertAt(index, hash, move(key), move(initial))
            },
        }
    }

    // Keep the map at this address and use this entry exclusively while it is live.
    pub unsafe func entry(key: K) Entry<K, V> { unsafe { Entry<K, V>(self, move(key)) } }

    pub func getMutPtr(key: *const K) ?*V {
        var index = findIndex(key, hashKey(key)) ?? { return null; };
        some(buckets.getMutPtr(index).unwrap().valueMut())
    }

    pub const func getKeyValue(key: *const K) ?(*const K, *const V) {
        var hash = hashKey(key);
        switch findIndex(key, hash) {
            null => null,
            some(index) => {
                var bucket = buckets.getPtr(index).unwrap();
                some((bucket.keyRef(), bucket.valueRef()))
            },
        }
    }

    pub const func containsKey(key: in K) bool {
        findIndex(&key, hashKey(&key)) != null
    }

    pub func removeEntry(key: in K) ?(K, V) {
        var hash = hashKey(&key);
        switch findIndex(&key, hash) {
            null => null,
            some(index) => {
                var pair = buckets.getMutPtr(index).unwrap().take();
                length--;
                tombstones++;
                some(move(pair))
            },
        }
    }

    pub func remove(key: in K) ?V {
        switch removeEntry(key) {
            null => null,
            some(pair) => {
                oldKey, oldValue := move(pair);
                some(move(oldValue))
            },
        }
    }

    pub func retain<F: Movable>(predicate: F) void {
        for i in usize(0)..buckets.len() {
            var bucket = buckets.getMutPtr(i).unwrap();
            if bucket.isOccupied() && !predicate(bucket.keyRef(), bucket.valueRef()) {
                bucket.tombstoneEntry();
                length--;
                tombstones++;
            }
        }
    }

    pub func clear() void {
        for i in usize(0)..buckets.len() {
            buckets.getMutPtr(i).unwrap().clearEntry();
        }
        length = 0;
        tombstones = 0;
    }

    pub func shrinkToFit() !void {
        var target = hashTableCapacity(length)!;
        if target != buckets.len() || tombstones != 0 { rehash(target)!; }
    }

    pub func extend<I: Movable>(entries: I) !void {
        for key, value in move(entries) { insert(move(key), move(value))!; }
    }

    pub const func iterRef() !MapIterRef<K, V> {
        MapIterRef<K, V>(buckets.asConstSlice(), length)
    }

    pub const func keys() Keys<K, V> { Keys<K, V>(MapIterRef<K, V>(buckets.asConstSlice(), length)) }
    pub const func values() Values<K, V> { Values<K, V>(MapIterRef<K, V>(buckets.asConstSlice(), length)) }

    pub func deinit() void { clear(); }
}

pub class Entry<K: Movable, V: Movable> {
    #copy: disabled
    var map: *HashMap<K, V>;
    var query: ?K;
    pub unsafe func init(map: *HashMap<K, V>, key: K) : map(map), query(some(move(key))) {}

    pub const func key() *const K {
        var lookup = queryPtr();
        switch map.getKeyValue(lookup) {
            some(found) => found.0,
            null => lookup,
        }
    }
    pub const func isOccupied() bool { map.getKeyValue(queryPtr()) != null }
    pub const func isVacant() bool { !isOccupied() }
    pub const func get() ?*const V {
        switch map.getKeyValue(queryPtr()) {
            some(found) => some(found.1),
            null => null,
        }
    }
    pub func getMut() ?*V { map.getMutPtr(queryPtr()) }
    pub func andModify<F: Movable>(callback: F) *Self {
        switch getMut() {
            some(address) => { move(callback)(address); },
            null => {},
        }
        self
    }
    pub func orInsert(value: V) !*V { map.getOrInsertPtr(takeKey(), move(value)) }
    pub func orInsertWith<F: Movable>(create: F) !*V {
        switch getMut() {
            some(value) => {
                var used = takeKey();
                return value;
            },
            null => {},
        }
        var initial: V = move(create)();
        map.getOrInsertPtr(takeKey(), move(initial))
    }
    pub func removeEntry() ?(K, V) {
        var key = takeKey();
        map.removeEntry(key)
    }
    pub func remove() ?V {
        switch removeEntry() {
            some(pair) => {
                key, value := move(pair);
                some(move(value))
            },
            null => null,
        }
    }
    const func queryPtr() *const K {
        __vqr_optional_pointer(&query) ?? { panic("hash map entry has already been consumed"); }
    }
    func takeKey() K {
        var value = core.replace<?K>(&query, null);
        move(value).unwrap()
    }
}

pub class SetIterRef<T: Movable> {
    var source: MapIterRef<T, u8>;
    pub func init(source: MapIterRef<T, u8>) : source(move(source)) {}
    pub func next() ?*const T {
        switch source.next() {
            null => null,
            some(entry) => {
                key, value := move(entry);
                some(key)
            },
        }
    }
    pub const func remaining() usize { source.remaining() }
}

pub class HashSet<T: Movable> {
    #copy: disabled
    var values: HashMap<T, u8>;
    pub func init(
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool
    ) : values(HashMap<T, u8>(hashFunction, equalsFunction)) {}

    pub static func withHasher(
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool
    ) Self {
        HashSet<T>(hashFunction, equalsFunction)
    }

    pub static func withCapacity(
        n: usize,
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool
    ) !Self {
        var result = HashSet<T>.withHasher(hashFunction, equalsFunction);
        result.values.reserve(n)!;
        move(result)
    }

    pub static func withSeed(
        seed: u32,
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool
    ) Self {
        var result = HashSet<T>.withHasher(hashFunction, equalsFunction);
        result.values = HashMap<T, u8>.withSeed(seed, hashFunction, equalsFunction);
        move(result)
    }

    pub static func withAllocator(
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool,
        allocator: mem.AllocatorRef
    ) Self {
        var result = HashSet<T>.withHasher(hashFunction, equalsFunction);
        result.values = HashMap<T, u8>.withAllocator(hashFunction, equalsFunction, allocator);
        move(result)
    }

    pub static func withCapacityAndAllocator(
        n: usize,
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool,
        allocator: mem.AllocatorRef
    ) !Self {
        var result = HashSet<T>.withHasher(hashFunction, equalsFunction);
        result.values = HashMap<T, u8>.withCapacityAndAllocator(
            n, hashFunction, equalsFunction, allocator
        )!;
        move(result)
    }

    pub static func withSeedAndAllocator(
        seed: u32,
        hashFunction: func(*const T, u32) usize,
        equalsFunction: func(*const T, *const T) bool,
        allocator: mem.AllocatorRef
    ) Self {
        var result = HashSet<T>.withHasher(hashFunction, equalsFunction);
        result.values = HashMap<T, u8>.withSeedAndAllocator(
            seed, hashFunction, equalsFunction, allocator
        );
        move(result)
    }

    pub const func len() usize { values.len() }
    pub const func capacity() usize { values.capacity() }
    pub const func isEmpty() bool { values.isEmpty() }

    pub func insert(value: T) !bool {
        switch values.insert(move(value), 0u8)! {
            null => true,
            some(_) => false,
        }
    }

    pub func remove(value: in T) bool {
        switch values.remove(value) {
            null => false,
            some(_) => true,
        }
    }

    pub func take(value: in T) ?T {
        switch values.removeEntry(value) {
            null => null,
            some(entry) => {
                key, ignored := move(entry);
                some(move(key))
            },
        }
    }

    pub const func contains(value: in T) bool { values.containsKey(value) }
    pub func reserve(n: usize) !void { values.reserve(n) }
    pub func clear() void { values.clear(); }
    pub const func iterRef() !SetIterRef<T> { SetIterRef<T>(values.iterRef()!) }
    pub func deinit() void { values.clear(); }
}

pub func i32Map<V: Movable>() HashMap<i32, V> {
    HashMap<i32, V>.withHasher(hashing.hashI32, hashing.eqI32)
}

pub func i64Map<V: Movable>() HashMap<i64, V> {
    HashMap<i64, V>.withHasher(hashing.hashI64, hashing.eqI64)
}
