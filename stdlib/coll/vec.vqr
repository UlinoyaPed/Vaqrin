package coll
import (core, iter as iterator, mem, meta)

pub error CapacityError { Overflow, IndexOutOfBounds }

func nextSequenceCapacity(capacity: usize) usize {
    if capacity < 4 { return 4; }
    var maximum = ~usize(0);
    if capacity > maximum / 2 { return maximum; }
    capacity * 2
}

pub enum ReplaceResult<T: Movable> {
    Replaced(T),
    InvalidIndex(T),
}

pub class Vec<T: Movable> {
    #copy: disabled
    var data: ?*T;
    var length: usize;
    var reserved: usize;
    var allocator: ?mem.AllocatorRef;
    pub func init() : data(null), length(0), reserved(0), allocator(null) {}

    pub static func withAllocator(allocator: mem.AllocatorRef) Self {
        var out = Vec<T>();
        out.allocator = some(allocator);
        move(out)
    }

    pub static func withCapacityAndAllocator(n: usize, allocator: mem.AllocatorRef) !Self {
        var out = Vec<T>.withAllocator(allocator);
        out.reserve(n)!;
        move(out)
    }

    pub static func withCapacity(n: usize) !Self {
        var out = Vec<T>();
        out.reserve(n)!;
        move(out)
    }

    // Copies each element; this method is available when T is Copyable.
    pub static func fromSlice(values: []const T) !Self {
        var out = Vec<T>.withCapacity(values.len())!;
        for item in values { out.push(move(item))!; }
        move(out)
    }

    pub static func fromIter<I: Movable>(values: I) !Self {
        var out = Vec<T>();
        for item in move(values) { out.push(move(item))!; }
        move(out)
    }

    pub const func len() usize { length }
    pub const func capacity() usize { reserved }
    pub const func isEmpty() bool { length == 0 }

    pub func reserve(minCapacity: usize) !void {
        if minCapacity <= reserved { return; }
        reallocate(minCapacity)
    }

    pub func reserveAdditional(extra: usize) !void {
        if extra > ~usize(0) - length { return CapacityError.Overflow; }
        reserve(length + extra)
    }

    pub func shrinkTo(minCapacity: usize) !void {
        var target = if minCapacity > length { minCapacity } else { length };
        if target >= reserved { return; }
        reallocate(target)
    }

    pub func shrinkToFit() !void { shrinkTo(length) }

    comptime if mem.hasDefaultAllocator() {
        func allocateBuffer(capacity: usize) !*T {
            unsafe { __vqr_alloc<T>(capacity) }
        }
    } else {
        func allocateBuffer(capacity: usize) !*T { mem.AllocationError.AllocatorUnavailable }
    }

    func allocationLayout(capacity: usize) !mem.Layout {
        var layout = mem.Layout.array<T>(capacity)!;
        // Zero-sized elements still need a unique, releasable allocation token.
        if layout.size() == 0 {
            return mem.Layout.fromSizeAlign(1, layout.align());
        }
        layout
    }

    func freeBuffer(address: *T, capacity: usize) void {
        switch allocator {
            null => unsafe { __vqr_free<T>(address); },
            some(owner) => {
                var layout = allocationLayout(capacity) catch { panic("invalid stored Vec capacity"); };
                var bytes = unsafe { ptrCast<*u8>(address) };
                owner.free(bytes, layout);
            },
        }
    }

    func reallocate(newCapacity: usize) !void {
        if newCapacity == 0 {
            switch data {
                null => {},
                some(address) => freeBuffer(address, reserved),
            }
            data = null;
            reserved = 0;
            return;
        }

        var next: *T;
        switch allocator {
            null => { next = allocateBuffer(newCapacity)!; },
            some(owner) => {
                var layout = allocationLayout(newCapacity)!;
                var raw = owner.alloc(layout)!;
                switch raw {
                    null => return mem.AllocationError.OutOfMemory,
                    some(bytes) => { next = unsafe { ptrCast<*T>(bytes) }; },
                }
            },
        }

        var i: usize = 0;
        if __vqr_optional_present(raw data) {
            var previous = data.unwrap();
            unsafe {
                while i < length {
                    __vqr_slot_write<T>(next.offset(i), __vqr_slot_take<T>(previous.offset(i)));
                    i++;
                }
            }
            freeBuffer(previous, reserved);
        }
        data = some(next);
        reserved = newCapacity;
    }

    func ensureRoomForOne() !void {
        if length < reserved { return; }
        if length == ~usize(0) { return CapacityError.Overflow; }
        reserve(nextSequenceCapacity(reserved))
    }

    // Each specialization exposes one mode, not two overloads.
    comptime if meta.isCopyable<T>() {
        pub func push(value: T) !void {
            ensureRoomForOne()!;
            unsafe { __vqr_slot_write<T>(data.unwrap().offset(length), move(value)); }
            length++;
        }

        // Returns the argument copy if allocation or capacity growth fails.
        pub func pushPreserving(value: T) PushResult<T> {
            ensureRoomForOne() catch (reason) {
                return PushResult<T>.Failed(reason, move(value));
            };
            unsafe { __vqr_slot_write<T>(data.unwrap().offset(length), move(value)); }
            length++;
            PushResult<T>.Stored()
        }
    } else {
        pub func push(value: move T) !void {
            ensureRoomForOne()!;
            unsafe { __vqr_slot_write<T>(data.unwrap().offset(length), move(value)); }
            length++;
        }

        // Returns the original value if allocation or capacity growth fails.
        pub func pushPreserving(value: move T) PushResult<T> {
            ensureRoomForOne() catch (reason) {
                return PushResult<T>.Failed(reason, move(value));
            };
            unsafe { __vqr_slot_write<T>(data.unwrap().offset(length), move(value)); }
            length++;
            PushResult<T>.Stored()
        }
    }

    pub func pop() ?T {
        if length == 0 { return null; }
        length--;
        unsafe { some(__vqr_slot_take<T>(data.unwrap().offset(length))) }
    }

    pub func insert(index: usize, value: T) !void {
        if index > length { return CapacityError.IndexOutOfBounds; }
        ensureRoomForOne()!;
        unsafe {
            var base = data.unwrap();
            for position := length; position > index; position-- {
                __vqr_slot_write<T>(base.offset(position), __vqr_slot_take<T>(base.offset(position - 1)));
            }
            __vqr_slot_write<T>(base.offset(index), move(value));
        }
        length++;
    }

    pub func insertPreserving(index: usize, value: T) PushResult<T> {
        if index > length {
            return PushResult<T>.Failed(CapacityError.IndexOutOfBounds, move(value));
        }
        ensureRoomForOne() catch (reason) {
            return PushResult<T>.Failed(reason, move(value));
        };
        unsafe {
            var base = data.unwrap();
            for position := length; position > index; position-- {
                __vqr_slot_write<T>(base.offset(position), __vqr_slot_take<T>(base.offset(position - 1)));
            }
            __vqr_slot_write<T>(base.offset(index), move(value));
        }
        length++;
        PushResult<T>.Stored()
    }

    pub func remove(index: usize) ?T {
        if index >= length { return null; }
        unsafe {
            var base = data.unwrap();
            var old = __vqr_slot_take<T>(base.offset(index));
            length--;
            for position := index; position < length; position++ {
                __vqr_slot_write<T>(base.offset(position), __vqr_slot_take<T>(base.offset(position + 1)));
            }
            some(move(old))
        }
    }

    pub func swapRemove(index: usize) ?T {
        if index >= length { return null; }
        swap(index, length - 1);
        pop()
    }

    pub func replace(index: usize, value: T) ?T {
        if index >= length { return null; }
        unsafe {
            var slot = data.unwrap().offset(index);
            var previous = __vqr_slot_take<T>(slot);
            __vqr_slot_write<T>(slot, move(value));
            some(move(previous))
        }
    }

    pub func replacePreserving(index: usize, value: T) ReplaceResult<T> {
        if index >= length { return ReplaceResult<T>.InvalidIndex(move(value)); }
        var previous = replace(index, move(value)).unwrap();
        ReplaceResult<T>.Replaced(move(previous))
    }

    pub func retain<F: Movable>(predicate: F) void {
        var kept: usize = 0;
        for i in usize(0)..length {
            var address = data.unwrap().offset(i);
            if predicate(getPtr(i).unwrap()) {
                if kept != i {
                    unsafe { __vqr_slot_write<T>(data.unwrap().offset(kept), __vqr_slot_take<T>(address)); }
                }
                kept++;
            } else {
                unsafe { __vqr_slot_drop<T>(address); }
            }
        }
        length = kept;
    }

    pub func extend<I: Movable>(values: I) !void {
        for item in move(values) { push(move(item))!; }
    }

    // Reserves first, then transfers elements. On allocation failure both vectors are unchanged.
    pub func append(other: *Self) !void {
        if self == other || other.length == 0 { return; }
        reserveAdditional(other.length)!;
        var source = other.data.unwrap();
        var target = data.unwrap();
        for i in usize(0)..other.length {
            unsafe {
                __vqr_slot_write<T>(target.offset(length), __vqr_slot_take<T>(source.offset(i)));
            }
            length++;
        }
        other.length = 0;
    }

    // The suffix is transferred only after the result buffer has been allocated.
    pub func splitOff(index: usize) !Self {
        if index > length { return CapacityError.IndexOutOfBounds; }
        var count = length - index;
        var result = switch allocator {
            null => Vec<T>.withCapacity(count)!,
            some(owner) => Vec<T>.withCapacityAndAllocator(count, owner)!,
        };
        if count != 0 {
            var source = data.unwrap();
            var target = result.data.unwrap();
            for i in usize(0)..count {
                unsafe {
                    __vqr_slot_write<T>(target.offset(i), __vqr_slot_take<T>(source.offset(index + i)));
                }
            }
        }
        result.length = count;
        length = index;
        move(result)
    }

    // Reserve before moving any elements. The removed interval owns its slots
    // independently of this vector and can be consumed in either direction.
    pub func spliceOwned(start: usize, end: usize, replacement: Self) !IntoVecIter<T> {
        if start > end || end > length { return CapacityError.IndexOutOfBounds; }
        var removed = end - start;
        var incoming = replacement.len();
        var kept = length - removed;
        if incoming > ~usize(0) - kept { return CapacityError.Overflow; }
        var result = switch allocator {
            null => Vec<T>.withCapacity(removed)!,
            some(owner) => Vec<T>.withCapacityAndAllocator(removed, owner)!,
        };
        if removed == 0 && incoming == 0 { return IntoVecIter<T>(move(result)); }
        reserve(kept + incoming)!;
        var storage = data.unwrap();
        if removed != 0 {
            var taken = result.data.unwrap();
            for i in usize(0)..removed {
                unsafe { __vqr_slot_write<T>(taken.offset(i), __vqr_slot_take<T>(storage.offset(start + i))); }
            }
            result.length = removed;
        }
        var destination = start + incoming;
        if destination > end {
            var i = length;
            while i > end {
                i--;
                unsafe {
                    __vqr_slot_write<T>(storage.offset(destination + (i - end)),
                                       __vqr_slot_take<T>(storage.offset(i)));
                }
            }
        } else if destination < end {
            for i in end..length {
                unsafe {
                    __vqr_slot_write<T>(storage.offset(destination + (i - end)),
                                       __vqr_slot_take<T>(storage.offset(i)));
                }
            }
        }
        if incoming != 0 {
            var source = replacement.data.unwrap();
            for i in usize(0)..incoming {
                unsafe { __vqr_slot_write<T>(storage.offset(start + i), __vqr_slot_take<T>(source.offset(i))); }
            }
            replacement.length = 0;
        }
        length = kept + incoming;
        IntoVecIter<T>(move(result))
    }

    pub func splice(start: usize, end: usize, replacement: []const T) !void {
        if start > end || end > length { return CapacityError.IndexOutOfBounds; }
        var removed = spliceOwned(start, end, Vec<T>.fromSlice(replacement)!)!;
    }

    pub func drain(start: usize, end: usize) !IntoVecIter<T> { spliceOwned(start, end, Vec<T>()) }

    // Requires T: Copyable. Copying is explicit at this API boundary.
    pub const func clone() !Self {
        var result = switch allocator {
            null => Vec<T>.withCapacity(length)!,
            some(owner) => Vec<T>.withCapacityAndAllocator(length, owner)!,
        };
        for item in iterRef() { result.push(*item)!; }
        move(result)
    }

    pub const func iter() iterator.SliceIter<T> { iterator.SliceIter<T>(asSlice()) }
    pub const func iterRef() iterator.SliceIterRef<T> { iterator.SliceIterRef<T>(asSlice()) }
    pub func iterMut() iterator.SliceIterMut<T> { iterator.SliceIterMut<T>(asSlice()) }
    pub const func reverseIter() iterator.RevIter<iterator.SliceIterRef<T>, *const T> {
        iterator.rev<iterator.SliceIterRef<T>, *const T>(iterRef())
    }

    pub static func intoIter(value: Self) IntoVecIter<T> { IntoVecIter<T>(move(value)) }

    pub const func asConstSlice() []const T { asSlice() }
    pub func asPtr() ?*T { if length == 0 { null } else { data } }
    pub const func asConstPtr() ?*const T { if length == 0 { null } else { some(data.unwrap()) } }

    pub const func getPtr(index: usize) ?*const T {
        if index < length { some(raw asSlice()[index]) } else { null }
    }
    pub func getMutPtr(index: usize) ?*T {
        if index < length { some(raw asSlice()[index]) } else { null }
    }
    pub const func get(index: usize) ?ref T from self {
        if index >= length { return null; }
        unsafe { __vqr_borrow_from_self(getPtr(index).unwrap()) }
    }

    pub func getMut(index: usize) ?ref mut T from self {
        if index >= length { return null; }
        unsafe { __vqr_borrow_from_self(getMutPtr(index).unwrap()) }
    }

    pub const func at(index: usize) *const T { getPtr(index).unwrap() }
    pub func atMut(index: usize) *T { getMutPtr(index).unwrap() }
    pub const func first() ?*const T { getPtr(0) }
    pub func firstMut() ?*T { getMutPtr(0) }
    pub const func last() ?*const T {
        if length == 0 { null } else { getPtr(length - 1) }
    }
    pub func lastMut() ?*T {
        if length == 0 { null } else { getMutPtr(length - 1) }
    }

    pub func swap(a: usize, b: usize) void { core.swap<T>(atMut(a), atMut(b)); }

    pub func reverse() void {
        for i in usize(0)..(length / 2) { swap(i, length - i - 1); }
    }

    pub func clear() void { truncate(0); }

    pub func truncate(n: usize) void {
        while length > n {
            length--;
            unsafe { __vqr_slot_drop<T>(data.unwrap().offset(length)); }
        }
    }

    pub func asSlice() []T { unsafe { __vqr_slice<T>(data, length) } }
    pub const func asSlice() []const T { unsafe { __vqr_const_slice<T>(data, length) } }

    // The consuming iterator has already moved every remaining slot.
    pub unsafe func forgetMovedPrefix() void { length = 0; }

    pub func deinit() void {
        clear();
        switch data {
            null => {},
            some(address) => freeBuffer(address, reserved),
        }
        data = null;
        reserved = 0;
    }
}

pub class IntoVecIter<T: Movable> {
    var source: Vec<T>;
    var front: usize;
    pub func init(values: Vec<T>) : source(move(values)), front(0) {}
    pub func next() ?T {
        if remaining() == 0 { return null; }
        var slot = source.getMutPtr(front).unwrap();
        front++;
        some(unsafe { __vqr_slot_take<T>(slot) })
    }
    pub func nextBack() ?T {
        if remaining() == 0 { return null; }
        source.pop()
    }
    pub const func remaining() usize { source.len() - front }
    pub func deinit() void {
        // Vec handles the remaining initialized suffix and releases its allocation.
        source.truncate(front);
        unsafe { source.forgetMovedPrefix(); }
    }
}

// Retains the direct constructors that accept an existing pointer list.
class IteratorSnapshot<T: Copyable + Movable> {
    var entries: Vec<T>;
    var front: usize;
    var back: usize;
    pub func init(entries: Vec<T>, count: usize) : entries(move(entries)), front(0), back(count) {}
    pub func take(reverse: bool) ?T {
        if front == back { return null; }
        if reverse {
            back--;
            return some(*entries.getPtr(back).unwrap());
        }
        var entry = *entries.getPtr(front).unwrap();
        front++;
        some(move(entry))
    }
    pub const func remaining() usize { back - front }
}
