package core
import (meta)

pub type Box<T> = ^T;
pub type ResultOptional<T> = !?T;
pub type OptionalResult<T> = ?!T;
pub type NestedOptional<T> = ??T;

pub func isSome<T>(value: *const ?T) bool { __vqr_optional_present(value) }
pub func isNone<T>(value: *const ?T) bool { !isSome(value) }
pub func isOk<T>(value: *const !T) bool { __vqr_result_ok(value) }
pub func isErr<T>(value: *const !T) bool { !isOk(value) }

pub func unwrapOr<T: Movable>(value: ?T, fallback: func() T) T {
    move(value) ?? fallback()
}

pub func swap<T: Movable>(a: *T, b: *T) void {
    if a == b { return; }
    unsafe {
        var previous = __vqr_slot_take<T>(a);
        __vqr_slot_write<T>(a, __vqr_slot_take<T>(b));
        __vqr_slot_write<T>(b, move(previous));
    }
}

// Replace an initialized, exclusively borrowed place and return its former
// owner. The replacement is already owned before the slot is touched.
pub class Exchange<T: Movable> {
    comptime if meta.isCopyable<T>() {
        pub static func replace(dst: mut T, value: T) T {
            unsafe {
                var address = dst.toRaw();
                var previous = __vqr_slot_take<T>(address);
                __vqr_slot_write<T>(address, move(value));
                move(previous)
            }
        }
    } else {
        pub static func replace(dst: mut T, value: move T) T {
            unsafe {
                var address = dst.toRaw();
                var previous = __vqr_slot_take<T>(address);
                __vqr_slot_write<T>(address, move(value));
                move(previous)
            }
        }
    }
}

pub func identity<T: Copyable + Movable>(value: T) T { move(value) }
pub func drop<T: Movable>(value: move T) void {}
pub func unreachable() never { panic("unreachable") }
pub unsafe func unreachableUnchecked() never { unsafe { __vqr_unreachable() } }
