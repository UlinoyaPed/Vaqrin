package env
import (core, coll, io, path, text)

pub error EnvError { InvalidKey, InvalidValue }

extern "C" func __vqr_io_env_get(key: *const u8, length: *usize, status: *i32) usize;
extern "C" func __vqr_io_env_free_string(address: usize) void;
extern "C" func __vqr_io_env_set(key: *const u8, value: *const u8) i32;
extern "C" func __vqr_io_env_remove(key: *const u8) i32;
extern "C" func __vqr_io_env_snapshot(length: *usize, status: *i32) usize;
extern "C" func __vqr_io_env_entry(entries: usize, index: usize, length: *usize) *u8;
extern "C" func __vqr_io_env_free_snapshot(entries: usize, length: usize) void;
extern "C" func __vqr_io_env_current_exe(buffer: *u8, capacity: usize, status: *i32) isize;

func validateKey(key: str) !void {
    if key.byteLen() == 0 { return EnvError.InvalidKey; }
    for byte in key.asBytes() {
        if byte == 0 || byte == 61 { return EnvError.InvalidKey; }
    }
}

func validateValue(value: str) !void {
    for byte in value.asBytes() {
        if byte == 0 { return EnvError.InvalidValue; }
    }
}

func toCString(value: str) !coll.Vec<u8> {
    var data = value.asBytes();
    if data.len() == ~usize(0) { return coll.CapacityError.Overflow; }
    var bytes = coll.Vec<u8>.withCapacity(data.len() + 1)!;
    for byte in data { bytes.push(byte)!; }
    bytes.push(0)!;
    move(bytes)
}

class HostValue {
    #copy: disabled
    var address: usize;
    pub func init(address: usize) : address(address) {}
    pub const func toString(length: usize) !string {
        var pointer = unsafe { ptrFromInt<*u8>(address) };
        var bytes = unsafe { __vqr_const_slice<u8>(some(pointer), length) };
        text.fromBytes(bytes)
    }
    pub func deinit() void { unsafe { __vqr_io_env_free_string(address); } }
}

class HostSnapshot {
    #copy: disabled
    var address: usize;
    var count: usize;
    pub func init(address: usize, count: usize) : address(address), count(count) {}
    pub const func toVars() !coll.Vec<(string,string)> {
        var output = coll.Vec<(string,string)>.withCapacity(count)!;
        for index in usize(0)..count {
            var length: usize = 0;
            var pointer = unsafe { __vqr_io_env_entry(address, index, raw length) };
            var bytes = unsafe { __vqr_const_slice<u8>(some(pointer), length) };
            var split: usize = 0;
            while split < length && bytes[split] != 61 { split++; }
            if split == 0 || split == length { continue; }
            var key = text.fromBytes(bytes[0..split])!;
            var value = text.fromBytes(bytes[split + 1..length])!;
            output.push((move(key), move(value)))!;
        }
        move(output)
    }
    pub func deinit() void { unsafe { __vqr_io_env_free_snapshot(address, count); } }
}

pub func get(key: str) core.ResultOptional<string> {
    validateKey(key)!;
    var name = toCString(key)!;
    var length: usize = 0;
    var status: i32 = 0;
    var address = unsafe { __vqr_io_env_get(raw name[0], raw length, raw status) };
    if status != 0 { return io.systemError(status); }
    if address == 0 { return null; }
    var nativeValue = HostValue(address);
    some(nativeValue.toString(length)!)
}

pub func getOr(key: str, fallback: str) !string {
    var value = get(key)!;
    value ?? { return text.fromBytes(fallback.asBytes()); }
}

pub func set(key: str, value: str) !void {
    validateKey(key)!;
    validateValue(value)!;
    var name = toCString(key)!;
    var raw = toCString(value)!;
    var status = unsafe { __vqr_io_env_set(raw name[0], raw raw[0]) };
    if status != 0 { return io.systemError(status); }
}

pub func remove(key: str) !void {
    validateKey(key)!;
    var name = toCString(key)!;
    var status = unsafe { __vqr_io_env_remove(raw name[0]) };
    if status != 0 { return io.systemError(status); }
}

pub func contains(key: str) !bool { get(key)! != null }

pub func vars() !coll.Vec<(string,string)> {
    var count: usize = 0;
    var status: i32 = 0;
    var address = unsafe { __vqr_io_env_snapshot(raw count, raw status) };
    if status != 0 { return io.systemError(status); }
    var nativeEnvironment = HostSnapshot(address, count);
    nativeEnvironment.toVars()
}

pub class Environment {
    #copy: disabled
    var entries: coll.Vec<(string,string)>;
    func init(entries: move coll.Vec<(string,string)>) : entries(move(entries)) {}
    const func indexOf(key: str) ?usize {
        for index in usize(0)..entries.len() {
            if text.equal(entries[index].0, key) { return some(index); }
        }
        null
    }
    pub static func snapshot() !Self { Environment(vars()!) }
    pub const func get(key: str) core.ResultOptional<string> {
        validateKey(key)!;
        var index = indexOf(key) ?? { return null; };
        some(text.fromBytes(entries[index].1.asBytes())!)
    }
    pub func set(key: str, value: str) !void {
        validateKey(key)!;
        validateValue(value)!;
        var owned = text.fromBytes(value.asBytes())!;
        switch indexOf(key) {
            some(index) => { entries[index].1 = move(owned); },
            null => {
                var name = text.fromBytes(key.asBytes())!;
                entries.push((move(name), move(owned)))!;
            },
        };
    }
    pub func remove(key: str) !void {
        validateKey(key)!;
        for {
            var index = indexOf(key) ?? { return; };
            var removed = entries.remove(index);
        }
    }
    pub const func contains(key: str) bool { indexOf(key) != null }
    pub const func items() !coll.Vec<(string,string)> { entries.clone() }
    pub const func keys() !coll.Vec<string> {
        var output = coll.Vec<string>.withCapacity(entries.len())!;
        for index in usize(0)..entries.len() {
            output.push(text.fromBytes(entries[index].0.asBytes())!)!;
        }
        move(output)
    }
    pub const func clone() !Self { Environment(entries.clone()!) }
}

pub func snapshot() !Environment { Environment.snapshot() }

pub func currentDir() !path.PathBuf {
    var directory = io.currentDir()!;
    path.fromString(directory)
}

pub func tempDir() !path.PathBuf {
    var value = getOr("TMPDIR", "/tmp")!;
    if value.byteLen() == 0 { return path.fromString("/tmp"); }
    path.fromString(value)
}

pub func homeDir() core.ResultOptional<path.PathBuf> {
    var value = get("HOME")! ?? { return null; };
    if value.byteLen() == 0 { return null; }
    some(path.fromString(value)!)
}

pub func currentExe() !path.PathBuf {
    var capacity: usize = 256;
    for {
        var buffer = coll.Vec<u8>.withCapacity(capacity)!;
        for index in usize(0)..capacity { buffer.push(0)!; }
        var status: i32 = 0;
        var size = unsafe { __vqr_io_env_current_exe(raw buffer[0], capacity, raw status) };
        if status != 0 { return io.systemError(status); }
        var length = usize(size)!;
        if length < capacity {
            var name = text.fromBytes(buffer.asConstSlice()[0..length])!;
            return path.fromString(name);
        }
        if capacity > ~usize(0) / 2 { return coll.CapacityError.Overflow; }
        capacity *= 2;
    }
}
