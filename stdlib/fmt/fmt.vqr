package fmt
import (io, text, coll, convert, mem)

pub error FormatError { InvalidRadix, InvalidPrecision, WidthTooLarge, UnsupportedType, InvalidFormat }
pub enum Alignment { Left, Right, Center }
pub enum FloatStyle { General, Fixed, Scientific }

pub class FormatOptions {
    pub var radix: u8;
    pub var width: usize;
    pub var precision: i32;
    pub var fill: char;
    pub var alignment: Alignment;
    pub var uppercase: bool;
    pub var showSign: bool;
    pub var floatStyle: FloatStyle;
public:
    func init() : radix(10), width(0), precision(-1), fill(' '),
        alignment(Alignment.Right), uppercase(false), showSign(false), floatStyle(FloatStyle.General) {}
}

func formatMagnitude(value: u128, radix: u8, negative: bool, uppercase: bool) !string {
    if radix < 2 || radix > 36 { return FormatError.InvalidRadix; }
    var digits = if uppercase { "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ" } else { "0123456789abcdefghijklmnopqrstuvwxyz" };
    var buffer = mem.zeroedBytes<130>();
    var length: usize = 0;
    var number = value;
    for {
        var digit = usize(number % u128(radix))!;
        buffer[length] = digits.asBytes()[digit];
        length++;
        number = number / u128(radix);
        if number == 0 { break; }
    }
    if negative { buffer[length] = 45u8; length++; }
    var output = coll.Vec<u8>();
    for index := length; index > 0; index-- { output.push(buffer[index - 1])!; }
    text.fromBytes(output.asConstSlice())
}

func formatSigned<T>(value: T, radix: u8, uppercase: bool) !string {
    var number = i128(value);
    var negative = number < 0;
    var magnitude = if negative { 0u128 -% bitCast<u128>(number) } else { bitCast<u128>(number) };
    formatMagnitude(magnitude, radix, negative, uppercase)
}
func formatUnsigned<T>(value: T, radix: u8, uppercase: bool) !string {
    formatMagnitude(u128(value), radix, false, uppercase)
}
pub func formatInt(value: i8, radix: u8) !string { formatSigned<i8>(value, radix, false) }
pub func formatInt(value: i16, radix: u8) !string { formatSigned<i16>(value, radix, false) }
pub func formatInt(value: i32, radix: u8) !string { formatSigned<i32>(value, radix, false) }
pub func formatInt(value: i64, radix: u8) !string { formatSigned<i64>(value, radix, false) }
pub func formatInt(value: i128, radix: u8) !string { formatSigned<i128>(value, radix, false) }
pub func formatUint(value: u8, radix: u8) !string { formatUnsigned<u8>(value, radix, false) }
pub func formatUint(value: u16, radix: u8) !string { formatUnsigned<u16>(value, radix, false) }
pub func formatUint(value: u32, radix: u8) !string { formatUnsigned<u32>(value, radix, false) }
pub func formatUint(value: u64, radix: u8) !string { formatUnsigned<u64>(value, radix, false) }
pub func formatUint(value: u128, radix: u8) !string { formatUnsigned<u128>(value, radix, false) }

func byte(value: u32) u8 { u8(value) catch { panic("UTF-8 encoder byte overflow"); } }

func charBytes(value: char, output: *[4]u8) usize {
    var code = convert.fromChar(value);
    if code <= 0x7f {
        (*output)[0] = byte(code);
        return 1;
    }
    if code <= 0x7ff {
        (*output)[0] = byte(0xc0 | (code >> 6));
        (*output)[1] = byte(0x80 | (code & 0x3f));
        return 2;
    }
    if code <= 0xffff {
        (*output)[0] = byte(0xe0 | (code >> 12));
        (*output)[1] = byte(0x80 | ((code >> 6) & 0x3f));
        (*output)[2] = byte(0x80 | (code & 0x3f));
        return 3;
    }
    (*output)[0] = byte(0xf0 | (code >> 18));
    (*output)[1] = byte(0x80 | ((code >> 12) & 0x3f));
    (*output)[2] = byte(0x80 | ((code >> 6) & 0x3f));
    (*output)[3] = byte(0x80 | (code & 0x3f));
    4
}

func writeCharRaw(writer: *io.Writer, value: char) !void {
    var bytes = mem.zeroedBytes<4>();
    var count = charBytes(value, &bytes);
    io.writeAll(writer, bytes[0..count])!
}
func writeFill(writer: *io.Writer, value: char, count: usize) !void {
    for index in usize(0)..count { writeCharRaw(writer, value)!; }
}

pub func writeString(writer: *io.Writer, value: str, options: FormatOptions) !void {
    var length = text.scalarCount(value);
    var padding = if options.width > length { options.width - length } else { 0 };
    var left: usize = if options.alignment == Alignment.Left { 0 }
               else if options.alignment == Alignment.Center { padding / 2 }
               else { padding };
    var right = padding - left;
    writeFill(writer, options.fill, left)!;
    io.writeString(writer, value)!;
    writeFill(writer, options.fill, right)!
}
pub func writeString(writer: *io.Writer, value: str) !void {
    var options = FormatOptions();
    options.alignment = Alignment.Left;
    writeString(writer, value, options)
}
pub func writeBool(writer: *io.Writer, value: bool, options: FormatOptions) !void {
    writeString(writer, if value { "true" } else { "false" }, options)
}
pub func writeChar(writer: *io.Writer, value: char, options: FormatOptions) !void {
    var bytes = mem.zeroedBytes<4>();
    var count = charBytes(value, &bytes);
    var valueText = text.fromBytes(bytes[0..count])!;
    writeString(writer, unsafe { __vqr_text_borrow_utf8(valueText.asBytes()) }, options)
}

extern "C" func __vqr_io_format_float(value: f64, style: i32, precision: i32, buffer: *u8, capacity: usize, length: *usize, status: *i32) i32;

pub func formatFloat(value: f64, style: FloatStyle, precision: ?usize) !string {
    var styleCode = switch style {
        FloatStyle.General => 0,
        FloatStyle.Fixed => 1,
        FloatStyle.Scientific => 2,
    };
    var digits: i32 = -1;
    switch precision {
        null => { if style != FloatStyle.General { digits = 6; } },
        some(value) => {
            if value > 64 { return FormatError.InvalidPrecision; }
            digits = i32(value)!;
        },
    }
    var buffer = mem.zeroedBytes<512>();
    var length: usize = 0;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_format_float(value, styleCode, digits, &buffer[0], buffer.len(), &length, &errorCode) } != 0 {
        return io.systemError(errorCode);
    }
    text.fromBytes(buffer[0..length])
}

pub func writeFloat(writer: *io.Writer, value: f64, options: FormatOptions) !void {
    var style = options.floatStyle;
    var precision: ?usize = if options.precision < 0 { null } else { some(usize(options.precision)!) };
    var output = formatFloat(value, style, precision)!;
    writeNumber(writer, output, options)
}

func writeNumber(writer: *io.Writer, value: str, options: FormatOptions) !void {
    var bytes = value.asBytes();
    var negative = bytes.len() != 0 && bytes[0] == 45;
    if !negative && !options.showSign { return writeString(writer, value, options); }
    var sign: str = if negative { "-" } else { "+" };
    var width = options.width -| value.byteLen();
    if !negative { width = width -| 1; }
    var left: usize = if options.alignment == Alignment.Left { 0 }
                      else if options.alignment == Alignment.Center { width / 2 }
                      else { width };
    var zeroFill = options.fill == '0' && options.alignment == Alignment.Right;
    if !zeroFill { writeFill(writer, options.fill, left)!; }
    io.writeString(writer, sign)!;
    if zeroFill { writeFill(writer, options.fill, left)!; }
    var offset: usize = if negative { 1 } else { 0 };
    io.writeAll(writer, bytes[offset..bytes.len()])!;
    writeFill(writer, options.fill, width - left)
}

pub func writeSigned(writer: *io.Writer, value: i128, options: FormatOptions) !void {
    var output = formatMagnitude(
        if value < 0 { 0u128 -% bitCast<u128>(value) } else { bitCast<u128>(value) },
        options.radix, value < 0, options.uppercase
    )!;
    writeNumber(writer, output, options)
}
pub func writeUnsigned(writer: *io.Writer, value: u128, options: FormatOptions) !void {
    var output = formatMagnitude(value, options.radix, false, options.uppercase)!;
    writeNumber(writer, output, options)
}
pub func writeInt(writer: *io.Writer, value: i64, options: FormatOptions) !void {
    writeSigned(writer, i128(value), options)
}
pub func writeUint(writer: *io.Writer, value: u64, options: FormatOptions) !void {
    writeUnsigned(writer, u128(value), options)
}
pub func writeHex(writer: *io.Writer, data: []const u8, uppercase: bool) !void {
    var digits = if uppercase { "0123456789ABCDEF" } else { "0123456789abcdef" };
    var pair = mem.zeroedBytes<2>();
    for item in data {
        pair[0] = digits.asBytes()[usize(item) >> 4];
        pair[1] = digits.asBytes()[usize(item) & 0x0f];
        io.writeAll(writer, pair[:])!;
    }
}

pub enum FormatArg {
    Text(str), OwnedText(string), Signed(i128), Unsigned(u128), Float(f64), Boolean(bool), Character(char),
}
pub func arg(value: str) FormatArg { FormatArg.Text(value) }
pub func arg(value: string) FormatArg { FormatArg.OwnedText(move(value)) }
pub func arg(value: i8) FormatArg { FormatArg.Signed(i128(value)) }
pub func arg(value: i16) FormatArg { FormatArg.Signed(i128(value)) }
pub func arg(value: i128) FormatArg { FormatArg.Signed(value) }
pub func arg(value: u8) FormatArg { FormatArg.Unsigned(u128(value)) }
pub func arg(value: u16) FormatArg { FormatArg.Unsigned(u128(value)) }
pub func arg(value: u128) FormatArg { FormatArg.Unsigned(value) }
pub func arg(value: i32) FormatArg { FormatArg.Signed(i128(value)) }
pub func arg(value: i64) FormatArg { FormatArg.Signed(i128(value)) }
pub func arg(value: u32) FormatArg { FormatArg.Unsigned(u128(value)) }
pub func arg(value: u64) FormatArg { FormatArg.Unsigned(u128(value)) }
pub func arg(value: f32) FormatArg { FormatArg.Float(f64(value)) }
pub func arg(value: f64) FormatArg { FormatArg.Float(value) }
pub func arg(value: bool) FormatArg { FormatArg.Boolean(value) }
pub func arg(value: char) FormatArg { FormatArg.Character(value) }

func writeArg(writer: *io.Writer, value: FormatArg, options: FormatOptions) !void {
    switch value {
        FormatArg.Text(item) => writeString(writer, item, options)!,
        FormatArg.OwnedText(&item) => writeString(writer, item, options)!,
        FormatArg.Signed(item) => writeSigned(writer, item, options)!,
        FormatArg.Unsigned(item) => writeUnsigned(writer, item, options)!,
        FormatArg.Float(item) => writeFloat(writer, item, options)!,
        FormatArg.Boolean(item) => writeBool(writer, item, options)!,
        FormatArg.Character(item) => writeChar(writer, item, options)!,
    }
}

func parseSpec(value: str) !FormatOptions {
    var options = FormatOptions();
    var bytes = value.asBytes();
    var index: usize = 0;
    if index < bytes.len() && bytes[index] == 43u8 { options.showSign = true; index++; }
    if index < bytes.len() && (bytes[index] == 60u8 || bytes[index] == 62u8 || bytes[index] == 94u8) {
        options.alignment = if bytes[index] == 60u8 { Alignment.Left }
                            else if bytes[index] == 94u8 { Alignment.Center }
                            else { Alignment.Right };
        index++;
    }
    if index < bytes.len() && bytes[index] == 48u8 { options.fill = '0'; }
    for index < bytes.len() && 48 <= bytes[index] && bytes[index] <= 57 {
        var digit = usize(bytes[index]) - 48;
        if options.width > (~usize(0) - digit) / 10 { return FormatError.WidthTooLarge; }
        options.width = options.width * 10 + digit;
        index++;
    }
    if index < bytes.len() && bytes[index] == 46u8 {
        index++;
        if index == bytes.len() { return FormatError.InvalidPrecision; }
        var precision: usize = 0;
        var firstDigit = index;
        for index < bytes.len() && 48 <= bytes[index] && bytes[index] <= 57 {
            var digit = usize(bytes[index]) - 48;
            if precision > (64 - digit) / 10 { return FormatError.InvalidPrecision; }
            precision = precision * 10 + digit;
            index++;
        }
        if index == firstDigit { return FormatError.InvalidPrecision; }
        options.precision = i32(precision)!;
    }
    if index < bytes.len() {
        switch bytes[index] {
            98 => { options.radix = 2; },
            111 => { options.radix = 8; },
            100 => { options.radix = 10; },
            120 => { options.radix = 16; },
            88 => { options.radix = 16; options.uppercase = true; },
            102 => { options.floatStyle = FloatStyle.Fixed; },
            101 => { options.floatStyle = FloatStyle.Scientific; },
            103 => { options.floatStyle = FloatStyle.General; },
            _ => return FormatError.InvalidFormat,
        }
        index++;
    }
    if index != bytes.len() { return FormatError.InvalidFormat; }
    options
}

pub func writeTo(writer: *io.Writer, pattern: str, args: []const FormatArg) !void {
    var bytes = pattern.asBytes();
    var index: usize = 0;
    var literal: usize = 0;
    var argument: usize = 0;
    var indexed = false;
    for index < bytes.len() {
        if bytes[index] == 123u8 {
            if index + 1 < bytes.len() && bytes[index + 1] == 123u8 {
                if index > literal { io.writeAll(writer, bytes[literal..index])!; }
                io.writeString(writer, "{")!;
                index += 2;
                literal = index;
                continue;
            }
            if index > literal { io.writeAll(writer, bytes[literal..index])!; }
            var end = index + 1;
            for end < bytes.len() && bytes[end] != 125u8 { end++; }
            if end == bytes.len() { return FormatError.InvalidFormat; }
            var start = index + 1;
            var cursor = start;
            var selected: usize = 0;
            for cursor < end && 48 <= bytes[cursor] && bytes[cursor] <= 57 {
                var digit = usize(bytes[cursor]) - 48;
                if selected > (~usize(0) - digit) / 10 { return FormatError.InvalidFormat; }
                selected = selected * 10 + digit;
                cursor++;
            }
            if cursor != start {
                if argument != 0 { return FormatError.InvalidFormat; }
                indexed = true;
            } else {
                if indexed || argument >= args.len() { return FormatError.InvalidFormat; }
                selected = argument;
                argument++;
            }
            if selected >= args.len() { return FormatError.InvalidFormat; }
            var spec: str = if end == cursor { "" }
                       else if bytes[cursor] == 58u8 {
                           unsafe { __vqr_text_borrow_utf8(bytes[cursor + 1..end]) }
                       } else { return FormatError.InvalidFormat; };
            var options = parseSpec(spec)!;
            writeArg(writer, args[selected], options)!;
            index = end + 1;
            literal = index;
            continue;
        }
        if bytes[index] == 125u8 {
            if index + 1 < bytes.len() && bytes[index + 1] == 125u8 {
                if index > literal { io.writeAll(writer, bytes[literal..index])!; }
                io.writeString(writer, "}")!;
                index += 2;
                literal = index;
                continue;
            }
            return FormatError.InvalidFormat;
        }
        index++;
    }
    if literal < bytes.len() { io.writeAll(writer, bytes[literal..bytes.len()])!; }
    if !indexed && argument != args.len() { return FormatError.InvalidFormat; }
}

pub func format(pattern: str, args: []const FormatArg) !string {
    var writer = io.MemoryWriter();
    writeTo(&writer, pattern, args)!;
    text.fromBytes(writer.asSlice())
}
pub func format(value: str) !string { text.fromBytes(value.asBytes()) }
pub func writeTo(writer: *io.Writer, value: str) !void { io.writeString(writer, value) }

pub func print(value: FormatArg) !void {
    var output = io.stdout();
    writeArg(&output, value, FormatOptions())!;
    output.flush()
}
pub func println(value: FormatArg) !void {
    var output = io.stdout();
    writeArg(&output, value, FormatOptions())!;
    io.writeString(&output, "\n")!;
    output.flush()
}
pub func eprint(value: FormatArg) !void {
    var output = io.stderr();
    writeArg(&output, value, FormatOptions())!;
    output.flush()
}
pub func eprintln(value: FormatArg) !void {
    var output = io.stderr();
    writeArg(&output, value, FormatOptions())!;
    io.writeString(&output, "\n")!;
    output.flush()
}

pub func print(value: str) !void {
    var output = io.stdout();
    writeString(&output, value)!;
    output.flush()
}
pub func println(value: str) !void {
    var output = io.stdout();
    writeString(&output, value)!;
    writeString(&output, "\n")!;
    output.flush()
}
pub func eprint(value: str) !void {
    var output = io.stderr();
    writeString(&output, value)!;
    output.flush()
}
pub func eprintln(value: str) !void {
    var output = io.stderr();
    writeString(&output, value)!;
    writeString(&output, "\n")!;
    output.flush()
}
