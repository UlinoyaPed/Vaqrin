package fs
import (io, path, text, coll)

pub error FsError { InvalidOptions, NotFound, NotDirectory, IsDirectory, SameFile, InvalidPath, WalkLimit }
pub enum FileType { File, Directory, Symlink, Device, Socket, Other }

func fileTypeFromCode(code: i32) FileType {
    switch code {
        0 => FileType.File,
        1 => FileType.Directory,
        2 => FileType.Symlink,
        3 => FileType.Device,
        4 => FileType.Socket,
        _ => FileType.Other,
    }
}

pub class Permissions {
    var modeBits: u32;
    pub func init(mode: u32) : modeBits(mode) {}
    pub const func mode() u32 { modeBits }
    pub const func readonly() bool { (modeBits & 146u32) == 0 }
    pub func setReadonly(value: bool) void {
        if value { modeBits = modeBits & ~u32(146); }
        else { modeBits = modeBits | 128u32; }
    }
}

pub class OpenOptions {
    pub var readEnabled: bool;
    pub var writeEnabled: bool;
    pub var appendEnabled: bool;
    pub var createEnabled: bool;
    pub var createNewEnabled: bool;
    pub var truncateEnabled: bool;
    pub var modeBits: u32;
    pub func init() : readEnabled(false), writeEnabled(false), appendEnabled(false),
        createEnabled(false), createNewEnabled(false), truncateEnabled(false), modeBits(420) {}
    pub func read(value: bool) void { readEnabled = value; }
    pub func write(value: bool) void { writeEnabled = value; }
    pub func append(value: bool) void { appendEnabled = value; }
    pub func create(value: bool) void { createEnabled = value; }
    pub func createNew(value: bool) void { createNewEnabled = value; }
    pub func truncate(value: bool) void { truncateEnabled = value; }
    pub func mode(value: u32) void { modeBits = value; }
    pub func open(name: path.Path) !File {
        if !readEnabled && !writeEnabled && !appendEnabled { return FsError.InvalidOptions; }
        if appendEnabled && !writeEnabled { return FsError.InvalidOptions; }
        if truncateEnabled && !writeEnabled { return FsError.InvalidOptions; }
        if createNewEnabled && createEnabled { return FsError.InvalidOptions; }
        var flags: u32 = (if readEnabled { 1u32 } else { 0u32 }) | (if writeEnabled { 2u32 } else { 0u32 }) |
            (if appendEnabled { 4u32 } else { 0u32 }) | (if createEnabled { 8u32 } else { 0u32 }) |
            (if createNewEnabled { 16u32 } else { 0u32 }) | (if truncateEnabled { 32u32 } else { 0u32 });
        var handle = io.HostFile.open(name.asString().asBytes(), flags, modeBits)!;
        File(move(handle))
    }
    pub func open(name: str) !File { open(path.fromString(name)!) }
}

pub class Metadata {
    var value: io.HostMetadata;
    pub func init(value: io.HostMetadata) : value(move(value)) {}
    pub const func len() u64 { value.size() }
    pub const func isFile() bool { value.kindCode() == 0 }
    pub const func isDir() bool { value.kindCode() == 1 }
    pub const func isSymlink() bool { value.kindCode() == 2 }
    pub const func fileType() FileType { fileTypeFromCode(value.kindCode()) }
    pub const func identity() ?io.FileIdentity { value.identity() }
    pub const func permissions() Permissions { Permissions(value.mode()) }
    pub const func modifiedUnixSeconds() i64 { value.modifiedUnixSeconds() }
}

pub class File {
    #copy: disabled
    #implements: io.Reader, io.Writer, io.Seeker, io.ReaderAt, io.WriterAt, io.Closer
    var handle: io.HostFile;
    pub func init(handle: io.HostFile) : handle(move(handle)) {}
    // A borrowed OS descriptor. Its ownership remains with this file.
    pub const func systemDescriptor() !i32 { handle.systemDescriptor() }
    pub func read(dst: []u8) !usize { handle.read(dst) }
    pub func write(src: []const u8) !usize { handle.write(src) }
    pub func seek(offset: i64, origin: io.SeekOrigin) !u64 { handle.seek(offset, origin) }
    pub func readAt(offset: u64, dst: []u8) !usize { handle.readAt(offset, dst) }
    pub func writeAt(offset: u64, src: []const u8) !usize { handle.writeAt(offset, src) }
    pub func flush() !void { handle.flush() }
    pub func close() !void { handle.close() }
    pub func syncAll() !void { handle.syncAll() }
    pub func syncData() !void { handle.syncData() }
    pub func truncate(size: u64) !void { handle.truncate(size) }
    pub func metadata() !Metadata { Metadata(handle.metadata()!) }
    pub func setPermissions(value: Permissions) !void { handle.setMode(value.mode()) }
    pub func deinit() void { handle.close() catch {}; }
}

pub class DirectoryEntry {
    var entry: io.HostDirEntry;
    var parentPath: path.Path;
    pub func init(entry: io.HostDirEntry, parent: path.Path) : entry(move(entry)), parentPath(parent) {}
    pub const func name() str { entry.name() }
    pub const func fileType() FileType { fileTypeFromCode(entry.kindCode()) }
    pub const func path() !path.Path { path.join(parentPath, path.fromString(name())!) }
    pub func metadata() !Metadata { stat(path()!) }
}

pub class Directory {
    #copy: disabled
    var handle: io.HostDirectory;
    var base: path.Path;
    pub func init(handle: io.HostDirectory, base: path.Path) : handle(move(handle)), base(base) {}
    pub func next() !?DirectoryEntry {
        var item = handle.next()!;
        switch item {
            null => null,
            some(entry) => some(DirectoryEntry(move(entry), base)),
        }
    }
    pub func close() !void { handle.close() }
    pub func deinit() void { handle.close() catch {}; }
}

pub func open(name: path.Path, options: OpenOptions) !File { options.open(name) }
pub func open(name: str, options: OpenOptions) !File { options.open(name) }
pub func create(name: path.Path) !File {
    var options = OpenOptions();
    options.write(true);
    options.create(true);
    options.truncate(true);
    options.open(name)
}
pub func create(name: str) !File { create(path.fromString(name)!) }
pub func openRead(name: path.Path) !File {
    var options = OpenOptions();
    options.read(true);
    options.open(name)
}
pub func openWrite(name: path.Path) !File {
    var options = OpenOptions();
    options.write(true);
    options.create(true);
    options.truncate(true);
    options.open(name)
}
pub func readFile(name: path.Path, limit: usize) !coll.Vec<u8> {
    var file = openRead(name)!;
    io.readToEnd(raw file, limit)
}
pub func readFile(name: str, limit: usize) !coll.Vec<u8> { readFile(path.fromString(name)!, limit) }
pub func readText(name: path.Path, limit: usize) !string {
    var data = readFile(name, limit)!;
    text.fromBytes(data.asConstSlice())
}
pub func readText(name: str, limit: usize) !string { readText(path.fromString(name)!, limit) }
pub func writeFile(name: path.Path, data: []const u8) !void {
    var file = create(name)!;
    io.writeAll(raw file, data)!;
    file.flush()!;
}
pub func writeFile(name: str, data: []const u8) !void { writeFile(path.fromString(name)!, data) }
pub func appendFile(name: path.Path, data: []const u8) !void {
    var options = OpenOptions();
    options.write(true);
    options.append(true);
    options.create(true);
    var file = options.open(name)!;
    io.writeAll(raw file, data)!
}
pub func tryExists(name: path.Path) !bool {
    stat(name) catch (reason) {
        // ENOENT and ENOTDIR both mean the requested path cannot exist.
        if reason == io.systemError(2) || reason == io.systemError(20) { return false; }
        return reason;
    };
    true
}
pub func tryExists(name: str) !bool { tryExists(path.fromString(name)!) }
pub func exists(name: path.Path) bool { tryExists(name) catch { false } }
pub func exists(name: str) bool { tryExists(name) catch { false } }
pub func stat(name: path.Path) !Metadata { Metadata(io.hostStat(name.asString().asBytes(), true)!) }
pub func stat(name: str) !Metadata { stat(path.fromString(name)!) }
pub func lstat(name: path.Path) !Metadata { Metadata(io.hostStat(name.asString().asBytes(), false)!) }
pub func lstat(name: str) !Metadata { lstat(path.fromString(name)!) }
pub func mkdir(name: path.Path) !void { io.hostMkdir(name.asString().asBytes(), 493) }
pub func mkdir(name: str) !void { mkdir(path.fromString(name)!) }
pub func chmod(name: path.Path, permissions: Permissions) !void {
    io.hostChmod(name.asString().asBytes(), permissions.mode())
}
pub func remove(name: path.Path) !void { io.hostRemove(name.asString().asBytes()) }
pub func remove(name: str) !void { remove(path.fromString(name)!) }
pub func removeDir(name: path.Path) !void { io.hostRemoveDir(name.asString().asBytes()) }
pub func removeDir(name: str) !void { removeDir(path.fromString(name)!) }
pub func rename(from: path.Path, to: path.Path) !void {
    io.hostRename(from.asString().asBytes(), to.asString().asBytes())
}
pub func rename(from: str, to: str) !void { rename(path.fromString(from)!, path.fromString(to)!) }
pub func readDir(name: path.Path) !Directory {
    var handle = io.HostDirectory.open(name.asString().asBytes())!;
    Directory(move(handle), name)
}
pub func readDir(name: str) !Directory { readDir(path.fromString(name)!) }
pub func sameFile(first: path.Path, second: path.Path) !bool {
    var a = stat(first)!;
    var b = stat(second)!;
    a.identity().unwrap().matches(b.identity().unwrap())
}
pub func sameFile(first: str, second: str) !bool {
    sameFile(path.fromString(first)!, path.fromString(second)!)
}

pub func copy(source: path.Path, destination: path.Path) !u64 {
    var input = openRead(source)!;
    var sourceInfo = input.metadata()!;
    if sourceInfo.isDir() { return FsError.IsDirectory; }
    var options = OpenOptions();
    options.write(true);
    options.create(true);
    var output = options.open(destination)!;
    // Compare the opened objects before truncation. Either path can be replaced
    // by another process without changing the identity of these descriptors.
    var targetInfo = output.metadata()!;
    if sourceInfo.identity().unwrap().matches(targetInfo.identity().unwrap()) {
        return FsError.SameFile;
    }
    if targetInfo.isFile() { output.truncate(0)!; }
    var count = io.copyAll(raw input, raw output)!;
    output.flush()!;
    output.close()!;
    count
}
pub func copy(source: str, destination: str) !u64 {
    copy(path.fromString(source)!, path.fromString(destination)!)
}
pub func currentDir() !string { io.currentDir() }
pub func setCurrentDir(name: path.Path) !void { io.setCurrentDir(name.asString().asBytes()) }
pub func setCurrentDir(name: str) !void { setCurrentDir(path.fromString(name)!) }
