package fs
import (io, path, text, coll)

pub error FsError { InvalidOptions, NotFound, NotDirectory, IsDirectory }

pub class OpenOptions {
    pub var readEnabled: bool;
    pub var writeEnabled: bool;
    pub var appendEnabled: bool;
    pub var createEnabled: bool;
    pub var createNewEnabled: bool;
    pub var truncateEnabled: bool;
    pub var modeBits: u32;
public:
    func init() : readEnabled(false), writeEnabled(false), appendEnabled(false),
        createEnabled(false), createNewEnabled(false), truncateEnabled(false), modeBits(420) {}
    func read(value: bool) Self { readEnabled = value; move(self) }
    func write(value: bool) Self { writeEnabled = value; move(self) }
    func append(value: bool) Self { appendEnabled = value; move(self) }
    func create(value: bool) Self { createEnabled = value; move(self) }
    func createNew(value: bool) Self { createNewEnabled = value; move(self) }
    func truncate(value: bool) Self { truncateEnabled = value; move(self) }
    func mode(value: u32) Self { modeBits = value; move(self) }
    func open(name: str) !File {
        if !readEnabled && !writeEnabled && !appendEnabled { return FsError.InvalidOptions; }
        if appendEnabled && !writeEnabled { return FsError.InvalidOptions; }
        var flags: u32 = (if readEnabled { 1 } else { 0 }) | (if writeEnabled { 2 } else { 0 }) |
            (if appendEnabled { 4 } else { 0 }) | (if createEnabled { 8 } else { 0 }) |
            (if createNewEnabled { 16 } else { 0 }) | (if truncateEnabled { 32 } else { 0 });
        var handle = io.HostFile.open(name.asBytes(), flags, modeBits)!;
        File(move(handle))
    }
}

pub class Metadata {
    var value: io.HostMetadata;
public:
    func init(value: io.HostMetadata) : value(move(value)) {}
    const func len() u64 { value.size() }
    const func isFile() bool { value.kindCode() == 0 }
    const func isDir() bool { value.kindCode() == 1 }
    const func isSymlink() bool { value.kindCode() == 2 }
    const func permissions() u32 { value.mode() }
    const func modifiedUnixSeconds() i64 { value.modifiedUnixSeconds() }
}

pub class File {
    #copy: disabled
    #implements: io.Reader, io.Writer, io.Seeker, io.Closer
    var handle: io.HostFile;
public:
    func init(handle: io.HostFile) : handle(move(handle)) {}
    func read(dst: []u8) !usize { handle.read(dst) }
    func write(src: []const u8) !usize { handle.write(src) }
    func seek(offset: i64, origin: io.SeekOrigin) !u64 { handle.seek(offset, origin) }
    func flush() !void { handle.flush() }
    func close() !void { handle.close() }
    func syncAll() !void { handle.syncAll() }
    func syncData() !void { handle.syncData() }
    func truncate(size: u64) !void { handle.truncate(size) }
    func metadata() !Metadata { Metadata(handle.metadata()!) }
    func deinit() void { handle.close() catch {}; }
}

pub func open(name: str, options: OpenOptions) !File { options.open(name) }
pub func create(name: str) !File { OpenOptions().write(true).create(true).truncate(true).open(name) }
pub func readFile(name: str, limit: usize) !coll.Vec<u8> {
    var file = OpenOptions().read(true).open(name)!;
    io.readToEnd(&file, limit)
}
pub func readText(name: str, limit: usize) !string {
    var data = readFile(name, limit)!;
    text.fromBytes(data.asConstSlice())
}
pub func writeFile(name: str, data: []const u8) !void {
    var file = create(name)!;
    io.writeAll(&file, data)!;
    file.flush()!;
}
pub func exists(name: str) bool { io.hostStat(name.asBytes(), true) != null }
pub func stat(name: str) !Metadata { Metadata(io.hostStat(name.asBytes(), true)!) }
pub func lstat(name: str) !Metadata { Metadata(io.hostStat(name.asBytes(), false)!) }
pub func mkdir(name: str) !void { io.hostMkdir(name.asBytes(), 493) }
pub func remove(name: str) !void { io.hostRemove(name.asBytes()) }
pub func removeDir(name: str) !void { io.hostRemoveDir(name.asBytes()) }
pub func rename(from: str, to: str) !void { io.hostRename(from.asBytes(), to.asBytes()) }
pub func currentDir() !string { io.currentDir() }
pub func setCurrentDir(name: str) !void { io.setCurrentDir(name.asBytes()) }
