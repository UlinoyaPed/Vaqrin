package grpc
import (cmp, coll, core, http2, time)

pub class UnaryResponse {
    #copy: disabled
    pub var initial: Metadata;
    pub var trailing: Metadata;
    pub var status: Status;
    pub var body: ?coll.Vec<u8>;
}

pub class Call {
    #copy: disabled
    pub var stream: i32;
    pub var deadline: ?time.Deadline;
    pub var id: u64;
    pub var decoder: MessageReader;
    var compression: Compression;
    pub var sentEnd: bool;
    pub var remoteEnd: bool;
    pub var cancelled: bool;
    pub var gotHeaders: bool;
    pub var grpc: bool;
    pub var http: u32;
    pub var initial: Metadata;
    pub var trailing: Metadata;
    pub var status: ?Status;
    pub func init(stream: i32, deadline: ?time.Deadline, id: u64, limit: usize)
        : stream(stream), deadline(deadline), id(id), decoder(MessageReader(limit)),
          compression(Compression.Identity), sentEnd(false), remoteEnd(false), cancelled(false),
          gotHeaders(false), grpc(false), http(0), initial(Metadata()), trailing(Metadata()), status(null) {}
    pub static func withCompression(stream: i32, deadline: ?time.Deadline, id: u64,
                                    limit: usize, algorithm: Compression) Self {
        var call = Call(stream, deadline, id, limit);
        call.compression = algorithm;
        move(call)
    }
    pub const func sendCompression() Compression { compression }
    pub func complete() !UnaryResponse {
        if !remoteEnd { return RpcError.CallInProgress; }
        var current = core.replace<?Status>(&status, null) ?? { return RpcError.CallClosed; };
        var headers = core.replace<Metadata>(&initial, Metadata());
        var trailers = core.replace<Metadata>(&trailing, Metadata());
        UnaryResponse{initial: move(headers), trailing: move(trailers), status: move(current), body: null}
    }
}

class ActiveCall {
    pub var stream: i32;
    pub var serial: u64;
    pub func init(stream: i32, serial: u64) : stream(stream), serial(serial) {}
}

pub class ClientConn {
    #copy: disabled
    var wire: Transport;
    var connection: http2.Connection;
    var authority: string;
    var secure: bool;
    var timeout: time.Duration;
    var limit: usize;
    var active: coll.Vec<ActiveCall>;
    var deferred: DeferredEvents;
    var maxCalls: usize;
    var lastAccepted: ?i32;
    var terminated: bool;
    var serial: u64;
    pub func init(wire: Transport, session: http2.Connection, authority: string, secure: bool, options: DialOptions)
        : wire(move(wire)), connection(move(session)), authority(move(authority)), secure(secure),
          timeout(options.timeout), limit(options.maxMessageBytes), active(coll.Vec<ActiveCall>()),
          deferred(DeferredEvents()), maxCalls(options.maxConcurrentCalls), lastAccepted(null),
          terminated(false), serial(0) {}
    pub const func maxMessageBytes() usize { limit }
    pub func close() !void {
        terminated = true;
        active.clear();
        connection.goAway(0) catch {};
        connection.flush(&wire) catch {};
        connection.close();
        wire.close()
    }
    pub func start(path: str, options: *const CallOptions) !Call {
        if terminated || lastAccepted != null { return RpcError.ConnectionClosed; }
        if active.len() >= maxCalls { return RpcError.ResourceExhausted; }
        if !validMethod(path) { return RpcError.InvalidMethod; }
        var headers = http2.HeaderBlock();
        headers.add(":method", "POST")!;
        headers.add(":scheme", if secure { "https" } else { "http" })!;
        headers.add(":path", path)!;
        headers.add(":authority", authority)!;
        headers.add("content-type", "application/grpc")!;
        headers.add("te", "trailers")!;
        headers.add("grpc-accept-encoding", "identity,gzip")!;
        if options.compression == Compression.Gzip { headers.add("grpc-encoding", "gzip")!; }
        if options.deadline != null {
            var remaining = options.deadline.unwrap().remaining()!;
            var value = durationHeader(remaining)!;
            headers.add("grpc-timeout", value)!;
        }
        options.metadata.writeTo(&headers)!;
        active.reserve(active.len() + 1)!;
        var stream = connection.request(&headers, false)!;
        serial +%= 1;
        active.push(ActiveCall(stream, serial))!;
        Call.withCompression(stream, options.deadline, serial, limit, options.compression)
    }
    pub func sendMessage(call: *Call, message: []const u8) !void {
        requireActive(call)!;
        if call.sentEnd { return RpcError.CallClosed; }
        var encoded = frameMessage(message, limit, call.sendCompression())!;
        connection.sendData(call.stream, encoded.asConstSlice(), false)!;
        updateTimeout(call)!;
        connection.flush(&wire)
    }
    pub func finishSend(call: *Call) !void {
        requireActive(call)!;
        if call.sentEnd { return; }
        connection.sendData(call.stream, "".asBytes(), true)!;
        call.sentEnd = true;
        updateTimeout(call)!;
        connection.flush(&wire)
    }
    pub func cancel(call: *Call) !void {
        requireActive(call)!;
        call.cancelled = true;
        removeCall(call.stream);
        var reset = connection.reset(call.stream, 8);
        drainCallEvents(call.stream);
        reset!;
        wire.setTimeout(timeout)!;
        connection.flush(&wire)
    }
    pub func recvMessage(call: *Call) !?coll.Vec<u8> {
        if call.cancelled { return RpcError.Cancelled; }
        if call.remoteEnd { return null; }
        requireActive(call)!;
        readMessage(call) catch (reason) {
            var expired = call.deadline != null && (call.deadline.unwrap().expired() catch { false });
            if reason == RpcError.ConnectionClosed || terminated {
                removeCall(call.stream);
                drainCallEvents(call.stream);
            } else {
                cancel(call) catch (problem) {
                    if problem != http2.Http2Error.StreamClosed { terminated = true; }
                };
            }
            if expired { return RpcError.DeadlineExceeded; }
            return reason;
        }
    }
    pub func unary(path: str, message: []const u8, options: *const CallOptions) !UnaryResponse {
        var call = start(path, options)!;
        sendMessage(&call, message) catch (reason) { cancel(&call) catch {}; return reason; };
        finishSend(&call) catch (reason) { cancel(&call) catch {}; return reason; };
        var body = recvMessage(&call)!;
        var extra = recvMessage(&call)!;
        if extra != null { cancel(&call) catch {}; return RpcError.Protocol; }
        var response = call.complete()!;
        if response.status.isOk() && body == null { return RpcError.Protocol; }
        response.body = move(body);
        move(response)
    }
    const func requireActive(call: *const Call) !void {
        if call.cancelled { return RpcError.Cancelled; }
        if terminated { return RpcError.ConnectionClosed; }
        var index = findCall(call.stream) ?? { return RpcError.CallClosed; };
        if active.at(index).serial != call.id { return RpcError.CallClosed; }
    }
    const func findCall(stream: i32) ?usize {
        for i in usize(0)..active.len() {
            if active.at(i).stream == stream { return some(i); }
        }
        null
    }
    func removeCall(stream: i32) void {
        var index = findCall(stream) ?? { return; };
        active.swapRemove(index);
    }
    func drainCallEvents(stream: i32) void {
        for {
            var discarded = deferred.forStream(stream) ?? { return; };
        }
    }
    func nextEvent(call: *const Call) !http2.Event {
        for {
            updateTimeout(call)!;
            var deferredEvent = deferred.forStream(call.stream);
            switch move(deferredEvent) {
                some(waiting) => { return move(waiting); },
                null => {},
            };
            if terminated || (lastAccepted != null && call.stream > lastAccepted.unwrap()) {
                return RpcError.ConnectionClosed;
            }
            var event = connection.next()! ?? {
                connection.flush(&wire)!;
                if !connection.receive(&wire)! {
                    terminated = true;
                    return RpcError.ConnectionClosed;
                }
                continue;
            };
            if event.kind == http2.EventKind.GoAway {
                if event.code != 0 { terminated = true; return RpcError.ConnectionClosed; }
                if lastAccepted == null || event.stream < lastAccepted.unwrap() {
                    lastAccepted = some(event.stream);
                }
                continue;
            }
            if event.kind == http2.EventKind.Data { connection.consumeConnection(event.payload().len())!; }
            if event.stream == call.stream { return move(event); }
            if findCall(event.stream) != null {
                deferred.defer(move(event)) catch (reason) {
                    terminated = true;
                    return reason;
                };
            }
        }
    }
    func updateTimeout(call: *const Call) !void {
        var duration = timeout;
        if call.deadline != null {
            var remaining = call.deadline.unwrap().remaining()!;
            if remaining.isZero() { return RpcError.DeadlineExceeded; }
            if remaining.compare(duration) == cmp.Ordering.Less { duration = remaining; }
        }
        wire.setTimeout(duration)
    }
    func finishRemote(call: *Call) !void {
        call.decoder.finish()!;
        if call.status == null {
            call.status = some(status(httpStatus(call.http), ""));
        }
        // An early final response can arrive before the application half-closes.
        if !call.sentEnd { connection.reset(call.stream, 0) catch {}; }
        call.remoteEnd = true;
        removeCall(call.stream);
        drainCallEvents(call.stream);
    }
    func readMessage(call: *Call) !?coll.Vec<u8> {
        for {
            var message = call.decoder.next()!;
            if message != null { return move(message); }
            var event = nextEvent(call)!;
            switch event.kind {
                http2.EventKind.Headers => {
                    var info = parseHeaders(&event)!;
                    if info.http >= 100 && info.http < 200 { continue; }
                    var initial = !call.gotHeaders;
                    if initial {
                        call.http = info.http;
                        call.grpc = info.http == 200 && info.grpc;
                        call.gotHeaders = true;
                        var encoding = info.encoding ?? MessageEncoding.Identity;
                        if call.grpc && encoding == MessageEncoding.Unsupported { return RpcError.UnsupportedEncoding; }
                        if encoding == MessageEncoding.Gzip { call.decoder.useCompression(Compression.Gzip); }
                    }
                    if info.remoteStatus != null {
                        if (event.code & 1) == 0 || call.status != null { return RpcError.Protocol; }
                        var remote = Status{code: info.remoteStatus.unwrap(),
                            message: core.replace<string>(&info.message, ""),
                            details: core.replace<coll.Vec<u8>>(&info.details, coll.Vec<u8>())};
                        call.status = some(move(remote));
                        call.trailing = core.replace<Metadata>(&info.metadata, Metadata());
                    } else if initial {
                        call.initial = core.replace<Metadata>(&info.metadata, Metadata());
                    } else {
                        call.trailing = core.replace<Metadata>(&info.metadata, Metadata());
                    }
                },
                http2.EventKind.Data => {
                    if call.grpc { call.decoder.feed(event.payload())!; }
                    connection.consumeStream(call.stream, event.payload().len())!;
                },
                http2.EventKind.EndStream => {
                    finishRemote(call)!;
                    return null;
                },
                http2.EventKind.Closed => {
                    if event.code == 8 { return RpcError.Cancelled; }
                    return RpcError.Protocol;
                },
                http2.EventKind.InvalidFrame => { return RpcError.Protocol; },
                _ => {},
            };
        }
    }
}
