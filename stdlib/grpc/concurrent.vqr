package grpc
import (channel, cmp, coll, core, http2, reactor, task, text, time)

class ConcurrentInput {
    #copy: disabled
    var handler: *const ConcurrentUnaryHandler;
    var request: UnaryRequest;
    pub func init(handler: *const ConcurrentUnaryHandler, request: UnaryRequest)
        : handler(handler), request(move(request)) {}
    pub func run(limit: usize) !ConcurrentOutput {
        var input = core.Exchange<UnaryRequest>.replace(request,
            UnaryRequest("", Metadata(), null, coll.Vec<u8>()));
        var result = handler.call(move(input)) catch {
            var code = if task.isCancelled() { StatusCode.Cancelled } else { StatusCode.Internal };
            reply(status(code, ""))
        };
        ConcurrentOutput(result, limit)
    }
}

// Copy values returned by application handlers because their original
// vectors may use an allocator that is local to the current worker.
class ConcurrentOutput {
    #copy: disabled
    pub var result: UnaryResponse;
    pub func init(source: in UnaryResponse, limit: usize) !void
        : result(copyResponse(source, limit)!) {}
}

func copyResponse(source: in UnaryResponse, limit: usize) !UnaryResponse {
    var content: ?coll.Vec<u8> = null;
    switch source.body {
        some(ref body) => {
            if body.len() > limit { return reply(status(StatusCode.ResourceExhausted, "")); }
            content = some(coll.Vec<u8>.fromSlice(body.asConstSlice())!);
        },
        null => {},
    };
    var message = text.fromBytes(source.status.message.asBytes())!;
    var details = coll.Vec<u8>.fromSlice(source.status.details.asConstSlice())!;
    var code = Status(source.status.code, move(message), move(details));
    UnaryResponse(
        source.initial.cloneOwned()!,
        source.trailing.cloneOwned()!,
        move(code),
        move(content)
    )
}

class PendingCall {
    #copy: disabled
    pub var stream: i32;
    pub var deadline: ?time.Deadline;
    pub var job: task.Task<ConcurrentOutput>;
    pub var compression: Compression;
    pub var replyable: bool;
    pub func init(stream: i32, deadline: ?time.Deadline, job: task.Task<ConcurrentOutput>, compression: Compression)
        : stream(stream), deadline(deadline), job(move(job)), compression(compression), replyable(true) {}
}

class CompletionWatch {
    #copy: disabled
    var watched: reactor.Reactor;
    var shutdown: ?reactor.WatchId;
    pub func init(socket: i32, completed: i32, stop: ?*const Shutdown) !void
        : watched(reactor.Reactor.open()!), shutdown(null) {
        watched.register(socket, reactor.Interest.read())!;
        watched.register(completed, reactor.Interest.read())!;
        if stop != null { shutdown = some(watched.register(stop.unwrap().descriptor(), reactor.Interest.read())!); }
    }
    pub func stopWatchingShutdown() !void {
        if shutdown == null { return; }
        watched.remove(shutdown.unwrap())!;
        shutdown = null;
    }
    pub func wait(deadline: time.Deadline) !void {
        task.waitDescriptor(watched.systemDescriptor()!, reactor.Interest.read(), some(deadline))!;
        watched.wait(some(time.Duration.zero()))!;
    }
}

class ConcurrentCalls {
    #copy: disabled
    var group: task.TaskGroup;
    var running: coll.Vec<PendingCall>;
    var streaming: coll.Vec<PendingStream>;
    pub func init(workers: usize) !void
        : group(task.TaskGroup.withWorkers(workers)!), running(coll.Vec<PendingCall>()),
          streaming(coll.Vec<PendingStream>()) {}

    pub const func count() usize { running.len() + streaming.len() }
    pub const func pending() bool { count() != 0 }

    pub func completionDescriptor() !i32 { group.completionDescriptor() }
    pub func clearCompletionSignal() !void { group.clearCompletionSignal() }
    pub const func nextDeadline(ceiling: time.Deadline) time.Deadline {
        var first = ceiling;
        for index in usize(0)..running.len() {
            var call = running.at(index);
            if call.replyable && call.deadline != null {
                var candidate = call.deadline.unwrap();
                if candidate.instant().compare(first.instant()) == cmp.Ordering.Less { first = candidate; }
            }
        }
        for index in usize(0)..streaming.len() {
            var call = streaming.at(index);
            if call.replyable && call.deadline != null {
                var candidate = call.deadline.unwrap();
                if candidate.instant().compare(first.instant()) == cmp.Ordering.Less { first = candidate; }
            }
        }
        first
    }
    pub func start(stream: i32, handler: *const ConcurrentUnaryHandler, request: UnaryRequest,
                   compression: Compression, limit: usize) !void {
        running.reserve(running.len() + 1)!;
        var deadline = request.deadline;
        var input = ConcurrentInput(handler, move(request));
        var run = [move(input), limit]() !ConcurrentOutput => {
            var owned = move(input);
            owned.run(limit)
        };
        var job = group.spawn<ConcurrentOutput>(move(run))!;
        running.push(PendingCall(stream, deadline, move(job), compression))
    }

    pub func startStream(id: i32, handler: *const ConcurrentStreamingHandler, request: HeaderInfo,
                         options: ServeOptions) !void {
        streaming.reserve(streaming.len() + 1)!;
        var alarm = request.deadline;
        var decoder = MessageReader(options.maxMessageBytes);
        decoder.useReceiveWindow();
        if (request.encoding ?? MessageEncoding.Identity) == MessageEncoding.Gzip {
            decoder.useCompression(Compression.Gzip);
        }
        command, commands := channel.Channel<StreamCommand>.bounded(1)!;
        reply, replies := channel.Channel<StreamReply>.bounded(1)!;
        var stream = ConcurrentServerStream(move(command), move(replies), completionDescriptor()!,
                                            move(request), options);
        var input = ConcurrentStreamInput(handler, move(stream));
        var run = [move(input)]() !void => {
            var owned = move(input);
            owned.run()
        };
        var job = group.spawn<void>(move(run))!;
        streaming.push(PendingStream(id, alarm, move(job), move(commands), move(reply), move(decoder)))
    }

    pub func streamAt(id: i32) ?*PendingStream {
        for index in usize(0)..streaming.len() {
            var stream = streaming.atMut(index);
            if stream.id == id { return some(stream); }
        }
        null
    }

    pub func cancel(stream: i32) void {
        var active = streamAt(stream);
        if active != null {
            active.unwrap().cancel();
            return;
        }
        for index in usize(0)..running.len() {
            var call = running.atMut(index);
            if call.stream == stream {
                call.replyable = false;
                call.job.cancel();
                return;
            }
        }
    }

    pub func collect(session: *http2.Connection, limit: usize) !void {
        collectStreams(session)!;
        var index = usize(0);
        while index < running.len() {
            var call = running.atMut(index);
            if call.replyable && call.deadline != null && call.deadline.unwrap().expired()! {
                call.replyable = false;
                call.job.cancel();
                sendError(session, call.stream, StatusCode.DeadlineExceeded) catch (reason) {
                    if reason != http2.Http2Error.StreamClosed { return reason; }
                };
            }
            if !call.job.isFinished() { index++; continue; }
            var completed = running.swapRemove(index).unwrap();
            var result = completed.job.join() catch {
                if !completed.replyable { continue; }
                sendError(session, completed.stream, StatusCode.Internal) catch (reason) {
                    if reason != http2.Http2Error.StreamClosed { return reason; }
                };
                continue;
            };
            if !completed.replyable { continue; }
            sendUnaryResult(session, completed.stream, raw result.result, limit, completed.compression)
                catch (reason) { if reason != http2.Http2Error.StreamClosed { return reason; } };
        }
    }

    pub func advanceWrites(session: *http2.Connection) !bool {
        var queued = false;
        for index in usize(0)..streaming.len() {
            var stream = streaming.atMut(index);
            var submitted = stream.advanceWrite(session) catch (reason) {
                if reason != http2.Http2Error.StreamClosed { return reason; }
                stream.cancel();
                false
            };
            if submitted { queued = true; }
        }
        queued
    }

    func collectStreams(session: *http2.Connection) !void {
        var index = usize(0);
        while index < streaming.len() {
            var stream = streaming.atMut(index);
            stream.poll(session) catch (reason) {
                if reason == http2.Http2Error.StreamClosed { stream.cancel(); }
                else if reason == http2.Http2Error.ResourceLimit || reason == http2.Http2Error.InvalidArgument {
                    stream.abort(session, StatusCode.ResourceExhausted) catch (failure) {
                        if failure != http2.Http2Error.StreamClosed { return failure; }
                    };
                } else { return reason; }
            };
            if !stream.job.isFinished() { index++; continue; }
            var completed = streaming.swapRemove(index).unwrap();
            completed.job.join() catch (reason) {
                if !completed.replyable { continue; }
                completed.abort(session, streamStatus(reason)) catch (failure) {
                    if failure != http2.Http2Error.StreamClosed { return failure; }
                };
            };
        }
    }
}
