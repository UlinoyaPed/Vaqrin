package grpc
import (core, binary, coll)

pub func frame(message: []const u8, limit: usize) !coll.Vec<u8> {
    frameWire(message, limit, 0)
}

func frameWire(message: []const u8, limit: usize, flag: u8) !coll.Vec<u8> {
    if message.len() > limit || message.len() > 0x7fffffff { return RpcError.MessageTooLarge; }
    var encoded = coll.Vec<u8>.withCapacity(message.len() + 5)!;
    encoded.push(flag)!;
    var length = binary.u32ToBytes(u32(message.len())!, binary.Endian.Big);
    for byte in length[:] { encoded.push(byte)!; }
    for byte in message { encoded.push(byte)!; }
    move(encoded)
}

func frameMessage(message: []const u8, limit: usize, compression: Compression) !coll.Vec<u8> {
    if message.len() > limit || message.len() > 0x7fffffff { return RpcError.MessageTooLarge; }
    if compression == Compression.Identity || message.len() == 0 { return frame(message, limit); }
    var compressed = gzip(message, message.len() - 1, true) catch (reason) {
        if reason == RpcError.MessageTooLarge { return frame(message, limit); }
        return reason;
    };
    frameWire(compressed.asConstSlice(), limit, 1)
}

pub class MessageReader {
    #copy: disabled
    var data: coll.Vec<u8>;
    var offset: usize;
    var limit: usize;
    var encoding: MessageEncoding;
    var readAhead: usize;
    pub func init(limit: usize) : data(coll.Vec<u8>()), offset(0),
        limit(if limit > 0x7fffffff { 0x7fffffff } else { limit }), encoding(MessageEncoding.Identity), readAhead(4096) {}
    pub func useCompression(value: Compression) void {
        encoding = if value == Compression.Gzip { MessageEncoding.Gzip } else { MessageEncoding.Identity };
    }
    pub const func unreadBytes() usize { data.len() - offset }
    pub func useReceiveWindow() void { readAhead += 65535; }
    pub func feed(fragment: []const u8) !void {
        var unread = unreadBytes();
        // One partial message plus the transport read-ahead or unconsumed window.
        var capacity = limit + 5 + readAhead;
        if unread > capacity || fragment.len() > capacity - unread { return RpcError.MessageTooLarge; }
        if offset != 0 {
            for index in usize(0)..unread { data[index] = data[offset + index]; }
            data.truncate(unread);
            offset = 0;
        }
        var needed = unread + fragment.len();
        if needed > data.capacity() {
            var target = data.capacity() * 2;
            if target > capacity { target = capacity; }
            data.reserve(if needed > target { needed } else { target })!;
        }
        for byte in fragment { data.push(byte)!; }
    }
    pub func next() core.ResultOptional<coll.Vec<u8>> {
        var available = data.len() - offset;
        if available < 5 { return null; }
        var flag = data[offset];
        if flag == 1 && encoding != MessageEncoding.Gzip { return RpcError.UnsupportedEncoding; }
        if flag > 1 { return RpcError.Protocol; }
        var wire = data.asConstSlice();
        var size = usize(binary.readU32(wire[offset + 1..offset + 5], binary.Endian.Big)!);
        if size > limit { return RpcError.MessageTooLarge; }
        if size > available - 5 { return null; }
        var end = offset + 5 + size;
        var payload = wire[offset + 5..end];
        var message = if flag == 1 { gzip(payload, limit, false)! } else { coll.Vec<u8>.fromSlice(payload)! };
        offset = end;
        some(move(message))
    }
    pub const func finish() !void {
        if offset != data.len() { return RpcError.Protocol; }
    }
}
