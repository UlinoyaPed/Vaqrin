package grpc
import (cmp, coll, core, http2, io, mem, net, opt, reactor, task, text, time, tls)

pub class UnaryRequest {
    #copy: disabled
    pub var path: string;
    pub var metadata: Metadata;
    pub var deadline: ?time.Deadline;
    pub var body: coll.Vec<u8>;

    pub func init(path: string, metadata: move Metadata, deadline: ?time.Deadline, body: move coll.Vec<u8>)
        : path(move(path)), metadata(move(metadata)), deadline(deadline), body(move(body)) {}
}

pub interface UnaryHandler { func call(request: UnaryRequest) !UnaryResponse; }
pub interface ConcurrentUnaryHandler { const func call(request: UnaryRequest) !UnaryResponse; }

enum UnaryRoute { Synchronous(*UnaryHandler), Concurrent(*const ConcurrentUnaryHandler) }

pub class ServeOptions {
    pub var timeout: time.Duration;
    pub var maxMessageBytes: usize;
    pub var maxConcurrentStreams: u32;
    pub var compressResponses: bool;
    pub var applicationWorkers: usize;
    pub var shutdownTimeout: time.Duration;
    pub func init() : timeout(time.Duration.fromSeconds(15)), maxMessageBytes(4 * 1024 * 1024),
        maxConcurrentStreams(16), compressResponses(false), applicationWorkers(2),
        shutdownTimeout(time.Duration.fromSeconds(15)) {}
}

pub func reply(status: Status) UnaryResponse {
    UnaryResponse(Metadata(), Metadata(), move(status), null)
}

pub func response(body: coll.Vec<u8>) UnaryResponse {
    UnaryResponse(Metadata(), Metadata(), status(StatusCode.Ok, ""), some(move(body)))
}

enum RouteHandler {
    Unary(UnaryRoute),
    Streaming(*StreamingHandler),
    ConcurrentStreaming(*const ConcurrentStreamingHandler),
}

class Route {
    pub var path: string;
    pub var handler: RouteHandler;

    pub func init(path: string, handler: RouteHandler)
        : path(move(path)), handler(handler) {}
}

class Incoming {
    #copy: disabled
    pub var stream: i32;
    pub var route: UnaryRoute;
    pub var decoder: MessageReader;
    pub var head: HeaderInfo;
    pub func init(stream: i32, route: UnaryRoute, incoming: HeaderInfo, limit: usize)
        : stream(stream), route(route), decoder(MessageReader(limit)), head(move(incoming)) {
        if (head.encoding ?? MessageEncoding.Identity) == MessageEncoding.Gzip { decoder.useCompression(Compression.Gzip); }
    }
    pub func request() !UnaryRequest {
        var body = decoder.next()! ?? { return RpcError.Protocol; };
        decoder.finish()!;
        var path = core.Exchange<string>.replace(head.path, "");
        var metadata = core.Exchange<Metadata>.replace(head.metadata, Metadata());
        UnaryRequest(move(path), move(metadata), head.deadline, move(body))
    }
}

pub class Server {
    #copy: disabled
    var routes: coll.Vec<Route>;
    pub func init() : routes(coll.Vec<Route>()) {}
    pub func register(path: str, handler: *UnaryHandler) !void {
        registerRoute(path, RouteHandler.Unary(UnaryRoute.Synchronous(handler)))
    }
    // The shared handler must remain alive at a stable address while registered.
    pub unsafe func registerConcurrent<H: ConcurrentUnaryHandler + Shareable>(path: str, handler: *const H) !void {
        var route: *const ConcurrentUnaryHandler = handler;
        registerRoute(path, RouteHandler.Unary(UnaryRoute.Concurrent(route)))
    }
    pub func registerStreaming(path: str, handler: *StreamingHandler) !void {
        registerRoute(path, RouteHandler.Streaming(handler))
    }
    // The shared handler must remain alive at a stable address while registered.
    pub unsafe func registerConcurrentStreaming<H: ConcurrentStreamingHandler + Shareable>(
        path: str, handler: *const H) !void {
        var route: *const ConcurrentStreamingHandler = handler;
        registerRoute(path, RouteHandler.ConcurrentStreaming(route))
    }
    pub func serveTls(socket: tls.TlsStream, options: ServeOptions) !void {
        var settings = http2.Settings();
        settings.maxStreams = options.maxConcurrentStreams;
        var session = http2.openTls(http2.Role.Server, raw socket, settings)!;
        var stream = Transport(StreamSocket.Secure(move(socket)));
        stream.setTimeout(options.timeout)!;
        serve(raw stream, raw session, options, false, null)
    }
    pub func serveH2c(socket: net.TcpStream, options: ServeOptions) !void {
        var settings = http2.Settings();
        settings.maxStreams = options.maxConcurrentStreams;
        var session = http2.Connection.open(http2.Role.Server, settings)!;
        var stream = Transport(StreamSocket.Clear(move(socket)));
        stream.setTimeout(options.timeout)!;
        serve(raw stream, raw session, options, false, null)
    }
    pub func serveConcurrentH2c(socket: net.AsyncTcpStream, options: ServeOptions) !void {
        serveConcurrentH2c(move(socket), options, null)
    }
    pub func serveConcurrentH2c(socket: net.AsyncTcpStream, options: ServeOptions, stop: ?*const Shutdown) !void {
        var settings = http2.Settings();
        settings.maxStreams = options.maxConcurrentStreams;
        var session = http2.Connection.open(http2.Role.Server, settings)!;
        var stream = Transport(StreamSocket.AsyncClear(move(socket)));
        serve(raw stream, raw session, options, true, stop)
    }
    pub func acceptConcurrentTls(listener: *net.AsyncTcpListener, acceptor: *const tls.TlsAcceptor,
                             options: ServeOptions, deadline: ?time.Deadline) !void {
        acceptConcurrentTls(listener, acceptor, options, deadline, null)
    }
    pub func acceptConcurrentTls(listener: *net.AsyncTcpListener, acceptor: *const tls.TlsAcceptor,
                             options: ServeOptions, deadline: ?time.Deadline, stop: ?*const Shutdown) !void {
        socket, peer := listener.accept(deadline)!;
        var secure = acceptor.acceptAsync(move(socket), some(time.Deadline.after(options.timeout)!))!;
        var settings = http2.Settings();
        settings.maxStreams = options.maxConcurrentStreams;
        var session = http2.openTls(http2.Role.Server, raw secure, settings)!;
        var stream = Transport(StreamSocket.AsyncSecure(move(secure)));
        serve(raw stream, raw session, options, true, stop)
    }
    pub func acceptTls(listener: *net.TcpListener, acceptor: *const tls.TlsAcceptor, options: ServeOptions) !void {
        raw, _ := listener.accept()!;
        raw.setReadTimeout(some(options.timeout))!;
        raw.setWriteTimeout(some(options.timeout))!;
        var secure = acceptor.accept(move(raw))!;
        serveTls(move(secure), options)
    }
    func registerRoute(path: str, handler: RouteHandler) !void {
        if !validMethod(path) || find(path) != null { return RpcError.InvalidMethod; }
        var name = text.fromBytes(path.asBytes())!;
        routes.push(Route(move(name), handler))
    }
    const func find(path: str) ?RouteHandler {
        for route in routes.iterRef() {
            if route.path == path { return some(route.handler); }
        }
        null
    }
    func incoming(event: *const http2.Event, session: *http2.Connection) core.ResultOptional<HeaderInfo> {
        var head = parseHeaders(event) catch {
            sendError(session, event.stream, StatusCode.InvalidArgument)!;
            return null;
        };
        if !head.grpc || head.method != "POST" || !head.trailersExpected || !validMethod(head.path) {
            sendError(session, event.stream, StatusCode.InvalidArgument)!;
            return null;
        }
        if (head.encoding ?? MessageEncoding.Identity) == MessageEncoding.Unsupported {
            sendError(session, event.stream, StatusCode.Unimplemented)!;
            return null;
        }
        some(move(head))
    }
    func serve(wire: *Transport, session: *http2.Connection, options: ServeOptions, concurrent: bool,
               stop: ?*const Shutdown) !void {
        var calls = ConcurrentCalls(if concurrent { options.applicationWorkers } else { 1 })!;
        var watched: ?CompletionWatch = null;
        if concurrent { watched = some(CompletionWatch(wire.descriptor()!, calls.completionDescriptor()!, stop)!); }
        var storage = mem.zeroedBytes<4096>();
        var pendingTlsWrite = false;
        var active = coll.Vec<Incoming>();
        var deferred = DeferredEvents();
        var goingAway = false;
        var lastProcessed: i32 = 0;
        var drainDeadline: ?time.Deadline = null;
        var receiveDeadline: ?time.Deadline = null;
        for {
            var queuedWrite = false;
            if !pendingTlsWrite && drainDeadline == null && stop != null && stop.unwrap().requested()! {
                opt.asMutPtr<CompletionWatch>(raw watched).unwrap().stopWatchingShutdown()!;
                session.goAway(lastProcessed, 0)!;
                drainDeadline = some(time.Deadline.after(options.shutdownTimeout)!);
            }
            var timeout = options.timeout;
            if drainDeadline != null {
                var remaining = drainDeadline.unwrap().remaining()!;
                if remaining.isZero() { return RpcError.DeadlineExceeded; }
                if remaining.compare(timeout) == cmp.Ordering.Less { timeout = remaining; }
            }
            if !pendingTlsWrite {
                if concurrent {
                    calls.clearCompletionSignal()!;
                    calls.collect(session, options.maxMessageBytes)!;
                    wire.setTimeout(timeout)!;
                }
                session.flush(wire)!;
                if concurrent { queuedWrite = calls.advanceWrites(session)!; }
                if (goingAway || drainDeadline != null) && active.len() == 0 && !calls.pending() { return; }
            }
            var next = if pendingTlsWrite { null } else { deferred.next(session)! };
            var event = move(next) ?? {
                if queuedWrite { continue; }
                if concurrent {
                    if receiveDeadline == null { receiveDeadline = some(time.Deadline.after(options.timeout)!); }
                    var idle = receiveDeadline.unwrap();
                    if drainDeadline != null &&
                       drainDeadline.unwrap().instant().compare(idle.instant()) == cmp.Ordering.Less {
                        idle = drainDeadline.unwrap();
                    }
                    received, interest := wire.tryRead(storage[:]) catch (reason) {
                        if reason == tls.TlsError.UnexpectedEof && active.len() == 0 { return; }
                        return reason;
                    };
                    pendingTlsWrite = interest != null && interest.unwrap().writable;
                    if pendingTlsWrite {
                        task.waitDescriptor(wire.descriptor()!, reactor.Interest.write(), some(idle))!;
                        continue;
                    }
                    if interest != null {
                        var wake = opt.asMutPtr<CompletionWatch>(raw watched).unwrap();
                        wake.wait(calls.nextDeadline(idle)) catch (reason) {
                            if reason != io.IoError.DeadlineExceeded { return reason; }
                            if drainDeadline != null && drainDeadline.unwrap().expired()! { return RpcError.DeadlineExceeded; }
                            if idle.expired()! { return reason; }
                        };
                        continue;
                    }
                    if received == 0 {
                        if active.len() != 0 { return RpcError.ConnectionClosed; }
                        return;
                    }
                    session.ingest(storage[0..received])!;
                    receiveDeadline = null;
                } else {
                    var received = session.receive(wire) catch (reason) {
                        if reason == tls.TlsError.UnexpectedEof && active.len() == 0 { return; }
                        return reason;
                    };
                    if !received {
                        if active.len() != 0 { return RpcError.ConnectionClosed; }
                        return;
                    }
                }
                continue;
            };
            var runningStream = calls.streamAt(event.stream);
            if runningStream != null {
                var stream = runningStream.unwrap();
                switch event.kind {
                    http2.EventKind.Data => {
                        stream.data(session, event.payload()) catch (reason) {
                            if reason != http2.Http2Error.StreamClosed { return reason; }
                            stream.cancel();
                        };
                        continue;
                    },
                    http2.EventKind.EndStream => { stream.end(); continue; },
                    http2.EventKind.Closed => { stream.cancel(); continue; },
                    http2.EventKind.Headers => {
                        // Request metadata is sent in the initial header block.
                        session.reset(event.stream, 1)!;
                        stream.cancel();
                        continue;
                    },
                    _ => {},
                };
            }
            var position = callAt(raw active, event.stream);
            switch event.kind {
                http2.EventKind.Headers => {
                    if position != null {
                        session.reset(event.stream, 1)!;
                        active.swapRemove(position.unwrap());
                    } else {
                        if drainDeadline != null {
                            session.reset(event.stream, 7) catch (reason) { // REFUSED_STREAM
                                if reason != http2.Http2Error.StreamClosed { return reason; }
                            };
                            continue;
                        }
                        if event.stream > lastProcessed { lastProcessed = event.stream; }
                        var head = incoming(raw event, session)! ?? { continue; };
                        var handler = find(head.path) ?? {
                            sendError(session, event.stream, StatusCode.Unimplemented)!;
                            continue;
                        };
                        switch handler {
                            RouteHandler.Unary(handler) => {
                                active.push(Incoming(event.stream, handler, move(head), options.maxMessageBytes))!;
                            },
                            RouteHandler.Streaming(handler) => {
                                performStream(handler, wire, session, raw deferred, event.stream,
                                              move(head), options)!;
                            },
                            RouteHandler.ConcurrentStreaming(handler) => {
                                if !concurrent {
                                    sendError(session, event.stream, StatusCode.Unimplemented)!;
                                    continue;
                                }
                                if calls.count() >= usize(options.maxConcurrentStreams) {
                                    sendError(session, event.stream, StatusCode.ResourceExhausted)!;
                                    continue;
                                }
                                calls.startStream(event.stream, handler, move(head), options)
                                    catch { sendError(session, event.stream, StatusCode.ResourceExhausted)!; };
                            },
                        };
                    }
                },
                http2.EventKind.Data => {
                    if position != null {
                        var index = position.unwrap();
                        var item = active.getMutPtr(index).unwrap();
                        item.decoder.feed(event.payload()) catch (reason) {
                            sendError(session, event.stream, if reason == RpcError.MessageTooLarge || reason == RpcError.ResourceExhausted {
                                StatusCode.ResourceExhausted
                            } else { StatusCode.Internal })!;
                            active.swapRemove(index);
                        };
                    }
                    session.consume(event.stream, event.payload().len())!;
                },
                http2.EventKind.EndStream => {
                    if position != null {
                        var item = active.swapRemove(position.unwrap()).unwrap();
                        runHandler(session, raw item, options, raw calls, concurrent)!;
                    }
                },
                http2.EventKind.Closed => {
                    if concurrent { calls.cancel(event.stream); }
                    if position != null { active.swapRemove(position.unwrap()); }
                },
                http2.EventKind.GoAway => { goingAway = true; },
                _ => {},
            };
        }
    }
}

func callAt(calls: *const coll.Vec<Incoming>, stream: i32) ?usize {
    for index in usize(0)..calls.len() {
        if calls.getPtr(index).unwrap().stream == stream { return some(index); }
    }
    null
}

func runHandler(session: *http2.Connection, item: *Incoming, options: ServeOptions,
                calls: *ConcurrentCalls, concurrent: bool) !void {
    var deadline = item.head.deadline;
    if deadline != null && deadline.unwrap().expired()! {
        return sendError(session, item.stream, StatusCode.DeadlineExceeded);
    }
    var request = item.request() catch (reason) {
        return sendError(session, item.stream,
            if reason == RpcError.MessageTooLarge || reason == RpcError.ResourceExhausted { StatusCode.ResourceExhausted }
            else if reason == RpcError.UnsupportedEncoding { StatusCode.Unimplemented }
            else { StatusCode.InvalidArgument });
    };
    var compression = if options.compressResponses && item.head.acceptsCompressed {
        Compression.Gzip
    } else { Compression.Identity };
    switch item.route {
        UnaryRoute.Synchronous(handler) => {
            var result = handler.call(move(request)) catch {
                return sendError(session, item.stream, StatusCode.Internal);
            };
            if deadline != null && deadline.unwrap().expired()! {
                return sendError(session, item.stream, StatusCode.DeadlineExceeded);
            }
            sendUnaryResult(session, item.stream, raw result, options.maxMessageBytes, compression)
        },
        UnaryRoute.Concurrent(handler) => {
            if !concurrent { return sendError(session, item.stream, StatusCode.Unimplemented); }
            if calls.count() >= usize(options.maxConcurrentStreams) {
                return sendError(session, item.stream, StatusCode.ResourceExhausted);
            }
            calls.start(item.stream, handler, move(request), compression, options.maxMessageBytes)
                catch { return sendError(session, item.stream, StatusCode.ResourceExhausted); }
        },
    }
}

func sendUnaryResult(session: *http2.Connection, stream: i32, result: *const UnaryResponse,
                     limit: usize, compression: Compression) !void {
    if result.status.code == StatusCode.Ok && result.body == null {
        return sendError(session, stream, StatusCode.Internal);
    }
    sendResponse(session, stream, result, limit, compression)
}

func sendError(session: *http2.Connection, stream: i32, code: StatusCode) !void {
    var answer = reply(status(code, ""));
    sendResponse(session, stream, raw answer, 0, Compression.Identity)
}

func sendResponse(session: *http2.Connection, stream: i32,
                  response: *const UnaryResponse, limit: usize, compression: Compression) !void {
    var headers = http2.HeaderBlock();
    headers.add(":status", "200")!;
    headers.add("content-type", "application/grpc")!;
    headers.add("grpc-accept-encoding", "identity,gzip")!;
    if compression == Compression.Gzip && response.body != null { headers.add("grpc-encoding", "gzip")!; }
    response.initial.writeTo(raw headers)!;
    switch response.body {
        null => {
            if response.initial.items().len() == 0 {
                response.trailing.writeTo(raw headers)!;
                encodeStatus(raw headers, raw response.status)!;
                return session.respond(stream, raw headers, true);
            }
        },
        some(ref body) => {
            if body.len() > limit {
                return sendError(session, stream, StatusCode.ResourceExhausted);
            }
        },
    };
    var trailers = http2.HeaderBlock();
    response.trailing.writeTo(raw trailers)!;
    encodeStatus(raw trailers, raw response.status)!;
    session.respond(stream, raw headers, false)!;
    switch response.body {
        some(ref body) => {
            var payload = frameMessage(body.asConstSlice(), limit, compression)!;
            session.sendData(stream, payload.asConstSlice(), false)!;
        },
        null => {},
    };
    session.sendTrailers(stream, raw trailers)
}
