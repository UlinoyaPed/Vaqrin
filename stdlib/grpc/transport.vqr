package grpc
import (bytes, fmt, http2, io, net, reactor, text, time, tls, url)

enum StreamSocket { Clear(net.TcpStream), Secure(tls.TlsStream), AsyncClear(net.AsyncTcpStream), AsyncSecure(tls.TlsStream) }

class Transport {
    #copy: disabled
    #implements: io.Reader, io.Writer
    var stream: StreamSocket;
public:
    func init(socket: StreamSocket) : stream(move(socket)) {}
    func read(dst: []u8) !usize {
        switch stream {
            StreamSocket.Clear(ref mut raw) => raw.read(dst),
            StreamSocket.Secure(ref mut secure) => secure.read(dst),
            StreamSocket.AsyncClear(ref mut raw) => raw.read(dst),
            StreamSocket.AsyncSecure(ref mut secure) => secure.read(dst),
        }
    }
    func write(src: []const u8) !usize {
        switch stream {
            StreamSocket.Clear(ref mut raw) => raw.write(src),
            StreamSocket.Secure(ref mut secure) => secure.write(src),
            StreamSocket.AsyncClear(ref mut raw) => raw.write(src),
            StreamSocket.AsyncSecure(ref mut secure) => secure.write(src),
        }
    }
    func flush() !void {
        switch stream {
            StreamSocket.Clear(ref mut raw) => raw.flush(),
            StreamSocket.Secure(ref mut secure) => secure.flush(),
            StreamSocket.AsyncClear(ref mut raw) => raw.flush(),
            StreamSocket.AsyncSecure(ref mut secure) => secure.flush(),
        }
    }
    func close() !void {
        switch stream {
            StreamSocket.Clear(ref mut raw) => raw.close(),
            StreamSocket.Secure(ref mut secure) => secure.close(),
            StreamSocket.AsyncClear(ref mut raw) => raw.close(),
            StreamSocket.AsyncSecure(ref mut secure) => secure.close(),
        }
    }
    func setTimeout(timeout: time.Duration) !void {
        switch stream {
            StreamSocket.Clear(ref mut raw) => {
                raw.setReadTimeout(some(timeout))!;
                raw.setWriteTimeout(some(timeout))!;
            },
            StreamSocket.Secure(ref mut secure) => {
                secure.setReadTimeout(some(timeout))!;
                secure.setWriteTimeout(some(timeout))!;
            },
            StreamSocket.AsyncClear(ref mut raw) => {
                var deadline = some(time.Deadline.after(timeout)!);
                raw.setReadDeadline(deadline);
                raw.setWriteDeadline(deadline);
            },
            StreamSocket.AsyncSecure(ref mut secure) => {
                var deadline = some(time.Deadline.after(timeout)!);
                secure.setReadDeadline(deadline);
                secure.setWriteDeadline(deadline);
            },
        };
    }
    const func descriptor() !i32 {
        switch stream {
            StreamSocket.AsyncClear(ref raw) => raw.systemDescriptor(),
            StreamSocket.AsyncSecure(ref secure) => secure.systemDescriptor(),
            _ => { return io.IoError.Unsupported; },
        }
    }
    func tryRead(dst: []u8) !(usize, ?reactor.Interest) {
        switch stream {
            StreamSocket.AsyncClear(ref mut raw) => {
                var count = raw.tryRead(dst) catch (reason) {
                    if io.isWouldBlock(reason) { return (usize(0), some(reactor.Interest.read())); }
                    return reason;
                };
                return (count, null);
            },
            StreamSocket.AsyncSecure(ref mut secure) => { return secure.tryRead(dst); },
            _ => { return io.IoError.Unsupported; },
        }
    }
}

pub class DialOptions {
    pub var allowH2c: bool;
    pub var trustedRoots: ?str;
    pub var timeout: time.Duration;
    pub var maxMessageBytes: usize;
    pub var maxConcurrentCalls: usize;
    pub func init() : allowH2c(false), trustedRoots(null), timeout(time.Duration.fromSeconds(15)),
        maxMessageBytes(4 * 1024 * 1024), maxConcurrentCalls(16) {}
}

pub class CallOptions {
    #copy: disabled
    pub var metadata: Metadata;
    pub var deadline: ?time.Deadline;
    pub var compression: Compression;
    pub func init() : metadata(Metadata()), deadline(null), compression(Compression.Identity) {}
}

func connectTcp(host: str, port: u16, duration: time.Duration) !net.TcpStream {
    var addresses = net.resolveAddr(host, port)!;
    var unsuccessful: ErrorId = net.NetError.NameResolution;
    for address in addresses.asConstSlice() {
        var socket = net.TcpStream.connectTimeout(address, duration) catch (reason) {
            unsuccessful = reason;
            continue;
        };
        socket.setReadTimeout(some(duration))!;
        socket.setWriteTimeout(some(duration))!;
        return move(socket);
    }
    unsuccessful
}

pub func dial(endpoint: str, options: DialOptions) !ClientConn {
    var target = url.parse(endpoint)!;
    var host = target.host() ?? { return RpcError.InvalidEndpoint; };
    var secure = target.scheme() == "https";
    if !secure && !(target.scheme() == "http" && options.allowH2c) { return RpcError.InvalidEndpoint; }
    if target.userInfo() != null || target.query() != null || target.fragment() != null ||
       (target.path() != "" && target.path() != "/") { return RpcError.InvalidEndpoint; }
    var portDefault: u16 = if secure { 443 } else { 80 };
    var port = target.port() ?? portDefault;
    var authority = text.StringBuilder();
    var ipv6 = bytes.find(host.asBytes(), 58) != null;
    if ipv6 { authority.append("[")!; }
    authority.append(host)!;
    if ipv6 { authority.append("]")!; }
    if target.port() != null {
        var digits = fmt.formatUint(port, 10)!;
        authority.append(":")!;
        authority.append(digits)!;
    }
    var name = authority.build()!;
    var socket = connectTcp(host, port, options.timeout)!;
    if secure {
        var config = tls.TlsConfig();
        config.requireProtocol = true;
        config.addProtocol("h2".asBytes())!;
        if options.trustedRoots != null { config.setRootFile(options.trustedRoots.unwrap())!; }
        var tlsStream = tls.TlsStream.connect(move(socket), host, &config)!;
        var h2 = http2.openTls(http2.Role.Client, &tlsStream, http2.Settings())!;
        return ClientConn(Transport(StreamSocket.Secure(move(tlsStream))), move(h2), move(name), true, options);
    }
    var h2 = http2.Connection.open(http2.Role.Client, http2.Settings())!;
    ClientConn(Transport(StreamSocket.Clear(move(socket))), move(h2), move(name), false, options)
}

func validMethod(path: str) bool {
    var raw = path.asBytes();
    if raw.len() < 4 || raw[0] != 47 { return false; }
    var found = false;
    for index in usize(1)..raw.len() {
        var char = raw[index];
        if char == 47 {
            if found || index == 1 || index == raw.len() - 1 { return false; }
            found = true;
        } else if !(65 <= char && char <= 90) && !(97 <= char && char <= 122) &&
                  !(48 <= char && char <= 57) && char != 46 && char != 95 {
            return false;
        }
    }
    found
}
