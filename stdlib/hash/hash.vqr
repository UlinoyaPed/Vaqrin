package hash

pub interface Hasher {
    func write(bytes: []const u8) void;
    const func finish() usize;
}

pub interface HashKey {
    const func hash(state: *Hasher) void;
    const func equals(other: *const Self) bool;
}

pub class FnvHasher {
    #implements: Hasher
    var state: u32;
public:
    func init() : state(2166136261u32) {}
    func init(seed: u32) : state(2166136261u32 ^ seed) {}

    func writeByte(byte: u8) void {
        state = (state ^ u32(byte)) *% 16777619u32;
    }

    func write(bytes: []const u8) void {
        for byte in bytes { writeByte(byte); }
    }

    const func finish() usize { usize(state) }
    func reset() void { state = 2166136261u32; }
    func resetSeeded(seed: u32) void { state = 2166136261u32 ^ seed; }
}

pub func hashValue<T: HashKey>(value: *const T) usize {
    var hasher = FnvHasher();
    value.hash(&hasher);
    hasher.finish()
}

pub func hashValueSeeded<T: HashKey>(value: *const T, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    value.hash(&hasher);
    hasher.finish()
}

pub func hashBytes(bytes: []const u8) usize {
    var hasher = FnvHasher();
    hasher.write(bytes);
    hasher.finish()
}

pub func hashBytesSeeded(bytes: []const u8, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    hasher.write(bytes);
    hasher.finish()
}

pub func hashCombine(seed: usize, value: usize) usize {
    seed ^ (value +% usize(0x9e3779b9u32) +% (seed << 6) +% (seed >> 2))
}

pub func hashKey<T: HashKey>(value: *const T, seed: u32) usize {
    hashValueSeeded<T>(value, seed)
}

pub func equalKey<T: HashKey>(a: *const T, b: *const T) bool {
    a.equals(b)
}

pub func hashI8(value: *const i8, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    hasher.writeByte(bitCast<u8>(*value));
    hasher.finish()
}

pub func hashU8(value: *const u8, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    hasher.writeByte(*value);
    hasher.finish()
}

func byte32(value: u32) u8 { u8(value) catch { panic("hash byte conversion invariant"); } }
func byte64(value: u64) u8 { u8(value) catch { panic("hash byte conversion invariant"); } }

pub func hashI16(value: *const i16, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    var bits = u32(bitCast<u16>(*value));
    for i in usize(0)..2 {
        hasher.writeByte(byte32((bits >> (i * 8)) & 255u32));
    }
    hasher.finish()
}

pub func hashU16(value: *const u16, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    for i in usize(0)..2 {
        hasher.writeByte(byte32((u32(*value) >> (i * 8)) & 255u32));
    }
    hasher.finish()
}

pub func hashI32(value: *const i32, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    var bits = bitCast<u32>(*value);
    for i in usize(0)..4 {
        hasher.writeByte(byte32((bits >> (i * 8)) & 255u32));
    }
    hasher.finish()
}

pub func hashU32(value: *const u32, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    for i in usize(0)..4 {
        hasher.writeByte(byte32((*value >> (i * 8)) & 255u32));
    }
    hasher.finish()
}

pub func hashI64(value: *const i64, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    var bits = bitCast<u64>(*value);
    for i in usize(0)..8 {
        hasher.writeByte(byte64((bits >> (i * 8)) & 255u64));
    }
    hasher.finish()
}

pub func hashU64(value: *const u64, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    for i in usize(0)..8 {
        hasher.writeByte(byte64((*value >> (i * 8)) & 255u64));
    }
    hasher.finish()
}

pub func hashBool(value: *const bool, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    hasher.writeByte(if *value { 1u8 } else { 0u8 });
    hasher.finish()
}

pub func eqI8(a: *const i8, b: *const i8) bool { *a == *b }
pub func eqU8(a: *const u8, b: *const u8) bool { *a == *b }
pub func eqI16(a: *const i16, b: *const i16) bool { *a == *b }
pub func eqU16(a: *const u16, b: *const u16) bool { *a == *b }
pub func eqI32(a: *const i32, b: *const i32) bool { *a == *b }
pub func eqU32(a: *const u32, b: *const u32) bool { *a == *b }
pub func eqI64(a: *const i64, b: *const i64) bool { *a == *b }
pub func eqU64(a: *const u64, b: *const u64) bool { *a == *b }
pub func eqBool(a: *const bool, b: *const bool) bool { *a == *b }
