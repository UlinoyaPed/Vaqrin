package hash

pub interface Hasher {
    func write(bytes: []const u8) void;
    const func finish() usize;
}

pub interface HashKey {
    const func hash(state: *Hasher) void;
    const func equals(other: *const Self) bool;
}

pub class FnvHasher {
    #implements: Hasher
    var state: u32;
public:
    func init() : state(2166136261u32) {}
    func initSeeded(seed: u32) : state(2166136261u32 ^ seed) {}

    func write(bytes: []const u8) void {
        for byte in bytes {
            state = (state ^ u32(byte)) *% 16777619u32;
        }
    }

    const func finish() usize { usize(state) }
    func reset() void { state = 2166136261u32; }
    func resetSeeded(seed: u32) void { state = 2166136261u32 ^ seed; }
}

pub func hashValue<T: HashKey>(value: *const T) usize {
    var hasher = FnvHasher();
    value.hash(&hasher);
    hasher.finish()
}

pub func hashValueSeeded<T: HashKey>(value: *const T, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    value.hash(&hasher);
    hasher.finish()
}

pub func hashBytes(bytes: []const u8) usize {
    var hasher = FnvHasher();
    hasher.write(bytes);
    hasher.finish()
}

pub func hashBytesSeeded(bytes: []const u8, seed: u32) usize {
    var hasher = FnvHasher();
    hasher.resetSeeded(seed);
    hasher.write(bytes);
    hasher.finish()
}

pub func hashCombine(seed: usize, value: usize) usize {
    (seed ^ (value +% 0x9e3779b9usize +% (seed << 6) +% (seed >> 2)))
}
