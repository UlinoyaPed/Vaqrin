package http
import (bufio, io, net, opt, text, time, tls)

func dialAsync(host: str, port: u16, deadline: ?time.Deadline) !net.AsyncTcpStream {
    var raw = host.asBytes();
    if byteAt(raw, 58) < raw.len() {
        var address = net.SocketAddr.new(net.IpAddr.V6(net.parseIpv6(host)!), port);
        return net.AsyncTcpStream.connect(address, deadline);
    }
    var endpoints = net.resolveAddrAsync(host, port, deadline)!;
    var last: ErrorId = net.NetError.NameResolution;
    for endpoint in endpoints.asConstSlice() {
        var stream = net.AsyncTcpStream.connect(endpoint, deadline) catch (reason) {
            if reason == io.IoError.Cancelled || reason == io.IoError.DeadlineExceeded { return reason; }
            last = reason;
            continue;
        };
        return move(stream);
    }
    last
}

pub interface ResponseConsumer {
    func consume(head: *const Response, body: *io.Reader) !void;
}

// One sequential HTTP/1.1 session to a fixed origin.
pub class AsyncConnection {
    #copy: disabled
    var plain: ?net.AsyncTcpStream;
    var encrypted: ?tls.TlsStream;
    var authority: string;
    var limits: HttpLimits;
    var usable: bool;
    pub func init(plain: move ?net.AsyncTcpStream, encrypted: move ?tls.TlsStream, authority: string, limits: HttpLimits)
        : plain(move(plain)), encrypted(move(encrypted)), authority(move(authority)), limits(limits), usable(true) {}
    pub const func isOpen() bool { usable }

    pub func close() !void {
        usable = false;
        switch opt.asMutPtr<net.AsyncTcpStream>(raw plain) {
            some(socket) => return socket.close(),
            null => {},
        }
        switch opt.asMutPtr<tls.TlsStream>(raw encrypted) {
            some(socket) => return socket.close(),
            null => {},
        }
    }

    pub func send(request: *Request) !Response {
        sendUntil(request, some(time.Deadline.after(limits.timeout)!))
    }

    pub func sendUntil(request: *Request, deadline: ?time.Deadline) !Response {
        if !usable { return io.IoError.Closed; }
        request.headers().set("Host", authority)!;
        var requestClose = connectionClose(request.headers());
        var response = exchangeOnStream(request, deadline) catch (reason) {
            close() catch {};
            return reason;
        };
        if requestClose || !response.1 { close() catch {}; }
        reply, more := move(response);
        move(reply)
    }

    pub func sendStreaming(request: *Request, consumer: *ResponseConsumer) !void {
        sendStreamUntil(request, null, consumer, some(time.Deadline.after(limits.timeout)!))
    }

    pub func sendWithBodyStream(request: *Request, source: *io.Reader, consumer: *ResponseConsumer) !void {
        sendStreamUntil(request, some(source), consumer, some(time.Deadline.after(limits.timeout)!))
    }

    pub func sendStreamUntil(request: *Request, source: ?*io.Reader, consumer: *ResponseConsumer,
                      deadline: ?time.Deadline) !void {
        if !usable { return io.IoError.Closed; }
        request.headers().set("Host", authority)!;
        var requestClose = connectionClose(request.headers());
        var persisted = streamResponse(request, source, consumer, deadline) catch (reason) {
            close() catch {};
            return reason;
        };
        if requestClose || !persisted { close() catch {}; }
    }

    func streamResponse(request: *Request, source: ?*io.Reader, consumer: *ResponseConsumer,
                        deadline: ?time.Deadline) !bool {
        switch opt.asMutPtr<net.AsyncTcpStream>(raw plain) {
            some(socket) => {
                socket.setReadDeadline(deadline);
                socket.setWriteDeadline(deadline);
                return exchangeStreamed(socket, socket, request, source, limits, consumer);
            },
            null => {},
        }
        var secure = opt.asMutPtr<tls.TlsStream>(raw encrypted).unwrap();
        secure.setReadDeadline(deadline);
        secure.setWriteDeadline(deadline);
        exchangeStreamed(secure, secure, request, source, limits, consumer) catch (reason) { return httpTlsError(reason); }
    }

    func exchangeOnStream(request: *Request, deadline: ?time.Deadline) !(Response, bool) {
        switch opt.asMutPtr<net.AsyncTcpStream>(raw plain) {
            some(socket) => {
                socket.setReadDeadline(deadline);
                socket.setWriteDeadline(deadline);
                return exchangePersistent(socket, socket, request, limits);
            },
            null => {},
        }
        var secure = opt.asMutPtr<tls.TlsStream>(raw encrypted).unwrap();
        secure.setReadDeadline(deadline);
        secure.setWriteDeadline(deadline);
        exchangePersistent(secure, secure, request, limits) catch (reason) { return httpTlsError(reason); }
    }
}

func exchangePersistent(reader: *io.Reader, writer: *io.Writer, request: *Request,
                        limits: HttpLimits) !(Response, bool) {
    writeRequest(writer, request)!;
    var buffer = bufio.BufferedReader(reader, 8192)!;
    for attempt in 0..8 {
        response, persistent := parseResponseState(raw buffer, request.method(), limits)!;
        if response.status().value() >= 200 {
            return (move(response), persistent && buffer.bufferLen() == 0);
        }
    }
    HttpError.TooManyResponses
}

func exchangeStreamed(reader: *io.Reader, writer: *io.Writer, request: *Request, source: ?*io.Reader,
                      limits: HttpLimits, consumer: *ResponseConsumer) !bool {
    if source != null { writeRequestStream(writer, request, source.unwrap(), limits.maxBodyBytes)!; }
    else { writeRequest(writer, request)!; }
    var buffer = bufio.BufferedReader(reader, 8192)!;
    for attempt in 0..8 {
        response, body, persistent := parseResponseHead(raw buffer, request.method(), limits)!;
        if response.status().value() < 200 { continue; }
        consumer.consume(raw response, raw body)!;
        return persistent && body.isComplete() && buffer.bufferLen() == 0;
    }
    HttpError.TooManyResponses
}

pub class AsyncClient {
    pub var limits: HttpLimits;
    var tlsOptions: tls.TlsConfig;
    pub func init() : limits(HttpLimits()), tlsOptions(tls.TlsConfig()) {}
    pub func setTimeout(timeout: time.Duration) void { limits.timeout = timeout; }
    pub func setRootFile(path: str) !void { tlsOptions.setRootFile(path) }

    pub const func connect(address: str) !AsyncConnection {
        connectUntil(address, some(time.Deadline.after(limits.timeout)!))
    }

    pub const func connectUntil(address: str, deadline: ?time.Deadline) !AsyncConnection {
        var target = parseUrl(address)!;
        var secure = sameName(target.scheme(), "https");
        if !secure && !sameName(target.scheme(), "http") { return HttpError.UnsupportedScheme; }
        var host = httpHost(raw target)!;
        var authority = hostHeader(raw target, host)!;
        var defaultPort: u16 = if secure { 443 } else { 80 };
        var socket = dialAsync(host, target.port() ?? defaultPort, deadline)!;
        if secure {
            var encrypted = tlsOptions.connectAsync(move(socket), host, deadline) catch (reason) {
                return httpTlsError(reason);
            };
            return AsyncConnection(null, some(move(encrypted)), move(authority), limits);
        }
        AsyncConnection(some(move(socket)), null, move(authority), limits)
    }

    pub const func send(address: str, request: *Request) !Response {
        var target = parseUrl(address)!;
        sendTo(raw target, request)
    }
    pub const func request(address: str, method: Method, body: move Body) !Response {
        var target = parseUrl(address)!;
        var path = pathTarget(raw target)!;
        var message = Request.new(method, path)!;
        message.setBody(move(body));
        sendTo(raw target, raw message)
    }
    pub const func get(address: str) !Response { request(address, Method.GET, Body()) }
    pub const func head(address: str) !Response { request(address, Method.HEAD, Body()) }
    pub const func post(address: str, body: move Body) !Response { request(address, Method.POST, move(body)) }
    const func sendTo(target: *const Url, request: *Request) !Response {
        var deadline = some(time.Deadline.after(limits.timeout)!);
        var secure = sameName(target.scheme(), "https");
        if !secure && !sameName(target.scheme(), "http") { return HttpError.UnsupportedScheme; }
        var host = httpHost(target)!;
        var authority = hostHeader(target, host)!;
        request.headers().set("Host", authority)!;
        request.headers().set("Connection", "close")!;
        var defaultPort: u16 = if secure { 443 } else { 80 };
        var stream = dialAsync(host, target.port() ?? defaultPort, deadline)!;
        stream.setReadDeadline(deadline);
        stream.setWriteDeadline(deadline);
        if secure {
            var encrypted = tlsOptions.connectAsync(move(stream), host, deadline) catch (reason) {
                return httpTlsError(reason);
            };
            return exchange(raw encrypted, raw encrypted, request, limits) catch (reason) {
                return httpTlsError(reason);
            };
        }
        exchange(raw stream, raw stream, request, limits)
    }
}

pub interface RequestConsumer {
    func consume(head: *const Request, body: *io.Reader) !Response;
}

pub class AsyncServer {
    #copy: disabled
    var listener: net.AsyncTcpListener;
    pub var limits: HttpLimits;
    func init(value: move net.AsyncTcpListener) : listener(move(value)), limits(HttpLimits()) {}
    pub static func bind(address: net.SocketAddr) !Self { AsyncServer(net.AsyncTcpListener.bind(address)!) }
    pub const func localAddr() !net.SocketAddr { listener.localAddr() }
    pub func close() !void { listener.close() }

    pub func serveOne(handler: *Handler, acceptDeadline: ?time.Deadline) !void {
        socket, peer := listener.accept(acceptDeadline)!;
        var deadline = some(time.Deadline.after(limits.timeout)!);
        socket.setReadDeadline(deadline);
        socket.setWriteDeadline(deadline);
        serveHttp(raw socket, raw socket, handler, limits)
    }

    pub func serveOneStreaming(handler: *RequestConsumer, acceptDeadline: ?time.Deadline) !void {
        socket, peer := listener.accept(acceptDeadline)!;
        var deadline = some(time.Deadline.after(limits.timeout)!);
        socket.setReadDeadline(deadline);
        socket.setWriteDeadline(deadline);
        serveStreamedHttp(raw socket, raw socket, handler, limits)
    }

    pub func serveOneStreamingTls(handler: *RequestConsumer, config: *const tls.TlsAcceptor,
                              acceptDeadline: ?time.Deadline) !void {
        socket, peer := listener.accept(acceptDeadline)!;
        var deadline = some(time.Deadline.after(limits.timeout)!);
        var stream = config.acceptAsync(move(socket), deadline)!;
        serveStreamedHttp(raw stream, raw stream, handler, limits)
    }

    pub func serveOneTls(handler: *Handler, config: *const tls.TlsAcceptor, acceptDeadline: ?time.Deadline) !void {
        socket, peer := listener.accept(acceptDeadline)!;
        var deadline = some(time.Deadline.after(limits.timeout)!);
        var stream = config.acceptAsync(move(socket), deadline)!;
        serveHttp(raw stream, raw stream, handler, limits)
    }
}

func serveHttp(reader: *io.Reader, writer: *io.Writer, handler: *Handler, limits: HttpLimits) !void {
    var buffer = bufio.BufferedReader(reader, 8192)!;
    var request = parseRequest(raw buffer, limits)!;
    var method = request.method();
    var response = handler.handle(move(request))!;
    response.headers().set("Connection", "close")!;
    writeResponseFor(writer, raw response, method)
}


func serveStreamedHttp(reader: *io.Reader, writer: *io.Writer, handler: *RequestConsumer,
                       limits: HttpLimits) !void {
    var buffer = bufio.BufferedReader(reader, 8192)!;
    request, body := parseRequestStream(raw buffer, limits)!;
    var response = handler.consume(raw request, raw body)!;
    response.headers().set("Connection", "close")!;
    writeResponseFor(writer, raw response, request.method())
}
