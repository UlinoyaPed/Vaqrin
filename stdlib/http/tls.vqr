package http
import (tls)

pub error TlsError { Unavailable, SetupFailed, TrustStore, Certificate, Handshake, Protocol }

func httpTlsError(reason: ErrorId) ErrorId {
    if reason == tls.TlsError.Unavailable { return TlsError.Unavailable; }
    if reason == tls.TlsError.SetupFailed || reason == tls.TlsError.InvalidName { return TlsError.SetupFailed; }
    if reason == tls.TlsError.TrustStore { return TlsError.TrustStore; }
    if reason == tls.TlsError.Certificate { return TlsError.Certificate; }
    if reason == tls.TlsError.Handshake { return TlsError.Handshake; }
    if reason == tls.TlsError.Protocol || reason == tls.TlsError.UnexpectedEof { return TlsError.Protocol; }
    reason
}
