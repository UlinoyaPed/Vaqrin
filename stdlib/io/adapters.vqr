package io
import (coll, mem)

pub class LimitedReader {
    #implements: Reader
    var source: *Reader;
    var limit: u64;
    pub func init(reader: *Reader, limit: u64) : source(reader), limit(limit) {}

    pub const func remaining() u64 { limit }

    pub func read(dst: []u8) !usize {
        if limit == 0 || dst.len() == 0 { return 0; }
        var capacity = usableBytes(limit, dst.len());
        var count = source.read(dst[0..capacity])!;
        if count > capacity { return IoError.InvalidCount; }
        limit -= u64(count);
        count
    }
}

pub func limit(reader: *Reader, n: u64) LimitedReader { LimitedReader(reader, n) }

pub class CountingReader {
    #implements: Reader
    var source: *Reader;
    var processed: u64;
    pub func init(reader: *Reader) : source(reader), processed(0) {}
    pub const func count() u64 { processed }

    pub func read(dst: []u8) !usize {
        if dst.len() == 0 { return 0; }
        var count = source.read(dst)!;
        if count > dst.len() || u64(count) > ~u64(0) - processed { return IoError.InvalidCount; }
        processed += u64(count);
        count
    }
}

pub class CountingWriter {
    #implements: Writer
    var target: *Writer;
    var processed: u64;
    pub func init(writer: *Writer) : target(writer), processed(0) {}
    pub const func count() u64 { processed }

    pub func write(src: []const u8) !usize {
        if src.len() == 0 { return 0; }
        var count = target.write(src)!;
        if count > src.len() || u64(count) > ~u64(0) - processed { return IoError.InvalidCount; }
        if count == 0 { return IoError.NoProgress; }
        processed += u64(count);
        count
    }

    pub func flush() !void { target.flush() }
}

pub class MultiReader {
    #implements: Reader
    var sources: []const *Reader;
    var index: usize;
    pub func init(sources: []const *Reader) : sources(sources), index(0) {}

    pub func read(dst: []u8) !usize {
        if dst.len() == 0 { return 0; }
        while index < sources.len() {
            var count = sources[index].read(dst)!;
            if count > dst.len() { return IoError.InvalidCount; }
            if count != 0 { return count; }
            index++;
        }
        0
    }
}

pub class MultiWriter {
    #copy: disabled
    #implements: Writer
    var targets: []const *Writer;
    var pending: coll.Vec<u8>;
    var targetIndex: usize;
    var processed: usize;
    pub func init(targets: []const *Writer)
        : targets(targets), pending(coll.Vec<u8>()), targetIndex(0), processed(0) {}

    // After an error, retry with the same unacknowledged prefix.
    pub func write(data: []const u8) !usize {
        if data.len() == 0 || targets.len() == 0 { return data.len(); }
        if pending.isEmpty() {
            pending.reserve(data.len())!;
            for byte in data { pending.push(byte)!; }
        } else {
            if data.len() < pending.len() { return IoError.InvalidArgument; }
            for i in usize(0)..pending.len() {
                if data[i] != pending[i] { return IoError.InvalidArgument; }
            }
        }
        while targetIndex < targets.len() {
            writeAll(targets[targetIndex], pending.asConstSlice(), raw processed)!;
            targetIndex++;
            processed = 0;
        }
        var count = pending.len();
        pending.clear();
        targetIndex = 0;
        count
    }

    pub func flush() !void {
        if !pending.isEmpty() { return IoError.WouldBlock; }
        for target in targets { target.flush()!; }
    }
}

pub class TeeReader {
    #copy: disabled
    #implements: Reader
    var source: *Reader;
    var mirror: *Writer;
    var pending: [4096]u8;
    var filled: usize;
    var written: usize;
    var delivered: usize;
    pub func init(reader: *Reader, writer: *Writer)
        : source(reader), mirror(writer), pending(mem.zeroedBytes<4096>()), filled(0), written(0), delivered(0) {}
    pub func read(dst: []u8) !usize {
        if dst.len() == 0 { return 0; }
        var buffer = pending[:];
        if delivered == filled {
            var limit = if dst.len() < buffer.len() { dst.len() } else { buffer.len() };
            var count = source.read(buffer[0..limit])!;
            if count > limit { return IoError.InvalidCount; }
            filled = count;
            written = 0;
            delivered = 0;
            if filled == 0 { return 0; }
        }
        writeAll(mirror, buffer[0..filled], raw written)!;
        var available = filled - delivered;
        var count = if dst.len() < available { dst.len() } else { available };
        mem.copyBytes(buffer[delivered..delivered + count], dst[0..count])!;
        delivered += count;
        count
    }
}
pub func tee(reader: *Reader, writer: *Writer) TeeReader { TeeReader(reader, writer) }
