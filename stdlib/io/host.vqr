package io
import (core, coll, text, mem)

extern "C" func __vqr_io_open(path: *const u8, flags: u32, mode: u32, status: *i32) i32;
extern "C" func __vqr_io_file_read(fd: i32, dst: *u8, length: usize, status: *i32) isize;
extern "C" func __vqr_io_file_write(fd: i32, src: *const u8, length: usize, status: *i32) isize;
extern "C" func __vqr_io_file_read_at(fd: i32, dst: *u8, length: usize, offset: u64, status: *i32) isize;
extern "C" func __vqr_io_file_write_at(fd: i32, src: *const u8, length: usize, offset: u64, status: *i32) isize;
extern "C" func __vqr_io_file_seek(fd: i32, offset: i64, origin: i32, status: *i32) i64;
extern "C" func __vqr_io_file_close(fd: i32, status: *i32) i32;
extern "C" func __vqr_io_file_sync(fd: i32, dataOnly: i32, status: *i32) i32;
extern "C" func __vqr_io_file_truncate(fd: i32, size: u64, status: *i32) i32;
extern "C" func __vqr_io_file_metadata(fd: i32, size: *u64, mode: *u32, modified: *i64, kind: *i32, device: *u64, inode: *u64, status: *i32) i32;
extern "C" func __vqr_io_file_set_mode(fd: i32, mode: u32, status: *i32) i32;
extern "C" func __vqr_io_stat(path: *const u8, follow: i32, size: *u64, mode: *u32, modified: *i64, kind: *i32, device: *u64, inode: *u64, status: *i32) i32;
extern "C" func __vqr_io_mkdir(path: *const u8, mode: u32, status: *i32) i32;
extern "C" func __vqr_io_remove(path: *const u8, status: *i32) i32;
extern "C" func __vqr_io_remove_dir(path: *const u8, status: *i32) i32;
extern "C" func __vqr_io_rename(from: *const u8, to: *const u8, status: *i32) i32;
extern "C" func __vqr_io_chmod(path: *const u8, mode: u32, status: *i32) i32;
extern "C" func __vqr_io_dir_open(path: *const u8, status: *i32) usize;
extern "C" func __vqr_io_dir_next(dir: *u8, name: *u8, capacity: usize, length: *usize, kind: *i32, status: *i32) i32;
extern "C" func __vqr_io_dir_close(dir: *u8, status: *i32) i32;
extern "C" func __vqr_io_getcwd(buffer: *u8, capacity: usize, length: *usize, status: *i32) i32;
extern "C" func __vqr_io_chdir(path: *const u8, status: *i32) i32;

extern "C" func __vqr_io_symlink(target: *const u8, name: *const u8) i32;
extern "C" func __vqr_io_readlink(name: *const u8, dst: *u8, size: usize, reason: *i32) isize;
extern "C" func __vqr_io_dir_open_at(parent: i32, name: *const u8, reason: *i32) usize;
extern "C" func __vqr_io_dir_open_nofollow(name: *const u8, reason: *i32) usize;
extern "C" func __vqr_io_dir_fd(handle: usize) i32;
extern "C" func __vqr_io_unlink_at(dir: i32, name: *const u8, isDir: i32) i32;
extern "C" func __vqr_io_rename_at(dir: i32, old: *const u8, replacement: *const u8) i32;
extern "C" func __vqr_io_sync_dir(dir: i32) i32;
extern "C" func __vqr_io_temp_at(dir: i32, name: *u8, folder: i32, reason: *i32) i32;
extern "C" func __vqr_io_remove_tree_at(dir: i32, name: *const u8, depth: u32) i32;

func cString(value: []const u8) !coll.Vec<u8> {
    if value.len() == ~usize(0) { return IoError.InvalidArgument; }
    var output = coll.Vec<u8>.withCapacity(value.len() + 1)!;
    for byte in value {
        if byte == 0 { return IoError.InvalidArgument; }
        output.push(byte)!;
    }
    output.push(0)!;
    move(output)
}

func component(name: str) ![256]u8 {
    if name.byteLen() == 0 || name == "." || name == ".." { return IoError.InvalidArgument; }
    if name.byteLen() > 255 { return IoError.LimitExceeded; }
    var result = mem.zeroedBytes<256>();
    var input = name.asBytes();
    for index in usize(0)..input.len() {
        if input[index] == 0 || input[index] == 47 { return IoError.InvalidArgument; }
        result[index] = input[index];
    }
    result
}

func checkNative(reason: i32) !void {
    if reason != 0 { return systemError(reason); }
}

pub func systemError(code: i32) ErrorId {
    if code <= 0 || code > 0x3fffffff { return IoError.InvalidArgument; }
    __vqr_encode_system_error(code)
}

pub func systemErrorCode(reason: ErrorId) ?i32 { __vqr_decode_system_error(reason) }

pub func isSystemError(reason: ErrorId) bool {
    switch systemErrorCode(reason) { some(code) => true, null => false }
}

pub func isInterrupted(reason: ErrorId) bool {
    if reason == IoError.Interrupted { return true; }
    switch systemErrorCode(reason) { some(code) => code == 4, null => false }
}

pub func isWouldBlock(reason: ErrorId) bool {
    if reason == IoError.WouldBlock { return true; }
    switch systemErrorCode(reason) { some(code) => code == __vqr_posix_would_block(), null => false }
}

pub class FileIdentity {
    pub var device: u64;
    pub var inode: u64;
    pub const func matches(other: FileIdentity) bool {
        device == other.device && inode == other.inode
    }
}

pub class HostMetadata {
    var fileSize: u64;
    var permissionMode: u32;
    var modified: i64;
    var kind: i32;
    var fileId: ?FileIdentity;
    pub func init(size: u64, mode: u32, modified: i64, kind: i32)
        : self(size, mode, modified, kind, null) {}
    pub func init(size: u64, mode: u32, modified: i64, kind: i32, fileId: ?FileIdentity)
        : fileSize(size), permissionMode(mode), modified(modified), kind(kind), fileId(fileId) {}
    pub const func size() u64 { fileSize }
    pub const func mode() u32 { permissionMode }
    pub const func modifiedUnixSeconds() i64 { modified }
    pub const func kindCode() i32 { kind }
    pub const func identity() ?FileIdentity { fileId }
}

pub class HostFile {
    #copy: disabled
    #implements: Reader, Writer, Seeker, ReaderAt, WriterAt, Closer
    var descriptor: i32;
    var owns: bool;
    var appendMode: bool;
    var closed: bool;
    func init(fd: i32, ownsDescriptor: bool, append: bool)
        : descriptor(fd), owns(ownsDescriptor), appendMode(append), closed(false) {}
    pub static func open(path: []const u8, flags: u32, mode: u32) !Self {
        var name = cString(path)!;
        var errorCode: i32 = 0;
        var fd = unsafe { __vqr_io_open(raw name[0], flags, mode, raw errorCode) };
        if fd < 0 { return systemError(errorCode); }
        HostFile(fd, true, (flags & 4) != 0)
    }

    pub static func tempIn(parent: *const HostDirectory) !(Self, string) {
        var dir = parent.systemDescriptor()!;
        var name = mem.zeroedBytes<25>();
        var reason: i32 = 0;
        var fd = unsafe { __vqr_io_temp_at(dir, raw name[0], 0, raw reason) };
        if fd < 0 { return systemError(reason); }
        var file = HostFile(fd, true, false);
        var path = text.fromBytes(name[0..24]) catch (failure) {
            unsafe { __vqr_io_unlink_at(dir, raw name[0], 0); }
            return failure;
        };
        (move(file), move(path))
    }

    pub static func standardInput() Self { HostFile(0, false, false) }
    pub static func standardOutput() Self { HostFile(1, false, false) }
    pub static func standardError() Self { HostFile(2, false, false) }

    // A borrowed OS descriptor. Its ownership remains with this file.
    pub const func systemDescriptor() !i32 {
        if closed { return IoError.Closed; }
        descriptor
    }

    pub func read(dst: []u8) !usize {
        if closed { return IoError.Closed; }
        if dst.len() == 0 { return 0; }
        var errorCode: i32 = 0;
        var count = unsafe { __vqr_io_file_read(descriptor, raw dst[0], dst.len(), raw errorCode) };
        if count < 0 { return systemError(errorCode); }
        if usize(count)! > dst.len() { return IoError.InvalidCount; }
        usize(count)
    }

    pub func write(src: []const u8) !usize {
        if closed { return IoError.Closed; }
        if src.len() == 0 { return 0; }
        var errorCode: i32 = 0;
        var count = unsafe { __vqr_io_file_write(descriptor, raw src[0], src.len(), raw errorCode) };
        if count < 0 { return systemError(errorCode); }
        if usize(count)! > src.len() { return IoError.InvalidCount; }
        usize(count)
    }


    pub func readAt(offset: u64, dst: []u8) !usize {
        if closed { return IoError.Closed; }
        if dst.len() == 0 { return 0; }
        var errorCode: i32 = 0;
        var count = unsafe { __vqr_io_file_read_at(descriptor, raw dst[0], dst.len(), offset, raw errorCode) };
        if count < 0 { return systemError(errorCode); }
        if usize(count)! > dst.len() { return IoError.InvalidCount; }
        usize(count)
    }

    pub func writeAt(offset: u64, src: []const u8) !usize {
        if closed { return IoError.Closed; }
        if appendMode { return IoError.Unsupported; }
        if src.len() == 0 { return 0; }
        var errorCode: i32 = 0;
        var count = unsafe { __vqr_io_file_write_at(descriptor, raw src[0], src.len(), offset, raw errorCode) };
        if count < 0 { return systemError(errorCode); }
        if usize(count)! > src.len() { return IoError.InvalidCount; }
        usize(count)
    }

    pub func seek(offset: i64, origin: SeekOrigin) !u64 {
        if closed { return IoError.Closed; }
        var base = switch origin {
            SeekOrigin.Start => 0,
            SeekOrigin.Current => 1,
            SeekOrigin.End => 2,
        };
        var errorCode: i32 = 0;
        var position = unsafe { __vqr_io_file_seek(descriptor, offset, base, raw errorCode) };
        if position < 0 { return systemError(errorCode); }
        u64(position)
    }

    pub func flush() !void { if closed { return IoError.Closed; } }

    pub func syncAll() !void {
        if closed { return IoError.Closed; }
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_file_sync(descriptor, 0, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
    }

    pub func syncData() !void {
        if closed { return IoError.Closed; }
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_file_sync(descriptor, 1, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
    }

    pub func truncate(size: u64) !void {
        if closed { return IoError.Closed; }
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_file_truncate(descriptor, size, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
    }

    pub func metadata() !HostMetadata {
        if closed { return IoError.Closed; }
        var size: u64 = 0;
        var mode: u32 = 0;
        var modified: i64 = 0;
        var kind: i32 = 0;
        var device: u64 = 0;
        var inode: u64 = 0;
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_file_metadata(descriptor, raw size, raw mode, raw modified, raw kind, raw device, raw inode, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
        HostMetadata(size, mode, modified, kind, some(FileIdentity{device: device, inode: inode}))
    }

    pub func setMode(mode: u32) !void {
        if closed { return IoError.Closed; }
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_file_set_mode(descriptor, mode, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
    }

    pub func close() !void {
        if closed || !owns { closed = true; return; }
        var fd = descriptor;
        descriptor = -1;
        closed = true;
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_file_close(fd, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
    }

    pub func deinit() void { close() catch {}; }
}

pub class HostDirEntry {
    var entryName: string;
    var kind: i32;
    pub func init(name: string, kind: i32) : entryName(name), kind(kind) {}
    pub const func name() str { unsafe { __vqr_text_borrow_utf8(entryName.asBytes()) } }
    pub const func kindCode() i32 { kind }
}

pub class HostDirectory {
    #copy: disabled
    var handle: usize;
    func init(handle: usize) : handle(handle) {}
    pub static func open(path: []const u8) !Self {
        var name = cString(path)!;
        var errorCode: i32 = 0;
        var directory = unsafe { __vqr_io_dir_open(raw name[0], raw errorCode) };
        if directory == 0 { return systemError(errorCode); }
        HostDirectory(directory)
    }

    pub static func openNoFollow(path: []const u8) !Self {
        var name = cString(path)!;
        var reason: i32 = 0;
        var directory = unsafe { __vqr_io_dir_open_nofollow(raw name[0], raw reason) };
        if directory == 0 { return systemError(reason); }
        HostDirectory(directory)
    }

    pub const func systemDescriptor() !i32 {
        if handle == 0 { return IoError.Closed; }
        unsafe { __vqr_io_dir_fd(handle) }
    }

    pub const func openChild(name: str) !Self {
        var child = component(name)!;
        var fd = systemDescriptor()!;
        var reason: i32 = 0;
        var directory = unsafe { __vqr_io_dir_open_at(fd, raw child[0], raw reason) };
        if directory == 0 { return systemError(reason); }
        HostDirectory(directory)
    }

    pub const func removeChild(name: str, directory: bool) !void {
        var child = component(name)!;
        var fd = systemDescriptor()!;
        checkNative(unsafe { __vqr_io_unlink_at(fd, raw child[0], if directory { 1 } else { 0 }) })
    }

    pub const func removeTree(name: str, depth: u32) !void {
        if depth > 128 { return IoError.LimitExceeded; }
        var child = component(name)!;
        var fd = systemDescriptor()!;
        checkNative(unsafe { __vqr_io_remove_tree_at(fd, raw child[0], depth) })
    }

    pub const func replaceChild(from: str, to: str) !void {
        var source = component(from)!;
        var destination = component(to)!;
        var fd = systemDescriptor()!;
        checkNative(unsafe { __vqr_io_rename_at(fd, raw source[0], raw destination[0]) })
    }

    pub const func sync() !void {
        var fd = systemDescriptor()!;
        checkNative(unsafe { __vqr_io_sync_dir(fd) })
    }

    pub const func makeTempDir() !string {
        var fd = systemDescriptor()!;
        var name = mem.zeroedBytes<25>();
        var reason: i32 = 0;
        var result = unsafe { __vqr_io_temp_at(fd, raw name[0], 1, raw reason) };
        if result < 0 { return systemError(reason); }
        text.fromBytes(name[0..24]) catch (failure) {
            unsafe { __vqr_io_unlink_at(fd, raw name[0], 1); }
            return failure;
        }
    }

    pub func next() core.ResultOptional<HostDirEntry> {
        if handle == 0 { return IoError.Closed; }
        var directory = unsafe { ptrFromInt<*u8>(handle) };
        var storage = __vqr_uninitialized<[4096]u8>();
        var name = unsafe { (*__vqr_raw_address(raw storage))[:] };
        mem.zeroBytes(name);
        var length: usize = 0;
        var kind: i32 = 0;
        var errorCode: i32 = 0;
        var status = unsafe { __vqr_io_dir_next(directory, raw name[0], name.len(), raw length, raw kind, raw errorCode) };
        if status == 0 { return null; }
        if status < 0 { return systemError(errorCode); }
        var value = text.fromBytes(name[0..length])!;
        some(HostDirEntry(move(value), kind))
    }

    pub func close() !void {
        if handle == 0 { return; }
        var directory = unsafe { ptrFromInt<*u8>(handle) };
        handle = 0;
        var errorCode: i32 = 0;
        if unsafe { __vqr_io_dir_close(directory, raw errorCode) } != 0 {
            return systemError(errorCode);
        }
    }

    pub func deinit() void { close() catch {}; }
}
pub func hostStat(path: []const u8, follow: bool) !HostMetadata {
    var name = cString(path)!;
    var size: u64 = 0;
    var mode: u32 = 0;
    var modified: i64 = 0;
    var kind: i32 = 0;
    var device: u64 = 0;
    var inode: u64 = 0;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_stat(raw name[0], if follow { 1 } else { 0 }, raw size, raw mode, raw modified, raw kind, raw device, raw inode, raw errorCode) } != 0 {
        return systemError(errorCode);
    }
    HostMetadata(size, mode, modified, kind, some(FileIdentity{device: device, inode: inode}))
}

pub func hostSymlink(target: []const u8, path: []const u8) !void {
    var value = cString(target)!;
    var name = cString(path)!;
    checkNative(unsafe { __vqr_io_symlink(raw value[0], raw name[0]) })
}

pub func hostReadLink(path: []const u8) !string {
    var name = cString(path)!;
    var storage = __vqr_uninitialized<[4096]u8>();
    var buffer = unsafe { (*__vqr_raw_address(raw storage))[:] };
    mem.zeroBytes(buffer);
    var reason: i32 = 0;
    var size = unsafe { __vqr_io_readlink(raw name[0], raw buffer[0], buffer.len(), raw reason) };
    if size < 0 { return systemError(reason); }
    var count = usize(size)!;
    if count >= buffer.len() { return IoError.LimitExceeded; }
    text.fromBytes(buffer[0..count])
}

pub func hostMkdir(path: []const u8, mode: u32) !void {
    var name = cString(path)!;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_mkdir(raw name[0], mode, raw errorCode) } != 0 { return systemError(errorCode); }
}

pub func hostRemove(path: []const u8) !void {
    var name = cString(path)!;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_remove(raw name[0], raw errorCode) } != 0 { return systemError(errorCode); }
}

pub func hostRemoveDir(path: []const u8) !void {
    var name = cString(path)!;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_remove_dir(raw name[0], raw errorCode) } != 0 { return systemError(errorCode); }
}

pub func hostRename(from: []const u8, to: []const u8) !void {
    var source = cString(from)!;
    var target = cString(to)!;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_rename(raw source[0], raw target[0], raw errorCode) } != 0 {
        return systemError(errorCode);
    }
}

pub func hostChmod(path: []const u8, mode: u32) !void {
    var name = cString(path)!;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_chmod(raw name[0], mode, raw errorCode) } != 0 { return systemError(errorCode); }
}

pub func currentDir() !string {
    var storage = __vqr_uninitialized<[4096]u8>();
    var buffer = unsafe { (*__vqr_raw_address(raw storage))[:] };
    mem.zeroBytes(buffer);
    var length: usize = 0;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_getcwd(raw buffer[0], buffer.len(), raw length, raw errorCode) } != 0 {
        return systemError(errorCode);
    }
    text.fromBytes(buffer[0..length])
}

pub func setCurrentDir(path: []const u8) !void {
    var name = cString(path)!;
    var errorCode: i32 = 0;
    if unsafe { __vqr_io_chdir(raw name[0], raw errorCode) } != 0 { return systemError(errorCode); }
}

pub func stdin() HostFile { HostFile.standardInput() }
pub func stdout() HostFile { HostFile.standardOutput() }
pub func stderr() HostFile { HostFile.standardError() }
pub func flushStdout() !void { var output = stdout(); output.flush() }
