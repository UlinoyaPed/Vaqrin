package io
import (coll, mem, text)

pub interface Reader { func read(dst: []u8) !usize; }
pub interface Writer {
    func write(src: []const u8) !usize;
    func flush() !void;
}
pub interface Seeker { func seek(offset: i64, origin: SeekOrigin) !u64; }
pub interface ReaderAt { func readAt(offset: u64, dst: []u8) !usize; }
pub interface WriterAt { func writeAt(offset: u64, src: []const u8) !usize; }
pub interface Closer { func close() !void; }

pub enum SeekOrigin { Start, Current, End }
pub enum ReadStatus { Bytes, Eof, WouldBlock, Interrupted, Cancelled, DeadlineExceeded, Failed }
pub class IoProgress {
    pub var processed: usize;
    pub var status: ReadStatus;
    pub var reason: ?ErrorId;

    pub func init(processed: usize, status: ReadStatus, reason: ?ErrorId)
        : processed(processed), status(status), reason(reason) {}
    pub const func check() !void {
        if status == ReadStatus.Eof { return IoError.UnexpectedEof; }
        if status == ReadStatus.WouldBlock { return IoError.WouldBlock; }
        if status == ReadStatus.Interrupted { return IoError.Interrupted; }
        if reason != null { return reason.unwrap(); }
    }
}
pub error IoError {
    WriteFailed, UnexpectedEof, NoProgress, WouldBlock, Interrupted, InvalidCount,
    PositionOutOfRange, LimitExceeded, Closed, InvalidArgument, Unsupported, Cancelled, DeadlineExceeded,
}

pub func read(reader: *Reader, dst: []u8) !usize {
    if dst.len() == 0 { return 0; }
    var count = reader.read(dst)!;
    if count > dst.len() { return IoError.InvalidCount; }
    count
}

pub func write(writer: *Writer, src: []const u8) !usize {
    if src.len() == 0 { return 0; }
    var count = writer.write(src)!;
    if count > src.len() { return IoError.InvalidCount; }
    if count == 0 { return IoError.NoProgress; }
    count
}

func stopped(processed: usize, reason: ErrorId) IoProgress {
    var status = ReadStatus.Failed;
    if isWouldBlock(reason) { status = ReadStatus.WouldBlock; }
    else if isInterrupted(reason) { status = ReadStatus.Interrupted; }
    else if reason == IoError.Cancelled { status = ReadStatus.Cancelled; }
    else if reason == IoError.DeadlineExceeded { status = ReadStatus.DeadlineExceeded; }
    IoProgress(processed, status, some(reason))
}

func complete(processed: usize) IoProgress {
    IoProgress(processed, ReadStatus.Bytes, null)
}

pub func readExactProgress(reader: *Reader, dst: []u8) !IoProgress {
    var offset: usize = 0;
    while offset < dst.len() {
        var count = read(reader, dst[offset..dst.len()]) catch (reason) { return stopped(offset, reason); };
        if count == 0 { return IoProgress(offset, ReadStatus.Eof, null); }
        offset += count;
    }
    complete(offset)
}
pub func readExact(reader: *Reader, dst: []u8, processed: mut usize) !void {
    if processed > dst.len() { return IoError.InvalidCount; }
    var progress = readExactProgress(reader, dst[processed..dst.len()])!;
    processed += progress.processed;
    progress.check()
}
pub func readExact(reader: *Reader, dst: []u8) !void {
    var processed: usize = 0;
    readExact(reader, dst, processed)
}
pub func readAtLeast(reader: *Reader, dst: []u8, min: usize, processed: mut usize) !usize {
    if min > dst.len() || processed > dst.len() { return IoError.InvalidCount; }
    while processed < min {
        var count = read(reader, dst[processed..dst.len()])!;
        if count == 0 { return IoError.UnexpectedEof; };
        processed += count;
    }
    return processed;
}
pub func readAtLeast(reader: *Reader, dst: []u8, min: usize) !usize {
    var processed: usize = 0;
    readAtLeast(reader, dst, min, processed)
}
pub func writeAllProgress(writer: *Writer, src: []const u8) !IoProgress {
    var offset: usize = 0;
    while offset < src.len() {
        var count = write(writer, src[offset..src.len()]) catch (reason) { return stopped(offset, reason); };
        offset += count;
    }
    complete(offset)
}
pub func writeAll(writer: *Writer, src: []const u8, processed: mut usize) !void {
    if processed > src.len() { return IoError.InvalidCount; }
    var progress = writeAllProgress(writer, src[processed..src.len()])!;
    processed += progress.processed;
    progress.check()
}
pub func writeAll(writer: *Writer, src: []const u8) !void {
    var processed: usize = 0;
    writeAll(writer, src, processed)
}
pub func writeString(writer: *Writer, value: str) !void { writeAll(writer, value.asBytes()) }

pub func readToEnd(reader: *Reader, limit: usize) !coll.Vec<u8> {
    var out = coll.Vec<u8>();
    var scratch = mem.zeroedBytes<4096>();
    for {
        var available = limit - out.len();
        var chunk = scratch.len();
        if available < scratch.len() { chunk = available + 1; }
        var count = read(reader, scratch[0..chunk])!;
        if count == 0 { return move(out); }
        if count > available { return IoError.LimitExceeded; }
        for byte in scratch[0..count] { out.push(byte)!; }
    }
}
pub func readToString(reader: *Reader, limit: usize) !string {
    var data = readToEnd(reader, limit)!;
    text.fromBytes(data.asConstSlice())
}
func usableBytes(left: u64, capacity: usize) usize {
    if left >= u64(capacity) { return capacity; }
    var count: !usize = usize(left);
    count catch { panic("byte count cannot exceed buffer capacity") }
}
pub func copy(reader: *Reader, writer: *Writer, scratch: []u8) !u64 {
    copyN(reader, writer, ~u64(0), scratch)
}
pub class CopyCursor {
    #copy: disabled
    var total: u64;
    var first: usize;
    var last: usize;
    var ended: bool;
    pub func init() : total(0), first(0), last(0), ended(false) {}
    pub const func copied() u64 { total }
    pub const func pending() usize { last - first }
    pub func transfer(reader: *Reader, writer: *Writer, limit: u64, scratch: []u8) !u64 {
        if total > limit || last > scratch.len() || u64(pending()) > limit - total ||
            (total < limit && scratch.len() == 0) { return IoError.InvalidCount; }
        while total < limit && !ended {
            if first == last {
                var count = read(reader, scratch[0..usableBytes(limit - total, scratch.len())])!;
                if count == 0 { ended = true; break; }
                first = 0;
                last = count;
            }
            var progress = writeAllProgress(writer, scratch[first..last])!;
            first += progress.processed;
            total += u64(progress.processed);
            progress.check()!;
        }
        total
    }
}

pub func copyN(reader: *Reader, writer: *Writer, n: u64, scratch: []u8) !u64 {
    var cursor = CopyCursor();
    cursor.transfer(reader, writer, n, scratch)
}
pub func copyAll(reader: *Reader, writer: *Writer) !u64 {
    var storage = __vqr_uninitialized<[8192]u8>();
    var scratch = unsafe { (*__vqr_raw_address(raw storage))[:] };
    mem.zeroBytes(scratch);
    copy(reader, writer, scratch)
}
pub func discard(reader: *Reader, n: u64, scratch: []u8) !u64 {
    if n != 0 && scratch.len() == 0 { return IoError.InvalidCount; }
    var discarded: u64 = 0;
    while discarded < n {
        var count = read(reader, scratch[0..usableBytes(n - discarded, scratch.len())])!;
        if count == 0 { break; }
        discarded += u64(count);
    }
    discarded
}

pub func readAt(reader: *ReaderAt, offset: u64, dst: []u8) !usize {
    for {
        var count = reader.readAt(offset, dst) catch (reason) {
            if isInterrupted(reason) { continue; }
            return reason;
        };
        if count > dst.len() { return IoError.InvalidCount; }
        return count;
    }
}

pub func writeAt(writer: *WriterAt, offset: u64, src: []const u8) !usize {
    if src.len() == 0 { return 0; }
    for {
        var count = writer.writeAt(offset, src) catch (reason) {
            if isInterrupted(reason) { continue; }
            return reason;
        };
        if count > src.len() { return IoError.InvalidCount; }
        if count == 0 { return IoError.NoProgress; }
        return count;
    }
}

pub func readExactAt(reader: *ReaderAt, offset: u64, dst: []u8) !void {
    var processed: usize = 0;
    while processed < dst.len() {
        if u64(processed) > ~u64(0) - offset { return IoError.PositionOutOfRange; }
        var count = readAt(reader, offset + u64(processed), dst[processed..dst.len()])!;
        if count > dst.len() - processed { return IoError.InvalidCount; }
        if count == 0 { return IoError.UnexpectedEof; }
        processed += count;
    }
}

pub func writeAllAt(writer: *WriterAt, offset: u64, src: []const u8) !void {
    var processed: usize = 0;
    while processed < src.len() {
        if u64(processed) > ~u64(0) - offset { return IoError.PositionOutOfRange; }
        var count = writeAt(writer, offset + u64(processed), src[processed..src.len()])!;
        if count > src.len() - processed { return IoError.InvalidCount; }
        if count == 0 { return IoError.NoProgress; }
        processed += count;
    }
}
