package io
import (coll, mem, text)

pub interface Reader { func read(dst: []u8) !usize; }
pub interface Writer {
    func write(src: []const u8) !usize;
    func flush() !void;
}
pub interface Seeker { func seek(offset: i64, origin: SeekOrigin) !u64; }
pub interface ReaderAt { func readAt(offset: u64, dst: []u8) !usize; }
pub interface WriterAt { func writeAt(offset: u64, src: []const u8) !usize; }
pub interface Closer { func close() !void; }

pub enum SeekOrigin { Start, Current, End }
pub enum ReadStatus { Bytes, Eof, WouldBlock, Interrupted }
pub class IoProgress {
    pub var processed: usize;
    pub var status: ReadStatus;
}
pub error IoError {
    WriteFailed, UnexpectedEof, NoProgress, WouldBlock, Interrupted, InvalidCount,
    PositionOutOfRange, LimitExceeded, Closed, InvalidArgument, Unsupported,
}

pub func read(reader: *Reader, dst: []u8) !usize {
    if dst.len() == 0 { return 0; }
    var count = reader.read(dst)!;
    if count > dst.len() { return IoError.InvalidCount; }
    count
}

pub func write(writer: *Writer, src: []const u8) !usize {
    if src.len() == 0 { return 0; }
    var count = writer.write(src)!;
    if count > src.len() { return IoError.InvalidCount; }
    if count == 0 { return IoError.NoProgress; }
    count
}

pub func readExactProgress(reader: *Reader, dst: []u8) !IoProgress {
    var offset: usize = 0;
    for offset < dst.len() {
        var count = read(reader, dst[offset..dst.len()]) catch (reason) {
            if isWouldBlock(reason) { return IoProgress{processed: offset, status: ReadStatus.WouldBlock}; }
            if isInterrupted(reason) { return IoProgress{processed: offset, status: ReadStatus.Interrupted}; }
            return reason;
        };
        if count == 0 { return IoProgress{processed: offset, status: ReadStatus.Eof}; }
        offset += count;
    }
    IoProgress{processed: offset, status: ReadStatus.Bytes}
}
pub func readExact(reader: *Reader, dst: []u8) !void {
    var progress = readExactProgress(reader, dst)!;
    switch progress.status {
        ReadStatus.Bytes => {},
        ReadStatus.Eof => return IoError.UnexpectedEof,
        ReadStatus.WouldBlock => return IoError.WouldBlock,
        ReadStatus.Interrupted => return IoError.Interrupted,
    };
}
pub func readAtLeast(reader: *Reader, dst: []u8, min: usize) !usize {
    if min > dst.len() { return IoError.InvalidCount; }
    var offset: usize = 0;
    for offset < min {
        var count = read(reader, dst[offset..dst.len()])!;
        if count == 0 { return IoError.UnexpectedEof; }
        offset += count;
    }
    offset
}
pub func writeAllProgress(writer: *Writer, src: []const u8) !IoProgress {
    var offset: usize = 0;
    for offset < src.len() {
        var count = write(writer, src[offset..src.len()]) catch (reason) {
            if isWouldBlock(reason) { return IoProgress{processed: offset, status: ReadStatus.WouldBlock}; }
            if isInterrupted(reason) { return IoProgress{processed: offset, status: ReadStatus.Interrupted}; }
            return reason;
        };
        offset += count;
    }
    IoProgress{processed: offset, status: ReadStatus.Bytes}
}
pub func writeAll(writer: *Writer, src: []const u8) !void {
    var progress = writeAllProgress(writer, src)!;
    if progress.status == ReadStatus.WouldBlock { return IoError.WouldBlock; }
    if progress.status == ReadStatus.Interrupted { return IoError.Interrupted; }
}
pub func writeString(writer: *Writer, value: str) !void { writeAll(writer, value.asBytes()) }

pub func readToEnd(reader: *Reader, limit: usize) !coll.Vec<u8> {
    var out = coll.Vec<u8>();
    var scratch = mem.zeroedBytes<256>();
    for {
        var available = limit - out.len();
        var chunk = scratch.len();
        if available < scratch.len() {
            if available == ~usize(0) { chunk = scratch.len(); }
            else { chunk = available + 1; }
        }
        var count = read(reader, scratch[0..chunk])!;
        if count == 0 { return move(out); }
        if count > available { return IoError.LimitExceeded; }
        out.reserveAdditional(count)!;
        for byte in scratch[0..count] { out.push(byte)!; }
    }
}
pub func readToString(reader: *Reader, limit: usize) !string {
    var data = readToEnd(reader, limit)!;
    text.fromBytes(data.asConstSlice())
}
func usableBytes(left: u64, capacity: usize) usize {
    if left >= u64(capacity) { return capacity; }
    var count: !usize = usize(left);
    count catch { panic("byte count cannot exceed buffer capacity") }
}
pub func copy(reader: *Reader, writer: *Writer, scratch: []u8) !u64 {
    copyN(reader, writer, ~u64(0), scratch)
}
pub func copyN(reader: *Reader, writer: *Writer, n: u64, scratch: []u8) !u64 {
    if n != 0 && scratch.len() == 0 { return IoError.InvalidCount; }
    var copied: u64 = 0;
    for copied < n {
        var count = read(reader, scratch[0..usableBytes(n - copied, scratch.len())])!;
        if count == 0 { break; }
        writeAll(writer, scratch[0..count])!;
        copied += u64(count);
    }
    copied
}
pub func copyAll(reader: *Reader, writer: *Writer) !u64 {
    var scratch = mem.zeroedBytes<256>();
    copy(reader, writer, scratch[:])
}
pub func discard(reader: *Reader, n: u64, scratch: []u8) !u64 {
    if n != 0 && scratch.len() == 0 { return IoError.InvalidCount; }
    var discarded: u64 = 0;
    for discarded < n {
        var count = read(reader, scratch[0..usableBytes(n - discarded, scratch.len())])!;
        if count == 0 { break; }
        discarded += u64(count);
    }
    discarded
}

pub func readAt(reader: *ReaderAt, offset: u64, dst: []u8) !usize {
    for {
        var count = reader.readAt(offset, dst) catch (reason) {
            if isInterrupted(reason) { continue; }
            return reason;
        };
        if count > dst.len() { return IoError.InvalidCount; }
        return count;
    }
}

pub func writeAt(writer: *WriterAt, offset: u64, src: []const u8) !usize {
    if src.len() == 0 { return 0; }
    for {
        var count = writer.writeAt(offset, src) catch (reason) {
            if isInterrupted(reason) { continue; }
            return reason;
        };
        if count > src.len() { return IoError.InvalidCount; }
        if count == 0 { return IoError.NoProgress; }
        return count;
    }
}

pub func readExactAt(reader: *ReaderAt, offset: u64, dst: []u8) !void {
    var processed: usize = 0;
    for processed < dst.len() {
        if u64(processed) > ~u64(0) - offset { return IoError.PositionOutOfRange; }
        var count = readAt(reader, offset + u64(processed), dst[processed..dst.len()])!;
        if count > dst.len() - processed { return IoError.InvalidCount; }
        if count == 0 { return IoError.UnexpectedEof; }
        processed += count;
    }
}

pub func writeAllAt(writer: *WriterAt, offset: u64, src: []const u8) !void {
    var processed: usize = 0;
    for processed < src.len() {
        if u64(processed) > ~u64(0) - offset { return IoError.PositionOutOfRange; }
        var count = writeAt(writer, offset + u64(processed), src[processed..src.len()])!;
        if count > src.len() - processed { return IoError.InvalidCount; }
        if count == 0 { return IoError.NoProgress; }
        processed += count;
    }
}
