package iter

pub class EnumerateIter<I: Movable, T: Movable> {
    var source: I;
    var index: usize;
    pub func init(source: I) : source(move(source)), index(0) {}
    pub func next() ?(usize, T) {
        switch source.next() {
            null => null,
            some(value) => {
                var position = index;
                index++;
                some((position, move(value)))
            },
        }
    }
}

pub class TakeIter<I: Movable, T> {
    var source: I;
    var limit: usize;
    pub func init(source: I, count: usize) : source(move(source)), limit(count) {}
    pub func next() ?T {
        if limit == 0 { return null; }
        limit--;
        source.next()
    }
    pub const func remainingLimit() usize { limit }
}

pub class SkipIter<I: Movable, T: Movable> {
    var source: I;
    var skipCount: usize;
    pub func init(source: I, count: usize) : source(move(source)), skipCount(count) {}
    pub func next() ?T {
        while skipCount > 0 {
            skipCount--;
            switch source.next() {
                null => { skipCount = 0; return null; },
                some(_) => {},
            }
        }
        source.next()
    }
}

pub class FuseIter<I: Movable, T: Movable> {
    var source: I;
    var ended: bool;
    pub func init(source: I) : source(move(source)), ended(false) {}
    pub func next() ?T {
        if ended { return null; }
        switch source.next() {
            null => { ended = true; null },
            some(value) => some(move(value)),
        }
    }
}

pub func enumerate<I: Movable + Copyable, T: Movable>(source: I) EnumerateIter<I, T> {
    EnumerateIter<I, T>(move(source))
}

pub func take<I: Movable + Copyable, T>(source: I, count: usize) TakeIter<I, T> {
    TakeIter<I, T>(move(source), count)
}

pub func skip<I: Movable + Copyable, T: Movable>(source: I, count: usize) SkipIter<I, T> {
    SkipIter<I, T>(move(source), count)
}

pub func fuse<I: Movable + Copyable, T: Movable>(source: I) FuseIter<I, T> {
    FuseIter<I, T>(move(source))
}

pub class ChainIter<IA: Movable, IB: Movable, T: Movable> {
    var first: IA;
    var second: IB;
    var useFirst: bool;
    pub func init(a: IA, b: IB) : first(move(a)), second(move(b)), useFirst(true) {}
    pub func next() ?T {
        if useFirst {
            switch first.next() {
                null => { useFirst = false; },
                some(item) => return some(move(item)),
            }
        }
        second.next()
    }
}

pub class ZipIter<IA: Movable, IB: Movable, A: Movable, B: Movable> {
    var first: IA;
    var second: IB;
    var ended: bool;
    pub func init(a: IA, b: IB) : first(move(a)), second(move(b)), ended(false) {}
    pub func next() ?(A, B) {
        if ended { return null; }
        switch first.next() {
            null => { ended = true; null },
            some(a) => switch second.next() {
                null => { ended = true; null },
                some(b) => some((move(a), move(b))),
            },
        }
    }
}

pub class RevIter<I: Movable, T> {
    var source: I;
    pub func init(source: I) : source(move(source)) {}
    pub func next() ?T { source.nextBack() }
}

pub func chain<IA: Movable + Copyable, IB: Movable + Copyable, T: Movable>(a: IA, b: IB) ChainIter<IA, IB, T> {
    ChainIter<IA, IB, T>(move(a), move(b))
}

pub func zip<IA: Movable + Copyable, IB: Movable + Copyable, A: Movable, B: Movable>(a: IA, b: IB) ZipIter<IA, IB, A, B> {
    ZipIter<IA, IB, A, B>(move(a), move(b))
}

pub func rev<I: Movable + Copyable, T>(source: I) RevIter<I, T> { RevIter<I, T>(move(source)) }
