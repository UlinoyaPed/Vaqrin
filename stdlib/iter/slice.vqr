package iter

pub class SizeHint {
    pub var lower: usize;
    pub var upper: ?usize;

    pub func init(lower: usize, upper: ?usize) : lower(lower), upper(upper) {}
}

pub class SliceIter<T: Copyable + Movable> {
    var values: []const T;
    var front: usize;
    var back: usize;
    pub func init(values: []const T) : values(values), front(0), back(values.len()) {}

    pub func next() ?T {
        if front == back { return null; }
        var value = values[front];
        front++;
        some(move(value))
    }

    pub func nextBack() ?T {
        if front == back { return null; }
        back--;
        some(values[back])
    }

    pub const func remaining() usize { back - front }
    pub const func sizeHint() SizeHint {
        var n = remaining();
        SizeHint(n, some(n))
    }
}

pub func iter<T: Copyable + Movable>(values: []const T) SliceIter<T> { SliceIter<T>(values) }

pub class SliceIterRef<T> {
    var values: []const T;
    var front: usize;
    var back: usize;
    pub func init(values: []const T) : values(values), front(0), back(values.len()) {}

    pub func next() ?*const T {
        if front == back { return null; }
        var value = raw values[front];
        front++;
        some(move(value))
    }

    pub func nextBack() ?*const T {
        if front == back { return null; }
        back--;
        some(raw values[back])
    }

    pub const func remaining() usize { back - front }
}

pub func iterRef<T>(values: []const T) SliceIterRef<T> { SliceIterRef<T>(values) }

pub class SliceIterMut<T> {
    var values: []T;
    var front: usize;
    var back: usize;
    pub func init(values: []T) : values(values), front(0), back(values.len()) {}

    pub func next() ?*T {
        if front == back { return null; }
        var value = raw values[front];
        front++;
        some(move(value))
    }

    pub func nextBack() ?*T {
        if front == back { return null; }
        back--;
        some(raw values[back])
    }

    pub const func remaining() usize { back - front }
}

pub func iterMut<T>(values: []T) SliceIterMut<T> { SliceIterMut<T>(values) }
