package iter
import (core, meta)

pub class OnceOptional<T: Movable> {
    var item: ?T;
    comptime if meta.isCopyable<T>() {
        pub func init(value: ?T) : item(move(value)) {}
    } else {
        pub func init(value: move ?T) : item(move(value)) {}
    }
    pub func next() ?T { core.Exchange<?T>.replace(item, null) }
}

pub class OnceIter<T: Movable> {
    var source: OnceOptional<T>;
    comptime if meta.isCopyable<T>() {
        pub func init(value: T) : source(OnceOptional<T>(some(move(value)))) {}
    } else {
        pub func init(value: move T) : source(OnceOptional<T>(some(move(value)))) {}
    }
    pub func next() ?T { source.next() }
}

pub class EmptyIter<T> {
    pub func init() {}
    pub func next() ?T { null }
}

pub class RepeatIter<T: Copyable + Movable> {
    var item: T;
    pub func init(value: T) : item(move(value)) {}
    pub func next() ?T { some(item) }
}

pub class FromFnIter<T, F: Movable> {
    var callback: F;
    pub func init(callback: F) : callback(move(callback)) {}
    pub func next() ?T { callback() }
}

pub func empty<T>() EmptyIter<T> { EmptyIter<T>() }
pub func repeat<T: Copyable + Movable>(value: T) RepeatIter<T> { RepeatIter<T>(move(value)) }
pub func fromFn<T, F: Movable + Copyable>(callback: F) FromFnIter<T, F> { FromFnIter<T, F>(move(callback)) }
