package json
import (coll, core, iter as iterator, parse, text)

pub error JsonError {
    UnexpectedEnd, TrailingInput, InvalidSyntax, InvalidNumber, InvalidEscape,
    InvalidUnicode, InvalidUtf8, ControlCharacter, DuplicateKey, DepthLimit,
    SizeLimit, ElementLimit, TypeMismatch, IndexOutOfRange, InvalidPointer,
    InexactNumber, IntegerOutOfRange, UnsupportedOption,
}

pub enum DuplicateKeyPolicy { Reject, KeepFirst, KeepLast }
pub enum Value {
    Null, Bool(bool), Number(JsonNumber), String(string), Array(JsonArray), Object(JsonObject),
}

pub class ParseOptions {
    pub var maxDepth: usize;
    pub var maxBytes: usize;
    pub var maxElements: usize;
    pub var duplicateKeys: DuplicateKeyPolicy;
    pub func init()
        : maxDepth(128), maxBytes(16 * 1024 * 1024),
          maxElements(1_000_000), duplicateKeys(DuplicateKeyPolicy.Reject) {}
}

pub class EncodeOptions {
    pub var indent: usize;
    pub var maxDepth: usize;
    pub var escapeNonAscii: bool;
    pub var sortKeys: bool;
    pub func init()
        : indent(0), maxDepth(128), escapeNonAscii(false), sortKeys(false) {}
}

pub class JsonNumber {
    var raw: string;
    func init(value: string) : raw(move(value)) {}
    pub static func parse(value: str) !Self {
        validateNumber(value)!;
        var owned = text.fromBytes(value.asBytes())!;
        JsonNumber(move(owned))
    }
    pub const func text() str { raw }
    pub const func isInteger() bool { !hasFractionOrExponent(raw.asBytes()) }
    pub const func asI64() !i64 {
        if !isInteger() { return JsonError.InexactNumber; }
        parse.parseInt<i64>(raw, 10)
    }
    pub const func asU64() !u64 {
        if !isInteger() { return JsonError.InexactNumber; }
        parse.parseUint<u64>(raw, 10)
    }
    pub const func asF64() !f64 {
        if isInteger() {
            var integer = parse.parseInt<i64>(raw, 10)!;
            if integer < -9007199254740992 || integer > 9007199254740992 {
                return JsonError.InexactNumber;
            }
        }
        parse.parseFloat<f64>(raw)
    }
}

pub class JsonArray {
    var values: coll.Vec<Value>;
    pub func init() : values(coll.Vec<Value>()) {}
    pub const func len() usize { values.len() }
    pub const func isEmpty() bool { values.isEmpty() }
    pub func reserve(count: usize) !void { values.reserve(count) }
    pub const func get(index: usize) ?*const Value { values.getPtr(index) }
    pub func getMut(index: usize) ?*Value { values.getMutPtr(index) }
    pub func push(value: Value) !void { values.push(move(value)) }
    pub func pop() ?Value { values.pop() }
    pub func insert(index: usize, value: Value) !void { values.insert(index, move(value)) }
    pub func remove(index: usize) ?Value { values.remove(index) }
    pub func replace(index: usize, value: Value) ?Value { values.replace(index, move(value)) }
    pub const func asSlice() []const Value { values.asConstSlice() }
    pub const func iterRef() iterator.SliceIterRef<Value> {
        iterator.SliceIterRef<Value>(values.asConstSlice())
    }
}

class JsonEntry {
    pub var key: string;
    pub var value: Value;
}

pub class JsonObject {
    var entries: coll.Vec<JsonEntry>;
    pub func init() : entries(coll.Vec<JsonEntry>()) {}
    pub const func len() usize { entries.len() }
    pub const func isEmpty() bool { entries.isEmpty() }
    pub const func containsKey(key: str) bool {
        for index in usize(0)..entries.len() {
            var entry = entries.getPtr(index).unwrap();
            if entry.key == key { return true; }
        }
        false
    }
    pub const func get(key: str) ?*const Value {
        for index in usize(0)..entries.len() {
            var entry = entries.getPtr(index).unwrap();
            if entry.key == key { return some(raw entry.value); }
        }
        null
    }
    pub func getMut(key: str) ?*Value {
        for index in usize(0)..entries.len() {
            var entry = entries.getMutPtr(index).unwrap();
            if entry.key == key { return some(raw entry.value); }
        }
        null
    }
    pub func insert(key: string, value: Value) !?Value {
        for index in usize(0)..entries.len() {
            var entry = entries.getMutPtr(index).unwrap();
            if entry.key == key {
                var previous = core.replace<Value>(raw entry.value, move(value));
                return some(move(previous));
            }
        }
        entries.push(JsonEntry{key: move(key), value: move(value)})!;
        null
    }
    pub func remove(key: str) ?Value {
        for index in usize(0)..entries.len() {
            var entry = entries.getPtr(index).unwrap();
            if entry.key == key {
                var removed = entries.remove(index);
                switch move(removed) {
                    null => return null,
                    some(entry) => { return some(core.replace<Value>(raw entry.value, Value.Null)); },
                }
            }
        }
        null
    }
    pub const func keyAt(index: usize) ?str {
        if index >= entries.len() { return null; }
        some(entries.getPtr(index).unwrap().key)
    }
    pub const func valueAt(index: usize) ?*const Value {
        if index >= entries.len() { return null; }
        some(raw entries.getPtr(index).unwrap().value)
    }
    pub func valueAtMut(index: usize) ?*Value {
        if index >= entries.len() { return null; }
        some(raw entries.getMutPtr(index).unwrap().value)
    }
    pub const func keys() JsonKeyIter { JsonKeyIter(self) }
    pub const func items() JsonItemIter { JsonItemIter(self) }
}

pub class JsonKeyIter {
    var object: *const JsonObject;
    var index: usize;
    pub func init(object: *const JsonObject) : object(object), index(0) {}
    pub func next() ?str {
        switch object.keyAt(index) {
            null => null,
            some(key) => { index++; some(key) },
        }
    }
}

pub class JsonItemIter {
    var object: *const JsonObject;
    var index: usize;
    pub func init(object: *const JsonObject) : object(object), index(0) {}
    pub func next() ?(str, *const Value) {
        if index >= object.len() { return null; }
        var key = object.keyAt(index).unwrap();
        var value = object.valueAt(index).unwrap();
        index++;
        some((key, value))
    }
}

pub func isNull(value: *const Value) bool {
    switch *value { Value.Null => true, _ => false }
}
pub func asBool(value: *const Value) ?bool {
    switch *value { Value.Bool(item) => some(item), _ => null }
}
pub func asNumber(value: *const Value) ?*const JsonNumber {
    switch *value { Value.Number(ref item) => some(item.toRaw()), _ => null }
}
pub func asString(value: *const Value) ?str {
    switch *value { Value.String(item) => some(item), _ => null }
}
pub func asArray(value: *const Value) ?*const JsonArray {
    switch *value { Value.Array(ref item) => some(item.toRaw()), _ => null }
}
pub func asObject(value: *const Value) ?*const JsonObject {
    switch *value { Value.Object(ref item) => some(item.toRaw()), _ => null }
}

func hasFractionOrExponent(value: []const u8) bool {
    for byte in value {
        if byte == 46 || byte == 101 || byte == 69 { return true; }
    }
    false
}

pub func validateNumber(value: str) !void {
    var data = value.asBytes();
    var position: usize = 0;
    if data.len() == 0 { return JsonError.InvalidNumber; }
    if data[position] == 45 {
        position++;
        if position == data.len() { return JsonError.InvalidNumber; }
    }
    if data[position] == 48 {
        position++;
        if position < data.len() && 48 <= data[position] && data[position] <= 57 {
            return JsonError.InvalidNumber;
        }
    } else {
        if data[position] < 49 || data[position] > 57 { return JsonError.InvalidNumber; }
        while position < data.len() && 48 <= data[position] && data[position] <= 57 { position++; }
    }
    if position < data.len() && data[position] == 46 {
        position++;
        var start = position;
        while position < data.len() && 48 <= data[position] && data[position] <= 57 { position++; }
        if position == start { return JsonError.InvalidNumber; }
    }
    if position < data.len() && (data[position] == 101 || data[position] == 69) {
        position++;
        if position < data.len() && (data[position] == 43 || data[position] == 45) { position++; }
        var start = position;
        while position < data.len() && 48 <= data[position] && data[position] <= 57 { position++; }
        if position == start { return JsonError.InvalidNumber; }
    }
    if position != data.len() { return JsonError.InvalidNumber; }
}
