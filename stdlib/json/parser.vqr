package json
import (coll, io, text)

pub class Parser {
    var source: str;
    var data: []const u8;
    var position: usize;
    var depth: usize;
    var elements: usize;
    var options: ParseOptions;
public:
    func init(value: str, options: ParseOptions)
        : source(value), data(value.asBytes()), position(0), depth(0),
          elements(0), options(move(options)) {}

    const func offset() usize { position }

    func parse() !Value {
        if data.len() > options.maxBytes { return JsonError.SizeLimit; }
        skipWhitespace();
        var value = parseValue()!;
        skipWhitespace();
        if position != data.len() { return JsonError.TrailingInput; }
        move(value)
    }

private:
    func skipWhitespace() void {
        for position < data.len() {
            var byte = data[position];
            if byte == 32 || byte == 9 || byte == 10 || byte == 13 {
                position++;
            } else {
                break;
            }
        }
    }

    func countElement() !void {
        if elements >= options.maxElements { return JsonError.ElementLimit; }
        elements++;
    }

    func parseValue() !Value {
        skipWhitespace();
        if position >= data.len() { return JsonError.UnexpectedEnd; }
        var byte = data[position];
        if byte == 110 { parseNull()!; return Value.Null; }
        if byte == 116 { parseTrue()!; return Value.Bool(true); }
        if byte == 102 { parseFalse()!; return Value.Bool(false); }
        if byte == 34 { return Value.String(parseString()!); }
        if byte == 91 { return parseArray(); }
        if byte == 123 { return parseObject(); }
        if byte == 45 || (48 <= byte && byte <= 57) {
            var number = parseNumber()!;
            return Value.Number(move(number));
        }
        JsonError.InvalidSyntax
    }

    func parseNull() !void { consumeLiteral("null") }
    func parseTrue() !void { consumeLiteral("true") }
    func parseFalse() !void { consumeLiteral("false") }

    func consumeLiteral(value: str) !void {
        var bytes = value.asBytes();
        if bytes.len() > data.len() - position { return JsonError.UnexpectedEnd; }
        for index in usize(0)..bytes.len() {
            if data[position + index] != bytes[index] { return JsonError.InvalidSyntax; }
        }
        position += bytes.len();
    }

    func parseNumber() !JsonNumber {
        var start = position;
        if data[position] == 45 { position++; }
        if position >= data.len() { return JsonError.UnexpectedEnd; }
        if data[position] == 48 {
            position++;
            if position < data.len() && 48 <= data[position] && data[position] <= 57 {
                return JsonError.InvalidNumber;
            }
        } else {
            if data[position] < 49 || data[position] > 57 { return JsonError.InvalidNumber; }
            for position < data.len() && 48 <= data[position] && data[position] <= 57 {
                position++;
            }
        }
        if position < data.len() && data[position] == 46 {
            position++;
            var fractionStart = position;
            for position < data.len() && 48 <= data[position] && data[position] <= 57 {
                position++;
            }
            if position == fractionStart { return JsonError.InvalidNumber; }
        }
        if position < data.len() && (data[position] == 101 || data[position] == 69) {
            position++;
            if position < data.len() && (data[position] == 43 || data[position] == 45) {
                position++;
            }
            var exponentStart = position;
            for position < data.len() && 48 <= data[position] && data[position] <= 57 {
                position++;
            }
            if position == exponentStart { return JsonError.InvalidNumber; }
        }
        var raw = text.fromBytes(data[start..position])!;
        JsonNumber.parse(raw)
    }

    func parseString() !string {
        if position >= data.len() || data[position] != 34 { return JsonError.InvalidSyntax; }
        position++;
        var output = coll.Vec<u8>();
        for {
            if position >= data.len() { return JsonError.UnexpectedEnd; }
            var byte = data[position];
            position++;
            if byte == 34 {
                return text.fromBytes(output.asConstSlice()) catch { return JsonError.InvalidUtf8; };
            }
            if byte < 0x20 { return JsonError.ControlCharacter; }
            if byte != 92 {
                output.push(byte)!;
                continue;
            }
            if position >= data.len() { return JsonError.UnexpectedEnd; }
            var escape = data[position];
            position++;
            switch escape {
                34 => output.push(34)!,
                92 => output.push(92)!,
                47 => output.push(47)!,
                98 => output.push(8)!,
                102 => output.push(12)!,
                110 => output.push(10)!,
                114 => output.push(13)!,
                116 => output.push(9)!,
                117 => appendUnicodeEscape(&output)!,
                _ => return JsonError.InvalidEscape,
            }
        }
    }

    func readHex4() !u32 {
        if position > data.len() || data.len() - position < 4 { return JsonError.UnexpectedEnd; }
        var value: u32 = 0;
        for i in usize(0)..usize(4) {
            var digit = hexValue(data[position + i]);
            switch digit {
                null => return JsonError.InvalidUnicode,
                some(n) => { value = (value << 4) | u32(n); },
            }
        }
        position += 4;
        value
    }

    func appendUnicodeEscape(output: *coll.Vec<u8>) !void {
        var first = readHex4()!;
        var scalar = first;
        if 0xd800 <= first && first <= 0xdbff {
            if position > data.len() || data.len() - position < 6 ||
               data[position] != 92 || data[position + 1] != 117 {
                return JsonError.InvalidUnicode;
            }
            position += 2;
            var second = readHex4()!;
            if second < 0xdc00 || second > 0xdfff { return JsonError.InvalidUnicode; }
            scalar = 0x10000 + ((first - 0xd800) << 10) + (second - 0xdc00);
        } else if 0xdc00 <= first && first <= 0xdfff {
            return JsonError.InvalidUnicode;
        }
        appendScalar(output, scalar)
    }

    func parseArray() !Value {
        if depth >= options.maxDepth { return JsonError.DepthLimit; }
        depth++;
        position++;
        var output = JsonArray();
        skipWhitespace();
        if position < data.len() && data[position] == 93 {
            position++;
            depth--;
            return Value.Array(move(output));
        }
        for {
            countElement()!;
            var item = parseValue()!;
            output.push(move(item))!;
            skipWhitespace();
            if position >= data.len() { return JsonError.UnexpectedEnd; }
            if data[position] == 93 {
                position++;
                depth--;
                return Value.Array(move(output));
            }
            if data[position] != 44 { return JsonError.InvalidSyntax; }
            position++;
            skipWhitespace();
        }
    }

    func parseObject() !Value {
        if depth >= options.maxDepth { return JsonError.DepthLimit; }
        depth++;
        position++;
        var output = JsonObject();
        skipWhitespace();
        if position < data.len() && data[position] == 125 {
            position++;
            depth--;
            return Value.Object(move(output));
        }
        for {
            if position >= data.len() || data[position] != 34 { return JsonError.InvalidSyntax; }
            var key = parseString()!;
            skipWhitespace();
            if position >= data.len() || data[position] != 58 { return JsonError.InvalidSyntax; }
            position++;
            var value = parseValue()!;
            countElement()!;
            if output.containsKey(key) {
                switch options.duplicateKeys {
                    DuplicateKeyPolicy.Reject => return JsonError.DuplicateKey,
                    DuplicateKeyPolicy.KeepFirst => {},
                    DuplicateKeyPolicy.KeepLast => {
                        var target = output.getMut(key).unwrap();
                        *target = move(value);
                    },
                }
            } else {
                output.insert(move(key), move(value))!;
            }
            skipWhitespace();
            if position >= data.len() { return JsonError.UnexpectedEnd; }
            if data[position] == 125 {
                position++;
                depth--;
                return Value.Object(move(output));
            }
            if data[position] != 44 { return JsonError.InvalidSyntax; }
            position++;
            skipWhitespace();
        }
    }
}

func hexValue(byte: u8) ?u8 {
    if 48 <= byte && byte <= 57 { return some(__vqr_parse_bits<u8>(u128(byte) - u128(48))); }
    if 65 <= byte && byte <= 70 { return some(__vqr_parse_bits<u8>(u128(byte) - u128(55))); }
    if 97 <= byte && byte <= 102 { return some(__vqr_parse_bits<u8>(u128(byte) - u128(87))); }
    null
}

func appendScalar(output: *coll.Vec<u8>, scalar: u32) !void {
    if scalar > 0x10ffff || (0xd800 <= scalar && scalar <= 0xdfff) {
        return JsonError.InvalidUnicode;
    }
    if scalar < 0x80 {
        output.push(u8(scalar)!)!;
    } else if scalar < 0x800 {
        output.push(u8(0xc0 | (scalar >> 6))!)!;
        output.push(u8(0x80 | (scalar & 0x3f))!)!;
    } else if scalar < 0x10000 {
        output.push(u8(0xe0 | (scalar >> 12))!)!;
        output.push(u8(0x80 | ((scalar >> 6) & 0x3f))!)!;
        output.push(u8(0x80 | (scalar & 0x3f))!)!;
    } else {
        output.push(u8(0xf0 | (scalar >> 18))!)!;
        output.push(u8(0x80 | ((scalar >> 12) & 0x3f))!)!;
        output.push(u8(0x80 | ((scalar >> 6) & 0x3f))!)!;
        output.push(u8(0x80 | (scalar & 0x3f))!)!;
    }
}

pub func parseWithOptions(value: str, options: ParseOptions) !Value {
    var parser = Parser(value, options);
    parser.parse()
}

pub func parse(value: str) !Value { parseWithOptions(value, ParseOptions()) }

pub func parseBytes(value: []const u8) !Value {
    var source = text.fromBytes(value) catch { return JsonError.InvalidUtf8; };
    parse(source)
}

pub func parseReader(reader: *io.Reader, options: ParseOptions) !Value {
    var source = io.readToString(reader, options.maxBytes) catch (reason) {
        if reason == io.IoError.LimitExceeded { return JsonError.SizeLimit; }
        if reason == text.Utf8Error.InvalidUtf8 { return JsonError.InvalidUtf8; }
        return reason;
    };
    parseWithOptions(source, options)
}

pub func validate(value: str) !void {
    var ignored = parse(value)!;
}
