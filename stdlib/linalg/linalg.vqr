package linalg
import (coll, math)

pub error LinalgError { ShapeMismatch, SizeOverflow, Singular, NonFinite, ZeroNorm }

func area(rows: usize, cols: usize) !usize {
    if rows != 0 && cols > ~usize(0) / rows { return LinalgError.SizeOverflow; }
    rows * cols
}

pub func dot<T>(a: []const T, b: []const T) !T {
    if a.len() != b.len() { return LinalgError.ShapeMismatch; }
    var sum = T(0);
    for i in usize(0)..a.len() { sum += a[i] * b[i]; }
    sum
}

pub func norm2<T>(values: []const T) T {
    var total = T(0);
    for value in values { total = math.hypot<T>(total, value); }
    total
}

pub func normInf<T>(values: []const T) T {
    var largest = T(0);
    for value in values {
        var magnitude = math.abs<T>(value);
        if math.isNan<T>(magnitude) { return magnitude; }
        if magnitude > largest { largest = magnitude; }
    }
    largest
}

pub func distance<T>(a: []const T, b: []const T) !T {
    if a.len() != b.len() { return LinalgError.ShapeMismatch; }
    var total = T(0);
    for i in usize(0)..a.len() { total = math.hypot<T>(total, a[i] - b[i]); }
    total
}

pub func normalize<T>(values: []T) !void {
    var scale = normInf<T>(values);
    if !math.isFinite<T>(scale) { return LinalgError.NonFinite; }
    if scale == T(0) { return LinalgError.ZeroNorm; }
    var length = T(0);
    for value in values { length = math.hypot<T>(length, value / scale); }
    for i in usize(0)..values.len() { values[i] = (values[i] / scale) / length; }
}

pub func axpy<T>(factor: T, x: []const T, y: []T) !void {
    if x.len() != y.len() { return LinalgError.ShapeMismatch; }
    for i in usize(0)..x.len() { y[i] += factor * x[i]; }
}

pub class Vector<T: Copyable> {
    #copy: disabled
    var values: coll.Vec<T>;
    func init(values: coll.Vec<T>) : values(move(values)) {}
    pub static func zeros(n: usize) !Self {
        var values = coll.Vec<T>.withCapacity(n)!;
        for i in usize(0)..n { values.push(T(0))!; }
        Vector<T>(move(values))
    }
    pub static func fromSlice(values: []const T) !Self { Vector<T>(coll.Vec<T>.fromSlice(values)!) }
    pub const func len() usize { values.len() }
    pub const func get(index: usize) ?*const T { values.getPtr(index) }
    pub func getMut(index: usize) ?*T { values.getMutPtr(index) }
    pub const func asSlice() []const T { values.asConstSlice() }
    pub func asMutSlice() []T { values.asSlice() }
    pub const func clone() !Self { Vector<T>(values.clone()!) }
    pub func resize(n: usize, value: T) !void {
        if n <= values.len() {
            values.truncate(n);
            return;
        }
        values.reserve(n)!;
        for i in values.len()..n { values.push(value)!; }
    }
    pub const func dot(other: *const Self) !T { linalg.dot<T>(asSlice(), other.asSlice()) }
    pub const func norm() T { norm2<T>(asSlice()) }
    pub func normalize() !void { linalg.normalize<T>(asMutSlice()) }
    pub const func add(other: *const Self) !Self {
        if len() != other.len() { return LinalgError.ShapeMismatch; }
        var out = Vector<T>.zeros(len())!;
        for i in usize(0)..len() { out.values[i] = values[i] + other.values[i]; }
        move(out)
    }
    pub func scale(factor: T) void {
        for i in usize(0)..len() { values[i] *= factor; }
    }
}

pub class Matrix<T: Copyable> {
    #copy: disabled
    var height: usize;
    var width: usize;
    var values: coll.Vec<T>;
    func init(rows: usize, cols: usize, values: coll.Vec<T>)
        : height(rows), width(cols), values(move(values)) {}
    pub static func zeros(rows: usize, cols: usize) !Self {
        var count = area(rows, cols)!;
        var values = coll.Vec<T>.withCapacity(count)!;
        for i in usize(0)..count { values.push(T(0))!; }
        Matrix<T>(rows, cols, move(values))
    }
    pub static func fromFlat(rows: usize, cols: usize, values: []const T) !Self {
        if area(rows, cols)! != values.len() { return LinalgError.ShapeMismatch; }
        Matrix<T>(rows, cols, coll.Vec<T>.fromSlice(values)!)
    }
    pub static func fromRows(rows: []const []const T) !Self {
        var width = if rows.len() == 0 { usize(0) } else { rows[0].len() };
        var values = coll.Vec<T>.withCapacity(area(rows.len(), width)!)!;
        for row in rows {
            if row.len() != width { return LinalgError.ShapeMismatch; }
            for value in row { values.push(value)!; }
        }
        Matrix<T>(rows.len(), width, move(values))
    }
    pub const func rows() usize { height }
    pub const func cols() usize { width }
    pub const func shape() (usize,usize) { (height, width) }
    pub const func get(row: usize, col: usize) ?*const T {
        if row >= height || col >= width { return null; }
        values.getPtr(row * width + col)
    }
    pub func getMut(row: usize, col: usize) ?*T {
        if row >= height || col >= width { return null; }
        values.getMutPtr(row * width + col)
    }
    pub const func at(row: usize, col: usize) T { *get(row, col).unwrap() }
    pub func set(row: usize, col: usize, value: T) void { *getMut(row, col).unwrap() = value; }
    pub const func row(index: usize) ?[]const T {
        if index >= height { return null; }
        var start = index * width;
        some(values.asConstSlice()[start..start + width])
    }
    pub func rowMut(index: usize) ?[]T {
        if index >= height { return null; }
        var start = index * width;
        some(values.asSlice()[start..start + width])
    }
    pub const func asSlice() []const T { values.asConstSlice() }
    pub func asMutSlice() []T { values.asSlice() }
    pub const func clone() !Self { Matrix<T>(height, width, values.clone()!) }
    pub const func transposeCopy() !Self {
        var out = Matrix<T>.zeros(width, height)!;
        for i in usize(0)..height {
            for j in usize(0)..width { out.set(j, i, at(i, j)); }
        }
        move(out)
    }
    pub const func add(other: *const Self) !Self {
        if height != other.height || width != other.width { return LinalgError.ShapeMismatch; }
        var out = clone()!;
        for i in usize(0)..values.len() { out.values[i] += other.values[i]; }
        move(out)
    }
    pub const func sub(other: *const Self) !Self {
        if height != other.height || width != other.width { return LinalgError.ShapeMismatch; }
        var out = clone()!;
        for i in usize(0)..values.len() { out.values[i] -= other.values[i]; }
        move(out)
    }
    pub func scale(factor: T) void {
        for i in usize(0)..values.len() { values[i] *= factor; }
    }
    pub const func matmul(other: *const Self) !Self {
        if width != other.height { return LinalgError.ShapeMismatch; }
        var out = Matrix<T>.zeros(height, other.width)!;
        for i in usize(0)..height {
            for k in usize(0)..width {
                var factor = at(i, k);
                for j in usize(0)..other.width {
                    out.values[i * other.width + j] += factor * other.at(k, j);
                }
            }
        }
        move(out)
    }
    pub func swapRows(a: usize, b: usize) void {
        if a >= height || b >= height { panic("matrix row out of bounds"); }
        if a == b { return; }
        for j in usize(0)..width { values.swap(a * width + j, b * width + j); }
    }
}

pub func matmul<T: Copyable>(a: *const Matrix<T>, b: *const Matrix<T>) !Matrix<T> { a.matmul(b) }
pub func transpose<T: Copyable>(value: *const Matrix<T>) !Matrix<T> { value.transposeCopy() }

pub func trace<T: Copyable>(value: *const Matrix<T>) !T {
    if value.rows() != value.cols() { return LinalgError.ShapeMismatch; }
    var sum = T(0);
    for i in usize(0)..value.rows() { sum += value.at(i, i); }
    sum
}

pub func outer<T: Copyable>(a: []const T, b: []const T) !Matrix<T> {
    var out = Matrix<T>.zeros(a.len(), b.len())!;
    for i in usize(0)..a.len() {
        for j in usize(0)..b.len() { out.set(i, j, a[i] * b[j]); }
    }
    move(out)
}

pub func kron<T: Copyable>(a: *const Matrix<T>, b: *const Matrix<T>) !Matrix<T> {
    var height = area(a.rows(), b.rows())!;
    var width = area(a.cols(), b.cols())!;
    var out = Matrix<T>.zeros(height, width)!;
    for i in usize(0)..a.rows() {
        for j in usize(0)..a.cols() {
            var factor = a.at(i, j);
            for k in usize(0)..b.rows() {
                for l in usize(0)..b.cols() { out.set(i * b.rows() + k, j * b.cols() + l, factor * b.at(k, l)); }
            }
        }
    }
    move(out)
}

pub class LU<T: Copyable> {
    #copy: disabled
    var factors: Matrix<T>;
    var permutation: coll.Vec<usize>;
    var odd: bool;
    pub static func factor(matrix: *const Matrix<T>) !Self {
        var size = matrix.rows();
        if size != matrix.cols() { return LinalgError.ShapeMismatch; }
        for entry in matrix.asSlice() {
            if !math.isFinite<T>(entry) { return LinalgError.NonFinite; }
        }
        var factors = matrix.clone()!;
        var permutation = coll.Vec<usize>.withCapacity(size)!;
        for i in usize(0)..size { permutation.push(i)!; }
        var odd = false;
        for k in usize(0)..size {
            var pivot = k;
            var largest = math.abs<T>(factors.at(k, k));
            for i in k + 1..size {
                var magnitude = math.abs<T>(factors.at(i, k));
                if magnitude > largest { pivot = i; largest = magnitude; }
            }
            if largest == T(0) { return LinalgError.Singular; }
            if pivot != k {
                factors.swapRows(pivot, k);
                permutation.swap(pivot, k);
                odd = !odd;
            }
            var diagonal = factors.at(k, k);
            for i in k + 1..size {
                var scale = factors.at(i, k) / diagonal;
                factors.set(i, k, scale);
                for j in k + 1..size {
                    var reduced = factors.at(i, j) - scale * factors.at(k, j);
                    if !math.isFinite<T>(reduced) { return LinalgError.NonFinite; }
                    factors.set(i, j, reduced);
                }
            }
        }
        LU<T>(move(factors), move(permutation), odd)
    }
    pub const func solve(rhs: *const Vector<T>) !Vector<T> {
        var size = factors.rows();
        if rhs.len() != size { return LinalgError.ShapeMismatch; }
        var out = Vector<T>.zeros(size)!;
        var source = rhs.asSlice();
        var values = out.asMutSlice();
        for i in usize(0)..size {
            var value = source[permutation[i]];
            for j in usize(0)..i { value -= factors.at(i, j) * values[j]; }
            if !math.isFinite<T>(value) { return LinalgError.NonFinite; }
            values[i] = value;
        }
        var i = size;
        for i != 0 {
            i--;
            var value = values[i];
            for j in i + 1..size { value -= factors.at(i, j) * values[j]; }
            var solved = value / factors.at(i, i);
            if !math.isFinite<T>(solved) { return LinalgError.NonFinite; }
            values[i] = solved;
        }
        move(out)
    }
    pub const func determinant() !T {
        var value = if odd { T(-1) } else { T(1) };
        for i in usize(0)..factors.rows() { value *= factors.at(i, i); }
        if !math.isFinite<T>(value) { return LinalgError.NonFinite; }
        value
    }
    pub const func inverse() !Matrix<T> {
        var size = factors.rows();
        var out = Matrix<T>.zeros(size, size)!;
        var basis = Vector<T>.zeros(size)!;
        for j in usize(0)..size {
            *basis.getMut(j).unwrap() = T(1);
            var column = solve(&basis)!;
            *basis.getMut(j).unwrap() = T(0);
            var values = column.asSlice();
            for i in usize(0)..size { out.set(i, j, values[i]); }
        }
        move(out)
    }
    func init(factors: Matrix<T>, permutation: coll.Vec<usize>, odd: bool)
        : factors(move(factors)), permutation(move(permutation)), odd(odd) {}
}

pub func lu<T: Copyable>(matrix: *const Matrix<T>) !LU<T> { LU<T>.factor(matrix) }

pub func determinant<T: Copyable>(matrix: *const Matrix<T>) !T {
    var factor = lu<T>(matrix) catch (reason) {
        if reason == LinalgError.Singular { return T(0); }
        return reason;
    };
    factor.determinant()
}

pub func solve<T: Copyable>(matrix: *const Matrix<T>, rhs: *const Vector<T>) !Vector<T> {
    var factor = lu<T>(matrix)!;
    factor.solve(rhs)
}

pub func inverse<T: Copyable>(matrix: *const Matrix<T>) !Matrix<T> {
    var factor = lu<T>(matrix)!;
    factor.inverse()
}
