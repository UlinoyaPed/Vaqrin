package log
import (coll, io, json, text)

func keyword(value: str) !json.Value { json.Value.String(text.fromBytes(value.asBytes())!) }

func encodeAttributes(values: []const Attr, depth: usize) !json.JsonObject {
    if depth >= 128 { return json.JsonError.DepthLimit; }
    var attributes = json.JsonObject();
    for i in usize(0)..values.len() {
        var encoded = switch values[i].kind() {
            AttrKind.String => keyword(values[i].asString().unwrap())!,
            AttrKind.Int => {
                var raw = formatInt(values[i].asInt().unwrap())!;
                json.Value.Number(json.JsonNumber.parse(raw)!)
            },
            AttrKind.Bool => json.Value.Bool(values[i].asBool().unwrap()),
            AttrKind.Error => keyword("ErrorId")!,
            AttrKind.Group => json.Value.Object(encodeAttributes(values[i].asGroup(), depth + 1)!),
        };
        var previous = attributes.insert(text.fromBytes(values[i].key().asBytes())!, move(encoded))!;
    }
    move(attributes)
}

pub class JsonHandler {
    #copy: disabled
    #implements: Handler
    var writer: *io.Writer;
    var pending: coll.Vec<u8>;
    var position: usize;
    func init(writer: *io.Writer) : writer(writer), pending(coll.Vec<u8>()), position(0) {}
    pub static func new(writer: *io.Writer) Self { JsonHandler(writer) }
    pub const func enabled(level: Level) bool { true }

    pub func handle(record: *const Record) !void {
        drain()!;
        var object = json.JsonObject();
        var oldLevel = object.insert("level", keyword(levelText(record.level()))!)!;
        var oldMessage = object.insert("message", keyword(record.message())!)!;
        var oldAttrs = object.insert("attrs", json.Value.Object(encodeAttributes(record.attrs(), 0)!))!;
        switch record.timestamp() {
            some(mark) => {
                seconds, nanos := unsafe { mark.monotonicParts() };
                var first = formatInt(seconds)!;
                var second = formatInt(i64(nanos))!;
                var oldSeconds = object.insert("monotonicSeconds", json.Value.Number(json.JsonNumber.parse(first)!))!;
                var oldNanos = object.insert("monotonicNanos", json.Value.Number(json.JsonNumber.parse(second)!))!;
            },
            null => {},
        };
        var value = json.Value.Object(move(object));
        var line = json.stringify(raw value)!;
        var encoded = coll.Vec<u8>.withCapacity(line.byteLen() + 1)!;
        for byte in line.asBytes() { encoded.push(byte)!; }
        encoded.push(10)!;
        pending = move(encoded);
        drain()
    }

    pub func flush() !void {
        drain()!;
        writer.flush()
    }
    func drain() !void {
        io.writeAll(writer, pending.asConstSlice(), raw position)!;
        pending.clear();
        position = 0;
    }
}
