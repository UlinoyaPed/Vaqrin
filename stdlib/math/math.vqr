package math
import (cmp, convert, math_ffi as ffi, meta)

pub enum FpClass { Nan, Infinite, Zero, Subnormal, Normal }
pub error MathError { Domain, Pole, InvalidInterval, Overflow, DivisionByZero }

func toF32<T: Copyable>(value: T) f32 { (convert.checkedCast<f32, T>(value) catch { panic("floating-point conversion failed"); }).unwrap() }
func toF64<T: Copyable>(value: T) f64 { (convert.checkedCast<f64, T>(value) catch { panic("floating-point conversion failed"); }).unwrap() }
func fromF32<T>(value: f32) T { (convert.checkedCast<T, f32>(value) catch { panic("floating-point conversion failed"); }).unwrap() }
func fromF64<T>(value: f64) T { (convert.checkedCast<T, f64>(value) catch { panic("floating-point conversion failed"); }).unwrap() }


func absValue<T>(x: T) T { if signbit(x) { -x } else { x } }
func copysignValue<T>(x: T, y: T) T { if signbit(x) == signbit(y) { x } else { -x } }
func sqrtValue<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.sqrtf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.sqrt(toF64<T>(x)) }) }
}
func expValue<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.expf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.exp(toF64<T>(x)) }) }
}
func logValue<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.logf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.log(toF64<T>(x)) }) }
}
func sinValue<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.sinf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.sin(toF64<T>(x)) }) }
}
func cosValue<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.cosf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.cos(toF64<T>(x)) }) }
}
func midpointValue<T>(a: T, b: T) T {
    if (a < T(0)) != (b < T(0)) {
        a / T(2) + b / T(2)
    } else {
        a + (b - a) / T(2)
    }
}

pub func pi<T>() T { T(3.14159265358979323846264338327950288) }
pub func tau<T>() T { T(6.28318530717958647692528676655900576) }
pub func e<T>() T { T(2.71828182845904523536028747135266250) }
pub func sqrt2<T>() T { T(1.41421356237309504880168872420969808) }
pub func ln2<T>() T { T(0.69314718055994530941723212145817657) }
pub func ln10<T>() T { T(2.30258509299404568401799145468436421) }

func nan32(x: f32) bool {
    var raw = convert.bitCast<u32, f32>(x);
    (raw & 0x7f800000u32) == 0x7f800000u32 && (raw & 0x007fffffu32) != 0
}
func nan64(x: f64) bool {
    var raw = convert.bitCast<u64, f64>(x);
    (raw & 0x7ff0000000000000u64) == 0x7ff0000000000000u64 &&
        (raw & 0x000fffffffffffffu64) != 0
}
func infinite32(x: f32) bool {
    (convert.bitCast<u32, f32>(x) & 0x7fffffffu32) == 0x7f800000u32
}
func infinite64(x: f64) bool {
    (convert.bitCast<u64, f64>(x) & 0x7fffffffffffffffu64) == 0x7ff0000000000000u64
}
func normal32(x: f32) bool {
    var exponent = convert.bitCast<u32, f32>(x) & 0x7f800000u32;
    exponent != 0 && exponent != 0x7f800000u32
}
func normal64(x: f64) bool {
    var exponent = convert.bitCast<u64, f64>(x) & 0x7ff0000000000000u64;
    exponent != 0 && exponent != 0x7ff0000000000000u64
}
func signbit32(x: f32) bool {
    (convert.bitCast<u32, f32>(x) & 0x80000000u32) != 0
}
func signbit64(x: f64) bool {
    (convert.bitCast<u64, f64>(x) & 0x8000000000000000u64) != 0
}

pub func isNan<T>(x: T) bool {
    if meta.bitWidth<T>() == 32 { nan32(toF32<T>(x)) } else { nan64(toF64<T>(x)) }
}
pub func isInfinite<T>(x: T) bool {
    if meta.bitWidth<T>() == 32 { infinite32(toF32<T>(x)) } else { infinite64(toF64<T>(x)) }
}
pub func isFinite<T>(x: T) bool { !isNan(x) && !isInfinite(x) }
pub func isNormal<T>(x: T) bool {
    if meta.bitWidth<T>() == 32 { normal32(toF32<T>(x)) } else { normal64(toF64<T>(x)) }
}
pub func signbit<T>(x: T) bool {
    if meta.bitWidth<T>() == 32 { signbit32(toF32<T>(x)) } else { signbit64(toF64<T>(x)) }
}
pub func fpClassify<T>(x: T) FpClass {
    if isNan(x) { return FpClass.Nan; }
    if isInfinite(x) { return FpClass.Infinite; }
    if x == T(0) { return FpClass.Zero; }
    if isNormal(x) { FpClass.Normal } else { FpClass.Subnormal }
}
pub func inf<T>() T {
    if meta.bitWidth<T>() == 32 {
        fromF32<T>(convert.bitCast<f32, u32>(0x7f800000u32))
    } else {
        fromF64<T>(convert.bitCast<f64, u64>(0x7ff0000000000000u64))
    }
}
pub func nan<T>() T {
    if meta.bitWidth<T>() == 32 {
        fromF32<T>(convert.bitCast<f32, u32>(0x7fc00000u32))
    } else {
        fromF64<T>(convert.bitCast<f64, u64>(0x7ff8000000000000u64))
    }
}
pub func abs<T>(x: T) T { absValue(x) }
pub func copysign<T>(x: T, y: T) T { copysignValue(x, y) }

pub func floor<T: Copyable>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.floorf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.floor(toF64<T>(x)) }) }
}
pub func ceil<T: Copyable>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.ceilf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.ceil(toF64<T>(x)) }) }
}
pub func trunc<T: Copyable>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.truncf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.trunc(toF64<T>(x)) }) }
}
pub func round<T: Copyable>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.roundf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.round(toF64<T>(x)) }) }
}

func roundEven32(x: f32) f32 {
    if !isFinite(x) || x == 0.0 { return x; }
    var magnitude = if signbit32(x) { -x } else { x };
    var lower = unsafe { ffi.floorf(magnitude) };
    var fraction = magnitude - lower;
    var result = lower;
    if fraction > 0.5f32 {
        result += 1.0f32;
    } else if fraction == 0.5f32 {
        var half = unsafe { ffi.floorf(lower * 0.5f32) };
        if lower - half * 2.0f32 != 0.0f32 { result += 1.0f32; }
    }
    if signbit32(x) { -result } else { result }
}
func roundEven64(x: f64) f64 {
    if !isFinite(x) || x == 0.0 { return x; }
    var magnitude = if signbit64(x) { -x } else { x };
    var lower = unsafe { ffi.floor(magnitude) };
    var fraction = magnitude - lower;
    var result = lower;
    if fraction > 0.5 {
        result += 1.0;
    } else if fraction == 0.5 {
        var half = unsafe { ffi.floor(lower * 0.5) };
        if lower - half * 2.0 != 0.0 { result += 1.0; }
    }
    if signbit64(x) { -result } else { result }
}
pub func roundEven<T: Copyable>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(roundEven32(toF32<T>(x))) }
    else { fromF64<T>(roundEven64(toF64<T>(x))) }
}

pub func fract<T: Copyable>(x: T) T { x - trunc(x) }
pub func modf<T>(x: T) (T, T) {
    if meta.bitWidth<T>() == 32 {
        var integer: f32 = 0.0;
        var fraction = unsafe { ffi.modff(toF32<T>(x), raw integer) };
        (fromF32<T>(fraction), fromF32<T>(integer))
    } else {
        var integer: f64 = 0.0;
        var fraction = unsafe { ffi.modf(toF64<T>(x), raw integer) };
        (fromF64<T>(fraction), fromF64<T>(integer))
    }
}
pub func fmod<T>(x: T, y: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.fmodf(toF32<T>(x), toF32<T>(y)) }) }
    else { fromF64<T>(unsafe { ffi.fmod(toF64<T>(x), toF64<T>(y)) }) }
}
pub func remainder<T>(x: T, y: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.remainderf(toF32<T>(x), toF32<T>(y)) }) }
    else { fromF64<T>(unsafe { ffi.remainder(toF64<T>(x), toF64<T>(y)) }) }
}
pub func remQuo<T>(x: T, y: T) (T, i32) {
    var quotient: i32 = 0;
    if meta.bitWidth<T>() == 32 {
        var result = fromF32<T>(unsafe { ffi.remquof(toF32<T>(x), toF32<T>(y), raw quotient) });
        (result, quotient)
    } else {
        var result = fromF64<T>(unsafe { ffi.remquo(toF64<T>(x), toF64<T>(y), raw quotient) });
        (result, quotient)
    }
}

pub func sqrt<T>(x: T) T { sqrtValue(x) }
pub func cbrt<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.cbrtf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.cbrt(toF64<T>(x)) }) }
}
pub func hypot<T>(x: T, y: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.hypotf(toF32<T>(x), toF32<T>(y)) }) }
    else { fromF64<T>(unsafe { ffi.hypot(toF64<T>(x), toF64<T>(y)) }) }
}
pub func pow<T>(x: T, y: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.powf(toF32<T>(x), toF32<T>(y)) }) }
    else { fromF64<T>(unsafe { ffi.pow(toF64<T>(x), toF64<T>(y)) }) }
}
pub func powi<T>(x: T, n: i32) T {
    var exponent: u32 = if n < 0 {
        convert.checkedCast<u32, i32>(-(n + 1))!.unwrap() + 1
    } else {
        convert.checkedCast<u32, i32>(n)!.unwrap()
    };
    var factor = if n < 0 { T(1) / x } else { x };
    var result = T(1);
    while exponent > 0 {
        if (exponent & 1) != 0 { result *= factor; }
        exponent >>= 1;
        if exponent != 0 { factor *= factor; }
    }
    result
}
pub func exp<T>(x: T) T { expValue(x) }
pub func exp2<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.exp2f(toF32<T>(x)) }) }
