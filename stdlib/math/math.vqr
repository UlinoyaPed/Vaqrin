    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.tgammaf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.tgamma(toF64<T>(x)) }) }
}
pub func logGamma<T>(x: T) T {
    if meta.bitWidth<T>() == 32 { fromF32<T>(unsafe { ffi.lgammaf(toF32<T>(x)) }) }
    else { fromF64<T>(unsafe { ffi.lgamma(toF64<T>(x)) }) }
}
pub func j0(x: f64) f64 { unsafe { ffi.j0(x) } }
pub func j1(x: f64) f64 { unsafe { ffi.j1(x) } }
pub func y0(x: f64) f64 { unsafe { ffi.y0(x) } }
pub func y1(x: f64) f64 { unsafe { ffi.y1(x) } }
// Correction to Stirling's log-Gamma formula for arguments >= 16.
func stirlingCorrection(x: f64) f64 {
    var inv = 1.0 / x;
    var square = inv * inv;
    inv * (1.0 / 12.0 + square * (-1.0 / 360.0 + square * (1.0 / 1260.0
           + square * (-1.0 / 1680.0 + square * (1.0 / 1188.0 - square * 691.0 / 360360.0)))))
}
pub func beta<T>(x: T, y: T) T {
    var a = toF64<T>(x);
    var b = toF64<T>(y);
    if isNan<f64>(a) || isNan<f64>(b) { return nan<T>(); }
    if a <= 0.0 || b <= 0.0 { return gamma<T>(x) * gamma<T>(y) / gamma<T>(x + y); }
    if isInfinite<f64>(a) || isInfinite<f64>(b) { return T(0); }
    var p = minNum<f64>(a, b);
    var q = maxNum<f64>(a, b);
    if q < 16.0 { return fromF64<T>(exp<f64>(logGamma<f64>(p) + logGamma<f64>(q) - logGamma<f64>(p + q))); }
    // Use log1p<f64>(p/q) to avoid subtracting nearly equal log-Gamma values.
    var ratioLog = log1p<f64>(p / q);
    var ratioTerm = q * ratioLog + (p - 0.5) * ratioLog;
    var correction = stirlingCorrection(q) - stirlingCorrection(p + q);
    if p < 16.0 {
        return fromF64<T>(exp<f64>(logGamma<f64>(p) - p * log<f64>(q) + p - ratioTerm + correction));
    }
    var logRatio = log<f64>(p) - log<f64>(q);
    if p / q >= 0.5 { logRatio = log<f64>(p / q); }
    fromF64<T>(exp<f64>((p - 0.5) * logRatio - 0.5 * log<f64>(q) - ratioTerm
        + 0.91893853320467274178 + stirlingCorrection(p) + correction))
}

pub func sinCos<T>(x: T) (T, T) { (sin(x), cos(x)) }
pub func ulp<T>(x: T) T {
    if isNan(x) || isInfinite(x) { return nan<T>(); }
    var toward = if signbit(x) { -inf<T>() } else { inf<T>() };
    var next = nextAfter(x, toward);
    if isInfinite(next) { next = nextAfter(x, T(0)); }
    abs(next - x)
}
pub func maxNum<T>(a: T, b: T) T {
    if isNan(a) { return b; }
    if isNan(b) { return a; }
    if a == T(0) && b == T(0) { return if signbit(a) { b } else { a }; }
    if a > b { a } else { b }
}
pub func minNum<T>(a: T, b: T) T {
    if isNan(a) { return b; }
    if isNan(b) { return a; }
    if a == T(0) && b == T(0) { return if signbit(a) { a } else { b }; }
    if a < b { a } else { b }
}
pub func totalMin<T>(a: T, b: T) T {
    if cmp.totalCmp(a, b) == cmp.Ordering.Greater { b } else { a }
}
pub func totalMax<T>(a: T, b: T) T {
    if cmp.totalCmp(a, b) == cmp.Ordering.Less { b } else { a }
}
pub func clamp<T>(x: T, low: T, high: T) T {
    if isNan(low) || isNan(high) || low > high { panic("invalid clamp bounds"); }
    if x < low { low } else if x > high { high } else { x }
}
pub func lerp<T>(a: T, b: T, t: T) T {
    if (a <= T(0) && b >= T(0)) || (a >= T(0) && b <= T(0)) {
        a * (T(1) - t) + b * t
    } else {
        a + (b - a) * t
    }
}
pub func midpoint<T>(a: T, b: T) T { midpointValue(a, b) }
pub func degrees<T>(radians: T) T { radians * T(180) / pi<T>() }
pub func radians<T>(degrees: T) T { degrees * pi<T>() / T(180) }
pub func distance2D<T>(x1: T, y1: T, x2: T, y2: T) T {
    hypot(x2 - x1, y2 - y1)
}
pub func reduceAngle<T>(x: T) T { remainder(x, tau<T>()) }

// Keep the exponent separate so even products of subnormal or maximum
// finite operands can participate in the quotient.
func scaledProduct(x: f64, y: f64) (f64, c_int) {
    var xExponent: c_int = 0;
    var yExponent: c_int = 0;
    var xFraction = unsafe { ffi.frexp(x, raw xExponent) };
    var yFraction = unsafe { ffi.frexp(y, raw yExponent) };
    (xFraction * yFraction, xExponent + yExponent)
}
func scaledDot(a: f64, b: f64, c: f64, d: f64) (f64, c_int) {
    x, xExponent := scaledProduct(a, c);
    y, yExponent := scaledProduct(b, d);
    if x == 0.0 { return (if y == 0.0 { x + y } else { y }, yExponent); }
    if y == 0.0 { return (x, xExponent); }
    if xExponent >= yExponent {
        return (x + unsafe { ffi.scalbn(y, yExponent - xExponent) }, xExponent);
    }
    (y + unsafe { ffi.scalbn(x, xExponent - yExponent) }, yExponent)
}
func infiniteComponent(x: f64) f64 { copysign(if isInfinite(x) { 1.0 } else { 0.0 }, x) }

func scaledExpComponent<T>(exponent: T, factor: T, scale: T) T {
    if factor == T(0) && !isNan(exponent) { return factor; }
    if isInfinite(scale) && isFinite(exponent) && isFinite(factor) {
        var shifted = toF64<T>(exponent) + logValue<f64>(absValue<f64>(toF64<T>(factor)));
        return copysignValue(fromF64<T>(expValue<f64>(shifted)), factor);
    }
    scale * factor
}

pub class Complex<T> {
    pub var re: T;
    pub var im: T;
    func init(real: T, imag: T) : re(real), im(imag) {}
    pub static func new(real: T, imag: T) Self { Complex<T>(real, imag) }
    pub const func real() T { re }
    pub const func imag() T { im }
    pub const func conjugate() Self { Complex<T>(re, -im) }
    pub const func norm() T { re * re + im * im }
    pub const func abs() T { hypot(re, im) }
    pub const func arg() T { atan2(im, re) }
    pub const func add(other: Self) Self { Complex<T>(re + other.re, im + other.im) }
    pub const func sub(other: Self) Self { Complex<T>(re - other.re, im - other.im) }
    pub const func mul(other: Self) Self {
        Complex<T>(re * other.re - im * other.im, re * other.im + im * other.re)
    }
    pub const func div(other: Self) !Self {
        if other.re == T(0) && other.im == T(0) { return MathError.DivisionByZero; }
        var a = toF64<T>(re);
        var b = toF64<T>(im);
        var c = toF64<T>(other.re);
        var d = toF64<T>(other.im);
        if isFinite(a) && isFinite(b) && (isInfinite(c) || isInfinite(d)) {
            c = infiniteComponent(c);
            d = infiniteComponent(d);
            realPart, realExponent := scaledDot(a, b, c, d);
            imagPart, imagExponent := scaledDot(b, -a, c, d);
            return Complex<T>(fromF64<T>(copysign(0.0, realPart)), fromF64<T>(copysign(0.0, imagPart)));
        }
        if (isInfinite(a) || isInfinite(b)) && isFinite(c) && isFinite(d) {
            a = infiniteComponent(a);
            b = infiniteComponent(b);
            realPart, realExponent := scaledDot(a, b, c, d);
            imagPart, imagExponent := scaledDot(b, -a, c, d);
            return Complex<T>(fromF64<T>(inf<f64>() * realPart), fromF64<T>(inf<f64>() * imagPart));
        }
        if !isFinite(a) || !isFinite(b) || !isFinite(c) || !isFinite(d) {
            return Complex<T>(nan<T>(), nan<T>());
        }
        denominator, exponent := scaledDot(c, d, c, d);
        realPart, realExponent := scaledDot(a, b, c, d);
        imagPart, imagExponent := scaledDot(b, -a, c, d);
        Complex<T>(fromF64<T>(unsafe { ffi.scalbn(realPart / denominator, realExponent - exponent) }),
                   fromF64<T>(unsafe { ffi.scalbn(imagPart / denominator, imagExponent - exponent) }))
    }
    pub const func sqrt() Self {
        if re == T(0) && im == T(0) { return Complex<T>(T(0), im); }
        if isInfinite(im) { return Complex<T>(inf<T>(), im); }
        if isInfinite(re) {
            if re > T(0) {
                return Complex<T>(re, if isNan(im) { im } else { copysignValue(T(0), im) });
            }
            return Complex<T>(if isNan(im) { im } else { T(0) }, copysignValue(inf<T>(), im));
        }
        if isNan(re) || isNan(im) { return Complex<T>(nan<T>(), nan<T>()); }
        var scale = maxNum<T>(absValue<T>(re), absValue<T>(im));
        var x = absValue(re) / scale;
        var y = im / scale;
        var major = sqrtValue<T>(scale) * sqrtValue<T>((hypot<T>(x, y) + x) / T(2));
        if re >= T(0) { return Complex<T>(major, im / (T(2) * major)); }
        Complex<T>(absValue(im) / (T(2) * major), copysignValue(major, im))
    }
    pub const func exp() Self {
        var scale = expValue(re);
        Complex<T>(scaledExpComponent(re, cosValue(im), scale), scaledExpComponent(re, sinValue(im), scale))
    }
    pub const func log() Self {
        var x = absValue<T>(re);
        var y = absValue<T>(im);
        if !isFinite(x) || !isFinite(y) || (x == T(0) && y == T(0)) {
            return Complex<T>(logValue(abs()), arg());
        }
        var major = maxNum<T>(x, y);
        var ratio = minNum<T>(x, y) / major;
        Complex<T>(logValue(major) + log1p<T>(ratio * ratio) / T(2), arg())
    }
    pub const func pow(other: Self) Self { (other.mul(log())).exp() }
}

pub class Interval<T> {
    pub var low: T;
    pub var high: T;
    func init(lower: T, upper: T) : low(lower), high(upper) {}
    pub static func new(lower: T, upper: T) !Self {
        if isNan(lower) || isNan(upper) || lower > upper { return MathError.InvalidInterval; }
        Interval<T>(lower, upper)
    }
    pub const func contains(value: T) bool { low <= value && value <= high }
    pub const func containsZero() bool { low <= T(0) && T(0) <= high }
    pub const func intersects(other: *const Self) bool { low <= other.high && other.low <= high }
    pub const func intersection(other: *const Self) ?Self {
        var lower = if low > other.low { low } else { other.low };
        var upper = if high < other.high { high } else { other.high };
        if lower > upper { null } else { some(Interval<T>(lower, upper)) }
    }
    pub const func hull(other: *const Self) Self {
        Interval<T>(if low < other.low { low } else { other.low },
                    if high > other.high { high } else { other.high })
    }
    pub const func width() T { high - low }
    pub const func midpoint() T { midpointValue(low, high) }
    pub const func add(other: *const Self) Self {
        Interval<T>(low + other.low, high + other.high)
    }
    pub const func sub(other: *const Self) Self {
        Interval<T>(low - other.high, high - other.low)
    }
    pub const func mul(other: *const Self) !Self {
        var a = low * other.low;
        var b = low * other.high;
        var c = high * other.low;
        var d = high * other.high;
        if isNan<f64>(a) || isNan<f64>(b) || isNan(c) || isNan(d) { return MathError.Domain; }
        var lower = minNum(minNum(a, b), minNum(c, d));
        var upper = maxNum(maxNum(a, b), maxNum(c, d));
        Interval<T>(lower, upper)
    }
    pub const func div(other: *const Self) !Self {
        if other.containsZero() { return MathError.Pole; }
        var a = T(1) / other.low;
        var b = T(1) / other.high;
        var reciprocal = Interval<T>(if a < b { a } else { b }, if a > b { a } else { b });
        mul(raw reciprocal)
    }
}
