package mem

pub class MaybeUninit<T: Movable> {
    var storage: __vqr_RawStorage<T>;
    func init() : storage(__vqr_uninitialized<T>()) {}
    pub static func uninit() Self { MaybeUninit<T>() }

    pub func asPtr() *T { __vqr_raw_address(raw storage) }
    pub const func asConstPtr() *const T { __vqr_raw_address(raw storage) }

    pub unsafe func write(value: T) *T {
        var address = asPtr();
        unsafe { __vqr_slot_write<T>(address, move(value)); }
        address
    }

    pub unsafe func assumeInit() T { unsafe { __vqr_slot_take<T>(asPtr()) } }
    pub unsafe func assumeInitRef() *T { asPtr() }
    pub unsafe func assumeInitDrop() void { unsafe { __vqr_slot_drop<T>(asPtr()); } }
}

pub class ManuallyDrop<T: Movable> {
    var slot: MaybeUninit<T>;
    func init(value: T) : slot(MaybeUninit<T>.uninit()) {
        unsafe { slot.write(move(value)); }
    }
    pub static func new(value: T) Self { ManuallyDrop<T>(move(value)) }
    pub func asPtr() *T { slot.asPtr() }
    pub static func intoInner(value: Self) T { unsafe { value.slot.assumeInit() } }
    pub unsafe func dropInPlace() void { unsafe { slot.assumeInitDrop(); } }
}

pub class ScopeGuard<F: Movable> {
    #copy: disabled
    var callback: F;
    var armed: bool;
    pub func init(callback: F) : callback(move(callback)), armed(true) {}
    pub func dismiss() void { armed = false; }
    pub const func isArmed() bool { armed }

    pub func runNow() void {
        if armed {
            armed = false;
            callback();
        }
    }

    pub func deinit() void { runNow(); }
}
