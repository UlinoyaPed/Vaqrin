package mmio
import (meta)

pub error MmioError { OutsideRegion, Misaligned, AddressOverflow }

pub unsafe func volatileLoad<T>(ptr: *const T) T { unsafe { __vqr_mmio_load(ptr) } }
pub unsafe func volatileStore<T>(ptr: *T, value: T) void { unsafe { __vqr_mmio_store(ptr, value); } }

pub unsafe func volatileUpdate<T: Movable, F: Movable>(ptr: *T, transform: F) void {
    unsafe {
        var value = volatileLoad<T>(ptr);
        volatileStore<T>(ptr, transform(move(value)));
    }
}

pub unsafe func ptrFromInt<T>(address: usize) *T {
    unsafe { __vqr_mmio_pointer<*T>(address) }
}

pub func addressOf<T>(ptr: *T) usize { __vqr_pointer_address(ptr) }
pub func compilerBarrier() void { __vqr_mmio_compiler_barrier(); }
pub func memoryBarrier() void { __vqr_mmio_memory_barrier(); }
pub func instructionBarrier() void { __vqr_mmio_instruction_barrier(); }

pub class Volatile<T> {
    var location: *T;
    func init(location: *T) : location(location) {}
public:
    static func new(ptr: *T) Self { Volatile<T>(ptr) }
    unsafe const func load() T { unsafe { volatileLoad<T>(location) } }
    unsafe func store(value: T) void { unsafe { volatileStore<T>(location, move(value)); } }
    unsafe func update<F: Movable>(transform: F) void {
        unsafe { volatileUpdate<T, F>(location, move(transform)); }
    }
}

pub class Register<T: Movable> {
    var location: *T;
    func init(ptr: *T) : location(ptr) {}
public:
    static func new(ptr: *T) Self { Register<T>(ptr) }
    unsafe const func read() T { unsafe { volatileLoad<T>(location) } }
    unsafe func write(value: T) void { unsafe { volatileStore<T>(location, move(value)); } }
    unsafe func modify<F: Movable>(transform: F) void {
        unsafe { volatileUpdate<T, F>(location, move(transform)); }
    }

    unsafe func setBits(mask: T) void {
        unsafe {
            var value = read();
            var updated: !T = T(value | mask);
            write(updated catch panic("register value exceeds its width"));
        }
    }

    unsafe func clearBits(mask: T) void {
        unsafe {
            var value = read();
            var updated: !T = T(value & ~mask);
            write(updated catch panic("register value exceeds its width"));
        }
    }
}

pub class MmioRegion {
    var start: usize;
    var size: usize;
    func init(base: usize, length: usize) : start(base), size(length) {}
public:
    static func new(base: usize, length: usize) Self { MmioRegion(base, length) }

    const func contains(address: usize) bool { address >= start && address - start < size }

    unsafe const func registerAt<T: Movable>(offset: usize) !Register<T> {
        if offset >= size || meta.sizeOf<T>() > size - offset { return MmioError.OutsideRegion; }
        if offset > ~usize(0) - start { return MmioError.AddressOverflow; }
        var address = start + offset;
        if address == 0 { return MmioError.OutsideRegion; }
        if address % meta.alignOf<T>() != 0 { return MmioError.Misaligned; }
        unsafe { Register<T>.new(ptrFromInt<T>(address)) }
    }
}
