package net
import (coll, core, io, reactor, task, time)

extern "C" func __vqr_net_socket_error(fd: i32) i32;

func checkWait(deadline: ?time.Deadline) !void {
    if task.isCancelled() { return io.IoError.Cancelled; }
    if deadline != null && deadline.unwrap().expired()! { return io.IoError.DeadlineExceeded; }
}

pub class AsyncTcpStream {
    #copy: disabled
    #implements: io.Reader, io.Writer, io.Closer
    var stream: TcpStream;
    var readDeadline: ?time.Deadline;
    var writeDeadline: ?time.Deadline;
    func init(value: move TcpStream) : stream(move(value)), readDeadline(null), writeDeadline(null) {}
    pub static func connect(address: SocketAddr, deadline: ?time.Deadline) !Self {
        checkWait(deadline)!;
        var tcp = TcpStream(openSocket(address, 3, -1)!);
        var descriptor = tcp.systemDescriptor()!;
        task.waitDescriptor(descriptor, reactor.Interest.write(), deadline)!;
        checkStatus(unsafe { __vqr_net_socket_error(descriptor) })!;
        AsyncTcpStream(move(tcp))
    }
    pub static func fromTcp(socket: move TcpStream) !Self {
        socket.setNonblocking(true)!;
        AsyncTcpStream(move(socket))
    }
    pub static func intoTcp(value: move Self) TcpStream {
        core.Exchange<TcpStream>.replace(value.stream, TcpStream(Socket(-1)))
    }
    pub const func systemDescriptor() !i32 { stream.systemDescriptor() }
    pub const func localAddr() !SocketAddr { stream.localAddr() }
    pub const func peerAddr() !SocketAddr { stream.peerAddr() }
    pub func setReadDeadline(value: ?time.Deadline) void { readDeadline = value; }
    pub func setWriteDeadline(value: ?time.Deadline) void { writeDeadline = value; }
    pub func tryRead(dst: []u8) !usize { stream.read(dst) }
    pub func read(dst: []u8) !usize {
        var fd = systemDescriptor()!;
        if dst.len() == 0 { return 0; }
        for {
            checkWait(readDeadline)!;
            var result = stream.read(dst) catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.read(), readDeadline)!;
                continue;
            };
            return result;
        }
    }
    pub func write(src: []const u8) !usize {
        var fd = systemDescriptor()!;
        if src.len() == 0 { return 0; }
        for {
            checkWait(writeDeadline)!;
            var result = stream.write(src) catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.write(), writeDeadline)!;
                continue;
            };
            return result;
        }
    }
    pub func shutdownRead() !void { stream.shutdownRead() }
    pub func shutdownWrite() !void { stream.shutdownWrite() }
    pub func flush() !void { stream.flush() }
    pub func close() !void { stream.close() }
}

pub class AsyncTcpListener {
    #copy: disabled
    var listener: TcpListener;
    func init(value: move TcpListener) : listener(move(value)) {}
    pub static func bind(address: SocketAddr) !Self {
        var listener = TcpListener.bind(address)!;
        listener.setNonblocking(true)!;
        AsyncTcpListener(move(listener))
    }
    pub const func localAddr() !SocketAddr { listener.localAddr() }
    pub func accept(deadline: ?time.Deadline) !(AsyncTcpStream, SocketAddr) {
        var fd = listener.systemDescriptor()!;
        for {
            checkWait(deadline)!;
            var accepted = listener.accept() catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.read(), deadline)!;
                continue;
            };
            socket, peer := move(accepted);
            return (AsyncTcpStream.fromTcp(move(socket))!, peer);
        }
    }
    pub func close() !void { listener.close() }
}

extern "C" func __vqr_net_resolve_start(host: *const u8, status: *i32) usize;
extern "C" func __vqr_net_resolve_event(handle: usize) i32;
extern "C" func __vqr_net_resolve_finish(handle: usize, status: *i32) usize;
extern "C" func __vqr_net_resolve_release(handle: usize) void;

class PendingResolution {
    #copy: disabled
    var handle: usize;
    pub func init(value: usize) : handle(value) {}
    pub const func wait(port: u16, deadline: ?time.Deadline) !coll.Vec<SocketAddr> {
        var event = unsafe { __vqr_net_resolve_event(handle) };
        task.waitDescriptor(event, reactor.Interest.read(), deadline)!;
        checkWait(deadline)!;
        var reason: i32 = 0;
        var result = unsafe { __vqr_net_resolve_finish(handle, raw reason) };
        var addresses = ResolverResults(result);
        if reason == -1 { return NetError.NameResolution; }
        checkStatus(reason)!;
        addresses.copyAddresses(port)
    }
    pub func deinit() void { unsafe { __vqr_net_resolve_release(handle); } }
}

pub func resolveAddrAsync(host: str, port: u16, deadline: ?time.Deadline) !coll.Vec<SocketAddr> {
    checkWait(deadline)!;
    var name = cString(host)!;
    var reason: i32 = 0;
    var raw = unsafe { __vqr_net_resolve_start(raw name[0], raw reason) };
    checkStatus(reason)!;
    var request = PendingResolution(raw);
    request.wait(port, deadline)
}

pub class AsyncUdpSocket {
    #copy: disabled
    var socket: UdpSocket;
    func init(value: move UdpSocket) : socket(move(value)) {}
    pub static func bind(address: SocketAddr) !Self { AsyncUdpSocket.fromUdp(UdpSocket.bind(address)!) }
    pub static func fromUdp(value: move UdpSocket) !Self {
        value.setNonblocking(true)!;
        AsyncUdpSocket(move(value))
    }
    pub const func localAddr() !SocketAddr { socket.localAddr() }
    pub func close() !void { socket.close() }
    pub func sendTo(src: []const u8, address: SocketAddr, deadline: ?time.Deadline) !usize {
        var fd = socket.systemDescriptor()!;
        for {
            checkWait(deadline)!;
            var count = socket.sendTo(src, address) catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.write(), deadline)!;
                continue;
            };
            return count;
        }
    }
    pub func recvFrom(dst: []u8, deadline: ?time.Deadline) !Datagram {
        var fd = socket.systemDescriptor()!;
        for {
            checkWait(deadline)!;
            var datagram = socket.recvFrom(dst) catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.read(), deadline)!;
                continue;
            };
            return datagram;
        }
    }
}
