package num
import (bits, coll, cmp, meta, text)

func bigDigit(byte: u8) u32 {
    var code = u32(byte);
    if code >= 48 && code <= 57 { return code - 48; }
    if code >= 65 && code <= 90 { return code - 55; }
    if code >= 97 && code <= 122 { return code - 87; }
    36
}

pub class BigUint {
    #copy: disabled
    var limbs: coll.Vec<u32>;

    func init() : limbs(coll.Vec<u32>()) {}
    func init(data: coll.Vec<u32>) : limbs(move(data)) { normalize(); }

public:
    static func zero() Self { BigUint() }

    static func fromU64(value: u64) !Self {
        var out = coll.Vec<u32>();
        if value != 0 {
            out.push(u32(value & 0xffffffffu64)!)!;
            var high = value >> 32;
            if high != 0 { out.push(u32(high)!)!; }
        }
        BigUint(move(out))
    }

    static func fromBytes(bytes: []const u8, endian: meta.Endian) !Self {
        if bytes.len() == 0 { return BigUint(); }
        if bytes.len() > ~usize(0) - 3 { return coll.CapacityError.Overflow; }
        var count = (bytes.len() + 3) / 4;
        var words = coll.Vec<u32>.withCapacity(count)!;
        for i in usize(0)..count { words.push(0)!; }
        var data = words.asSlice();
        for i in usize(0)..bytes.len() {
            var source = if endian == meta.Endian.Little { i } else { bytes.len() - i - 1 };
            var word = i / 4;
            var shift = (i % 4) * 8;
            data[word] = data[word] | (u32(bytes[source]) << shift);
        }
        BigUint(move(words))
    }

    static func parse(value: str, radix: u8) !Self {
        parseBytes(value.asBytes(), radix)
    }

    static func parseBytes(bytes: []const u8, radix: u8) !Self {
        if radix < 2 || radix > 36 { return NumError.InvalidRadix; }
        if bytes.len() == 0 { return NumError.InvalidSyntax; }
        var result = BigUint();
        for byte in bytes {
            var digit = bigDigit(byte);
            if digit >= u32(radix) { return NumError.InvalidDigit; }
            result.mulSmall(u32(radix))!;
            result.addSmall(digit)!;
        }
        move(result)
    }

    const func isZero() bool { limbs.isEmpty() }
    const func limbCount() usize { limbs.len() }

    const func bitLength() usize {
        if limbs.isEmpty() { return 0; }
        var last = limbs.asConstSlice()[limbs.len() - 1];
        limbs.len() * 32 - 32 + (32 - bits.leadingZeros(last))
    }

    const func compare(other: *const Self) cmp.Ordering {
        if limbs.len() < other.limbs.len() { return cmp.Ordering.Less; }
        if limbs.len() > other.limbs.len() { return cmp.Ordering.Greater; }
        var index = limbs.len();
        for index > 0 {
            index--;
            var left = limbs.asConstSlice()[index];
            var right = other.limbs.asConstSlice()[index];
            if left < right { return cmp.Ordering.Less; }
            if left > right { return cmp.Ordering.Greater; }
        }
        cmp.Ordering.Equal
    }

    const func clone() !Self {
        var out = coll.Vec<u32>.withCapacity(limbs.len())!;
        for limb in limbs.asConstSlice() { out.push(limb)!; }
        BigUint(move(out))
    }

    func add(other: *const Self) !Self {
        var count = if limbs.len() > other.limbs.len() { limbs.len() } else { other.limbs.len() };
        if count == ~usize(0) { return coll.CapacityError.Overflow; }
        var out = coll.Vec<u32>.withCapacity(count + 1)!;
        var carry: u64 = 0;
        for index in usize(0)..count {
            var left = if index < limbs.len() { u64(limbs.asConstSlice()[index]) } else { u64(0) };
            var right = if index < other.limbs.len() { u64(other.limbs.asConstSlice()[index]) } else { u64(0) };
            var total = left + right + carry;
            out.push(u32(total & 0xffffffffu64)!)!;
            carry = total >> 32;
        }
        if carry != 0 { out.push(u32(carry)!)!; }
        BigUint(move(out))
    }

    func sub(other: *const Self) !Self {
        if compare(other) == cmp.Ordering.Less { return NumError.Underflow; }
        var out = coll.Vec<u32>.withCapacity(limbs.len())!;
        var borrow: u64 = 0;
        for index in usize(0)..limbs.len() {
            var left = u64(limbs.asConstSlice()[index]);
            var right = if index < other.limbs.len() { u64(other.limbs.asConstSlice()[index]) } else { u64(0) };
            right += borrow;
            if left < right {
                out.push(u32((u64(0x100000000) + left - right) & 0xffffffffu64)!)!;
                borrow = 1;
            } else {
                out.push(u32(left - right)!)!;
                borrow = 0;
            }
        }
        BigUint(move(out))
    }

    func mul(other: *const Self) !Self {
        if isZero() || other.isZero() { return BigUint(); }
        if limbs.len() > ~usize(0) - other.limbs.len() { return coll.CapacityError.Overflow; }
        var count = limbs.len() + other.limbs.len();
        var out = coll.Vec<u32>.withCapacity(count)!;
        for i in usize(0)..count { out.push(0)!; }
        var data = out.asSlice();
        for i in usize(0)..limbs.len() {
            var carry: u64 = 0;
            for j in usize(0)..other.limbs.len() {
                var index = i + j;
                var total = u64(data[index]) +
                    u64(limbs.asConstSlice()[i]) * u64(other.limbs.asConstSlice()[j]) + carry;
                data[index] = u32(total & 0xffffffffu64)!;
                carry = total >> 32;
            }
            var index = i + other.limbs.len();
            for carry != 0 {
                if index >= data.len() { return NumError.Overflow; }
                var total = u64(data[index]) + carry;
                data[index] = u32(total & 0xffffffffu64)!;
                carry = total >> 32;
                index++;
            }
        }
        BigUint(move(out))
    }

    func divMod(other: *const Self) !(Self, Self) {
        if other.isZero() { return NumError.DivisionByZero; }
        var quotient = BigUint();
        var remainder = BigUint();
        var index = bitLength();
        for index > 0 {
            index--;
            remainder.mulSmall(2)!;
            if getBit(index) { remainder.addSmall(1)!; }
            if remainder.compare(other) != cmp.Ordering.Less {
                remainder.subInPlace(other)!;
                quotient.setBit(index)!;
            }
        }
        (move(quotient), move(remainder))
    }

    func div(other: *const Self) !Self {
        var quotient, remainder = divMod(other)!;
        move(quotient)
    }

    func rem(other: *const Self) !Self {
        var quotient, remainder = divMod(other)!;
        move(remainder)
    }

    func shl(count: usize) !Self {
        if isZero() { return BigUint(); }
        var words = count / 32;
        var shift = count % 32;
        if limbs.len() > ~usize(0) - words - 1 { return coll.CapacityError.Overflow; }
        var out = coll.Vec<u32>.withCapacity(limbs.len() + words + 1)!;
        for i in usize(0)..words { out.push(0)!; }
        var carry: u64 = 0;
        for limb in limbs.asConstSlice() {
            var value = (u64(limb) << shift) | carry;
            out.push(u32(value & 0xffffffffu64)!)!;
            carry = value >> 32;
        }
        if carry != 0 { out.push(u32(carry)!)!; }
        BigUint(move(out))
    }

    func shr(count: usize) !Self {
        var words = count / 32;
        var shift = count % 32;
        if words >= limbs.len() { return BigUint(); }
        var countOut = limbs.len() - words;
        var out = coll.Vec<u32>.withCapacity(countOut)!;
        for i in usize(0)..countOut { out.push(0)!; }
        var data = out.asSlice();
        var carry: u64 = 0;
        var index = limbs.len();
        for index > words {
            index--;
            var value = u64(limbs.asConstSlice()[index]);
            var shifted = if shift == 0 { value } else { (value >> shift) | (carry << (32 - shift)) };
            data[index - words] = u32(shifted & 0xffffffffu64)!;
            carry = if shift == 0 { u64(0) } else { value & ((u64(1) << shift) - 1) };
        }
        BigUint(move(out))
    }

    func toBytes(endian: meta.Endian) !coll.Vec<u8> {
        var count = if limbs.isEmpty() { usize(1) } else { limbs.len() * 4 };
        var out = coll.Vec<u8>.withCapacity(count)!;
        if limbs.isEmpty() {
            out.push(0)!;
        } else {
            for limb in limbs.asConstSlice() {
                var value = limb;
                for i in usize(0)..4 {
                    out.push(u8(value & 0xffu32)!)!;
                    value >>= 8;
                }
            }
            for out.len() > 1 && out.asConstSlice()[out.len() - 1] == 0 {
                out.truncate(out.len() - 1);
            }
        }
        if endian == meta.Endian.Big { out.reverse(); }
        move(out)
    }

    func toText(radix: u8) !string {
        if radix < 2 || radix > 36 { return NumError.InvalidRadix; }
        if isZero() { return "0"; }
        var work = clone()!;
        var output = coll.Vec<u8>();
        for !work.isZero() {
            var digit = work.divSmallInPlace(u32(radix))!;
            var byte = if digit < 10 { u8(48 + digit)! } else { u8(87 + digit)! };
            output.push(byte)!;
        }
        output.reverse();
        text.fromBytes(output.asConstSlice())
    }

private:
    const func getBit(index: usize) bool {
        var word = index / 32;
        if word >= limbs.len() { return false; }
        (limbs.asConstSlice()[word] & (u32(1) << (index % 32))) != 0
    }

    func setBit(index: usize) !void {
        var word = index / 32;
        while limbs.len() <= word { limbs.push(0)!; }
        var data = limbs.asSlice();
        data[word] = data[word] | (u32(1) << (index % 32));
    }

    func normalize() void {
        for limbs.len() > 0 && limbs.asConstSlice()[limbs.len() - 1] == 0 {
            limbs.truncate(limbs.len() - 1);
        }
    }

    func mulSmall(factor: u32) !void {
        if factor == 0 || isZero() {
            limbs.clear();
            return;
        }
        var carry: u64 = 0;
        var data = limbs.asSlice();
        for i in usize(0)..data.len() {
            var total = u64(data[i]) * u64(factor) + carry;
            data[i] = u32(total & 0xffffffffu64)!;
            carry = total >> 32;
        }
        if carry != 0 { limbs.push(u32(carry)!)!; }
    }

    func addSmall(value: u32) !void {
        if value == 0 { return; }
        if limbs.isEmpty() {
            limbs.push(value)!;
            return;
        }
        var carry = u64(value);
        var data = limbs.asSlice();
        var index: usize = 0;
        for carry != 0 && index < data.len() {
            var total = u64(data[index]) + carry;
            data[index] = u32(total & 0xffffffffu64)!;
            carry = total >> 32;
            index++;
        }
        if carry != 0 { limbs.push(u32(carry)!)!; }
    }

    func divSmallInPlace(divisor: u32) !u32 {
        if divisor == 0 { return NumError.DivisionByZero; }
        var remainder: u64 = 0;
        var data = limbs.asSlice();
        var index = data.len();
        for index > 0 {
            index--;
            var current = (remainder << 32) | u64(data[index]);
            data[index] = u32(current / u64(divisor))!;
            remainder = current % u64(divisor);
        }
        normalize();
        u32(remainder)!
    }

    func subInPlace(other: *const Self) !void {
        if compare(other) == cmp.Ordering.Less { return NumError.Underflow; }
        var borrow: u64 = 0;
        var data = limbs.asSlice();
        for index in usize(0)..data.len() {
            var left = u64(data[index]);
            var right = if index < other.limbs.len() { u64(other.limbs.asConstSlice()[index]) } else { u64(0) };
            right += borrow;
            if left < right {
                data[index] = u32((u64(0x100000000) + left - right) & 0xffffffffu64)!;
                borrow = 1;
            } else {
                data[index] = u32(left - right)!;
                borrow = 0;
            }
        }
        normalize();
    }
}

pub class BigInt {
    #copy: disabled
    var sign: i8;
    var magnitude: BigUint;

    func init() : sign(0), magnitude(BigUint()) {}
    func init(sign: i8, magnitude: BigUint) : sign(sign), magnitude(move(magnitude)) {
        if magnitude.isZero() { sign = 0; }
        else if sign < 0 { sign = -1; }
        else { sign = 1; }
    }

public:
    static func zero() Self { BigInt() }

    static func fromI64(value: i64) !Self {
        if value == 0 { return BigInt(); }
        var mag = if value < 0 {
            BigUint.fromU64(u64(~value) + u64(1))!
        } else {
            BigUint.fromU64(u64(value)!)!
        };
        BigInt(if value < 0 { i8(-1) } else { i8(1) }, move(mag))
    }

    static func fromTwosComplementBytes(bytes: []const u8, endian: meta.Endian) !Self {
        if bytes.len() == 0 { return NumError.InvalidSyntax; }
        var little = coll.Vec<u8>.withCapacity(bytes.len())!;
        for i in usize(0)..bytes.len() {
            var source = if endian == meta.Endian.Little { i } else { bytes.len() - i - 1 };
            little.push(bytes[source])!;
        }
        var data = little.asSlice();
        var negative = (data[data.len() - 1] & 0x80) != 0;
        if !negative {
            var mag = BigUint.fromBytes(little.asConstSlice(), meta.Endian.Little)!;
            return BigInt(if mag.isZero() { i8(0) } else { i8(1) }, move(mag));
        }
        for i in usize(0)..data.len() { data[i] = u8(255 - u32(data[i]))!; }
        var carry: u16 = 1;
        for i in usize(0)..data.len() {
            if carry == 0 { break; }
            var total = u16(data[i]) + carry;
            data[i] = u8(total & 0xffu16)!;
            carry = total >> 8;
        }
        var mag = BigUint.fromBytes(little.asConstSlice(), meta.Endian.Little)!;
        BigInt(if mag.isZero() { i8(0) } else { i8(-1) }, move(mag))
    }

    static func parse(value: str, radix: u8) !Self {
        var bytes = value.asBytes();
        if bytes.len() == 0 { return NumError.InvalidSyntax; }
        var negative = false;
        var start: usize = 0;
        if bytes[0] == 45 {
            negative = true;
            start = 1;
        } else if bytes[0] == 43 {
            start = 1;
        }
        if start == bytes.len() { return NumError.InvalidSyntax; }
        var mag = BigUint.parseBytes(bytes[start..bytes.len()], radix)!;
        BigInt(if mag.isZero() { i8(0) } else if negative { i8(-1) } else { i8(1) }, move(mag))
    }

    const func isZero() bool { sign == 0 }
    const func isNegative() bool { sign < 0 }
    const func compare(other: *const Self) cmp.Ordering {
        if sign < other.sign { return cmp.Ordering.Less; }
        if sign > other.sign { return cmp.Ordering.Greater; }
        if sign == 0 { return cmp.Ordering.Equal; }
        var order = magnitude.compare(&other.magnitude);
        if sign < 0 {
            if order == cmp.Ordering.Less { return cmp.Ordering.Greater; }
            if order == cmp.Ordering.Greater { return cmp.Ordering.Less; }
        }
        order
    }

    const func clone() !Self {
        BigInt(sign, magnitude.clone()!)
    }

    func add(other: *const Self) !Self {
        if sign == 0 { return other.clone(); }
        if other.sign == 0 { return clone(); }
        if sign == other.sign {
            BigInt(sign, magnitude.add(&other.magnitude)!)
        } else {
            var order = magnitude.compare(&other.magnitude);
            if order == cmp.Ordering.Equal { return BigInt(); }
            if order == cmp.Ordering.Greater {
                BigInt(sign, magnitude.sub(&other.magnitude)!)
            } else {
                BigInt(other.sign, other.magnitude.sub(&magnitude)!)
            }
        }
    }

    func sub(other: *const Self) !Self {
        var negative = other.negated()!;
        add(&negative)
    }

    func mul(other: *const Self) !Self {
        if sign == 0 || other.sign == 0 { return BigInt(); }
        BigInt(if sign == other.sign { i8(1) } else { i8(-1) }, magnitude.mul(&other.magnitude)!)
    }

    func divMod(other: *const Self) !(Self, Self) {
        if other.sign == 0 { return NumError.DivisionByZero; }
        var quotient, remainder = magnitude.divMod(&other.magnitude)!;
        var quotientSign = if quotient.isZero() { i8(0) } else { i8(sign * other.sign) };
        var remainderSign = if remainder.isZero() { i8(0) } else { sign };
        (BigInt(quotientSign, move(quotient)), BigInt(remainderSign, move(remainder)))
    }

    func div(other: *const Self) !Self {
        var quotient, remainder = divMod(other)!;
        move(quotient)
    }

    func rem(other: *const Self) !Self {
        var quotient, remainder = divMod(other)!;
        move(remainder)
    }

    const func abs() !Self {
        BigInt(if sign == 0 { i8(0) } else { i8(1) }, magnitude.clone()!)
    }

    func negate() void { sign = -sign; }

    const func negated() !Self {
        BigInt(-sign, magnitude.clone()!)
    }

    func toText(radix: u8) !string {
        var digits = magnitude.toText(radix)!;
        if sign >= 0 { return digits; }
        var out = coll.Vec<u8>.withCapacity(digits.byteLen() + 1)!;
        out.push(45)!;
        for byte in digits.asBytes() { out.push(byte)!; }
        text.fromBytes(out.asConstSlice())
    }

    func toTwosComplementBytes(endian: meta.Endian) !coll.Vec<u8> {
        var out = magnitude.toBytes(meta.Endian.Little)!;
        if sign >= 0 {
            if (out.asConstSlice()[out.len() - 1] & 0x80) != 0 { out.push(0)!; }
        } else {
            var data = out.asSlice();
            for i in usize(0)..data.len() { data[i] = u8(255 - u32(data[i]))!; }
            var carry: u16 = 1;
            for i in usize(0)..data.len() {
                if carry == 0 { break; }
                var total = u16(data[i]) + carry;
                data[i] = u8(total & 0xffu16)!;
                carry = total >> 8;
            }
            if (data[data.len() - 1] & 0x80) == 0 { out.push(0xff)!; }
        }
        if endian == meta.Endian.Big { out.reverse(); }
        move(out)
    }
}
