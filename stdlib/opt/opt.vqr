package opt
import (core, coll, iter as iterator, meta)

pub func flatten<T: Movable>(value: core.NestedOptional<T>) ?T {
    switch move(value) {
        null => null,
        some(inner) => move(inner),
    }
}

// The class selects the payload mode. The explicit Owned methods also
// consume an owning non-Copyable callable; neither path borrows a callback
// across the branch or invokes it for an absent optional.
pub class Transform<T: Movable> {
    comptime if meta.isCopyable<T>() {
        pub static func map<U: Movable, F: Copyable + Movable>(
                value: ?T, transform: F) ?U {
            switch move(value) {
                null => null,
                some(item) => some(transform(move(item))),
            }
        }

        pub static func mapOwned<U: Movable, F: Movable>(
                value: ?T, transform: move F) ?U {
            switch move(value) {
                null => null,
                some(item) => some(move(transform)(move(item))),
            }
        }

        pub static func andThen<U: Movable, F: Copyable + Movable>(
                value: ?T, transform: F) ?U {
            switch move(value) {
                null => null,
                some(item) => transform(move(item)),
            }
        }

        pub static func andThenOwned<U: Movable, F: Movable>(
                value: ?T, transform: move F) ?U {
            switch move(value) {
                null => null,
                some(item) => move(transform)(move(item)),
            }
        }
    } else {
        pub static func map<U: Movable, F: Copyable + Movable>(
                value: move ?T, transform: F) ?U {
            switch move(value) {
                null => null,
                some(item) => some(transform(move(item))),
            }
        }

        pub static func mapOwned<U: Movable, F: Movable>(
                value: move ?T, transform: move F) ?U {
            switch move(value) {
                null => null,
                some(item) => some(move(transform)(move(item))),
            }
        }

        pub static func andThen<U: Movable, F: Copyable + Movable>(
                value: move ?T, transform: F) ?U {
            switch move(value) {
                null => null,
                some(item) => transform(move(item)),
            }
        }

        pub static func andThenOwned<U: Movable, F: Movable>(
                value: move ?T, transform: move F) ?U {
            switch move(value) {
                null => null,
                some(item) => move(transform)(move(item)),
            }
        }
    }
}

pub func map<T: Copyable + Movable, U: Movable, F: Copyable + Movable>(value: ?T, transform: F) ?U {
    switch move(value) {
        null => null,
        some(item) => some(transform(move(item))),
    }
}

pub func andThen<T: Copyable + Movable, U: Movable, F: Copyable + Movable>(value: ?T, transform: F) ?U {
    switch move(value) {
        null => null,
        some(item) => transform(move(item)),
    }
}

pub func isSome<T>(value: *const ?T) bool { core.isSome(value) }
pub func isNone<T>(value: *const ?T) bool { core.isNone(value) }
pub func asPtr<T>(value: *const ?T) ?*const T { __vqr_optional_pointer(value) }
pub func asMutPtr<T>(value: *?T) ?*T { __vqr_optional_pointer(value) }

pub func asRef<T>(value: in ?T) ?ref T {
    switch value {
        null => { return null; },
        some(ref item) => { return item; },
    }
}

pub func asMutRef<T>(value: mut ?T) ?ref mut T {
    switch value {
        null => { return null; },
        some(ref mut item) => { return item; },
    }
}

pub func filter<T: Movable, F: Movable>(value: ?T, pred: F) ?T {
    switch move(value) {
        null => null,
        some(item) => if pred(raw item) { some(move(item)) } else { null },
    }
}

pub func inspect<T: Movable, F: Movable>(value: ?T, observer: F) ?T {
    switch move(value) {
        null => null,
        some(item) => {
            observer(raw item);
            some(move(item))
        },
    }
}

pub func zip<A: Movable, B: Movable>(a: ?A, b: ?B) ?(A, B) {
    switch move(a) {
        null => null,
        some(x) => switch move(b) {
            null => null,
            some(y) => some((move(x), move(y))),
        },
    }
}

pub func zipWith<A: Movable, B: Movable, U: Movable, F: Movable>(a: ?A, b: ?B, combine: F) ?U {
    switch move(a) {
        null => null,
        some(x) => switch move(b) {
            null => null,
            some(y) => some(combine(move(x), move(y))),
        },
    }
}

pub func unzip<A: Movable, B: Movable>(value: ?(A, B)) (?A, ?B) {
    switch move(value) {
        null => (null, null),
        some((a, b)) => (some(move(a)), some(move(b))),
    }
}

pub func xor<T: Movable>(a: ?T, b: ?T) ?T {
    if isSome(raw a) == isSome(raw b) { return null; }
    if isSome(raw a) { move(a) } else { move(b) }
}

pub func unwrapOr<T: Movable>(value: ?T, fallback: T) T { move(value) ?? move(fallback) }
pub func unwrapOrElse<T: Movable, F: Movable>(value: ?T, fallback: F) T { move(value) ?? fallback() }
pub func expect<T: Movable>(value: ?T, message: str) T { move(value) ?? panic(message) }

pub func okOr<T: Movable>(value: ?T, reason: ErrorId) !T {
    ok(move(value) ?? { return reason; })
}

pub func okOrElse<T: Movable, F: Movable>(value: ?T, reason: F) !T {
    ok(move(value) ?? {
        var failure: ErrorId = reason();
        return failure;
    })
}

pub func contains<T>(value: *const ?T, needle: *const T) bool {
    switch asPtr(value) { null => false, some(ptr) => *ptr == *needle }
}

pub func take<T: Movable>(slot: mut ?T) ?T { core.Exchange<?T>.replace(slot, null) }

// slot must address a live, aligned and initialized optional with exclusive
// read/write access for this call. Used at lock/join boundaries.
pub unsafe func takeRaw<T: Movable>(slot: *?T) ?T {
    unsafe {
        var previous = __vqr_slot_take<?T>(slot);
        __vqr_slot_write<?T>(slot, null);
        move(previous)
    }
}

pub class Storage<T: Movable> {
    comptime if meta.isCopyable<T>() {
        pub static func replace(slot: mut ?T, value: T) ?T {
            core.Exchange<?T>.replace(slot, some(move(value)))
        }
    } else {
        pub static func replace(slot: mut ?T, value: move T) ?T {
            core.Exchange<?T>.replace(slot, some(move(value)))
        }
    }
}

pub func insert<T: Movable>(slot: *?T, value: T) *T {
    *slot = some(move(value));
    asMutPtr(slot).unwrap()
}

pub func getOrInsert<T: Movable>(slot: *?T, value: T) *T {
    asMutPtr(slot) ?? insert(slot, move(value))
}

pub func getOrInsertWith<T: Movable, F: Movable>(slot: *?T, factory: F) *T {
    asMutPtr(slot) ?? insert(slot, factory())
}

// Lift an optional into an owning collection. For non-Copyable payloads,
// the source optional must be a temporary or an explicitly moved owner.
pub class Collection<T: Movable> {
    static func collect(source: mut iterator.OnceOptional<T>) !coll.Vec<T> {
        var out = coll.Vec<T>();
        switch source.next() {
            null => {},
            some(item) => { out.push(move(item))!; },
        }
        move(out)
    }

    comptime if meta.isCopyable<T>() {
        pub static func toVec(value: ?T) !coll.Vec<T> {
            var source = iterator.OnceOptional<T>(move(value));
            Self.collect(source)
        }
        pub static func intoIter(value: ?T) iterator.OnceOptional<T> {
            iterator.OnceOptional<T>(move(value))
        }
    } else {
        pub static func toVec(value: move ?T) !coll.Vec<T> {
            var source = iterator.OnceOptional<T>(move(value));
            Self.collect(source)
        }
        pub static func intoIter(value: move ?T) iterator.OnceOptional<T> {
            iterator.OnceOptional<T>(move(value))
        }
    }
}

pub func transpose<T: Movable>(value: core.OptionalResult<T>) core.ResultOptional<T> {
    switch move(value) {
        null => null,
        some(inner) => some(move(inner)!),
    }
}
