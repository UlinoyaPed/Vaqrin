package parse
import (bytes, convert, core, text)

func isWhitespace(ch: char) bool {
    var code = convert.fromChar(ch);
    (9 <= code && code <= 13) || code == 32 || code == 0x85 || code == 0xa0 ||
    code == 0x1680 || (0x2000 <= code && code <= 0x200a) || code == 0x2028 ||
    code == 0x2029 || code == 0x202f || code == 0x205f || code == 0x3000
}

pub class Cursor {
    var source: str;
    var position: usize;
public:
    func init(value: str) : source(value), position(0) {}

    const func remaining() str {
        unsafe { __vqr_text_borrow_utf8(source.asBytes()[position..source.byteLen()]) }
    }
    const func offset() usize { position }
    const func mark() usize { position }
    const func isEnd() bool { position == source.byteLen() }

    const func peek() ?char {
        var scalars = text.chars(remaining());
        scalars.next()
    }

    func next() ?char {
        var value = peek();
        if core.isSome(&value) { advanceScalar(); }
        value
    }

    func skipWhitespace() void {
        for !isEnd() && isWhitespace(peek().unwrap()) { advanceScalar(); }
    }

    func consumeChar(ch: char) bool {
        if isEnd() || peek().unwrap() != ch { return false; }
        advanceScalar();
        true
    }

    func consumeString(value: str) bool {
        if !bytes.startsWith(source.asBytes()[position..source.byteLen()], value.asBytes()) { return false; }
        position += value.byteLen();
        true
    }

    func takeWhile<F>(pred: F) str {
        var start = position;
        for !isEnd() && pred(peek().unwrap()) { advanceScalar(); }
        unsafe { __vqr_text_borrow_utf8(source.asBytes()[start..position]) }
    }

    func reset(mark: usize) void {
        var data = source.asBytes();
        if mark > data.len() || (mark < data.len() && (data[mark] & 0xc0) == 0x80) {
            panic("parse.Cursor mark is not a UTF-8 scalar boundary");
        }
        position = mark;
    }
private:
    func advanceScalar() void {
        var head = source.asBytes()[position];
        position += if head < 0x80 { 1 } else if head < 0xe0 { 2 }
                    else if head < 0xf0 { 3 } else { 4 };
    }
}

pub class Fields {
    var cursor: Cursor;
public:
    func init(value: str) : cursor(Cursor(value)) {}
    func next() ?str {
        cursor.skipWhitespace();
        if cursor.isEnd() { return null; }
        var isField = (ch: char) bool => !isWhitespace(ch);
        some(cursor.takeWhile(isField))
    }
}

pub func splitFields(value: str) Fields { Fields(value) }
