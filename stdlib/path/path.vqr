package path
import (coll, text)

pub error PathError { Empty, InvalidComponent, Capacity }

pub enum Component { Root, Current, Parent, Normal(str) }

pub class PathComponents {
    var value: string;
    var position: usize;
    var rootPending: bool;
    pub func init(source: string) : value(move(source)), position(0), rootPending(false) {
        rootPending = value.byteLen() != 0 && value.asBytes()[0] == 47u8;
        if rootPending { position = 1; }
    }
    pub func next() ?Component {
        if rootPending { rootPending = false; return some(Component.Root); }
        var bytes = value.asBytes();
        for position < bytes.len() && bytes[position] == 47u8 { position++; }
        if position == bytes.len() { return null; }
        var start = position;
        for position < bytes.len() && bytes[position] != 47u8 { position++; }
        var part = unsafe { __vqr_text_borrow_utf8(bytes[start..position]) };
        if part == "." { return some(Component.Current); }
        if part == ".." { return some(Component.Parent); }
        some(Component.Normal(part))
    }
}

pub class Path {
    var value: string;
    pub func init(source: string) : value(move(source)) {}
    pub static func fromString(source: str) !Self { Path(text.fromBytes(source.asBytes())!) }
    pub const func asString() str { value }
    pub const func isAbsolute() bool {
        var bytes = value.asBytes();
        bytes.len() != 0 && bytes[0] == 47u8
    }
    pub const func isRelative() bool { !isAbsolute() }

    pub const func filename() ?str {
        var bytes = value.asBytes();
        var end = bytes.len();
        for end > 0 && bytes[end - 1] == 47u8 { end--; }
        if end == 0 { return null; }
        var start = end;
        for start > 0 && bytes[start - 1] != 47u8 { start--; }
        some(unsafe { __vqr_text_borrow_utf8(bytes[start..end]) })
    }

    pub const func parent() !?Path {
        var bytes = value.asBytes();
        var end = bytes.len();
        for end > 0 && bytes[end - 1] == 47u8 { end--; }
        if end == 0 { return null; }
        var start = end;
        for start > 0 && bytes[start - 1] != 47u8 { start--; }
        if start == 0 { return some(Path(".")); }
        var parentEnd = start - 1;
        for parentEnd > 0 && bytes[parentEnd - 1] == 47u8 { parentEnd--; }
        if parentEnd == 0 { return some(Path("/")); }
        some(Path(text.fromBytes(bytes[0..parentEnd])!))
    }

    pub const func extension() ?str {
        var name = filename() ?? { return null; };
        var bytes = name.asBytes();
        var index = bytes.len();
        for index > 0 && bytes[index - 1] != 46u8 { index--; }
        if index <= 1 || name == ".." { return null; }
        some(unsafe { __vqr_text_borrow_utf8(bytes[index..bytes.len()]) })
    }

    pub const func stem() ?str {
        var name = filename() ?? { return null; };
        var bytes = name.asBytes();
        var index = bytes.len();
        for index > 0 && bytes[index - 1] != 46u8 { index--; }
        if index <= 1 || name == ".." { return some(name); }
        some(unsafe { __vqr_text_borrow_utf8(bytes[0..index - 1]) })
    }

    pub const func components() PathComponents { PathComponents(value) }

    pub const func normalize() !Path {
        var bytes = value.asBytes();
        var absolute = isAbsolute();
        var segments = coll.Vec<string>();
        var position: usize = 0;
        for position < bytes.len() {
            for position < bytes.len() && bytes[position] == 47u8 { position++; }
            if position == bytes.len() { break; }
            var start = position;
            for position < bytes.len() && bytes[position] != 47u8 { position++; }
            var part = unsafe { __vqr_text_borrow_utf8(bytes[start..position]) };
            if part == "." || part.byteLen() == 0 { continue; }
            if part == ".." {
                if segments.len() != 0 && segments[segments.len() - 1] != ".." {
                    var removed = segments.pop();
                } else if !absolute {
                    segments.push(text.fromBytes(part.asBytes())!)!;
                }
            } else { segments.push(text.fromBytes(part.asBytes())!)!; }
        }
        var output = text.StringBuilder();
        if absolute { output.append("/")!; }
        for index in usize(0)..segments.len() {
            if index != 0 { output.append("/")!; }
            output.append(segments[index])!;
        }
        if !absolute && segments.len() == 0 { output.append(".")!; }
        Path(output.build()!)
    }

    pub const func withExtension(extension: str) !Path {
        var original = filename() ?? { return PathError.Empty; };
        var name = stem() ?? { return PathError.Empty; };
        for byte in extension.asBytes() {
            if byte == 0 || byte == 47 { return PathError.InvalidComponent; }
        }
        var bytes = value.asBytes();
        var end = bytes.len();
        for end > 0 && bytes[end - 1] == 47u8 { end--; }
        var prefix = end - original.byteLen();
        var output = text.StringBuilder();
        if prefix != 0 {
            output.append(unsafe { __vqr_text_borrow_utf8(bytes[0..prefix]) })!;
        }
        output.append(name)!;
        if extension.byteLen() != 0 { output.append(".")!; output.append(extension)!; }
        Path(output.build()!)
    }
}

pub type PathBuf = Path;
pub func fromString(value: str) !Path { Path.fromString(value) }
pub func join(base: Path, child: Path) !Path {
    if child.isAbsolute() { return move(child); }
    if child.asString().byteLen() == 0 { return move(base); }
    if base.asString().byteLen() == 0 { return move(child); }
    var output = text.StringBuilder();
    output.append(base.asString())!;
    if base.asString().asBytes()[base.asString().byteLen() - 1] != 47u8 { output.append("/")!; }
    output.append(child.asString())!;
    Path(output.build()!)
}
pub func normalize(value: Path) !Path { value.normalize() }
pub func filename(value: *const Path) ?str { value.filename() }
pub func parent(value: *const Path) !?Path { value.parent() }
pub func extension(value: *const Path) ?str { value.extension() }
pub func stem(value: *const Path) ?str { value.stem() }
pub func isAbsolute(value: Path) bool { value.isAbsolute() }
pub func isRelative(value: Path) bool { value.isRelative() }
pub func components(value: Path) PathComponents { value.components() }
pub func withExtension(value: Path, extension: str) !Path { value.withExtension(extension) }
