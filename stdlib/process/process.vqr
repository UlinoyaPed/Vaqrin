package process
import (core, coll, env, fs, io, path, reactor, task, text, time)

pub error ProcessError { InvalidProgram, InvalidArgument, InvalidDirectory, OutputLimit }

extern "C" func __vqr_process_spawn(args: *const u8, count: usize, cwd: *const u8,
    modes: *const i32, overrides: *const u8, overrideCount: usize, inheritEnv: i32, status: *i32) usize;
extern "C" func __vqr_process_child_free(handle: usize) void;
extern "C" func __vqr_process_child_id(handle: usize) u64;
extern "C" func __vqr_process_child_has_pipe(handle: usize, stream: i32) i32;
extern "C" func __vqr_process_child_nonblocking(handle: usize, stream: i32, status: *i32) i32;
extern "C" func __vqr_process_child_close(handle: usize, stream: i32) void;
extern "C" func __vqr_process_child_read(handle: usize, stream: i32, dst: *u8, length: usize, status: *i32) isize;
extern "C" func __vqr_process_child_write(handle: usize, src: *const u8, length: usize, status: *i32) isize;
extern "C" func __vqr_process_child_wait(handle: usize, mode: i32, ready: *i32, code: *i32, signal: *i32) i32;
extern "C" func __vqr_process_child_signal(handle: usize, force: i32) i32;
extern "C" func __vqr_process_child_output(handle: usize, limit: usize, status: *i32) usize;
extern "C" func __vqr_process_output_status(handle: usize, code: *i32, signal: *i32) void;
extern "C" func __vqr_process_output_bytes(handle: usize, stream: i32, length: *usize) usize;
extern "C" func __vqr_process_output_free(handle: usize) void;
extern "C" func __vqr_process_pid() u64;
extern "C" func __vqr_process_parent_pid() u64;

pub class ExitStatus {
    var exitCode: i32;
    var signalNumber: i32;
    pub func init(code: i32, signal: i32) : exitCode(code), signalNumber(signal) {}
    pub const func success() bool { exitCode == 0 }
    pub const func code() ?i32 { if exitCode < 0 { null } else { some(exitCode) } }
    pub const func signal() ?i32 { if signalNumber == 0 { null } else { some(signalNumber) } }
}

pub class Output {
    #copy: disabled
    var termination: ExitStatus;
    var outBytes: coll.Vec<u8>;
    var errBytes: coll.Vec<u8>;
    pub func init(status: ExitStatus, out: coll.Vec<u8>, err: coll.Vec<u8>)
        : termination(status), outBytes(move(out)), errBytes(move(err)) {}
    pub const func status() ExitStatus { termination }
    pub const func stdout() []const u8 { outBytes.asConstSlice() }
    pub const func stderr() []const u8 { errBytes.asConstSlice() }
    pub const func stdoutText() !string { text.fromBytes(stdout()) }
    pub const func stderrText() !string { text.fromBytes(stderr()) }
}

class NativeOutput {
    #copy: disabled
    var handle: usize;
    pub func init(handle: usize) : handle(handle) {}
    pub const func toOutput() !Output {
        var code: i32 = 0;
        var signal: i32 = 0;
        unsafe { __vqr_process_output_status(handle, raw code, raw signal); }
        var out = copyStream(0)!;
        var err = copyStream(1)!;
        Output(ExitStatus(code, signal), move(out), move(err))
    }
    pub func deinit() void { unsafe { __vqr_process_output_free(handle); } }
    const func copyStream(stream: i32) !coll.Vec<u8> {
        var length: usize = 0;
        var address = unsafe { __vqr_process_output_bytes(handle, stream, raw length) };
        if length == 0 { return coll.Vec<u8>(); }
        var data = unsafe { ptrFromInt<*u8>(address) };
        var view = unsafe { __vqr_const_slice<u8>(some(data), length) };
        coll.Vec<u8>.fromSlice(view)
    }
}

pub enum Stdio { Inherit, Null, Piped, File(fs.File) }

const inheritStream: i32 = -1;
const nullStream: i32 = -2;
const pipedStream: i32 = -3;

func mode(config: *const ?Stdio, fallback: i32) !i32 {
    switch *config {
        null => fallback,
        some(ref value) => switch value {
            Stdio.Inherit => inheritStream,
            Stdio.Null => nullStream,
            Stdio.Piped => pipedStream,
            Stdio.File(ref file) => file.systemDescriptor()!,
        },
    }
}

func hasPipe(handle: usize, stream: i32) bool {
    unsafe { __vqr_process_child_has_pipe(handle, stream) != 0 }
}

func nonblockingPipe(handle: usize, stream: i32) !i32 {
    if !hasPipe(handle, stream) { return io.IoError.Closed; }
    var reason: i32 = 0;
    var descriptor = unsafe { __vqr_process_child_nonblocking(handle, stream, raw reason) };
    if reason != 0 { return io.systemError(reason); }
    descriptor
}

func checkPipeDeadline(deadline: ?time.Deadline) !void {
    if task.isCancelled() { return io.IoError.Cancelled; }
    if deadline != null && deadline.unwrap().expired()! { return io.IoError.DeadlineExceeded; }
}

class ChildHandle {
    pub var address: usize;

    pub func init(address: usize)
        : address(address) {}
}

pub class ChildInput {
    #copy: disabled
    #implements: io.Writer, io.Closer
    var handle: usize;
    pub func init(token: ChildHandle) : handle(token.address) {}
    // The owned pipe stays nonblocking after its first asynchronous operation.
    pub func writeAsync(source: []const u8, deadline: ?time.Deadline) !usize {
        if !hasPipe(handle, 0) { return io.IoError.Closed; }
        if source.len() == 0 { return 0; }
        checkPipeDeadline(deadline)!;
        var fd = nonblockingPipe(handle, 0)!;
        for {
            checkPipeDeadline(deadline)!;
            var count = write(source) catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.write(), deadline)!;
                continue;
            };
            return count;
        }
    }
    pub func write(source: []const u8) !usize {
        if !hasPipe(handle, 0) { return io.IoError.Closed; }
        if source.len() == 0 { return 0; }
        var reason: i32 = 0;
        var count = unsafe { __vqr_process_child_write(handle, raw source[0], source.len(), raw reason) };
        if reason != 0 { return io.systemError(reason); }
        usize(count)
    }
    pub func flush() !void {
        if !hasPipe(handle, 0) { return io.IoError.Closed; }
    }
    pub func close() !void { unsafe { __vqr_process_child_close(handle, 0); } }
}

pub class ChildOutput {
    #copy: disabled
    #implements: io.Reader, io.Closer
    var handle: usize;
    var stream: i32;
    pub func init(token: ChildHandle, stream: i32) : handle(token.address), stream(stream) {}
    // The owned pipe stays nonblocking after its first asynchronous operation.
    pub func readAsync(destination: []u8, deadline: ?time.Deadline) !usize {
        if !hasPipe(handle, stream) { return io.IoError.Closed; }
        if destination.len() == 0 { return 0; }
        checkPipeDeadline(deadline)!;
        var fd = nonblockingPipe(handle, stream)!;
        for {
            checkPipeDeadline(deadline)!;
            var count = read(destination) catch (reason) {
                if !io.isWouldBlock(reason) { return reason; }
                task.waitDescriptor(fd, reactor.Interest.read(), deadline)!;
                continue;
            };
            return count;
        }
    }
    pub func read(destination: []u8) !usize {
        if !hasPipe(handle, stream) { return io.IoError.Closed; }
        if destination.len() == 0 { return 0; }
        var reason: i32 = 0;
        var count = unsafe { __vqr_process_child_read(handle, stream, raw destination[0], destination.len(), raw reason) };
        if reason != 0 { return io.systemError(reason); }
        usize(count)
    }
    pub func close() !void { unsafe { __vqr_process_child_close(handle, stream); } }
}

func waitState(handle: usize, mode: i32) core.ResultOptional<ExitStatus> {
    var ready: i32 = 0;
    var code: i32 = 0;
    var signal: i32 = 0;
    var reason = unsafe { __vqr_process_child_wait(handle, mode, raw ready, raw code, raw signal) };
    if reason != 0 { return io.systemError(reason); }
    if ready == 0 { return null; }
    some(ExitStatus(code, signal))
}

pub class Child {
    #copy: disabled
    var handle: usize;
    var inputPipe: ChildInput;
    var outputPipe: ChildOutput;
    var errorPipe: ChildOutput;
    pub func init(token: ChildHandle)
        : handle(token.address), inputPipe(ChildInput(token)), outputPipe(ChildOutput(token, 1)),
          errorPipe(ChildOutput(token, 2)) {}
    pub const func id() u64 { unsafe { __vqr_process_child_id(handle) } }
    pub func stdin() ?ref mut ChildInput from self {
        if !hasPipe(handle, 0) { return null; }
        var pipe: ref mut ChildInput = raw inputPipe;
        some(pipe)
    }
    pub func stdout() ?ref mut ChildOutput from self {
        if !hasPipe(handle, 1) { return null; }
        var pipe: ref mut ChildOutput = raw outputPipe;
        some(pipe)
    }
    pub func stderr() ?ref mut ChildOutput from self {
        if !hasPipe(handle, 2) { return null; }
        var pipe: ref mut ChildOutput = raw errorPipe;
        some(pipe)
    }
    pub func tryWait() core.ResultOptional<ExitStatus> { waitState(handle, 1) }
    pub func wait() !ExitStatus { waitState(handle, 0)!.unwrap() }
    pub func waitWithOutput(limit: usize) !Output {
        var reason: i32 = 0;
        var captured = unsafe { __vqr_process_child_output(handle, limit, raw reason) };
        if reason == -1 { return ProcessError.OutputLimit; }
        if reason != 0 { return io.systemError(reason); }
        var result = NativeOutput(captured);
        result.toOutput()
    }
    pub func terminate() !void { sendSignal(0) }
    pub func kill() !void { sendSignal(1) }
    pub func closeHandles() void {
        unsafe {
            __vqr_process_child_close(handle, 0);
            __vqr_process_child_close(handle, 1);
            __vqr_process_child_close(handle, 2);
        }
    }
    pub func deinit() void { unsafe { __vqr_process_child_free(handle); } }
    func sendSignal(force: i32) !void {
        var reason = unsafe { __vqr_process_child_signal(handle, force) };
        if reason != 0 { return io.systemError(reason); }
    }
}

func containsNul(value: str) bool {
    for byte in value.asBytes() {
        if byte == 0 { return true; }
    }
    false
}

func appendCString(output: *coll.Vec<u8>, value: str) !void {
    for byte in value.asBytes() { output.push(byte)!; }
    output.push(0)!
}

func validateEnvironmentKey(key: str) !void {
    if key.byteLen() == 0 { return env.EnvError.InvalidKey; }
    for byte in key.asBytes() {
        if byte == 0 || byte == 61 { return env.EnvError.InvalidKey; }
    }
}

pub class Command {
    #copy: disabled
    var program: path.Path;
    var arguments: coll.Vec<string>;
    var directory: path.Path;
    var inputMode: ?Stdio;
    var outputMode: ?Stdio;
    var errorMode: ?Stdio;
    var environment: coll.Vec<string>;
    var inheritEnvironment: bool;
    func init(program: path.Path)
        : program(move(program)), arguments(coll.Vec<string>()), directory(path.Path("")),
          inputMode(null), outputMode(null), errorMode(null),
          environment(coll.Vec<string>()), inheritEnvironment(true) {}
    pub static func new(program: path.Path) Self { Command(move(program)) }
    pub func arg(value: str) !void {
        if containsNul(value) { return ProcessError.InvalidArgument; }
        arguments.push(text.fromBytes(value.asBytes())!)!
    }
    pub func args(values: []const str) !void {
        var pending = coll.Vec<string>.withCapacity(values.len())!;
        for value in values {
            if containsNul(value) { return ProcessError.InvalidArgument; }
            pending.push(text.fromBytes(value.asBytes())!)!;
        }
        arguments.reserveAdditional(pending.len())!;
        for value in coll.Vec<string>.intoIter(move(pending)) {
            arguments.push(move(value))!;
        }
    }
    pub func cwd(value: path.Path) !void {
        if value.asString().byteLen() == 0 || containsNul(value.asString()) {
            return ProcessError.InvalidDirectory;
        }
        directory = move(value);
    }
    pub func stdin(value: Stdio) void { inputMode = some(move(value)); }
    pub func stdout(value: Stdio) void { outputMode = some(move(value)); }
    pub func stderr(value: Stdio) void { errorMode = some(move(value)); }

    pub func env(key: str, value: str) !void {
        validateEnvironmentKey(key)!;
        if containsNul(value) { return env.EnvError.InvalidValue; }
        var entry = text.StringBuilder();
        entry.append(key)!;
        entry.append("=")!;
        entry.append(value)!;
        environment.push(entry.build()!)!
    }
    pub func envRemove(key: str) !void {
        validateEnvironmentKey(key)!;
        environment.push(text.fromBytes(key.asBytes())!)!
    }
    pub func envClear() void {
        inheritEnvironment = false;
        environment.clear();
    }

    pub const func spawn() !Child {
        Child(ChildHandle(start(inheritStream, inheritStream)!))
    }
    pub const func status() !ExitStatus {
        var handle = start(inheritStream, inheritStream)!;
        var child = Child(ChildHandle(handle));
        waitState(handle, 2)!.unwrap()
    }
    pub const func output(limit: usize) !Output {
        var child = Child(ChildHandle(start(nullStream, pipedStream)!));
        child.waitWithOutput(limit)
    }
    const func start(defaultInput: i32, defaultOutput: i32) !usize {
        var argv = argumentBlock()!;
        var cwd = directoryBlock()!;
        var overrides = coll.Vec<u8>();
        for entry in environment.iterRef() { appendCString(raw overrides, *entry)!; }
        overrides.push(0)!;
        var modes = [3]i32{mode(raw inputMode, defaultInput)!,
                           mode(raw outputMode, defaultOutput)!, mode(raw errorMode, defaultOutput)!};
        var reason: i32 = 0;
        var inherit = if inheritEnvironment { 1 } else { 0 };
        var handle = unsafe { __vqr_process_spawn(raw argv[0], arguments.len() + 1, raw cwd[0], raw modes[0],
            raw overrides[0], environment.len(), inherit, raw reason) };
        if reason != 0 { return io.systemError(reason); }
        handle
    }
    const func argumentBlock() !coll.Vec<u8> {
        var name = program.asString();
        if name.byteLen() == 0 || containsNul(name) { return ProcessError.InvalidProgram; }
        var result = coll.Vec<u8>();
        appendCString(raw result, name)!;
        for value in arguments.iterRef() { appendCString(raw result, *value)!; }
        move(result)
    }
    const func directoryBlock() !coll.Vec<u8> {
        var result = coll.Vec<u8>();
        appendCString(raw result, directory.asString())!;
        move(result)
    }
}

pub func spawn(command: Command) !Child { command.spawn() }

pub func run(program: path.Path, args: []const str) !ExitStatus {
    var command = Command.new(move(program));
    command.args(args)!;
    command.status()
}

pub func output(program: path.Path, args: []const str, limit: usize) !Output {
    var command = Command.new(move(program));
    command.args(args)!;
    command.output(limit)
}

pub func pid() u64 { unsafe { __vqr_process_pid() } }

pub func parentPid() core.ResultOptional<u64> {
    var id = unsafe { __vqr_process_parent_pid() };
    if id == 0 { null } else { some(id) }
}

pub func executable() !path.PathBuf { env.currentExe() }
