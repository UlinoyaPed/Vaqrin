package random
import (coll, math, num, text)

pub error RandomError { EmptyRange, InvalidProbability, InvalidWeights, EmptyAlphabet, SampleTooLarge }

pub interface Rng {
    func nextU64() u64;
    func fill(dst: []u8) void;
}

pub class Seed {
    pub var low: u64;
    pub var high: u64;
    func init(a: u64, b: u64) : low(a), high(b) {}
    pub static func fromU64(value: u64) Self {
        Seed(value ^ 0x9e3779b97f4a7c15u64, value + 0xd1b54a32d192ed03u64)
    }
}

pub class Pcg64 {
    var state: u64;
    var increment: u64;
    func init(seedValue: u64, stream: u64) : state(0), increment((stream << 1) | 1) {
        nextU32();
        state +%= seedValue;
        nextU32();
    }
public:
    pub static func seed(value: u64) Self { Pcg64(value, 0xda3e39cb94b95bdbu64) }
    pub static func withStream(value: u64, stream: u64) Self { Pcg64(value, stream) }
    func nextU32() u32 {
        var old = state;
        state = old *% 6364136223846793005u64 +% increment;
        var shifted = u32(((old >> 18) ^ old) >> 27);
        var rotation = u32(old >> 59);
        (shifted >> rotation) | (shifted << ((u32(0) -% rotation) & 31))
    }
    func nextU64() u64 { (u64(nextU32()) << 32) | u64(nextU32()) }
    func fill(dst: []u8) void {
        var index: usize = 0;
        for index < dst.len() {
            var value = nextU64();
            for j in usize(0)..8 {
                if index >= dst.len() { break; }
                dst[index] = u8(value & 0xffu64)!;
                value >>= 8;
                index++;
            }
        }
    }
    func jump(distance: u64) void {
        var delta = distance;
        var multiplier = 6364136223846793005u64;
        var plus = increment;
        var accumulatedMultiplier: u64 = 1;
        var accumulatedPlus: u64 = 0;
        for delta > 0 {
            if (delta & 1) != 0 {
                accumulatedMultiplier *%= multiplier;
                accumulatedPlus = accumulatedPlus *% multiplier +% plus;
            }
            plus = (multiplier +% 1) *% plus;
            multiplier *%= multiplier;
            delta >>= 1;
        }
        state = accumulatedMultiplier *% state +% accumulatedPlus;
    }
    func split(stream: u64) Self { Pcg64(state ^ stream, stream) }
}

pub class Xoshiro256 {
    var s0: u64;
    var s1: u64;
    var s2: u64;
    var s3: u64;
    func init(seed: [32]u8) : s0(0), s1(0), s2(0), s3(0) {
        for i in usize(0)..32 {
            var value = u64(seed[i]);
            var word = i / 8;
            var shift = (i % 8) * 8;
            if word == 0 { s0 |= value << shift; }
            else if word == 1 { s1 |= value << shift; }
            else if word == 2 { s2 |= value << shift; }
            else { s3 |= value << shift; }
        }
        if (s0 | s1 | s2 | s3) == 0 { s0 = 1; }
    }
public:
    pub static func fromSeed(seed: [32]u8) Self { Xoshiro256(seed) }
    func nextU64() u64 {
        var result = ((s1 *% 5) << 7 | (s1 *% 5) >> 57) *% 9;
        var temporary = s1 << 17;
        s2 ^= s0;
        s3 ^= s1;
        s1 ^= s2;
        s0 ^= s3;
        s2 ^= temporary;
        s3 = (s3 << 45) | (s3 >> 19);
        result
    }
    func fill(dst: []u8) void {
        var index: usize = 0;
        for index < dst.len() {
            var value = nextU64();
            for j in usize(0)..8 {
                if index >= dst.len() { break; }
                dst[index] = u8(value & 0xffu64)!;
                value >>= 8;
                index++;
            }
        }
    }
    func jump() void {
        const JUMP: [4]u64 = [4]u64{0x180ec6d33cfd0aba,0xd5a61266f0c9392c,0xa9582618e03fc9aa,0x39abdc4529b1661c};
        applyJump(JUMP);
    }
    func longJump() void {
        const JUMP: [4]u64 = [4]u64{0x76e15d3efefdcbbf,0xc5004e441c522fb3,0x77710069854ee241,0x39109bb02acbe635};
        applyJump(JUMP);
    }
private:
    func applyJump(polynomial: [4]u64) void {
        var a: u64 = 0; var b: u64 = 0; var c: u64 = 0; var d: u64 = 0;
        for word in polynomial {
            for bit in usize(0)..64 {
                if (word & (u64(1) << bit)) != 0 { a ^= s0; b ^= s1; c ^= s2; d ^= s3; }
                nextU64();
            }
        }
        s0 = a; s1 = b; s2 = c; s3 = d;
    }
}

pub func randomU64<R: Rng>(rng: *R) u64 { rng.nextU64() }
pub func randomU32<R: Rng>(rng: *R) u32 { u32(rng.nextU64() >> 32) }
pub func randomBool<R: Rng>(rng: *R) bool { (rng.nextU64() & 1) != 0 }
pub func fill<R: Rng>(rng: *R, dst: []u8) void { rng.fill(dst); }

pub func rangeInt<R: Rng>(rng: *R, low: u64, highExclusive: u64) !u64 {
    if low >= highExclusive { return RandomError.EmptyRange; }
    var width = highExclusive - low;
    var threshold = (u64(0) -% width) % width;
    for {
        var value = rng.nextU64();
        if value >= threshold { return low + value % width; }
    }
}

pub func rangeIntSigned<R: Rng>(rng: *R, low: i64, highExclusive: i64) !i64 {
    if low >= highExclusive { return RandomError.EmptyRange; }
    var orderedLow = u64(low) ^ 0x8000000000000000u64;
    var orderedHigh = u64(highExclusive) ^ 0x8000000000000000u64;
    var sampled = rangeInt<R>(rng, orderedLow, orderedHigh)!;
    i64(sampled ^ 0x8000000000000000u64)
}

pub func rangeFloat<R: Rng>(rng: *R, low: f64, high: f64) !f64 {
    if !math.isFinite(low) || !math.isFinite(high) || low > high { return RandomError.EmptyRange; }
    if low == high { return low; }
    var unit = f64(rng.nextU64() >> 11) * 1.1102230246251565e-16;
    var result = low * (1.0 - unit) + high * unit;
    if result >= high { result = math.nextAfter<f64>(high, low); }
    if result < low { result = low; }
    result
}

pub class Bernoulli {
    var threshold: f64;
    func init(probability: f64) : threshold(probability) {}
public:
    pub static func new(probability: f64) !Self {
        if !math.isFinite(probability) || probability < 0.0 || probability > 1.0 {
            return RandomError.InvalidProbability;
        }
        Bernoulli(probability)
    }
    func sample<R: Rng>(rng: *R) bool {
        if threshold == 0.0 { return false; }
        if threshold == 1.0 { return true; }
        rangeFloat<R>(rng, 0.0, 1.0)! < threshold
    }
}

pub func shuffle<R: Rng, T: Movable>(items: []T, rng: *R) void {
    var index = items.len();
    for index > 1 {
        index--;
        var selected = rangeInt<R>(rng, 0, u64(index + 1))! as usize;
        if selected != index {
            var value = move(items[index]);
            items[index] = move(items[selected]);
            items[selected] = move(value);
        }
    }
}

pub func choose<R: Rng, T>(items: []const T, rng: *R) ?*const T {
    if items.len() == 0 { return null; }
    var index = rangeInt<R>(rng, 0, u64(items.len()))! as usize;
    some(&items[index])
}
pub func chooseMut<R: Rng, T>(items: []T, rng: *R) ?*T {
    if items.len() == 0 { return null; }
    var index = rangeInt<R>(rng, 0, u64(items.len()))! as usize;
    some(&items[index])
}

pub func sample<R: Rng, T: Copyable & Movable>(items: []const T, count: usize, rng: *R) !coll.Vec<T> {
    if count > items.len() { return RandomError.SampleTooLarge; }
    var indices = coll.Vec<usize>.withCapacity(items.len())!;
    for i in usize(0)..items.len() { indices.push(i)!; }
    var i = usize(0);
    for i < count {
        var j = rangeInt<R>(rng, u64(i), u64(items.len()))! as usize;
        var tmp = indices[i]; indices[i] = indices[j]; indices[j] = tmp;
        i++;
    }
    var result = coll.Vec<T>.withCapacity(count)!;
    for i in usize(0)..count { result.push(items[indices[i]])!; }
    move(result)
}

pub func reservoirSample<R: Rng, T: Copyable & Movable>(items: []const T, count: usize, rng: *R) !coll.Vec<T> {
    if count > items.len() { return RandomError.SampleTooLarge; }
    var result = coll.Vec<T>.withCapacity(count)!;
    for i in usize(0)..count { result.push(items[i])!; }
    for i in count..items.len() {
        var selected = rangeInt<R>(rng, 0, u64(i + 1))! as usize;
        if selected < count { result[selected] = items[i]; }
    }
    move(result)
}

pub func randomString<R: Rng>(alphabet: str, length: usize, rng: *R) !string {
    var chars = coll.Vec<u8>.withCapacity(length)!;
    var bytes = alphabet.asBytes();
    if bytes.len() == 0 && length != 0 { return RandomError.EmptyAlphabet; }
    for i in usize(0)..length {
        var index = rangeInt<R>(rng, 0, u64(bytes.len()))! as usize;
        chars.push(bytes[index])!;
    }
    text.fromBytes(chars.asConstSlice())
}
