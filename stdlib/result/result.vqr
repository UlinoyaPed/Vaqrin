package result
import (core, coll)

pub enum ResultState { Ok, Err }

pub func isOk<T>(value: *const !T) bool { core.isOk(value) }
pub func isErr<T>(value: *const !T) bool { core.isErr(value) }

pub func map<T: Copyable + Movable, U: Movable, F: Copyable + Movable>(value: !T, transform: F) !U {
    ok(transform(move(value)!))
}

pub func andThen<T: Copyable + Movable, U: Movable, F: Copyable + Movable>(value: !T, transform: F) !U {
    transform(move(value)!)
}

pub func orElse<T: Copyable + Movable, F: Copyable + Movable>(value: !T, fallback: F) !T {
    var item = move(value) catch (errorId) { return fallback(errorId); };
    ok(move(item))
}

pub func inspect<T: Copyable + Movable, F: Copyable + Movable>(value: !T, observer: F) !T {
    var item = move(value)!;
    observer(ref item);
    ok(move(item))
}

pub func inspectErr<T: Copyable + Movable, F: Copyable + Movable>(value: !T, observer: F) !T {
    var item = move(value) catch (errorId) {
        observer(errorId);
        return errorId;
    };
    ok(move(item))
}

// Observe a copied Result through an immediate loan of the callback.
pub func inspectMut<T: Copyable + Movable, F>(value: !T, observer: mut F) !T {
    var item = move(value)!;
    observer(ref item);
    ok(move(item))
}

pub func inspectErrMut<T: Copyable + Movable, F>(value: !T, observer: mut F) !T {
    var item = move(value) catch (errorId) {
        observer(errorId);
        return errorId;
    };
    ok(move(item))
}

pub func unwrapOr<T: Copyable + Movable>(value: !T, fallback: T) T { move(value) catch move(fallback) }
pub func unwrapOrElse<T: Copyable + Movable, F: Copyable + Movable>(value: !T, fallback: F) T {
    move(value) catch (errorId) { fallback(errorId) }
}
pub func expect<T: Copyable + Movable>(value: !T, message: str) T { move(value) catch panic(message) }

pub func okValue<T>(value: *const !T) ?*const T { __vqr_result_pointer(value) }
pub func errorOf<T>(value: *const !T) ?ErrorId { __vqr_result_error(value) }

pub func transpose<T: Copyable + Movable>(value: core.ResultOptional<T>) core.OptionalResult<T> {
    var item = move(value) catch (errorId) {
        var failure: !T = errorId;
        return some(move(failure));
    };
    switch move(item) {
        null => null,
        some(payload) => some(ok(move(payload))),
    }
}

pub func collect<T: Movable, I: Copyable + Movable>(values: I) !coll.Vec<T> {
    var out = coll.Vec<T>();
    for item in move(values) { out.push(move(item)!)!; }
    move(out)
}
