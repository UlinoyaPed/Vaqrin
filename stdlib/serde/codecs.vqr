package serde
import (coll, convert, parse, text)

pub class BoolCodec {
public:
    func encode(value: *const bool, serializer: *Serializer) !void {
        serializer.writeBool(*value)
    }
    func decode(deserializer: *Deserializer) !bool {
        deserializer.readBool()
    }
}

pub class SignedIntegerCodec<T> {
public:
    func encode(value: *const T, serializer: *Serializer) !void {
        serializer.writeI64(convert.widen<i64>(*value))
    }
    func decode(deserializer: *Deserializer) !T {
        var value = deserializer.readI64()!;
        convert.narrow<T>(value)
    }
}

pub class UnsignedIntegerCodec<T> {
public:
    func encode(value: *const T, serializer: *Serializer) !void {
        serializer.writeU64(convert.widen<u64>(*value))
    }
    func decode(deserializer: *Deserializer) !T {
        var value = deserializer.readU64()!;
        convert.narrow<T>(value)
    }
}

pub class FloatCodec<T> {
public:
    func encode(value: *const T, serializer: *Serializer) !void {
        serializer.writeF64(convert.widen<f64>(*value))
    }
    func decode(deserializer: *Deserializer) !T {
        var value = deserializer.readF64()!;
        convert.narrow<T>(value)
    }
}

pub class StringCodec {
public:
    func encode(value: *const string, serializer: *Serializer) !void {
        serializer.writeString(*value)
    }
    func decode(deserializer: *Deserializer) !string {
        deserializer.readString()
    }
}

pub class CharCodec {
public:
    func encode(value: *const char, serializer: *Serializer) !void {
        var bytes = coll.Vec<u8>();
        var scalar = convert.fromChar(*value);
        if scalar < 0x80 {
            bytes.push(u8(scalar)!)!;
        } else if scalar < 0x800 {
            bytes.push(u8(0xc0 | (scalar >> 6))!)!;
            bytes.push(u8(0x80 | (scalar & 0x3f))!)!;
        } else if scalar < 0x10000 {
            bytes.push(u8(0xe0 | (scalar >> 12))!)!;
            bytes.push(u8(0x80 | ((scalar >> 6) & 0x3f))!)!;
            bytes.push(u8(0x80 | (scalar & 0x3f))!)!;
        } else {
            bytes.push(u8(0xf0 | (scalar >> 18))!)!;
            bytes.push(u8(0x80 | ((scalar >> 12) & 0x3f))!)!;
            bytes.push(u8(0x80 | ((scalar >> 6) & 0x3f))!)!;
            bytes.push(u8(0x80 | (scalar & 0x3f))!)!;
        }
        var encoded = text.fromBytes(bytes.asConstSlice())!;
        serializer.writeString(encoded)
    }

    func decode(deserializer: *Deserializer) !char {
        var value = deserializer.readString()!;
        parse.parseChar(value)
    }
}

pub class OptionalCodec<T> {
    var element: *const Codec<T>;
public:
    func init(element: *const Codec<T>) : element(element) {}

    func encode(value: *const ?T, serializer: *Serializer) !void {
        switch *value {
            null => serializer.writeNull(),
            some(item) => element.encode(&item, serializer),
        }
    }

    func decode(deserializer: *Deserializer) !?T {
        if deserializer.kind()! == DataKind.Null {
            deserializer.readNull()!;
            return null;
        }
        some(element.decode(deserializer)!)
    }
}

pub class SequenceCodec<T> {
    var element: *const Codec<T>;
public:
    func init(element: *const Codec<T>) : element(element) {}

    func encode(value: *const coll.Vec<T>, serializer: *Serializer) !void {
        serializer.beginSeq(some(value.len()))!;
        for index in usize(0)..value.len() {
            element.encode(value.get(index).unwrap(), serializer)!;
        }
        serializer.endSeq()
    }

    func decode(deserializer: *Deserializer) !coll.Vec<T> {
        var length = deserializer.beginSeq()!;
        var output = coll.Vec<T>();
        switch length {
            some(count) => output.reserve(count)!,
            null => {},
        }
        for deserializer.nextElement()! {
            var item = element.decode(deserializer)!;
            output.push(move(item))!;
        }
        deserializer.endSeq()!;
        move(output)
    }
}

pub class StringMapCodec<T> {
    var element: *const Codec<T>;
public:
    func init(element: *const Codec<T>) : element(element) {}

    func encode(value: *const coll.Vec<(string, T)>, serializer: *Serializer) !void {
        serializer.beginMap(some(value.len()))!;
        for index in usize(0)..value.len() {
            var entry = value.get(index).unwrap();
            serializer.writeKey(entry.0)!;
            element.encode(&entry.1, serializer)!;
        }
        serializer.endMap()
    }

    func decode(deserializer: *Deserializer) !coll.Vec<(string, T)> {
        var length = deserializer.beginMap()!;
        var output = coll.Vec<(string, T)>();
        switch length {
            some(count) => output.reserve(count)!,
            null => {},
        }
        for {
            var key = deserializer.nextKey()!;
            switch move(key) {
                null => break,
                some(name) => {
                    var value = element.decode(deserializer)!;
                    output.push((move(name), move(value)))!;
                },
            }
        }
        deserializer.endMap()!;
        move(output)
    }
}
