package serde
import (core, convert, fmt, parse)

comptime func valueKind<T>() u8 { __vqr_serde_value_kind<T>() }

class ValueCodec<T> {
    comptime if valueKind<T>() == 1 {
        pub static func encode(value: *const T, serializer: *Serializer) !void {
            serializer.writeBool(*value)
        }
        pub static func decode(deserializer: *Deserializer) !T { deserializer.readBool() }
    } else {
        comptime if valueKind<T>() == 2 {
            pub static func encode(value: *const T, serializer: *Serializer) !void {
                serializer.writeString(*value)
            }
            pub static func decode(deserializer: *Deserializer) !T { deserializer.readString() }
        } else {
            comptime if valueKind<T>() == 3 {
                pub static func encode(value: *const T, serializer: *Serializer) !void {
                    var wide = convert.widen<i128>(*value);
                    var raw = fmt.formatInt(wide, 10)!;
                    serializer.writeNumber(raw)
                }
                pub static func decode(deserializer: *Deserializer) !T {
                    var number = deserializer.readNumber()!;
                    parse.parseInt<T>(number, 10)
                }
            } else {
                comptime if valueKind<T>() == 4 {
                    pub static func encode(value: *const T, serializer: *Serializer) !void {
                        var wide = convert.widen<u128>(*value);
                        var raw = fmt.formatUint(wide, 10)!;
                        serializer.writeNumber(raw)
                    }
                    pub static func decode(deserializer: *Deserializer) !T {
                        var number = deserializer.readNumber()!;
                        parse.parseUint<T>(number, 10)
                    }
                } else {
                    comptime if valueKind<T>() == 5 {
                        pub static func encode(value: *const T, serializer: *Serializer) !void {
                            var codec = FloatCodec<T>{};
                            codec.encode(value, serializer)
                        }
                        pub static func decode(deserializer: *Deserializer) !T {
                            var codec = FloatCodec<T>{};
                            codec.decode(deserializer)
                        }
                    } else {
                        comptime if valueKind<T>() == 6 {
                            pub static func encode(value: *const T, serializer: *Serializer) !void {
                                var codec = CharCodec{};
                                codec.encode(value, serializer)
                            }
                            pub static func decode(deserializer: *Deserializer) !T {
                                var codec = CharCodec{};
                                codec.decode(deserializer)
                            }
                        } else {
                            pub static func encode(value: *const T, serializer: *Serializer) !void {
                                value.encodeSerde(serializer)
                            }
                            pub static func decode(deserializer: *Deserializer) !T {
                                T.decodeSerde(deserializer)
                            }
                        }
                    }
                }
            }
        }
    }
}

pub func encodeValue<T>(value: *const T, serializer: *Serializer) !void {
    ValueCodec<T>.encode(value, serializer)
}

pub func decodeValue<T>(deserializer: *Deserializer) !T {
    ValueCodec<T>.decode(deserializer)
}

pub func encodeOptional<T>(value: *const ?T, serializer: *Serializer) !void {
    switch *value {
        null => serializer.writeNull(),
        some(ref item) => encodeValue<T>(item.toRaw(), serializer),
    }
}

pub func decodeOptional<T>(deserializer: *Deserializer) core.ResultOptional<T> {
    if deserializer.kind()! == DataKind.Null {
        deserializer.readNull()!;
        return null;
    }
    some(decodeValue<T>(deserializer)!)
}

pub class DerivedCodec<T> {
    #implements: Codec<T>
    pub func encode(value: *const T, serializer: *Serializer) !void { encodeValue<T>(value, serializer) }
    pub func decode(deserializer: *Deserializer) !T { decodeValue<T>(deserializer) }
}
