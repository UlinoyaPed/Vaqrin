package simd
import (mem)

pub error LaneError { OutOfRange }

pub class Simd<T: Copyable & Movable, comptime N: usize> {
    var lanes: [N]T;
    func init(data: [N]T) : lanes(move(data)) {}
public:
    static func splat(value: T) Self {
        var array = mem.MaybeUninit<[N]T>.uninit();
        unsafe {
            var data = array.asPtr();
            for i in usize(0)..N { __vqr_slot_write<T>(&(*data)[i], value); }
            Simd<T, N>(array.assumeInit())
        }
    }

    static func fromArray(data: [N]T) Self { Simd<T, N>(move(data)) }
    const func toArray() [N]T { lanes }
    const func extract(index: usize) T { lanes[index] }

    const func replace(index: usize, value: T) Self {
        var data = lanes;
        data[index] = move(value);
        Simd<T, N>(move(data))
    }

    const func add(other: Self) Self {
        var data = lanes;
        for i in usize(0)..N { data[i] += other.lanes[i]; }
        Simd<T, N>(move(data))
    }

    const func sub(other: Self) Self {
        var data = lanes;
        for i in usize(0)..N { data[i] -= other.lanes[i]; }
        Simd<T, N>(move(data))
    }

    const func mul(other: Self) Self {
        var data = lanes;
        for i in usize(0)..N { data[i] *= other.lanes[i]; }
        Simd<T, N>(move(data))
    }

    const func div(other: Self) Self {
        var data = lanes;
        for i in usize(0)..N { data[i] /= other.lanes[i]; }
        Simd<T, N>(move(data))
    }

    const func min(other: Self) Self {
        var data = lanes;
        for i in usize(0)..N {
            if other.lanes[i] < data[i] { data[i] = other.lanes[i]; }
        }
        Simd<T, N>(move(data))
    }

    const func reduceMin() T {
        if N == 0 { panic("empty SIMD reduction"); }
        var out = lanes[0];
        for i in usize(1)..N {
            if lanes[i] < out { out = lanes[i]; }
        }
        move(out)
    }

    const func max(other: Self) Self {
        var data = lanes;
        for i in usize(0)..N {
            if other.lanes[i] > data[i] { data[i] = other.lanes[i]; }
        }
        Simd<T, N>(move(data))
    }

    const func reduceMax() T {
        if N == 0 { panic("empty SIMD reduction"); }
        var out = lanes[0];
        for i in usize(1)..N {
            if lanes[i] > out { out = lanes[i]; }
        }
        move(out)
    }

    const func compareEq(other: Self) Mask<N> {
        var out = Mask<N>.splat(false);
        for i in usize(0)..N { out.set(i, lanes[i] == other.lanes[i]); }
        out
    }

    const func compareLt(other: Self) Mask<N> {
        var out = Mask<N>.splat(false);
        for i in usize(0)..N { out.set(i, lanes[i] < other.lanes[i]); }
        out
    }

    const func reduceAdd() T {
        var total = T(0);
        for i in usize(0)..N { total += lanes[i]; }
        total
    }
}

pub class Mask<comptime N: usize> {
    var predicates: [N]bool;
    func init(values: [N]bool) : predicates(move(values)) {}
public:
    static func splat(value: bool) Self { Mask<N>(Simd<bool, N>.splat(value).toArray()) }

    func set(index: usize, value: bool) void {
        predicates[index] = value;
    }

    const func test(index: usize) bool { predicates[index] }

    const func any() bool {
        for i in usize(0)..N {
            if test(i) { return true; }
        }
        false
    }

    const func all() bool {
        for i in usize(0)..N {
            if !test(i) { return false; }
        }
        true
    }

    const func none() bool { !any() }

    const func countTrue() usize {
        var count: usize = 0;
        for i in usize(0)..N {
            if test(i) { count++; }
        }
        count
    }

    const func not() Self {
        var out = Mask<N>.splat(false);
        for i in usize(0)..N { out.set(i, !test(i)); }
        out
    }

    const func and(other: Self) Self {
        var out = Mask<N>.splat(false);
        for i in usize(0)..N { out.set(i, test(i) && other.test(i)); }
        out
    }

    const func or(other: Self) Self {
        var out = Mask<N>.splat(false);
        for i in usize(0)..N { out.set(i, test(i) || other.test(i)); }
        out
    }

    const func xor(other: Self) Self {
        var out = Mask<N>.splat(false);
        for i in usize(0)..N { out.set(i, test(i) != other.test(i)); }
        out
    }
}
