package sync
import (atomic, cell, core, time)

class NativeCondition {
    comptime if __vqr_host_is_windows() {
        pub static func wait(address: *const u32, version: u32, deadline: time.Deadline) bool {
            const maxMillis: i64 = 4294967294;
            for {
                var left = deadline.remaining() catch { return false; };
                if left.isZero() { return true; }
                var millis = left.toMillis() catch maxMillis;
                if millis < maxMillis && left.nanosPart() % 1000000 != 0 { millis += 1; }
                if millis > maxMillis { millis = maxMillis; }
                var timeout = u32(millis) catch { return false; };
                if !__vqr_sync_wait_for(address, version, timeout) { return false; }
            }
        }
    } else {
        pub static func wait(address: *const u32, version: u32, deadline: time.Deadline) bool {
            seconds, nanos := unsafe { deadline.instant().monotonicParts() };
            __vqr_sync_wait_until(address, version, seconds, i64(nanos))
        }
    }
}

pub class CondVar {
    #copy: disabled
    var sequence: u32;
    func init() : sequence(0) {}
    pub static func new() Self { CondVar() }

    pub const func wait<T>(guard: MutexGuard<T>) !MutexGuard<T> {
        var address = &sequence;
        var version = __vqr_atomic_load(address, atomic.Order.Relaxed);
        var awaitSignal = [address, version]() void => { __vqr_sync_wait(address, version); };
        unsafe { MutexGuard<T>.unlockWhile(move(guard), awaitSignal) }
    }

    pub const func waitTimeout<T>(guard: MutexGuard<T>, timeout: time.Duration) !(MutexGuard<T>, bool) {
        waitUntilDeadline<T>(move(guard), time.Deadline.after(timeout)!)
    }

    pub const func waitUntilDeadline<T>(guard: MutexGuard<T>, deadline: time.Deadline) !(MutexGuard<T>, bool) {
        if deadline.expired()! { return (move(guard), true); }
        var address = &sequence;
        var version = __vqr_atomic_load(address, atomic.Order.Relaxed);
        var timedOut = false;
        var awaitSignal = [address, version, deadline, &timedOut]() void => {
            timedOut = NativeCondition.wait(address, version, deadline);
        };
        var reacquired = unsafe { MutexGuard<T>.unlockWhile(move(guard), awaitSignal) };
        (move(reacquired), timedOut)
    }

    pub const func notifyOne() void { notify(1); }
    pub const func notifyAll() void { notify(0x7fffffff); }
    const func notify(count: u32) void {
        var address = unsafe { constCast<*u32>(&sequence) };
        var previous = __vqr_atomic_add(address, 1u32, atomic.Order.Relaxed);
        __vqr_sync_wake(address, count);
    }
}

pub func waitUntil<T, F>(condition: *const CondVar, guard: MutexGuard<T>, pred: F) !MutexGuard<T> {
    for !pred(guard.get()) { guard = condition.wait<T>(move(guard))!; }
    move(guard)
}

pub type OnceLock<T> = cell.OnceLock<T>;

pub class Once {
    #copy: disabled
    var cell: cell.OnceLock<bool>;
    func init() : cell(cell.OnceLock<bool>.new()) {}
    pub static func new() Self { Once() }

    pub func callOnce<F: Movable>(callback: F) !void {
        var initialize = [move(callback)]() !bool => {
            var outcome: !void = move(callback)();
            outcome!;
            true
        };
        var published = cell.getOrTryInit(move(initialize))!;
    }

    pub const func isDone() bool {
        var initialized = cell.get();
        core.isSome<*const bool>(&initialized)
    }
}
