package time
import (cmp)

class Timespec {
    #repr: C
    pub var seconds: i64;
    pub var nanoseconds: i64;
}

class WindowsFileTime {
    #repr: C
    pub var low: u32;
    pub var high: u32;
}

const monotonicClock: i32 = 1;
const realtimeClock: i32 = 0;
const absoluteSleep: c_int = 1;
const interrupted: c_int = 4;
const darwinClock: i32 = 1;
const windowsClock: i32 = 2;

extern "C" func clock_gettime(clock: c_int, value: *Timespec) c_int;
extern "C" func clock_nanosleep(clock: c_int, flags: c_int, value: *const Timespec, remaining: *Timespec) c_int;
extern "C" func __vqr_io_clock_now(clock: i32, seconds: *i64, nanoseconds: *i64) i32;
extern "C" func __vqr_io_clock_sleep_until(seconds: i64, nanoseconds: i32) i32;
extern "C" func GetSystemTimePreciseAsFileTime(output: *WindowsFileTime) void;
extern "C" func QueryPerformanceCounter(output: *i64) i32;
extern "C" func QueryPerformanceFrequency(output: *i64) i32;
extern "C" func Sleep(milliseconds: u32) void;

class WindowsClock {
    pub static func read(clock: i32) !Timespec {
        if clock == monotonicClock {
            var ticks: i64 = 0;
            var frequency: i64 = 0;
            if unsafe { QueryPerformanceCounter(raw ticks) } == 0 ||
               unsafe { QueryPerformanceFrequency(raw frequency) } == 0 || ticks < 0 || frequency <= 0 {
                return TimeError.ClockUnavailable;
            }
            var seconds = ticks / frequency;
            var remainder = ticks % frequency;
            const nanosPerSecond: i64 = 1000000000;
            var nanos = if remainder <= largestSecond / nanosPerSecond {
                remainder * nanosPerSecond / frequency
            } else {
                i64(i128(remainder) * i128(nanosPerSecond) / i128(frequency))!
            };
            return Timespec{seconds: seconds, nanoseconds: nanos};
        }
        const ticksPerSecond: u64 = 10000000;
        const secondsFrom1601To1970: i64 = 11644473600;
        var fileTime = WindowsFileTime{low: 0, high: 0};
        unsafe { GetSystemTimePreciseAsFileTime(raw fileTime); }
        var ticks = (u64(fileTime.high) << 32) | u64(fileTime.low);
        Timespec{seconds: i64(ticks / ticksPerSecond)! - secondsFrom1601To1970,
                 nanoseconds: i64(ticks % ticksPerSecond)! * 100}
    }

    pub static func waitUntil(seconds: i64, nanoseconds: i32) !void {
        const maxMillis: i64 = 4294967294;
        for {
            var now = WindowsClock.read(monotonicClock)!;
            if seconds < now.seconds || (seconds == now.seconds && i64(nanoseconds) <= now.nanoseconds) {
                return;
            }
            var whole = seconds - now.seconds;
            var nanos = i64(nanoseconds) - now.nanoseconds;
            if nanos < 0 {
                whole -= 1;
                nanos += 1000000000;
            }
            var millis = maxMillis;
            if whole <= maxMillis / 1000 {
                millis = whole * 1000 + (nanos + 999999) / 1000000;
                if millis > maxMillis { millis = maxMillis; }
            }
            unsafe { Sleep(u32(millis)!); }
        }
    }
}

class NativeClock {
    comptime if __vqr_clock_platform() == windowsClock {
        pub static func read(clock: i32) !Timespec { WindowsClock.read(clock) }
        pub static func waitUntil(seconds: i64, nanos: i32) !void { WindowsClock.waitUntil(seconds, nanos) }
    } else {
      comptime if __vqr_clock_platform() == darwinClock {
        pub static func read(clock: i32) !Timespec {
            var seconds: i64 = 0;
            var nanoseconds: i64 = 0;
            if unsafe { __vqr_io_clock_now(clock, raw seconds, raw nanoseconds) } != 0 {
                return TimeError.ClockUnavailable;
            }
            Timespec{seconds: seconds, nanoseconds: nanoseconds}
        }
        pub static func waitUntil(seconds: i64, nanoseconds: i32) !void {
            if unsafe { __vqr_io_clock_sleep_until(seconds, nanoseconds) } != 0 {
                return TimeError.ClockUnavailable;
            }
        }
      } else {
        pub static func read(clock: i32) !Timespec {
            var value = Timespec{seconds: 0, nanoseconds: 0};
            if unsafe { clock_gettime(clock, raw value) } != 0 { return TimeError.ClockUnavailable; }
            value
        }
        pub static func waitUntil(seconds: i64, nanoseconds: i32) !void {
            var absolute = Timespec{seconds: seconds, nanoseconds: i64(nanoseconds)};
            var leftover = Timespec{seconds: 0, nanoseconds: 0};
            for {
                var status = unsafe { clock_nanosleep(monotonicClock, absoluteSleep, raw absolute, raw leftover) };
                if status == 0 { return; }
                if status != interrupted { return TimeError.ClockUnavailable; }
            }
        }
      }
    }
}

func readClock(clock: i32) !Timespec { NativeClock.read(clock) }

pub class Instant {
    var offset: Duration;
    func init(offset: Duration) : offset(offset) {}
    pub static func now() !Self {
        var time = readClock(monotonicClock)!;
        var nanos = i32(time.nanoseconds) catch { return TimeError.ClockUnavailable; };
        Instant(Duration.fromParts(time.seconds, nanos)!)
    }

    pub const func compare(other: Self) cmp.Ordering { offset.compare(other.offset) }
    pub const func elapsed() !Duration { Instant.now()!.durationSince(Instant(offset)) }
    pub const func durationSince(earlier: Instant) !Duration { offset.sub(earlier.offset) }

    pub const func checkedAdd(value: Duration) !Self { Instant(offset.add(value)!) }
    pub const func checkedSub(value: Duration) !Self { Instant(offset.sub(value)!) }

    pub unsafe const func monotonicParts() (i64, i32) { (offset.seconds(), offset.nanosPart()) }

    pub const func waitUntil() !void {
        if offset.isNegative() || offset.isZero() { return; }
        NativeClock.waitUntil(offset.seconds(), offset.nanosPart())
    }
}

pub func monotonicNow() !Instant { Instant.now() }
pub func sleepUntil(instant: Instant) !void { instant.waitUntil() }
pub func sleep(duration: Duration) !void {
    if duration.isNegative() || duration.isZero() { return; }
    var deadline = Instant.now()!.checkedAdd(duration)!;
    sleepUntil(deadline)
}

pub interface Clock {
    const func monotonicNow() !Instant;
    const func utcNow() !UtcDateTime;
}

pub class Deadline {
    var target: Instant;
    func init(target: Instant) : target(target) {}
    pub static func at(instant: Instant) Self { Deadline(instant) }
    pub static func after(delay: Duration) !Self { Deadline(Instant.now()!.checkedAdd(delay)!) }

    pub const func instant() Instant { target }

    pub const func expired() !bool {
        var now = Instant.now()!;
        now.compare(target) != cmp.Ordering.Less
    }

    pub const func remaining() !Duration {
        var now = Instant.now()!;
        if now.compare(target) != cmp.Ordering.Less { return Duration.zero(); }
        target.durationSince(now)
    }
}

pub class Timer {
    #copy: disabled
    var target: ?Instant;
    func init(target: Instant) : target(some(target)) {}
    pub static func at(deadline: Instant) !Self { Timer(deadline) }
    pub static func after(delay: Duration) !Self { Timer(Instant.now()!.checkedAdd(delay)!) }

    pub func wait() !void {
        var deadline = target ?? { return TimeError.TimerCancelled; };
        sleepUntil(deadline)
    }
    pub func cancel() void { target = null; }
    pub func reset(delay: Duration) !void { target = some(Instant.now()!.checkedAdd(delay)!); }
}

pub class Ticker {
    #copy: disabled
    var due: ?Instant;
    var period: Duration;
    func init(due: Instant, period: Duration) : due(some(due)), period(period) {}
    pub static func every(period: Duration) !Self {
        if period.isNegative() || period.isZero() { return TimeError.InvalidTime; }
        Ticker(Instant.now()!.checkedAdd(period)!, period)
    }

    pub func next() !Instant {
        var tick = due ?? { return TimeError.TimerCancelled; };
        var following = tick.checkedAdd(period)!;
        sleepUntil(tick)!;
        due = some(following);
        tick
    }
    pub func stop() void { due = null; }
}
