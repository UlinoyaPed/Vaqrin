package time
import (cmp)

class Timespec {
    pub var seconds: i64;
    pub var nanoseconds: i32;
}

const monotonicClock: i32 = 1;
const realtimeClock: i32 = 0;

extern "C" func __vqr_io_clock_now(clock: i32, seconds: *i64, nanoseconds: *i32) i32;
extern "C" func __vqr_io_clock_sleep_until(seconds: i64, nanoseconds: i32) i32;

func readClock(clock: i32) !Timespec {
    var seconds: i64 = 0;
    var nanoseconds: i32 = 0;
    if unsafe { __vqr_io_clock_now(clock, &seconds, &nanoseconds) } != 0 {
        return TimeError.ClockUnavailable;
    }
    Timespec{seconds: seconds, nanoseconds: nanoseconds}
}

pub class Instant {
    var offset: Duration;
    func init(offset: Duration) : offset(offset) {}
public:
    static func now() !Self {
        var time = readClock(monotonicClock)!;
        Instant(Duration.fromParts(time.seconds, time.nanoseconds)!)
    }

    const func compare(other: Self) cmp.Ordering { offset.compare(other.offset) }
    const func elapsed() !Duration { Instant.now()!.durationSince(Instant(offset)) }
    const func durationSince(earlier: Instant) !Duration { offset.sub(earlier.offset) }

    const func checkedAdd(value: Duration) !Self { Instant(offset.add(value)!) }
    const func checkedSub(value: Duration) !Self { Instant(offset.sub(value)!) }

    unsafe const func monotonicParts() (i64, i32) { (offset.seconds(), offset.nanosPart()) }

    const func waitUntil() !void {
        if offset.isNegative() || offset.isZero() { return; }
        if unsafe { __vqr_io_clock_sleep_until(offset.seconds(), offset.nanosPart()) } != 0 {
            return TimeError.ClockUnavailable;
        }
    }
}

pub func monotonicNow() !Instant { Instant.now() }
pub func sleepUntil(instant: Instant) !void { instant.waitUntil() }
pub func sleep(duration: Duration) !void {
    if duration.isNegative() || duration.isZero() { return; }
    var deadline = Instant.now()!.checkedAdd(duration)!;
    sleepUntil(deadline)
}

pub interface Clock {
    const func monotonicNow() !Instant;
    const func utcNow() !UtcDateTime;
}

pub class Deadline {
    var target: Instant;
    func init(target: Instant) : target(target) {}
public:
    static func at(instant: Instant) Self { Deadline(instant) }
    static func after(delay: Duration) !Self { Deadline(Instant.now()!.checkedAdd(delay)!) }

    const func instant() Instant { target }

    const func expired() !bool {
        var now = Instant.now()!;
        now.compare(target) != cmp.Ordering.Less
    }

    const func remaining() !Duration {
        var now = Instant.now()!;
        if now.compare(target) != cmp.Ordering.Less { return Duration.zero(); }
        target.durationSince(now)
    }
}

pub class Timer {
    #copy: disabled
    var target: ?Instant;
    func init(target: Instant) : target(some(target)) {}
public:
    static func at(deadline: Instant) !Self { Timer(deadline) }
    static func after(delay: Duration) !Self { Timer(Instant.now()!.checkedAdd(delay)!) }

    func wait() !void {
        var deadline = target ?? { return TimeError.TimerCancelled; };
        sleepUntil(deadline)
    }
    func cancel() void { target = null; }
    func reset(delay: Duration) !void { target = some(Instant.now()!.checkedAdd(delay)!); }
}

pub class Ticker {
    #copy: disabled
    var due: ?Instant;
    var period: Duration;
    func init(due: Instant, period: Duration) : due(some(due)), period(period) {}
public:
    static func every(period: Duration) !Self {
        if period.isNegative() || period.isZero() { return TimeError.InvalidTime; }
        Ticker(Instant.now()!.checkedAdd(period)!, period)
    }

    func next() !Instant {
        var tick = due ?? { return TimeError.TimerCancelled; };
        var following = tick.checkedAdd(period)!;
        sleepUntil(tick)!;
        due = some(following);
        tick
    }
    func stop() void { due = null; }
}
