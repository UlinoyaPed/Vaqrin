package time
import (cmp)

pub error TimeError { Overflow, DivisionByZero, InvalidDate, InvalidTime, ClockUnavailable, TimerCancelled, InvalidZone, NonexistentLocalTime, InvalidFormat }

const nanosPerSecond: i128 = 1000000000i128;
const smallestSecond: i64 = -9223372036854775807i64 - 1;
const largestSecond: i64 = 9223372036854775807i64;
const largestDuration: i128 = i128(largestSecond) * nanosPerSecond + nanosPerSecond - 1;
const smallestDuration: i128 = i128(smallestSecond) * nanosPerSecond - nanosPerSecond + 1;

pub class Duration {
    var whole: i64;
    var fraction: i32;
    func init(seconds: i64, nanos: i32) : whole(seconds), fraction(nanos) {}
    pub static func zero() Self { Duration(0, 0) }
    pub static func fromNanos(value: i64) Self { Duration.split(value, 1000000000, 1) }
    pub static func fromMicros(value: i64) Self { Duration.split(value, 1000000, 1000) }
    pub static func fromMillis(value: i64) Self { Duration.split(value, 1000, 1000000) }
    pub static func millis(value: i64) Self { Duration.fromMillis(value) }
    pub static func fromSeconds(value: i64) Self { Duration(value, 0) }
    pub static func fromMinutes(value: i64) Self { Duration.scaleSeconds(value, 60) }
    pub static func fromHours(value: i64) Self { Duration.scaleSeconds(value, 3600) }
    pub static func fromDays(value: i64) Self { Duration.scaleSeconds(value, 86400) }

    pub static func fromParts(seconds: i64, nanos: i32) !Self {
        Duration.checked(i128(seconds) * nanosPerSecond + i128(nanos))
    }

    pub const func seconds() i64 { whole }
    pub const func nanosPart() i32 { fraction }
    pub const func isNegative() bool { whole < 0 || fraction < 0 }
    pub const func isZero() bool { whole == 0 && fraction == 0 }

    pub const func toMillis() !i64 {
        i64(total() / 1000000) catch { return TimeError.Overflow; }
    }
    pub const func toNanos() !i64 { i64(total()) catch { return TimeError.Overflow; } }

    pub const func abs() !Self {
        if isNegative() { return Duration.checked(-total()); }
        Duration(whole, fraction)
    }
    pub const func add(other: Self) !Self { Duration.checked(total() + other.total()) }
    pub const func sub(other: Self) !Self { Duration.checked(total() - other.total()) }

    pub const func mul(scale: i64) !Self {
        if scale == 0 { return Duration.zero(); }
        var value = total();
        var factor = i128(scale);
        var magnitude = if value < 0 { -value } else { value };
        var absoluteFactor = if factor < 0 { -factor } else { factor };
        var limit = if (value < 0) != (factor < 0) { -smallestDuration } else { largestDuration };
        if magnitude > limit / absoluteFactor { return TimeError.Overflow; }
        Duration.checked(value * factor)
    }

    pub const func div(scale: i64) !Self {
        if scale == 0 { return TimeError.DivisionByZero; }
        Duration.checked(total() / i128(scale))
    }

    pub const func compare(other: Self) cmp.Ordering {
        if whole != other.whole { return cmp.compare<i64>(&whole, &other.whole); }
        cmp.compare<i32>(&fraction, &other.fraction)
    }
    const func total() i128 { i128(whole) * nanosPerSecond + i128(fraction) }

    static func checked(nanos: i128) !Self {
        var seconds = i64(nanos / nanosPerSecond) catch { return TimeError.Overflow; };
        var fractional = i32(nanos % nanosPerSecond) catch { panic("invalid nanosecond remainder"); };
        Duration(seconds, fractional)
    }

    static func split(value: i64, units: i64, nanosPerUnit: i64) Self {
        var nanos = i32((value % units) * nanosPerUnit) catch { panic("invalid nanosecond remainder"); };
        Duration(value / units, nanos)
    }

    static func scaleSeconds(value: i64, unit: i64) Self {
        var seconds = i128(value) * i128(unit);
        if seconds > i128(largestSecond) { return Duration(largestSecond, 999999999); }
        if seconds < i128(smallestSecond) { return Duration(smallestSecond, -999999999); }
        Duration(i64(seconds) catch { panic("invalid duration seconds"); }, 0)
    }
}
