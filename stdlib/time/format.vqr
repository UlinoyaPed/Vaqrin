package time
import (fmt, text)

func appendNumber(output: *text.StringBuilder, value: i64, width: usize) !void {
    if value < 0 { output.append("-")!; }
    var magnitude = if value < 0 { -value } else { value };
    var raw = fmt.formatInt(magnitude, 10)!;
    for i in raw.byteLen()..width { output.append("0")!; }
    output.append(raw)
}

func formatCalendar(date: ?Date, clock: ?TimeOfDay, offset: ?i64, pattern: str) !string {
    var output = text.StringBuilder();
    var source = pattern.asBytes();
    var begin = usize(0);
    var index = usize(0);
    while index < source.len() {
        if source[index] != 37 { index++; continue; }
        var literal = text.fromBytes(source[begin..index])!;
        output.append(literal)!;
        index++;
        if index == source.len() { return TimeError.InvalidFormat; }
        var directive = source[index];
        switch directive {
            37 => { output.append("%")!; },
            89 => { appendNumber(raw output, i64((date ?? { return TimeError.InvalidFormat; }).year()), 4)!; },
            109 => { appendNumber(raw output, i64((date ?? { return TimeError.InvalidFormat; }).month()), 2)!; },
            100 => { appendNumber(raw output, i64((date ?? { return TimeError.InvalidFormat; }).day()), 2)!; },
            106 => { appendNumber(raw output, i64((date ?? { return TimeError.InvalidFormat; }).dayOfYear()), 3)!; },
            72 => { appendNumber(raw output, i64((clock ?? { return TimeError.InvalidFormat; }).hour()), 2)!; },
            77 => { appendNumber(raw output, i64((clock ?? { return TimeError.InvalidFormat; }).minute()), 2)!; },
            83 => { appendNumber(raw output, i64((clock ?? { return TimeError.InvalidFormat; }).second()), 2)!; },
            102 => { appendNumber(raw output, i64((clock ?? { return TimeError.InvalidFormat; }).nanosecond()), 9)!; },
            122 => {
                var zone = offset ?? { return TimeError.InvalidFormat; };
                output.append(if zone < 0 { "-" } else { "+" })!;
                if zone < 0 { zone = -zone; }
                appendNumber(raw output, zone / 3600, 2)!;
                appendNumber(raw output, (zone / 60) % 60, 2)!;
                if zone % 60 != 0 { appendNumber(raw output, zone % 60, 2)!; }
            },
            _ => { return TimeError.InvalidFormat; },
        }
        index++;
        begin = index;
    }
    var tail = text.fromBytes(source[begin..source.len()])!;
    output.append(tail)!;
    output.build()
}

pub func formatDate(value: Date, pattern: str) !string { formatCalendar(some(value), null, null, pattern) }
pub func formatTime(value: TimeOfDay, pattern: str) !string { formatCalendar(null, some(value), null, pattern) }
pub func formatDateTime(value: *const ZonedDateTime, pattern: str) !string {
    var local = value.local()!;
    formatCalendar(some(local.date()), some(local.time()), some(value.offset().seconds()), pattern)
}
