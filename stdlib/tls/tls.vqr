package tls
import (coll, io, mem, net, reactor, task, text, time)

pub error TlsError {
    Unavailable, SetupFailed, TrustStore, Certificate, Handshake, Protocol,
    InvalidName, InvalidProtocol, MissingProtocol, ServerIdentity, UnexpectedEof,
}
pub enum Version { Tls12, Tls13 }

extern "C" func __vqr_tls_open(fd: i32, host: *const u8, ca: *const u8, cert: *const u8,
    key: *const u8, protocols: *const u8, size: u32, version: i32,
    requireProtocol: i32, status: *i32) usize;
extern "C" func __vqr_tls_prepare(fd: i32, host: *const u8, ca: *const u8, cert: *const u8,
    key: *const u8, protocols: *const u8, size: u32, version: i32,
    requireProtocol: i32, nonblocking: i32, status: *i32) usize;
extern "C" func __vqr_tls_handshake(session: usize) i32;
extern "C" func __vqr_tls_alpn(session: usize, dst: *u8) usize;
extern "C" func __vqr_tls_read(session: usize, dst: *u8, size: usize, status: *i32) usize;
extern "C" func __vqr_tls_write(session: usize, src: *const u8, size: usize, status: *i32) usize;
extern "C" func __vqr_tls_close(session: usize) void;

func cString(value: str) !coll.Vec<u8> {
    if value.byteLen() == 0 { return TlsError.InvalidName; }
    var result = coll.Vec<u8>();
    for byte in value.asBytes() {
        if byte == 0 { return TlsError.InvalidName; }
        result.push(byte)!;
    }
    result.push(0)!;
    move(result)
}

func checkStatus(status: i32) !void {
    if status > 0 { return io.systemError(status); }
    switch status {
        0 => {},
        -1 => { return TlsError.Unavailable; },
        -2 => { return TlsError.SetupFailed; },
        -3 => { return TlsError.TrustStore; },
        -4 => { return TlsError.Certificate; },
        -5 => { return TlsError.Handshake; },
        -7 => { return TlsError.MissingProtocol; },
        -8 => { return TlsError.ServerIdentity; },
        -9 => { return TlsError.UnexpectedEof; },
        _ => { return TlsError.Protocol; },
    };
}

const wantRead: i32 = -10;
const wantWrite: i32 = -11;

class TlsReadiness {
    comptime if __vqr_host_supports_tasks() {
        pub static func check(deadline: ?time.Deadline) !void {
            if task.isCancelled() { return io.IoError.Cancelled; }
            if deadline != null && deadline.unwrap().expired()! { return io.IoError.DeadlineExceeded; }
        }
        pub static func wait(fd: i32, status: i32, deadline: ?time.Deadline) !void {
            var interest = if status == wantRead { reactor.Interest.read() } else { reactor.Interest.write() };
            task.waitDescriptor(fd, interest, deadline)
        }
    } else {
        pub static func check(deadline: ?time.Deadline) !void { io.IoError.Unsupported }
        pub static func wait(fd: i32, status: i32, deadline: ?time.Deadline) !void { io.IoError.Unsupported }
    }
}

class NativeSession {
    #copy: disabled
    pub var value: usize;
    pub func init(handle: usize) : value(handle) {}
}

pub class TlsConfig {
    #copy: disabled
    pub var minimumVersion: Version;
    pub var requireProtocol: bool;
    var caFile: coll.Vec<u8>;
    var protocols: coll.Vec<u8>;
    pub func init() : minimumVersion(Version.Tls12), requireProtocol(false),
        caFile(coll.Vec<u8>()), protocols(coll.Vec<u8>()) {}
    pub func setRootFile(path: str) !void { caFile = cString(path)!; }
    pub func addProtocol(name: []const u8) !void {
        if name.len() == 0 || name.len() > 255 || protocols.len() + name.len() + 1 > 65535 {
            return TlsError.InvalidProtocol;
        }
        protocols.reserve(protocols.len() + name.len() + 1)!;
        protocols.push(u8(name.len())!)!;
        for byte in name { protocols.push(byte)!; }
    }
    pub const func connect(socket: net.TcpStream, host: str) !TlsStream {
        var name = cString(host)!;
        var empty: u8 = 0;
        open(move(socket), raw name[0], raw empty, raw empty, false, null)
    }
    pub const func accept(socket: net.TcpStream, cert: str, key: str) !TlsStream {
        var certificate = cString(cert)!;
        var privateKey = cString(key)!;
        var empty: u8 = 0;
        open(move(socket), raw empty, raw certificate[0], raw privateKey[0], false, null)
    }
    pub const func connectAsync(socket: net.AsyncTcpStream, host: str, deadline: ?time.Deadline) !TlsStream {
        var name = cString(host)!;
        var empty: u8 = 0;
        open(net.AsyncTcpStream.intoTcp(move(socket)), raw name[0], raw empty, raw empty, true, deadline)
    }
    pub const func acceptAsync(socket: net.AsyncTcpStream, cert: str, key: str,
                           deadline: ?time.Deadline) !TlsStream {
        var certificate = cString(cert)!;
        var privateKey = cString(key)!;
        var empty: u8 = 0;
        open(net.AsyncTcpStream.intoTcp(move(socket)), raw empty, raw certificate[0], raw privateKey[0], true, deadline)
    }
    const func open(socket: net.TcpStream, host: *const u8,
                    cert: *const u8, key: *const u8, suspendable: bool, deadline: ?time.Deadline) !TlsStream {
        if requireProtocol && protocols.len() == 0 { return TlsError.InvalidProtocol; }
        var empty: u8 = 0;
        var roots: *const u8 = if caFile.len() == 0 { raw empty } else { raw caFile[0] };
        var offered: *const u8 = if protocols.len() == 0 { raw empty } else { raw protocols[0] };
        var size = u32(protocols.len())!;
        var version = if minimumVersion == Version.Tls12 { 12 } else { 13 };
        var required = if requireProtocol { 1 } else { 0 };
        var fd = socket.systemDescriptor()!;
        var status: i32 = 0;
        if suspendable { TlsReadiness.check(deadline)!; }
        var session = if suspendable {
            unsafe { __vqr_tls_prepare(fd, host, roots, cert, key, offered, size, version, required, 1, raw status) }
        } else {
            unsafe { __vqr_tls_open(fd, host, roots, cert, key, offered, size, version, required, raw status) }
        };
        checkStatus(status)!;
        var stream = TlsStream(move(socket), NativeSession(session));
        if suspendable {
            stream.startAsync(deadline)!;
        }
        move(stream)
    }
}

pub class TlsAcceptor {
    #copy: disabled
    var config: TlsConfig;
    var certificate: string;
    var privateKey: string;
    func init(options: TlsConfig, cert: string, key: string)
        : config(move(options)), certificate(move(cert)), privateKey(move(key)) {}
    pub static func fromPem(cert: str, key: str, options: TlsConfig) !Self {
        var certificate = text.fromBytes(cert.asBytes())!;
        var privateKey = text.fromBytes(key.asBytes())!;
        TlsAcceptor(move(options), move(certificate), move(privateKey))
    }
    pub const func accept(socket: net.TcpStream) !TlsStream {
        config.accept(move(socket), certificate, privateKey)
    }
    pub const func acceptAsync(socket: net.AsyncTcpStream, deadline: ?time.Deadline) !TlsStream {
        config.acceptAsync(move(socket), certificate, privateKey, deadline)
    }
}

pub class TlsStream {
    #copy: disabled
    #implements: io.Reader, io.Writer, io.Closer
    var stream: net.TcpStream;
    var session: usize;
    var suspendable: bool;
    var readDeadline: ?time.Deadline;
    var writeDeadline: ?time.Deadline;
    func deinit() void { close() catch {}; }
    pub func init(socket: net.TcpStream, native: NativeSession)
        : stream(move(socket)), session(native.value), suspendable(false), readDeadline(null), writeDeadline(null) {}
    pub func startAsync(deadline: ?time.Deadline) !void {
        TlsReadiness.check(deadline)!;
        suspendable = true;
        readDeadline = deadline;
        writeDeadline = deadline;
        var fd = stream.systemDescriptor()!;
        for {
            TlsReadiness.check(deadline)!;
            var status = unsafe { __vqr_tls_handshake(session) };
            if status != wantRead && status != wantWrite { return checkStatus(status); }
            TlsReadiness.wait(fd, status, deadline)!;
        }
    }
    pub func setReadDeadline(value: ?time.Deadline) void { readDeadline = value; }
    pub func setWriteDeadline(value: ?time.Deadline) void { writeDeadline = value; }
    pub static func connect(socket: net.TcpStream, host: str, config: *const TlsConfig) !Self {
        config.connect(move(socket), host)
    }
    pub const func negotiatedProtocol() !?coll.Vec<u8> {
        if session == 0 { return io.IoError.Closed; }
        var bytes = mem.zeroedBytes<255>();
        var count = unsafe { __vqr_tls_alpn(session, raw bytes[0]) };
        if count == 0 { return null; }
        some(coll.Vec<u8>.fromSlice(bytes[0..count])!)
    }
    pub const func systemDescriptor() !i32 { stream.systemDescriptor() }
    // A pending read must be retried with the same buffer.
    pub func tryRead(dst: []u8) !(usize, ?reactor.Interest) {
        if session == 0 { return io.IoError.Closed; }
        if !suspendable { return io.IoError.Unsupported; }
        if dst.len() == 0 { return (usize(0), null); }
        var status: i32 = 0;
        var count = unsafe { __vqr_tls_read(session, raw dst[0], dst.len(), raw status) };
        if status == wantRead { return (usize(0), some(reactor.Interest.read())); }
        if status == wantWrite { return (usize(0), some(reactor.Interest.write())); }
        checkStatus(status)!;
        (count, null)
    }
    pub func setReadTimeout(value: ?time.Duration) !void { stream.setReadTimeout(value) }
    pub func setWriteTimeout(value: ?time.Duration) !void { stream.setWriteTimeout(value) }
    pub func read(dst: []u8) !usize {
        if session == 0 { return io.IoError.Closed; }
        if dst.len() == 0 { return 0; }
        for {
            if suspendable {
                TlsReadiness.check(readDeadline) catch (reason) {
                    close() catch {};
                    return reason;
                };
            }
            var status: i32 = 0;
            var count = unsafe { __vqr_tls_read(session, raw dst[0], dst.len(), raw status) };
            if status != wantRead && status != wantWrite {
                checkStatus(status)!;
                return count;
            }
            TlsReadiness.wait(stream.systemDescriptor()!, status, readDeadline) catch (reason) {
                close() catch {};
                return reason;
            };
        }
    }
    pub func write(src: []const u8) !usize {
        if session == 0 { return io.IoError.Closed; }
        if src.len() == 0 { return 0; }
        for {
            if suspendable {
                TlsReadiness.check(writeDeadline) catch (reason) {
                    close() catch {};
                    return reason;
                };
            }
            var status: i32 = 0;
            var count = unsafe { __vqr_tls_write(session, raw src[0], src.len(), raw status) };
            if status != wantRead && status != wantWrite {
                checkStatus(status)!;
                return count;
            }
            TlsReadiness.wait(stream.systemDescriptor()!, status, writeDeadline) catch (reason) {
                close() catch {};
                return reason;
            };
        }
    }
    pub func flush() !void { if session == 0 { return io.IoError.Closed; } }
    pub func close() !void {
        if session == 0 { return; }
        var current = session;
        session = 0;
        unsafe { __vqr_tls_close(current); }
        stream.close()
    }
}
