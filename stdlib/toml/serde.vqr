package toml
import (coll, convert, opt, serde, text)

pub error TomlSerdeError { InvalidState, UnsupportedValue, MissingRoot }

class TomlWriteFrame {
    pub var mapMode: bool;
    pub var array: coll.Vec<Value>;
    pub var table: Document;
    pub var pendingKey: ?string;
    pub func init(isMap: bool)
        : mapMode(isMap), array(coll.Vec<Value>()), table(Document()), pendingKey(null) {}
}

pub class TomlDomSerializer {
    #implements: serde.Serializer
    var frames: coll.Vec<TomlWriteFrame>;
    var root: ?Value;
public:
    func init() : frames(coll.Vec<TomlWriteFrame>()), root(null) {}
    func writeNull() !void { return serde.SerdeError.Unsupported; }
    func writeBool(value: bool) !void { appendValue(Value.Bool(value)) }
    func writeI64(value: i64) !void { appendValue(Value.Integer(value)) }
    func writeU64(value: u64) !void {
        if value > 9223372036854775807 { return serde.SerdeError.IntegerOutOfRange; }
        var narrowed = convert.narrow<i64>(value)!;
        appendValue(Value.Integer(narrowed))
    }
    func writeF64(value: f64) !void { return serde.SerdeError.Unsupported; }
    func writeNumber(value: str) !void {
        var options = TomlOptions();
        var parsed = parseValue(value, 0, &options)!;
        switch move(parsed) {
            Value.Integer(value) => appendValue(Value.Integer(value)),
            Value.Float(value) => appendValue(Value.Float(move(value))),
            _ => TomlSerdeError.UnsupportedValue,
        }
    }
    func writeString(value: str) !void {
        var owned = text.fromBytes(value.asBytes())!;
        appendValue(Value.String(move(owned)))
    }
    func beginSeq(length: ?usize) !void { frames.push(TomlWriteFrame(false))!; }
    func endSeq() !void {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.pop().unwrap();
        if frame.mapMode { return TomlSerdeError.InvalidState; }
        appendValue(Value.Array(move(frame.array)))
    }
    func beginMap(length: ?usize) !void { frames.push(TomlWriteFrame(true))!; }
    func writeKey(value: str) !void {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.getMut(frames.len() - 1).unwrap();
        if !frame.mapMode || frame.pendingKey != null { return TomlSerdeError.InvalidState; }
        frame.pendingKey = some(text.fromBytes(value.asBytes())!);
    }
    func endMap() !void {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.pop().unwrap();
        if !frame.mapMode || frame.pendingKey != null { return TomlSerdeError.InvalidState; }
        appendValue(Value.Table(move(frame.table)))
    }
    func takeValue() !Value {
        if !frames.isEmpty() { return TomlSerdeError.InvalidState; }
        move(root).unwrap()
    }
private:
    func appendValue(value: Value) !void {
        if frames.isEmpty() {
            if root != null { return TomlSerdeError.InvalidState; }
            root = some(move(value));
            return;
        }
        var frame = frames.getMut(frames.len() - 1).unwrap();
        if frame.mapMode {
            var key = opt.take<string>(&frame.pendingKey) ?? { return TomlSerdeError.InvalidState; };
            frame.table.insertUnique(move(key), move(value))!;
        } else {
            frame.array.push(move(value))!;
        }
    }
}

class TomlReadFrame {
    pub var mapMode: bool;
    pub var parent: *const Value;
    pub var index: usize;
    pub func init(isMap: bool, parent: *const Value)
        : mapMode(isMap), parent(parent), index(0) {}
}

pub class TomlDomDeserializer {
    #implements: serde.Deserializer
    var root: Value;
    var current: ?*const Value;
    var frames: coll.Vec<TomlReadFrame>;
public:
    func init(value: Value)
        : root(move(value)), current(null), frames(coll.Vec<TomlReadFrame>()) {
        current = some(&root);
    }
    func kind() !serde.DataKind {
        var value = current ?? { return serde.SerdeError.InvalidState; };
        switch *value {
            Value.String(_) => serde.DataKind.String,
            Value.Integer(_), Value.Float(_) => serde.DataKind.Number,
            Value.Bool(_) => serde.DataKind.Bool,
            Value.Array(_) => serde.DataKind.Sequence,
            Value.Table(_) => serde.DataKind.Map,
            Value.DateTime(_) => serde.DataKind.String,
        }
    }
    func readNull() !void { return serde.SerdeError.TypeMismatch; }
    func readBool() !bool {
        switch *current.unwrap() { Value.Bool(value) => value, _ => serde.SerdeError.TypeMismatch }
    }
    func readI64() !i64 {
        switch *current.unwrap() {
            Value.Integer(value) => value,
            _ => serde.SerdeError.TypeMismatch,
        }
    }
    func readU64() !u64 {
        switch *current.unwrap() {
            Value.Integer(value) => {
                if value < 0 { return serde.SerdeError.IntegerOutOfRange; }
                convert.narrow<u64>(value)
            },
            _ => serde.SerdeError.TypeMismatch,
        }
    }
    func readF64() !f64 { return serde.SerdeError.Unsupported; }
    func readNumber() !string {
        switch *current.unwrap() {
            Value.Integer(value) => integerText(value),
            Value.Float(value) => text.fromBytes(value.asBytes()),
            _ => serde.SerdeError.TypeMismatch,
        }
    }
    func readString() !string {
        switch *current.unwrap() {
            Value.String(value) => text.fromBytes(value.asBytes()),
            Value.DateTime(value) => text.fromBytes(value.asBytes()),
            _ => serde.SerdeError.TypeMismatch,
        }
    }
    func beginSeq() !?usize {
        var parent = current ?? { return serde.SerdeError.InvalidState; };
        switch *parent {
            Value.Array(&array) => {
                frames.push(TomlReadFrame(false, parent))!;
                some(array.len())
            },
            _ => serde.SerdeError.TypeMismatch,
        }
    }
    func nextElement() !bool {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.getMut(frames.len() - 1).unwrap();
        if frame.mapMode { return TomlSerdeError.InvalidState; }
        var array = asArray(frame.parent).unwrap();
        if frame.index >= array.len() { current = null; return false; }
        current = array.get(frame.index);
        frame.index++;
        true
    }
    func endSeq() !void {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.pop().unwrap();
        if frame.mapMode { return TomlSerdeError.InvalidState; }
        var array = asArray(frame.parent).unwrap();
        if frame.index != array.len() { return serde.SerdeError.InvalidLength; }
        current = some(frame.parent);
    }
    func beginMap() !?usize {
        var parent = current ?? { return serde.SerdeError.InvalidState; };
        switch *parent {
            Value.Table(&table) => {
                frames.push(TomlReadFrame(true, parent))!;
                some(table.len())
            },
            _ => serde.SerdeError.TypeMismatch,
        }
    }
    func nextKey() !?string {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.getMut(frames.len() - 1).unwrap();
        if !frame.mapMode { return TomlSerdeError.InvalidState; }
        var table = asTable(frame.parent).unwrap();
        if frame.index >= table.len() { current = null; return null; }
        var key = table.keyAt(frame.index).unwrap();
        current = table.valueAt(frame.index);
        frame.index++;
        some(text.fromBytes(key.asBytes())!)
    }
    func endMap() !void {
        if frames.isEmpty() { return TomlSerdeError.InvalidState; }
        var frame = frames.pop().unwrap();
        if !frame.mapMode { return TomlSerdeError.InvalidState; }
        var table = asTable(frame.parent).unwrap();
        if frame.index != table.len() { return serde.SerdeError.InvalidLength; }
        current = some(frame.parent);
    }
    func finish() !void {
        if !frames.isEmpty() || current == null { return TomlSerdeError.InvalidState; }
    }
}

func asArray(value: *const Value) ?*const coll.Vec<Value> {
    switch *value { Value.Array(&array) => some(&array), _ => null }
}
func asTable(value: *const Value) ?*const Document {
    switch *value { Value.Table(&table) => some(&table), _ => null }
}
func integerText(value: i64) !string {
    var negative = value < 0;
    var bits = bitCast<u64>(value);
    var magnitude = if negative { 0u64 -% bits } else { bits };
    var digits = coll.Vec<u8>();
    for {
        digits.push(u8(48 + (magnitude % 10))!)!;
        magnitude = magnitude / 10;
        if magnitude == 0 { break; }
    }
    if negative { digits.push(45)!; }
    var output = coll.Vec<u8>();
    for index := digits.len(); index > 0; index-- { output.push(digits[index - 1])!; }
    text.fromBytes(output.asConstSlice())
}

pub func encode<T>(value: *const T, codec: *const serde.Codec<T>) !string {
    var serializer = TomlDomSerializer();
    serde.encode<T>(value, &serializer, codec)!;
    var root = serializer.takeValue()!;
    switch move(root) {
        Value.Table(document) => stringify(&document),
        _ => TomlError.TypeMismatch,
    }
}

pub func decode<T>(value: str, codec: *const serde.Codec<T>) !T {
    var document = parse(value)!;
    var root = Value.Table(move(document));
    var deserializer = TomlDomDeserializer(move(root));
    var result = serde.decode<T>(&deserializer, codec)!;
    deserializer.finish()!;
    move(result)
}
