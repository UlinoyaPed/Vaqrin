package toml
import (coll, convert, io, math, parse as numberParser, text)

pub error TomlError {
    InvalidSyntax, InvalidKey, DuplicateKey, DuplicateTable, TypeConflict,
    InvalidString, InvalidNumber, InvalidDateTime, UnsupportedSyntax,
    DepthLimit, SizeLimit, MissingKey, TypeMismatch,
}

pub enum Value {
    String(string), Integer(i64), Float(string), Bool(bool),
    DateTime(string), Array(coll.Vec<Value>), Table(Document),
}

pub func asF64(value: *const Value) !f64 {
    switch *value {
        Value.Integer(item) => convert.toFloat<f64>(item),
        Value.Float(item) => {
            if text.equal(item, "inf") || text.equal(item, "+inf") { return math.inf<f64>(); }
            if text.equal(item, "-inf") { return -math.inf<f64>(); }
            if text.equal(item, "nan") || text.equal(item, "+nan") { return math.nan<f64>(); }
            if text.equal(item, "-nan") { return -math.nan<f64>(); }
            var source = item.asBytes();
            for byte in source {
                if byte != 95 { continue; }
                var cleaned = coll.Vec<u8>.withCapacity(source.len())!;
                for digit in source {
                    if digit != 95 { cleaned.push(digit)!; }
                }
                var raw = text.fromBytes(cleaned.asConstSlice())!;
                return numberParser.parseFloat<f64>(raw);
            }
            numberParser.parseFloat<f64>(item)
        },
        _ => TomlError.TypeMismatch,
    }
}

pub class TomlOptions {
    pub var maxDepth: usize;
    pub var maxBytes: usize;
    pub var maxEntries: usize;
    pub func init() : maxDepth(64), maxBytes(4 * 1024 * 1024), maxEntries(100_000) {}
}

pub class Entry {
    pub var key: string;
    pub var value: Value;
    pub func init(key: string, value: move Value) : key(move(key)), value(move(value)) {}
}

enum TableKind { Implicit, Explicit, Dotted, Inline, ArrayElement }

pub class Document {
    var origin: TableKind;
    var entries: coll.Vec<Entry>;
    pub func init() : self(TableKind.Implicit) {}
    pub func init(origin: TableKind) : origin(origin), entries(coll.Vec<Entry>()) {}
    pub const func tableKind() TableKind { origin }
    pub func setTableKind(value: TableKind) void { origin = value; }
    pub const func len() usize { entries.len() }

    pub const func get(key: str) ?*const Value {
        for index in usize(0)..entries.len() {
            var entry = entries.getPtr(index).unwrap();
            if entry.key == key { return some(raw entry.value); }
        }
        null
    }

    pub func getMut(key: str) ?*Value {
        for index in usize(0)..entries.len() {
            var entry = entries.getMutPtr(index).unwrap();
            if entry.key == key { return some(raw entry.value); }
        }
        null
    }

    pub func set(key: string, value: move Value) !void {
        for index in usize(0)..entries.len() {
            var entry = entries.getMutPtr(index).unwrap();
            if entry.key == key { entry.value = move(value); return; }
        }
        entries.push(Entry(move(key), move(value)))!
    }

    pub func insertUnique(key: string, value: move Value) !void {
        if get(key) != null { return TomlError.DuplicateKey; }
        entries.push(Entry(move(key), move(value)))!
    }

    pub func remove(key: str) bool {
        for index in usize(0)..entries.len() {
            if entries.getPtr(index).unwrap().key == key {
                var removed = entries.remove(index);
                return true;
            }
        }
        false
    }

    pub const func keyAt(index: usize) ?str {
        if index >= entries.len() { return null; }
        some(entries.getPtr(index).unwrap().key)
    }

    pub const func valueAt(index: usize) ?*const Value {
        if index >= entries.len() { return null; }
        some(raw entries.getPtr(index).unwrap().value)
    }

    pub const func getPath(path: str) ?*const Value { lookupPath(self, path) }
    pub func setPath(path: str, value: move Value) !void {
        var keys = parseKeyPath(path)!;
        setDotted(self, keys.asConstSlice(), move(value), true)
    }
    pub const func stringify() !string { stringifyDocument(self) }
}

func trim(value: str) str {
    var data = value.asBytes();
    var start: usize = 0;
    var end = data.len();
    while start < end && isWhitespace(data[start]) { start++; }
    while end > start && isWhitespace(data[end - 1]) { end--; }
    unsafe { __vqr_text_borrow_utf8(data[start..end]) }
}

func isWhitespace(byte: u8) bool { byte == 32 || byte == 9 || byte == 13 || byte == 10 }
func tripleQuote(data: []const u8, index: usize, mark: u8) bool {
    data.len() - index >= 3 && data[index] == mark && data[index + 1] == mark && data[index + 2] == mark
}

class QuoteState {
    var mark: u8;
    var multiline: bool;
    pub func init() : mark(0), multiline(false) {}
    pub const func open() bool { mark != 0 }

    pub func skip(data: []const u8, cursor: *usize) bool {
        var index = *cursor;
        var byte = data[index];
        if mark == 0 {
            if byte != 34 && byte != 39 { return false; }
            mark = byte;
            multiline = tripleQuote(data, index, byte);
            *cursor += if multiline { usize(3) } else { usize(1) };
            return true;
        }
        if mark == 34 && byte == 92 && index + 1 < data.len() {
            *cursor += 2;
        } else if byte == mark && (!multiline || tripleQuote(data, index, mark)) {
            *cursor += if multiline { usize(3) } else { usize(1) };
            if multiline {
                while *cursor < data.len() && data[*cursor] == mark { *cursor += 1; }
            }
            mark = 0;
        } else {
            *cursor += 1;
        }
        true
    }
}

// Collect one assignment or header, discarding comments outside strings.
func nextStatement(data: []const u8, position: *usize, output: *coll.Vec<u8>) !void {
    output.clear();
    var quote = QuoteState();
    var square: usize = 0;
    var curly: usize = 0;
    while *position < data.len() {
        var start = *position;
        if quote.skip(data, position) {
            for byte in data[start..*position] { output.push(byte)!; }
            continue;
        }
        var byte = data[*position];
        *position += 1;
        if byte == 13 && (*position == data.len() || data[*position] != 10) {
            return TomlError.InvalidSyntax;
        }
        if byte == 35 {
            while *position < data.len() && data[*position] != 10 {
                var comment = data[*position];
                if comment < 32 && comment != 9 &&
                   !(comment == 13 && *position + 1 < data.len() && data[*position + 1] == 10) {
                    return TomlError.InvalidSyntax;
                }
                if comment == 127 { return TomlError.InvalidSyntax; };
                *position += 1;
            }
            continue;
        }
        if byte == 10 && square == 0 {
            if curly != 0 { return TomlError.InvalidSyntax; }
            return;
        }
        if byte == 91 { square++; }
        else if byte == 93 {
            if square == 0 { return TomlError.InvalidSyntax; }
            square--;
        } else if byte == 123 { curly++; }
        else if byte == 125 {
            if curly == 0 { return TomlError.InvalidSyntax; }
            curly--;
        }
        output.push(byte)!;
    }
    if quote.open() { return TomlError.InvalidString; }
    if square != 0 || curly != 0 { return TomlError.InvalidSyntax; }
}

func isDigitFor(byte: u8, radix: u8) bool {
    if 48 <= byte && byte <= 57 { return byte - 48 < radix; }
    if 65 <= byte && byte <= 70 { return radix > 10 && byte - 55 < radix; }
    if 97 <= byte && byte <= 102 { return radix > 10 && byte - 87 < radix; }
    false
}

func hexValue(byte: u8) ?u32 {
    if 48 <= byte && byte <= 57 { return some((u32(byte) - u32(48))); }
    if 65 <= byte && byte <= 70 { return some((u32(byte) - u32(55))); }
    if 97 <= byte && byte <= 102 { return some((u32(byte) - u32(87))); }
    null
}

func appendScalar(output: *coll.Vec<u8>, scalar: u32) !void {
    if scalar > 0x10ffff || (0xd800 <= scalar && scalar <= 0xdfff) {
        return TomlError.InvalidString;
    }
    if scalar < 0x80 {
        output.push(u8(scalar)!)!;
    } else if scalar < 0x800 {
        output.push(u8(0xc0 | (scalar >> 6))!)!;
        output.push(u8(0x80 | (scalar & 0x3f))!)!;
    } else if scalar < 0x10000 {
        output.push(u8(0xe0 | (scalar >> 12))!)!;
        output.push(u8(0x80 | ((scalar >> 6) & 0x3f))!)!;
        output.push(u8(0x80 | (scalar & 0x3f))!)!;
    } else {
        output.push(u8(0xf0 | (scalar >> 18))!)!;
        output.push(u8(0x80 | ((scalar >> 12) & 0x3f))!)!;
        output.push(u8(0x80 | ((scalar >> 6) & 0x3f))!)!;
        output.push(u8(0x80 | (scalar & 0x3f))!)!;
    }
}

func stringStart(data: []const u8, multiline: bool) usize {
    if !multiline { return 1; }
    if data[3] == 10 { return 4; }
    if data[3] == 13 && data[4] == 10 { return 5; }
    3
}

func appendStringByte(data: []const u8, position: *usize, stop: usize,
                      multiline: bool, mark: u8, out: *coll.Vec<u8>) !void {
    var index = *position;
    var byte = data[index];
    if byte == 13 && multiline && index + 1 < stop && data[index + 1] == 10 {
        out.push(10)!;
        *position += 2;
        return;
    }
    if byte == mark && (!multiline || (stop - index >= 3 && tripleQuote(data, index, mark))) {
        return TomlError.InvalidString;
    }
    if (byte < 0x20 && byte != 9 && !(multiline && byte == 10)) || byte == 0x7f {
        return TomlError.InvalidString;
    }
    out.push(byte)!;
    *position += 1;
}

func parseBasicString(value: str, allowMultiline: bool) !string {
    var data = value.asBytes();
    if data.len() < 2 || data[0] != 34 || data[data.len() - 1] != 34 { return TomlError.InvalidString; }
    var multiline = allowMultiline && tripleQuote(data, 0, 34);
    if multiline && (data.len() < 6 || !tripleQuote(data, data.len() - 3, 34)) { return TomlError.InvalidString; }
    var stop = data.len() - (if multiline { usize(3) } else { usize(1) });
    var output = coll.Vec<u8>();
    var index = stringStart(data, multiline);
    while index < stop {
        if data[index] != 92 {
            appendStringByte(data, raw index, stop, multiline, 34, raw output)!;
            continue;
        }
        index++;
        if multiline && index < stop && isWhitespace(data[index]) {
            var crossedLine = false;
            while index < stop && isWhitespace(data[index]) {
                if data[index] == 10 { crossedLine = true; }
                else if data[index] == 13 && (index + 1 == stop || data[index + 1] != 10) {
                    return TomlError.InvalidString;
                }
                index++;
            }
            if !crossedLine { return TomlError.InvalidString; }
            continue;
        }
        if index >= stop { return TomlError.InvalidString; }
        var escape = data[index];
        index++;
        switch escape {
            34 => output.push(34)!,
            92 => output.push(92)!,
            98 => output.push(8)!,
            116 => output.push(9)!,
            110 => output.push(10)!,
            102 => output.push(12)!,
            114 => output.push(13)!,
            117, 85 => {
                var digits = if escape == 117 { usize(4) } else { usize(8) };
                if stop - index < digits { return TomlError.InvalidString; }
                var scalar: u32 = 0;
                for i in usize(0)..digits {
                    var digit = hexValue(data[index + i]) ?? { return TomlError.InvalidString; };
                    scalar = (scalar << 4) | digit;
                }
                index += digits;
                appendScalar(raw output, scalar)!;
            },
            _ => return TomlError.InvalidString,
        }
    }
    text.fromBytes(output.asConstSlice()) catch { return TomlError.InvalidString; }
}

func parseLiteralString(value: str, allowMultiline: bool) !string {
    var data = value.asBytes();
    if data.len() < 2 || data[0] != 39 || data[data.len() - 1] != 39 { return TomlError.InvalidString; }
    var multiline = allowMultiline && tripleQuote(data, 0, 39);
    if multiline && (data.len() < 6 || !tripleQuote(data, data.len() - 3, 39)) { return TomlError.InvalidString; }
    var stop = data.len() - (if multiline { usize(3) } else { usize(1) });
    var output = coll.Vec<u8>();
    var index = stringStart(data, multiline);
    while index < stop { appendStringByte(data, raw index, stop, multiline, 39, raw output)!; }
    text.fromBytes(output.asConstSlice()) catch { return TomlError.InvalidString; }
}

func splitTopLevel(value: str, delimiter: u8) !coll.Vec<string> {
    var data = value.asBytes();
    var output = coll.Vec<string>();
    var start: usize = 0;
    var index: usize = 0;
    var quote = QuoteState();
    var square: usize = 0;
    var curly: usize = 0;
    while index < data.len() {
        if quote.skip(data, raw index) { continue; }
        var byte = data[index];
        if byte == 91 { square++; }
        else if byte == 93 {
            if square == 0 { return TomlError.InvalidSyntax; }
            square--;
        } else if byte == 123 { curly++; }
        else if byte == 125 {
            if curly == 0 { return TomlError.InvalidSyntax; }
            curly--;
        } else if byte == delimiter && square == 0 && curly == 0 {
            output.push(text.fromBytes(data[start..index])!)!;
            start = index + 1;
        }
        index++;
    }
    if quote.open() || square != 0 || curly != 0 { return TomlError.InvalidSyntax; }
    output.push(text.fromBytes(data[start..data.len()])!)!;
    move(output)
}

func findTopLevel(value: str, delimiter: u8) ?usize {
    var data = value.asBytes();
    var quote = QuoteState();
    var index: usize = 0;
    var square: usize = 0;
    var curly: usize = 0;
    while index < data.len() {
        if quote.skip(data, raw index) { continue; }
        var byte = data[index];
        if byte == 91 { square++; }
        else if byte == 93 && square != 0 { square--; }
        else if byte == 123 { curly++; }
        else if byte == 125 && curly != 0 { curly--; }
        else if byte == delimiter && square == 0 && curly == 0 { return some(index); }
        index++;
    }
    null
}

func parseKeySegment(value: str) !string {
    var segment = trim(value);
    var data = segment.asBytes();
    if data.len() == 0 { return TomlError.InvalidKey; }
    if data[0] == 34 { return parseBasicString(segment, false); }
    if data[0] == 39 { return parseLiteralString(segment, false); }
    for byte in data {
        var valid = (65 <= byte && byte <= 90) || (97 <= byte && byte <= 122) ||
                    (48 <= byte && byte <= 57) || byte == 95 || byte == 45;
        if !valid { return TomlError.InvalidKey; }
    }
    text.fromBytes(data)
}

func parseKeyPath(value: str) !coll.Vec<string> {
    var parts = splitTopLevel(value, 46)!;
    var output = coll.Vec<string>();
    for part in parts {
        var key = parseKeySegment(part)!;
        output.push(move(key))!;
    }
    move(output)
}

pub func get(document: *const Document, path: str) ?*const Value { lookupPath(document, path) }

func lookupPath(document: *const Document, path: str) ?*const Value {
    var keys = parseKeyPath(path) catch { return null; };
    if keys.len() == 0 { return null; }
    var current = document;
    for index in usize(0)..keys.len() {
        var key = *keys.getPtr(index).unwrap();
        var value = current.get(key) ?? { return null; };
        if index + 1 == keys.len() { return value; }
        switch *value {
            Value.Table(ref table) => { current = table.toRaw(); },
            _ => return null,
        }
    }
    null
}

func setDotted(document: *Document, path: []const string, value: move Value, rejectDuplicate: bool) !void {
    if path.len() == 0 { return TomlError.InvalidKey; }
    var current = document;
    for index in usize(0)..(path.len() - 1) {
        var key = path[index];
        var child = current.getMut(key);
        if child == null {
            current.set(text.fromBytes(key.asBytes())!, Value.Table(Document(TableKind.Dotted)))!;
            child = current.getMut(key);
        }
        switch *child.unwrap() {
            Value.Table(ref mut table) => {
                if rejectDuplicate {
                    var kind = table.tableKind();
                    if kind != TableKind.Implicit && kind != TableKind.Dotted { return TomlError.DuplicateTable; }
                    table.setTableKind(TableKind.Dotted);
                }
                current = table.toRaw();
            },
            _ => return TomlError.TypeConflict,
        }
    }
    var finalKey = text.fromBytes(path[path.len() - 1].asBytes())!;
    if rejectDuplicate {
        current.insertUnique(move(finalKey), move(value))!;
    } else {
        current.set(move(finalKey), move(value))!;
    }
}

func arrayTable(array: *coll.Vec<Value>) !*Document {
    var tail = array.lastMut() ?? { return TomlError.TypeConflict; };
    switch *tail {
        Value.Table(ref mut table) => {
            if table.tableKind() != TableKind.ArrayElement { return TomlError.TypeConflict; }
            var address: *Document = table.toRaw();
            return address;
        },
        _ => TomlError.TypeConflict,
    }
}

func declareTable(document: *Document, path: []const string, array: bool) !*Document {
    var current = document;
    for i in usize(0)..(path.len() - 1) {
        var key = path[i];
        var child = current.getMut(key);
        if child == null {
            current.set(text.fromBytes(key.asBytes())!, Value.Table(Document()))!;
            child = current.getMut(key);
        }
        switch *child.unwrap() {
            Value.Table(ref mut table) => {
                if table.tableKind() == TableKind.Inline { return TomlError.DuplicateTable; }
                current = table.toRaw();
            },
            Value.Array(ref mut tables) => { current = arrayTable(tables.toRaw())!; },
            _ => return TomlError.TypeConflict,
        }
    }
    var key = path[path.len() - 1];
    var child = current.getMut(key);
    if child == null {
        if array {
            var tables = coll.Vec<Value>();
            tables.push(Value.Table(Document(TableKind.ArrayElement)))!;
            current.set(text.fromBytes(key.asBytes())!, Value.Array(move(tables)))!;
            child = current.getMut(key);
            switch *child.unwrap() {
                Value.Array(ref mut list) => return arrayTable(list.toRaw()),
                _ => panic("TOML array table invariant"),
            }
        }
        current.set(text.fromBytes(key.asBytes())!, Value.Table(Document()))!;
        child = current.getMut(key);
    }
    switch *child.unwrap() {
        Value.Table(ref mut table) => {
            if array { return TomlError.TypeConflict; }
            if table.tableKind() != TableKind.Implicit { return TomlError.DuplicateTable; }
            table.setTableKind(TableKind.Explicit);
            var address: *Document = table.toRaw();
            return address;
        },
        Value.Array(ref mut tables) => {
            if !array { return TomlError.TypeConflict; }
            var previous = arrayTable(tables.toRaw())!;
            tables.push(Value.Table(Document(TableKind.ArrayElement)))!;
            arrayTable(tables.toRaw())
        },
        _ => TomlError.TypeConflict,
    }
}

func parseDigitRun(data: []const u8, position: *usize, radix: u8) !usize {
    var count: usize = 0;
    var previousDigit = false;
    while *position < data.len() {
        var byte = data[*position];
        if isDigitFor(byte, radix) {
            count++;
            previousDigit = true;
            *position += 1;
        } else if byte == 95 {
            if !previousDigit || *position + 1 >= data.len() ||
               !isDigitFor(data[*position + 1], radix) {
                return TomlError.InvalidNumber;
            }
            previousDigit = false;
            *position += 1;
        } else {
            break;
        }
    }
    if count == 0 { return TomlError.InvalidNumber; }
    count
}

func cleanInteger(value: str, radix: *u8) !string {
    var data = value.asBytes();
    var position: usize = 0;
    var sign: u8 = 0;
    if data.len() == 0 { return TomlError.InvalidNumber; }
    if data[0] == 43 || data[0] == 45 {
        sign = data[0];
        position++;
    }
    if position >= data.len() { return TomlError.InvalidNumber; }
    if sign == 0 && data.len() >= 2 && data[0] == 48 {
        if data[1] == 120 { *radix = 16; position = 2; }
        else if data[1] == 111 { *radix = 8; position = 2; }
        else if data[1] == 98 { *radix = 2; position = 2; }
    }
    if position >= data.len() { return TomlError.InvalidNumber; }
    var digits = coll.Vec<u8>();
    if sign != 0 { digits.push(sign)!; }
    var digitStart = position;
    var digitCount = parseDigitRun(data, raw position, *radix)!;
    if position != data.len() { return TomlError.InvalidNumber; }
    if *radix == 10 && data[digitStart] == 48 && digitCount > 1 {
        return TomlError.InvalidNumber;
    }
    for index in digitStart..data.len() {
        if data[index] != 95 { digits.push(data[index])!; }
    }
    text.fromBytes(digits.asConstSlice())
}

func validateFloat(value: str) !void {
    var data = value.asBytes();
    if value == "inf" || value == "+inf" || value == "-inf" ||
       value == "nan" || value == "+nan" || value == "-nan" { return; }
    var position: usize = 0;
    if data.len() == 0 { return TomlError.InvalidNumber; }
    if data[position] == 43 || data[position] == 45 { position++; }
    if position >= data.len() { return TomlError.InvalidNumber; }
    var start = position;
    var integerDigits = parseDigitRun(data, raw position, 10)!;
    if integerDigits > 1 && data[start] == 48 { return TomlError.InvalidNumber; }
    var hasFraction = false;
    var hasExponent = false;
    if position < data.len() && data[position] == 46 {
        hasFraction = true;
        position++;
        parseDigitRun(data, raw position, 10)!;
    }
    if position < data.len() && (data[position] == 101 || data[position] == 69) {
        hasExponent = true;
        position++;
        if position < data.len() && (data[position] == 43 || data[position] == 45) {
            position++;
        }
        parseDigitRun(data, raw position, 10)!;
    }
    if !hasFraction && !hasExponent { return TomlError.InvalidNumber; }
    if position != data.len() { return TomlError.InvalidNumber; }
}

func parseDateDigits(data: []const u8, start: usize, count: usize) ?u32 {
    if start > data.len() || data.len() - start < count { return null; }
    var value: u32 = 0;
    for index in start..(start + count) {
        if data[index] < 48 || data[index] > 57 { return null; }
        value = value * 10 + (u32(data[index]) - u32(48));
    }
    some(value)
}

func validDate(data: []const u8) bool {
    if data.len() != 10 || data[4] != 45 || data[7] != 45 { return false; }
    var year = parseDateDigits(data, 0, 4) ?? { return false; };
    var month = parseDateDigits(data, 5, 2) ?? { return false; };
    var day = parseDateDigits(data, 8, 2) ?? { return false; };
    if month < 1 || month > 12 { return false; }
    var days = if month == 2 {
        if year % 400 == 0 || (year % 4 == 0 && year % 100 != 0) { u32(29) } else { u32(28) }
    } else if month == 4 || month == 6 || month == 9 || month == 11 { u32(30) } else { u32(31) };
    day >= 1 && day <= days
}

func validTime(data: []const u8) bool {
    if data.len() < 8 || data[2] != 58 || data[5] != 58 { return false; }
    var hour = parseDateDigits(data, 0, 2) ?? { return false; };
    var minute = parseDateDigits(data, 3, 2) ?? { return false; };
    var second = parseDateDigits(data, 6, 2) ?? { return false; };
    if hour > 23 || minute > 59 || second > 60 { return false; }
    if data.len() == 8 { return true; }
    if data[8] != 46 || data.len() == 9 { return false; }
    for index in usize(9)..data.len() {
        if data[index] < 48 || data[index] > 57 { return false; }
    }
    true
}

func validateDateTime(value: str) !void {
    var data = value.asBytes();
    if data.len() == 10 {
        if !validDate(data) { return TomlError.InvalidDateTime; }
        return;
    }
    if data.len() >= 8 && data[2] == 58 {
        if !validTime(data) { return TomlError.InvalidDateTime; }
        return;
    }
    if data.len() < 19 || !validDate(data[0..10]) ||
       (data[10] != 84 && data[10] != 116 && data[10] != 32) {
        return TomlError.InvalidDateTime;
    }
    var timeEnd = data.len();
    var zoneStart: ?usize = null;
    for index in usize(19)..data.len() {
        if data[index] == 90 || data[index] == 122 || data[index] == 43 || data[index] == 45 {
            zoneStart = some(index);
            timeEnd = index;
            break;
        }
    }
    if !validTime(data[11..timeEnd]) { return TomlError.InvalidDateTime; }
    switch zoneStart {
        null => {},
        some(index) => {
            if data[index] == 90 || data[index] == 122 {
                if index + 1 != data.len() { return TomlError.InvalidDateTime; }
            } else {
                if data.len() - index != 6 || data[index + 3] != 58 {
                    return TomlError.InvalidDateTime;
                }
                var hour = parseDateDigits(data, index + 1, 2) ?? { return TomlError.InvalidDateTime; };
                var minute = parseDateDigits(data, index + 4, 2) ?? { return TomlError.InvalidDateTime; };
                if hour > 23 || minute > 59 { return TomlError.InvalidDateTime; }
            }
        },
    }
}

func parseArray(value: str, depth: usize, options: *const TomlOptions) !Value {
    var data = value.asBytes();
    if data.len() < 2 || data[0] != 91 || data[data.len() - 1] != 93 {
        return TomlError.InvalidSyntax;
    }
    var inside = trim(unsafe { __vqr_text_borrow_utf8(data[1..data.len() - 1]) });
    var output = coll.Vec<Value>();
    if inside.byteLen() == 0 { return Value.Array(move(output)); }
    var parts = splitTopLevel(inside, 44)!;
    for index in usize(0)..parts.len() {
        var part = trim(*parts.getPtr(index).unwrap());
        if part.byteLen() == 0 {
            if index == parts.len() - 1 { continue; }
            return TomlError.InvalidSyntax;
        }
        var item = parseValue(part, depth + 1, options)!;
        output.push(move(item))!;
        if output.len() > options.maxEntries { return TomlError.SizeLimit; }
    }
    Value.Array(move(output))
}

func parseInlineTable(value: str, depth: usize, options: *const TomlOptions) !Value {
    var data = value.asBytes();
    if data.len() < 2 || data[0] != 123 || data[data.len() - 1] != 125 {
        return TomlError.InvalidSyntax;
    }
    var inside = trim(unsafe { __vqr_text_borrow_utf8(data[1..data.len() - 1]) });
    var document = Document();
    if inside.byteLen() == 0 { return Value.Table(Document(TableKind.Inline)); }
    var parts = splitTopLevel(inside, 44)!;
    for part in parts {
        var equal = findTopLevel(part, 61) ?? { return TomlError.InvalidSyntax; };
        var key = parseKeyPath(trim(unsafe { __vqr_text_borrow_utf8(part.asBytes()[0..equal]) }))!;
        var rhs = trim(unsafe { __vqr_text_borrow_utf8(part.asBytes()[equal + 1..part.byteLen()]) });
        var item = parseValue(rhs, depth + 1, options)!;
        setDotted(raw document, key.asConstSlice(), move(item), true)!;
    }
    document.setTableKind(TableKind.Inline);
    Value.Table(move(document))
}

func parseValue(value: str, depth: usize, options: *const TomlOptions) !Value {
    if depth > options.maxDepth { return TomlError.DepthLimit; }
    var source = trim(value);
    var data = source.asBytes();
    if data.len() == 0 { return TomlError.InvalidSyntax; }
    if data[0] == 34 { return Value.String(parseBasicString(source, true)!); }
    if data[0] == 39 { return Value.String(parseLiteralString(source, true)!); }
    if data[0] == 91 { return parseArray(source, depth, options); }
    if data[0] == 123 { return parseInlineTable(source, depth, options); }
    if source == "true" { return Value.Bool(true); }
    if source == "false" { return Value.Bool(false); }
    if (data.len() == 10 && data[4] == 45 && data[7] == 45) ||
       (data.len() >= 8 && data[2] == 58) ||
       (data.len() >= 19 && data[4] == 45 && data[7] == 45) {
        validateDateTime(source)!;
        return Value.DateTime(text.fromBytes(data)!);
    }
    var prefixedInteger = data.len() >= 2 && data[0] == 48 &&
        (data[1] == 120 || data[1] == 111 || data[1] == 98);
    var floating = false;
    if !prefixedInteger {
        for byte in data {
            if byte == 46 || byte == 101 || byte == 69 { floating = true; }
        }
    }
    if source == "inf" || source == "+inf" || source == "-inf" ||
       source == "nan" || source == "+nan" || source == "-nan" { floating = true; }
    if floating {
        validateFloat(source)!;
        return Value.Float(text.fromBytes(data)!);
    }
    var radix: u8 = 10;
    var clean = cleanInteger(source, raw radix)!;
    var integer = numberParser.parseInt<i64>(clean, radix) catch { return TomlError.InvalidNumber; };
    Value.Integer(integer)
}

func countEntries(document: *const Document, depth: usize, maxDepth: usize) !usize {
    if depth > maxDepth { return TomlError.DepthLimit; }
    var count = document.len();
    for index in usize(0)..document.len() {
        switch *document.valueAt(index).unwrap() {
            Value.Table(ref table) => {
                var nested = countEntries(table.toRaw(), depth + 1, maxDepth)!;
                if nested > ~usize(0) - count { return TomlError.SizeLimit; }
                count += nested;
            },
            Value.Array(ref array) => {
                for item in array.iterRef() {
                    switch *item {
                        Value.Table(ref table) => {
                            var nested = countEntries(table.toRaw(), depth + 1, maxDepth)!;
                            if nested > ~usize(0) - count { return TomlError.SizeLimit; }
                            count += nested;
                        },
                        _ => {},
                    }
                }
            },
            _ => {},
        }
    }
    count
}

pub func parseWithOptions(value: str, options: TomlOptions) !Document {
    if value.byteLen() > options.maxBytes { return TomlError.SizeLimit; }
    var source = value.asBytes();
    text.validateUtf8(source) catch { return TomlError.InvalidSyntax; };
    var document = Document();
    var section = raw document;
    var sectionDepth: usize = 0;
    var statement = coll.Vec<u8>();
    var position: usize = 0;
    while position < source.len() {
        nextStatement(source, raw position, raw statement)!;
        var line = trim(unsafe { __vqr_text_borrow_utf8(statement.asConstSlice()) });
        if line.byteLen() == 0 { continue; }
        var data = line.asBytes();
        if data[0] == 91 {
            for byte in data { if byte == 10 { return TomlError.InvalidSyntax; } }
            var array = data.len() >= 2 && data[1] == 91;
            var brackets = if array { usize(2) } else { usize(1) };
            if data.len() <= brackets * 2 || data[data.len() - 1] != 93 ||
                (array && data[data.len() - 2] != 93) { return TomlError.InvalidSyntax; }
            var header = trim(unsafe { __vqr_text_borrow_utf8(data[brackets..data.len() - brackets]) });
            var path = parseKeyPath(header)!;
            if path.len() == 0 || path.len() > options.maxDepth { return TomlError.DepthLimit; }
            section = declareTable(raw document, path.asConstSlice(), array)!;
            sectionDepth = path.len();
            continue;
        }
        var equal = findTopLevel(line, 61) ?? { return TomlError.InvalidSyntax; };
        var keyText = trim(unsafe { __vqr_text_borrow_utf8(data[0..equal]) });
        var rhs = trim(unsafe { __vqr_text_borrow_utf8(data[equal + 1..data.len()]) });
        var keys = parseKeyPath(keyText)!;
        if keys.len() == 0 || keys.len() > options.maxDepth - sectionDepth { return TomlError.DepthLimit; }
        var item = parseValue(rhs, sectionDepth, raw options)!;
        setDotted(section, keys.asConstSlice(), move(item), true)!;
    }
    if countEntries(raw document, 0, options.maxDepth)! > options.maxEntries { return TomlError.SizeLimit; }
    move(document)
}

pub func parse(value: str) !Document { parseWithOptions(value, TomlOptions()) }

pub func parseReader(reader: *io.Reader, limit: usize) !Document {
    var source = io.readToString(reader, limit) catch (reason) {
        if reason == io.IoError.LimitExceeded { return TomlError.SizeLimit; }
        return reason;
    };
    var options = TomlOptions();
    options.maxBytes = limit;
    parseWithOptions(source, options)
}

func appendByte(builder: *text.StringBuilder, byte: u8) !void {
    var data: [1]u8 = [1]u8{byte};
    var piece = text.fromBytes(data[:])!;
    builder.append(piece)
}

func appendRaw(builder: *text.StringBuilder, value: str) !void { builder.append(value) }

func appendQuoted(builder: *text.StringBuilder, value: str) !void {
    appendRaw(builder, "\"")!;
    var data = value.asBytes();
    var start: usize = 0;
    for index in usize(0)..data.len() {
        var byte = data[index];
        var special = byte == 34 || byte == 92 || byte == 8 || byte == 9 ||
                      byte == 10 || byte == 12 || byte == 13 || byte < 0x20 || byte == 0x7f;
        if !special { continue; }
        if index > start {
            var raw = unsafe { __vqr_text_borrow_utf8(data[start..index]) };
            appendRaw(builder, raw)!;
        }
        switch byte {
            34 => appendRaw(builder, "\\\"")!,
            92 => appendRaw(builder, "\\\\")!,
            8 => appendRaw(builder, "\\b")!,
            9 => appendRaw(builder, "\\t")!,
            10 => appendRaw(builder, "\\n")!,
            12 => appendRaw(builder, "\\f")!,
            13 => appendRaw(builder, "\\r")!,
            _ => {
                var digits = "0123456789abcdef".asBytes();
                appendRaw(builder, "\\u00")!;
                appendByte(builder, digits[usize(byte >> 4)])!;
                appendByte(builder, digits[usize(byte & 15)])!;
            },
        }
        start = index + 1;
    }
    if start < data.len() {
        var raw = unsafe { __vqr_text_borrow_utf8(data[start..data.len()]) };
        appendRaw(builder, raw)!;
    }
    appendRaw(builder, "\"")
}

func bareKey(value: str) bool {
    var data = value.asBytes();
    if data.len() == 0 { return false; }
    for byte in data {
        var valid = (65 <= byte && byte <= 90) || (97 <= byte && byte <= 122) ||
                    (48 <= byte && byte <= 57) || byte == 95 || byte == 45;
        if !valid { return false; }
    }
    true
}

func appendKey(builder: *text.StringBuilder, value: str) !void {
    if bareKey(value) { appendRaw(builder, value) }
    else { appendQuoted(builder, value) }
}

func integerText(value: i64) !string {
    var negative = value < 0;
    var bits = bitCast<u64>(value);
    var magnitude = if negative { 0u64 -% bits } else { bits };
    var digits = coll.Vec<u8>();
    for {
        digits.push(u8(48 + (magnitude % 10))!)!;
        magnitude = magnitude / 10;
        if magnitude == 0 { break; }
    }
    if negative { digits.push(45)!; }
    var output = coll.Vec<u8>();
    for index := digits.len(); index > 0; index-- { output.push(digits[index - 1])!; }
    text.fromBytes(output.asConstSlice())
}

func writeValue(value: *const Value, builder: *text.StringBuilder, depth: usize, maxDepth: usize) !void {
    if depth > maxDepth { return TomlError.DepthLimit; }
    switch *value {
        Value.String(item) => appendQuoted(builder, item),
        Value.Integer(item) => {
            var raw = integerText(item)!;
            appendRaw(builder, raw)
        },
        Value.Float(item) => {
            validateFloat(item)!;
            appendRaw(builder, item)
        },
        Value.Bool(item) => appendRaw(builder, if item { "true" } else { "false" }),
        Value.DateTime(item) => {
            validateDateTime(item)!;
            appendRaw(builder, item)
        },
        Value.Array(ref items) => {
            appendRaw(builder, "[")!;
            for index in usize(0)..items.len() {
                if index != 0 { appendRaw(builder, ", ")!; }
                writeValue(items.getPtr(index).unwrap(), builder, depth + 1, maxDepth)!;
            }
            appendRaw(builder, "]")
        },
        Value.Table(ref table) => {
            appendRaw(builder, "{")!;
            for index in usize(0)..table.len() {
                if index != 0 { appendRaw(builder, ", ")!; }
                appendKey(builder, table.keyAt(index).unwrap())!;
                appendRaw(builder, " = ")!;
                writeValue(table.valueAt(index).unwrap(), builder, depth + 1, maxDepth)!;
            }
            appendRaw(builder, "}")
        },
    }
}

func writeDocument(document: *const Document, builder: *text.StringBuilder,
                   prefix: str, depth: usize, maxDepth: usize) !void {
    if depth > maxDepth { return TomlError.DepthLimit; }
    for index in usize(0)..document.len() {
        var value = document.valueAt(index).unwrap();
        switch *value {
            Value.Table(_) => {},
            _ => {
                appendKey(builder, document.keyAt(index).unwrap())!;
                appendRaw(builder, " = ")!;
                writeValue(value, builder, depth, maxDepth)!;
                appendRaw(builder, "\n")!;
            },
        }
    }
    for index in usize(0)..document.len() {
        var value = document.valueAt(index).unwrap();
        switch *value {
            Value.Table(ref table) => {
                var pathBuilder = text.StringBuilder();
                if prefix.byteLen() != 0 {
                    appendRaw(raw pathBuilder, prefix)!;
                    appendRaw(raw pathBuilder, ".")!;
                }
                appendKey(raw pathBuilder, document.keyAt(index).unwrap())!;
                var path = pathBuilder.build()!;
                appendRaw(builder, "\n[")!;
                appendRaw(builder, path)!;
                appendRaw(builder, "]\n")!;
                writeDocument(table.toRaw(), builder, path, depth + 1, maxDepth)!;
            },
            _ => {},
        }
    }
}

pub func stringify(document: *const Document) !string { stringifyDocument(document) }

func stringifyDocument(document: *const Document) !string {
    var builder = text.StringBuilder();
    writeDocument(document, raw builder, "", 0, 64)!;
    builder.build()
}
