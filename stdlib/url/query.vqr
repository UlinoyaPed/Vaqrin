package url
import (coll, encoding, text)

pub class QueryParam {
    var keyValue: string;
    var dataValue: string;
public:
    func init(key: string, value: string) : keyValue(move(key)), dataValue(move(value)) {}
    const func key() str { keyValue }
    const func value() str { dataValue }
}

pub class QueryValueIter {
    var entries: []const QueryParam;
    var keyValue: string;
    var index: usize;
public:
    func init(entries: []const QueryParam, key: string) : entries(entries), keyValue(key), index(0) {}
    func next() ?str {
        for index < entries.len() {
            var current = index;
            index++;
            if entries[current].key() == keyValue { return some(entries[current].value()); }
        }
        null
    }
}

pub class QueryParams {
    #copy: disabled
    var entries: coll.Vec<QueryParam>;
public:
    func init() : entries(coll.Vec<QueryParam>()) {}

    static func parse(value: str) !Self {
        var result = QueryParams();
        var source = value.asBytes();
        if findByte(source, 35) != null { return UrlError.InvalidCharacter; }
        var start: usize = 0;
        if source.len() > 0 && source[0] == 63 { start = 1; }
        var fieldStart = start;
        for i := start; i <= source.len(); i++ {
            if i == source.len() || source[i] == 38 {
                if i > fieldStart {
                    var field = source[fieldStart..i];
                    var equal = findByte(field, 61);
                    var keyBytes = field;
                    var valueBytes: []const u8 = field[0..0];
                    switch equal {
                        some(position) => {
                            keyBytes = field[0..position];
                            valueBytes = field[position + 1..field.len()];
                        },
                        null => {},
                    }
                    var key = decodeQueryComponent(keyBytes)!;
                    var item = decodeQueryComponent(valueBytes)!;
                    result.append(key, item)!;
                }
                fieldStart = i + 1;
            }
        }
        move(result)
    }

    func append(key: str, value: str) !void {
        var ownedKey = text.fromBytes(key.asBytes())!;
        var ownedValue = text.fromBytes(value.asBytes())!;
        entries.push(QueryParam(move(ownedKey), move(ownedValue)))!
    }

    func set(key: str, value: str) !void {
        var found = false;
        var index: usize = 0;
        for index < entries.len() {
            if entries[index].key() == key {
                if !found {
                    var replacement = QueryParam(text.fromBytes(key.asBytes())!, text.fromBytes(value.asBytes())!);
                    var previous = entries.replace(index, move(replacement));
                    found = true;
                    index++;
                } else {
                    var removed = entries.remove(index);
                }
            } else { index++; }
        }
        if !found { append(key, value)!; }
    }

    const func get(key: str) ?str {
        for index in usize(0)..entries.len() {
            var entry = entries.get(index).unwrap();
            if entry.key() == key { return some(entry.value()); }
        }
        null
    }

    const func getAll(key: str) !QueryValueIter {
        var owned = text.fromBytes(key.asBytes())!;
        QueryValueIter(entries.asConstSlice(), move(owned))
    }

    func remove(key: str) usize {
        var removed: usize = 0;
        var index: usize = 0;
        for index < entries.len() {
            if entries[index].key() == key {
                var item = entries.remove(index);
                removed++;
            } else { index++; }
        }
        removed
    }

    const func len() usize { entries.len() }
    const func isEmpty() bool { entries.isEmpty() }
    const func items() []const QueryParam { entries.asConstSlice() }

    const func encode() !string {
        var output = text.StringBuilder();
        for i := usize(0); i < entries.len(); i++ {
            if i != 0 { output.append("&")!; }
            var key = queryEscape(entries.get(i).unwrap().key())!;
            output.append(key)!;
            output.append("=")!;
            var value = queryEscape(entries.get(i).unwrap().value())!;
            output.append(value)!;
        }
        output.build()
    }
}

func decodeQueryComponent(value: []const u8) !string {
    for byte in value {
        if byte > 127 { return UrlError.InvalidCharacter; }
    }
    var raw = text.fromBytes(value)!;
    var decoded = encoding.percentDecode(raw) catch { return UrlError.InvalidPercentEncoding; };
    text.fromBytes(decoded.asConstSlice()) catch { return UrlError.InvalidUtf8; }
}


pub func queryEscape(value: str) !string {
    encoding.percentEncode(value.asBytes(), "".asBytes())
}
pub func queryUnescape(value: str) !string {
    var decoded = encoding.percentDecode(value) catch { return UrlError.InvalidPercentEncoding; };
    text.fromBytes(decoded.asConstSlice()) catch { return UrlError.InvalidUtf8; }
}
pub func pathEscape(value: str) !string {
    encoding.percentEncode(value.asBytes(), "!$&'()*+,;=:@".asBytes())
}
pub func pathUnescape(value: str) !string {
    var decoded = encoding.percentDecode(value) catch { return UrlError.InvalidPercentEncoding; };
    text.fromBytes(decoded.asConstSlice()) catch { return UrlError.InvalidUtf8; }
}
pub func parseQuery(value: str) !QueryParams { QueryParams.parse(value) }
pub func encodeQuery(items: []const (str, str)) !string {
    var output = text.StringBuilder();
    var first = true;
    for item in items {
        var key = queryEscape(item.0)!;
        var value = queryEscape(item.1)!;
        if !first { output.append("&")!; }
        first = false;
        output.append(key)!;
        output.append("=")!;
        output.append(value)!;
    }
    output.build()
}
